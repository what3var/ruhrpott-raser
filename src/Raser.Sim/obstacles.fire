// Raser.Sim: Hindernisse der Welt ohne Szene - die Grundrisse der Gebäude (mit Durchfahrten) und die Pfosten (Bäume, Laternen, Ampeln) je Kachel,
// aus den Daten der Kacheln (Raser.World). Client (Fahren, Kamera, Karte) und Server (autoritative Physik) rechnen damit dasselbe.
#import "filesystem"
#import "raser.core"
#import "raser.world"

namespace Raser {
    // Wo man im Fahrmodus nicht hin kann: die Grundrisse der Gebäude (je Kachel geladen, mit ihren Rechtecken). Frei bleiben Überdachungen
    // (nur ein Dach) und Durchfahrten (Raser.Voxelizer.Passages: ein Weg quer durch das Haus).
    class Obstacles {
        Raser.FileTileStore store
        Dictionary<string, Raser.Tile> tiles
        defined bool manual             // nicht selbst laden: die Kacheln kommen über Install (Server, Raser.TileWorker)
        Dictionary<string, List<Raser.Box2>> boxes
        Dictionary<string, List<int>> grids           // je Kachel ein Raster der Gebäude (16 x 16 Zellen zu 16 m, Obstacles.Grid): welche Rechtecke in welcher Zelle
        Dictionary<int, List<float>> passages         // je Gebäude (ID) seine Durchfahrten, bei Bedarf
        Dictionary<int, List<float>> posts            // je Zelle (8 m) die Pfosten darin: Ost, Nord, Radius (Baumstämme, Laternen, Ampeln)
        Dictionary<string, List<Raser.BridgeDeck>> decks  // je Kachel die Decks ihrer Brücken (Raser.Bridges: wie gezeichnet)
        Dictionary<string, List<float>> rails         // je Kachel Leitplanken und Wände der Autobahnen (Raser.Motorways.Rails, wie gezeichnet)

        // world "": ohne Welt (keine Hindernisse - Bots und Tests ohne Daten).
        construct(string world) {
            this.manual = false
            this.store = undefined
            if (world != undefined && world != "") { this.store = new Raser.FileTileStore(world) }
            this.tiles = new Dictionary<string, Raser.Tile>()
            this.boxes = new Dictionary<string, List<Raser.Box2>>()
            this.grids = new Dictionary<string, List<int>>()
            this.passages = new Dictionary<int, List<float>>()
            this.posts = new Dictionary<int, List<float>>()
            this.decks = new Dictionary<string, List<Raser.BridgeDeck>>(Owns.Values)
            this.rails = new Dictionary<string, List<float>>(Owns.Values)
        }

        // Die Kachel zu einem Schlüssel mit den Rechtecken ihrer Gebäude (um 2 m gewachsen), bei Bedarf geladen.
        undefined Need(Raser.TileKey key, string name) {
            if (this.tiles.ContainsKey(name) || this.manual) { return }
            Raser.Tile loaded = undefined
            if (this.store != undefined) { loaded = this.store.Load(key) }
            this.Install(key, name, take loaded)
        }

        // Eine geladene Kachel übernehmen (undefined: dort gibt es keine). Mit manual (Server: Raser.TileWorker lädt in einem eigenen Thread)
        // kommen die Kacheln nur so herein - fehlt eine, steht dort nichts im Weg.
        undefined Install(Raser.TileKey key, string name, Raser.Tile loaded) {
            if (this.tiles.ContainsKey(name)) { return }
            var list = new List<Raser.Box2>()
            if (loaded != undefined) {
                foreach (b in loaded.data.buildings) {
                    var box = Raser.Box2.Of(b.footprint)
                    box.Grow(2.0)
                    list.Add(take box)
                }
                // die Pfosten: Baumstämme, Laternen, Ampeln, Hecken, Spielgeräte, Lauben (Beete, Büsche, Farne, Bänke, Schilder halten nicht auf)
                if (loaded.data.props != undefined) {
                    foreach (p in loaded.data.props) {
                        float r = 0.0
                        if (p.kind == "tree") { r = 0.3 }
                        if (p.kind == "lamp" || p.kind == "signal") { r = 0.12 }
                        // Grün und Spiel (Raser.Greens): Hecken (je Stück 2 m), Spielgeräte, Lauben, Tore
                        if (p.kind == "hedge") { r = 0.7 }
                        if (p.kind == "swing" || p.kind == "slide" || p.kind == "climber") { r = 0.9 }
                        if (p.kind == "shed") { r = 1.2 }
                        if (p.kind == "goal" || p.kind == "hoop") { r = 0.25 }
                        if (r <= 0.0) { continue }
                        float pe = key.East + p.x
                        float pn = key.North + p.y
                        int cell = Raser.Obstacles.Cell(Math.Floor(pe / 8.0)!int, Math.Floor(pn / 8.0)!int)
                        if (!this.posts.ContainsKey(cell)) {
                            var fresh = new List<float>()
                            this.posts[cell] = fresh
                            fresh.TakeTo(this.posts)
                        }
                        var into = this.posts[cell]
                        into.Add(pe)
                        into.Add(pn)
                        into.Add(r)
                    }
                }
            }
            this.decks[name] = Raser.Bridges.Of(loaded)
            var rails = Raser.Motorways.Rails(loaded)
            // die Stützwände an den Rampen der Tunnel (Raser.Tunnels.Walls, dieselbe Form)
            foreach (v in Raser.Tunnels.Walls(loaded)) { rails.Add(v) }
            this.rails[name] = rails
            rails.TakeTo(this.rails)
            this.tiles[name] = loaded
            if (loaded != undefined) { loaded.TakeTo(this.tiles) }
            var grid = Raser.Obstacles.Grid(list)
            this.grids[name] = grid
            grid.TakeTo(this.grids)
            this.boxes[name] = list
            list.TakeTo(this.boxes)
        }

        // Das Raster der Gebäude einer Kachel: 256 Zellen zu 16 x 16 m. Die ersten 257 Werte sind, wo die Liste einer Zelle beginnt (ab 257 gezählt,
        // der letzte das Ende), danach die Nummern der Rechtecke je Zelle - ein Rechteck steht in jeder Zelle, die es berührt. So prüft eine
        // Abfrage an einem Punkt nur die Gebäude seiner Zelle statt aller der Kachel (die Kamera fragt je Bild gut 100 Punkte ab).
        static List<int> Grid(List<Raser.Box2> boxes) {
            var counts = new List<int>()
            for (int c = 0; c < 257; c++) { counts.Add(0) }
            for (int k = 0; k < boxes.Count; k++) {
                var b = boxes[k]
                int x0 = Raser.Obstacles.GridCell(b.minX)
                int x1 = Raser.Obstacles.GridCell(b.maxX)
                int y0 = Raser.Obstacles.GridCell(b.minY)
                int y1 = Raser.Obstacles.GridCell(b.maxY)
                for (int cy = y0; cy <= y1; cy++) {
                    for (int cx = x0; cx <= x1; cx++) { counts[cy * 16 + cx] = counts[cy * 16 + cx] + 1 }
                }
            }
            var grid = new List<int>()
            int at = 257
            for (int c = 0; c < 256; c++) {
                grid.Add(at)
                at = at + counts[c]
            }
            grid.Add(at)
            for (int i = 257; i < at; i++) { grid.Add(0) }
            // füllen (counts wird zum Schreibzeiger je Zelle)
            for (int c = 0; c < 256; c++) { counts[c] = grid[c] }
            for (int k = 0; k < boxes.Count; k++) {
                var b = boxes[k]
                int x0 = Raser.Obstacles.GridCell(b.minX)
                int x1 = Raser.Obstacles.GridCell(b.maxX)
                int y0 = Raser.Obstacles.GridCell(b.minY)
                int y1 = Raser.Obstacles.GridCell(b.maxY)
                for (int cy = y0; cy <= y1; cy++) {
                    for (int cx = x0; cx <= x1; cx++) {
                        int c = cy * 16 + cx
                        grid[counts[c]] = k
                        counts[c] = counts[c] + 1
                    }
                }
            }
            return grid
        }

        // Die Spalte bzw. Zeile (0 bis 15) des Rasters zu einer Koordinate in der Kachel (m).
        static defined int GridCell(defined float v) { return Math.Clamp(Math.Floor(v / 16.0)!int, 0, 15) }

        // Die Kachel unter (e, n) (geladen, wenn nötig); undefined: keine.
        Raser.Tile TileAt(defined float e, defined float n) {
            var key = Raser.TileKey.Of(e, n)
            string name = key + ""
            this.Need(key, name)
            return this.tiles.Get(name, undefined)
        }

        // Ein Kreis (Radius bis 1,9 m) um (e, n) gegen die Gebäude: true, wenn er in einer Wand steckt - dann zeigt (pushX, pushY) aus der Wand
        // heraus und depth sagt, wie weit er hinaus muss (die tiefste Berührung). Durchfahrten sind frei.
        defined float pushX
        defined float pushY
        defined float depth
        // posts = false: ohne die Pfosten (auf einer Brücke stehen sie unten).
        // buildings = false: ohne die Gebäude (in einem Tunnel liegen sie darüber).
        defined bool Push(defined float e, defined float n, defined float radius, defined bool posts = true, defined bool buildings = true) {
            var key = Raser.TileKey.Of(e, n)
            string name = key + ""
            this.Need(key, name)
            this.depth = 0.0
            var tile = this.tiles.Get(name, undefined)
            if (tile == undefined) { return false }
            // die Pfosten in den Zellen ringsum
            int ce = Math.Floor(e / 8.0)!int
            int cn = Math.Floor(n / 8.0)!int
            for (int dn = -1; dn <= 1 && posts; dn++) {
                for (int de = -1; de <= 1; de++) {
                    int cell = Raser.Obstacles.Cell(ce + de, cn + dn)
                    if (!this.posts.ContainsKey(cell)) { continue }
                    var ps = this.posts[cell]
                    for (int q = 0; q + 2 < ps.Count; q = q + 3) {
                        float dx = e - ps[q]
                        float dy = n - ps[q + 1]
                        float d = Math.Sqrt(dx * dx + dy * dy)
                        float deep = radius + ps[q + 2] - d
                        if (deep > this.depth && d > 0.0001) {
                            this.depth = deep
                            this.pushX = dx / d
                            this.pushY = dy / d
                        }
                    }
                }
            }
            // Leitplanken und Wände (auf dem Gelände: posts)
            if (posts && this.rails.ContainsKey(name)) {
                var rl = this.rails[name]
                float rx = e - key.East
                float ry = n - key.North
                for (int q = 0; q + 4 < rl.Count; q = q + 5) {
                    float ax = rl[q]
                    float ay = rl[q + 1]
                    if (Math.Abs(ax - rx) > radius + 4.0 || Math.Abs(ay - ry) > radius + 4.0) { continue }
                    float ex = rl[q + 2] - ax
                    float ey = rl[q + 3] - ay
                    float l2 = ex * ex + ey * ey
                    if (l2 < 0.0001) { continue }
                    float t = Math.Clamp(((rx - ax) * ex + (ry - ay) * ey) / l2, 0.0, 1.0)
                    float dx = rx - (ax + ex * t)
                    float dy = ry - (ay + ey * t)
                    float d = Math.Sqrt(dx * dx + dy * dy)
                    float thick = 0.1
                    if (rl[q + 4] > 1.5) { thick = 0.25 }
                    float deep = radius + thick - d
                    if (deep > this.depth && d > 0.0001) {
                        this.depth = deep
                        this.pushX = dx / d
                        this.pushY = dy / d
                    }
                }
            }
            if (!buildings) { return this.depth > 0.0 }
            var bx = this.boxes[name]
            float x = e - key.East
            float y = n - key.North
            // nur die Gebäude der Zelle (Raster)
            var grid = this.grids[name]
            int gcell = Raser.Obstacles.GridCell(y) * 16 + Raser.Obstacles.GridCell(x)
            for (int g = grid[gcell]; g < grid[gcell + 1]; g++) {
                int k = grid[g]
                if (!bx[k].Contains(x, y)) { continue }
                var b = tile.data.buildings[k]
                if (b.function != undefined && (b.function.StartsWith("alkis=51009") || b.function.StartsWith("alkis=53001"))) { continue }
                // der nächste Punkt auf dem Rand
                int np = b.footprint.length / 2
                float best = 1000000.0
                float qx = 0.0
                float qy = 0.0
                for (int i = 0; i < np; i++) {
                    int j = (i + 1) % np
                    float ax = b.footprint[i * 2]
                    float ay = b.footprint[i * 2 + 1]
                    float ex = b.footprint[j * 2] - ax
                    float ey = b.footprint[j * 2 + 1] - ay
                    float len2 = ex * ex + ey * ey
                    float t = 0.0
                    if (len2 > 0.0) { t = Math.Clamp(((x - ax) * ex + (y - ay) * ey) / len2, 0.0, 1.0) }
                    float px = ax + ex * t
                    float py = ay + ey * t
                    float d2 = (px - x) * (px - x) + (py - y) * (py - y)
                    if (d2 < best) {
                        best = d2
                        qx = px
                        qy = py
                    }
                }
                float d = Math.Sqrt(best)
                bool inside = Raser.Geo.Inside(b.footprint, x, y)
                if (!inside && d >= radius) { continue }
                if (d < 0.0001) { continue }
                if (!this.passages.ContainsKey(b.id)) {
                    var ps = Raser.Voxelizer.Passages(b, tile.data.roads)
                    this.passages[b.id] = ps
                    ps.TakeTo(this.passages)
                }
                var ways = this.passages[b.id]
                bool through = false
                for (int q = 0; q + 6 < ways.Count; q = q + 7) {
                    if (Raser.Voxelizer.PassageDistance(ways, q, x, y) < ways[q + 4] - radius * 0.5) { through = true }
                }
                if (through) { continue }
                float deep = radius - d
                float nx = (x - qx) / d
                float ny = (y - qy) / d
                if (inside) {
                    deep = radius + d
                    nx = -nx
                    ny = -ny
                }
                if (deep > this.depth) {
                    this.depth = deep
                    this.pushX = nx
                    this.pushY = ny
                }
            }
            return this.depth > 0.0
        }

        static defined int Cell(defined int ce, defined int cn) { return ce * 73856093 + cn * 19349663 }

        // Die Namen der Kacheln ("x_y") unter names, die mehr als eine Kachel von der Kachel bei (e, n) entfernt sind.
        static List<string> FarTiles(List<string> names, defined float e, defined float n) {
            var here = Raser.TileKey.Of(e, n)
            var gone = new List<string>()
            foreach (name in names) {
                var key = Raser.TileKey.Parse(name)
                if (key == undefined) { continue }
                if (Math.Max(Math.Abs(key.x - here.x), Math.Abs(key.y - here.y)) > 1) { gone.Add(name) }
            }
            return gone
        }

        // Lange Fahrten: alles von Kacheln weg, die mehr als eine Kachel von (e, n) entfernt sind - Grundrisse, Rechtecke, Pfosten und die
        // Durchfahrten (die werden bei Bedarf neu berechnet). Gibt zurück, wie viele Kacheln.
        defined int Trim(defined float e, defined float n) {
            var gone = Raser.Obstacles.FarTiles(this.tiles.Keys, e, n)
            return this.Forget(gone)
        }

        // Der Server: alles weg außer den Kacheln in keep ("x_y": die mit Spielern und ihre Nachbarn). Gibt zurück, wie viele Kacheln.
        defined int Keep(HashSet<string> keep) {
            var gone = new List<string>()
            foreach (name in this.tiles.Keys) { if (!keep.Contains(name)) { gone.Add(name) } }
            return this.Forget(gone)
        }

        // Vergisst die Kacheln gone (Namen "x_y").
        defined int Forget(List<string> gone) {
            if (gone.Count == 0) { return 0 }
            foreach (name in gone) {
                this.tiles.Remove(name)
                this.boxes.Remove(name)
                this.grids.Remove(name)
                this.decks.Remove(name)
                this.rails.Remove(name)
            }
            this.passages.Clear()
            // die Pfosten liegen je Zelle (8 m, nie über eine Kachelgrenze); zu welcher Kachel eine Zelle gehört, sagt ihr erster Pfosten
            var dropped = new HashSet<string>()
            foreach (name in gone) { dropped.Add(name) }
            var cells = new List<int>()
            foreach (pair in this.posts) {
                var ps = pair.Value
                if (ps.Count < 3) { continue }
                if (dropped.Contains(Raser.TileKey.Of(ps[0], ps[1]) + "")) { cells.Add(pair.Key) }
            }
            foreach (c in cells) { this.posts.Remove(c) }
            // (eine nachgeladene Kachel bringt ihre Pfosten wieder mit)
            return gone.Count
        }

        // Der nächste Baum zu (e, n) in dessen Kachel: Ost, Nord; undefined: keiner. (Zum Prüfen.)
        float[] NearestTree(defined float e, defined float n) {
            var key = Raser.TileKey.Of(e, n)
            string name = key + ""
            this.Need(key, name)
            var tile = this.tiles.Get(name, undefined)
            if (tile == undefined || tile.data.props == undefined) { return undefined }
            float best = 1.0e30
            float result[] = undefined
            foreach (p in tile.data.props) {
                if (p.kind != "tree") { continue }
                float dx = key.East + p.x - e
                float dy = key.North + p.y - n
                if (dx * dx + dy * dy < best) {
                    best = dx * dx + dy * dy
                    result = [key.East + p.x, key.North + p.y]
                }
            }
            return result
        }

        // Brücken (Raser.Bridges). Die Decks der Kachel unter (e, n) (geladen, wenn nötig); undefined: keine Kachel.
        List<Raser.BridgeDeck> DecksAt(defined float e, defined float n) {
            var key = Raser.TileKey.Of(e, n)
            string name = key + ""
            this.Need(key, name)
            if (!this.decks.ContainsKey(name)) { return undefined }
            return this.decks[name]
        }

        // Die Ebene nach einem Schritt nach (e, n): current ist die Brücke bzw. der Tunnel, auf dem man war (0: auf dem Gelände). Man bleibt darauf,
        // solange man auf ihm ist (bis 0,3 m über den Rand). Verlässt man es, kommt man auf ein anderes Deck derselben Höhe (bis 0,7 m: an den
        // Rampen der Brücken - nur über ihre Enden -, an Abzweigen der Tunnel und in Tiefgaragen) oder auf das Gelände; in einen Tunnel kommt man
        // vom Gelände über sein Portal (bis 3 m hinein, wo die Fahrbahn auf dem Gelände endet). Aus einem Tunnel heraus geht es nur dort aufs
        // Gelände, wo es höchstens 1,5 m darüber liegt (sonst bleibt man im Tunnel: eine Wand am Ende). Gibt die ID der Brücke bzw. des Tunnels
        // oder 0.
        defined int Level(defined float e, defined float n, defined int current) {
            var list = this.DecksAt(e, n)
            if (list == undefined || list.Count == 0) { return 0 }
            var key = Raser.TileKey.Of(e, n)
            float x = e - key.East
            float y = n - key.North
            Raser.BridgeDeck cur = undefined
            if (current != 0) {
                foreach (d in list) {
                    if (d.road == current) { cur = d }
                }
                if (cur != undefined && cur.Covers(x, y, 0.3)) { return current }
            }
            // die Höhe, auf der man ist
            float ground = 0.0
            var tile = this.tiles.Get(key + "", undefined)
            if (tile != undefined && tile.heights != undefined) { ground = tile.heights.At(x, y) }
            float h = ground
            if (cur != undefined) {
                cur.Nearest(x, y)
                h = cur.HeightHit()
            }
            int found = 0
            float bestDiff = 0.7
            foreach (d in list) {
                if (d == cur || !d.Covers(x, y, 0.0)) { continue }
                float z = d.HeightHit()
                float diff = Math.Abs(z - h)
                if (!d.tunnel) {
                    // auf eine Brücke nur über die Enden (die Seiten hat die Brüstung)
                    if (d.hitS > 3.0 && d.hitS < d.length - 3.0) { continue }
                    if (cur == undefined) { diff = Math.Abs(z - d.GroundAt(d.hitS)) }
                } else if (cur == undefined && d.ring == undefined) {
                    // vom Gelände in einen Tunnel: nur durch das Portal (das offene Ende; das Raster springt dort auf die Oberfläche)
                    bool portal = (d.startJoined && d.hitS <= 3.0) || (d.endJoined && d.hitS >= d.length - 3.0)
                    if (!portal || h > z + 2.0) { continue }
                    diff = 0.0
                }
                if (diff <= bestDiff) {
                    bestDiff = diff
                    found = d.road
                }
            }
            if (found != 0) { return found }
            if (cur != undefined && cur.tunnel && ground - h > 1.5) { return current }
            return 0
        }

        // Ist die Ebene level an (e, n) ein Tunnel bzw. eine Tiefgarage?
        defined bool Underground(defined float e, defined float n, defined int level) {
            if (level == 0) { return false }
            var list = this.DecksAt(e, n)
            if (list == undefined) { return false }
            foreach (d in list) {
                if (d.road == level) { return d.tunnel }
            }
            return false
        }

        // Unter der Decke: die Höhe der Decke über (e, n) auf der Ebene level (m über NHN); undefined: kein Tunnel oder offen (Rampe, Einschnitt).
        any Ceiling(defined float e, defined float n, defined int level) {
            if (level == 0) { return undefined }
            var list = this.DecksAt(e, n)
            if (list == undefined) { return undefined }
            var key = Raser.TileKey.Of(e, n)
            float x = e - key.East
            float y = n - key.North
            foreach (d in list) {
                if (d.road != level || !d.tunnel) { continue }
                d.Nearest(x, y)
                float z = d.HeightHit()
                float top = d.top[0]
                if (d.ring == undefined) { top = d.TopAt(d.hitS) }
                if (!Raser.Tunnels.Covered(z, top)) { return undefined }
                return Raser.Tunnels.Ceiling(z, top, d.clearance)
            }
            return undefined
        }

        // Liegt (e, n) in einem Tunnel bzw. einer Tiefgarage der Höhe z (bis 0,7 m) - mit margin m Abstand zu den Wänden?
        defined bool InTube(defined float e, defined float n, defined float z, defined float margin) {
            var list = this.DecksAt(e, n)
            if (list == undefined) { return false }
            var key = Raser.TileKey.Of(e, n)
            float x = e - key.East
            float y = n - key.North
            foreach (d in list) {
                if (!d.tunnel || !d.Covers(x, y, -margin)) { continue }
                if (Math.Abs(d.HeightHit() - z) <= 0.7) { return true }
            }
            return false
        }

        // Die Höhe der Fahrbahn an (e, n) auf der Brücke bridge (m über NHN); undefined: nicht darauf (dann gilt das Gelände). bridge -1: die
        // höchste Brücke, die (e, n) überdeckt (für die anderen, von denen der Snapshot nur weiß, dass sie auf einer sind); -2: der tiefste
        // Tunnel dort (Raser.EntityType.Underground).
        any DeckHeight(defined float e, defined float n, defined int bridge) {
            if (bridge == 0) { return undefined }
            var list = this.DecksAt(e, n)
            if (list == undefined) { return undefined }
            var key = Raser.TileKey.Of(e, n)
            float x = e - key.East
            float y = n - key.North
            any best = undefined
            foreach (d in list) {
                if (bridge > 0 && d.road != bridge) { continue }
                if (bridge == -2 && !d.tunnel) { continue }
                if (d.tunnel && bridge > 0) {
                    // im Tunnel auch über ein Ende hinaus (an einer Wand), solange man in seiner Breite ist
                    if (d.Nearest(x, y) > d.width / 2.0 + 1.0) { continue }
                } else if (!d.Covers(x, y, 0.5)) {
                    continue
                }
                float z = d.HeightHit()
                if (best == undefined || (bridge == -2 && z < best) || (bridge != -2 && z > best)) { best = z }
            }
            return best
        }

        // Der tiefste Tunnel bzw. die Tiefgarage an (e, n) (für die anderen, von denen der Snapshot nur weiß, dass sie unter dem Gelände sind); 0: keiner.
        defined int DeckBelow(defined float e, defined float n) {
            var list = this.DecksAt(e, n)
            if (list == undefined) { return 0 }
            var key = Raser.TileKey.Of(e, n)
            float x = e - key.East
            float y = n - key.North
            int found = 0
            float low = 1.0e30
            foreach (d in list) {
                if (!d.tunnel || !d.Covers(x, y, 0.5)) { continue }
                float z = d.HeightHit()
                if (z < low) {
                    low = z
                    found = d.road
                }
            }
            return found
        }

        // Das Deck an (e, n), dessen Fahrbahn z am nächsten liegt (bis 3 m); 0: keins. (Verkehr: die Höhe kommt mit, die Ebene nicht.)
        defined int DeckNear(defined float e, defined float n, defined float z) {
            var list = this.DecksAt(e, n)
            if (list == undefined) { return 0 }
            var key = Raser.TileKey.Of(e, n)
            float x = e - key.East
            float y = n - key.North
            int found = 0
            float best = 3.0
            foreach (d in list) {
                if (!d.Covers(x, y, 0.5)) { continue }
                float diff = Math.Abs(d.HeightHit() - z)
                if (diff < best) {
                    best = diff
                    found = d.road
                }
            }
            return found
        }

        // Die Brücke, die (e, n) überdeckt (die höchste); 0: keine.
        defined int DeckUnder(defined float e, defined float n) {
            var list = this.DecksAt(e, n)
            if (list == undefined) { return 0 }
            var key = Raser.TileKey.Of(e, n)
            float x = e - key.East
            float y = n - key.North
            int found = 0
            float top = -1.0e30
            foreach (d in list) {
                if (d.tunnel || !d.Covers(x, y, 0.5)) { continue }
                float z = d.At(d.hitS)
                if (z > top) {
                    top = z
                    found = d.road
                }
            }
            return found
        }

        // Ein Kreis an (e, n) auf der Brücke bridge gegen ihre Brüstungen (die Fahrbahn ist so breit wie die Straße), auf dem Gelände (0) gegen
        // die Pfeiler der Brücken darüber (wie Raser.BridgeMesher: alle 15 m, je ein Kreis alle 1,5 m quer). Setzt pushX, pushY, depth wie Push.
        defined bool PushBridge(defined float e, defined float n, defined float radius, defined int bridge) {
            var list = this.DecksAt(e, n)
            if (list == undefined || list.Count == 0) { return false }
            var key = Raser.TileKey.Of(e, n)
            float x = e - key.East
            float y = n - key.North
            float p[] = new float[4]
            this.depth = 0.0
            foreach (d in list) {
                if (bridge != 0 && d.tunnel) {
                    if (d.road == bridge) { this.PushTube(d, list, x, y, radius) }
                    continue
                }
                if (d.tunnel) { continue }        // vom Gelände: die Rampen haben Stützwände (Raser.Tunnels.Walls, wie Leitplanken)
                if (bridge != 0) {
                    if (d.road != bridge || !d.Covers(x, y, 0.3)) { continue }
                    float half = d.width / 2.0
                    float over = Math.Abs(d.hitSide) + radius - half
                    // die Brüstung geht über die ganze Länge (wie gezeichnet)
                    if (over <= 0.0) { continue }
                    d.PointAt(d.hitS, p)
                    // zurück zur Mitte: links der Linie nach rechts (dy, -dx), rechts nach links
                    float sg = -1.0
                    if (d.hitSide > 0.0) { sg = 1.0 }
                    if (over > this.depth) {
                        this.depth = over
                        this.pushX = p[3] * sg
                        this.pushY = -p[2] * sg
                    }
                    continue
                }
                // von unten: wo das Deck niedrig ist (unter 2,5 m über dem Gelände), ist seine Seite eine Wand (an den Enden nicht: dort geht
                // es hinauf)
                if (d.Covers(x, y, radius + 0.3) && d.hitS > 3.0 && d.hitS < d.length - 3.0 && d.At(d.hitS) - d.GroundAt(d.hitS) < 2.5) {
                    float out = d.width / 2.0 + 0.3 + radius - Math.Abs(d.hitSide)
                    if (out > this.depth) {
                        d.PointAt(d.hitS, p)
                        float sg = 1.0
                        if (d.hitSide < 0.0) { sg = -1.0 }
                        // nach außen: links der Linie nach links (-dy, dx)
                        this.depth = out
                        this.pushX = -p[3] * sg
                        this.pushY = p[2] * sg
                    }
                }
                // die Pfeiler
                foreach (s in d.piers) {
                    d.PointAt(s, p)
                    if (Math.Abs(p[0] - x) > 20.0 || Math.Abs(p[1] - y) > 20.0) { continue }
                    float across = d.width / 2.0 * 0.8
                    for (float c = -across; c <= across + 0.01; c = c + 1.5) {
                        float px = p[0] + p[3] * c
                        float py = p[1] - p[2] * c
                        float dx = x - px
                        float dy = y - py
                        float dd = Math.Sqrt(dx * dx + dy * dy)
                        float deep = radius + 0.5 - dd
                        if (deep > this.depth && dd > 0.0001) {
                            this.depth = deep
                            this.pushX = dx / dd
                            this.pushY = dy / dd
                        }
                    }
                }
            }
            return this.depth > 0.0
        }

        // Ein Kreis (kachel-lokal) im Tunnel bzw. der Tiefgarage d gegen ihre Wände (und die Wand an einem geschlossenen Ende, die Stützen der
        // Tiefgarage): frei, wo der Kreis in einen anderen Tunnel derselben Höhe reicht (Abzweig, Einfahrt). Setzt pushX, pushY, depth.
        undefined PushTube(Raser.BridgeDeck d, List<Raser.BridgeDeck> list, defined float x, defined float y, defined float radius) {
            float p[] = new float[4]
            if (d.ring != undefined) {
                float z = d.z[0]
                bool inside = Raser.Geo.Inside(d.ring, x, y)
                float dist = Raser.Geo.DistanceToRing(d.ring, x, y)
                float deep = radius - dist
                if (!inside) { deep = radius + dist }
                if (deep > this.depth) {
                    // die Richtung zum nächsten Punkt des Rands (nach innen)
                    float best = 1.0e30
                    float qx = x
                    float qy = y
                    int n = d.ring.length / 2
                    for (int i = 0; i < n; i++) {
                        int j = (i + 1) % n
                        float ax = d.ring[i * 2]
                        float ay = d.ring[i * 2 + 1]
                        float ex = d.ring[j * 2] - ax
                        float ey = d.ring[j * 2 + 1] - ay
                        float l2 = ex * ex + ey * ey
                        if (l2 < 0.000001) { continue }
                        float t = Math.Clamp(((x - ax) * ex + (y - ay) * ey) / l2, 0.0, 1.0)
                        float dd = (ax + ex * t - x) * (ax + ex * t - x) + (ay + ey * t - y) * (ay + ey * t - y)
                        if (dd < best) {
                            best = dd
                            qx = ax + ex * t
                            qy = ay + ey * t
                        }
                    }
                    float nx = qx - x
                    float ny = qy - y
                    float l = Math.Sqrt(nx * nx + ny * ny)
                    if (l > 0.0001) {
                        nx = nx / l
                        ny = ny / l
                        if (inside) {
                            nx = -nx
                            ny = -ny
                        }
                        // die Wand fehlt, wo der Kreis in eine Fahrgasse oder Rampe derselben Höhe reicht
                        float ox = x - nx * radius
                        float oy = y - ny * radius
                        if (!Raser.Obstacles.OtherTube(d, list, ox, oy, z) && !Raser.Obstacles.OtherTube(d, list, x, y, z)) {
                            this.depth = deep
                            this.pushX = nx
                            this.pushY = ny
                        }
                    }
                }
                // die Stützen (0,5 m im Quadrat, als Kreis)
                if (d.pillars == undefined) {
                    d.pillars = new List<float>()
                    var lines = new List<float>()
                    Raser.Tunnels.Bays(d, list, d.pillars, lines)
                }
                for (int q = 0; q + 1 < d.pillars.Count; q = q + 2) {
                    float dx = x - d.pillars[q]
                    float dy = y - d.pillars[q + 1]
                    float dd = Math.Sqrt(dx * dx + dy * dy)
                    float deep = radius + 0.35 - dd
                    if (deep > this.depth && dd > 0.0001) {
                        this.depth = deep
                        this.pushX = dx / dd
                        this.pushY = dy / dd
                    }
                }
                return
            }
            float dist = d.Nearest(x, y)
            float s = d.hitS
            float side = d.hitSide
            float z = d.At(s)
            d.PointAt(s, p)
            // die Seitenwände
            float over = Math.Abs(side) + radius - d.half
            if (over > 0.0 && over > this.depth) {
                float sg = -1.0
                if (side > 0.0) { sg = 1.0 }
                // nach außen: links (-dy, dx), rechts (dy, -dx)
                float ox = p[0] - p[3] * sg * (d.half + 0.2)
                float oy = p[1] + p[2] * sg * (d.half + 0.2)
                if (!Raser.Obstacles.OtherTube(d, list, ox, oy, z)) {
                    this.depth = over
                    this.pushX = p[3] * sg
                    this.pushY = -p[2] * sg
                }
            }
            // die Wand an einem geschlossenen Ende (kein Portal, kein anderer Tunnel)
            float along = 0.0
            float back = 0.0
            if (!d.startJoined && !d.startLinked) {
                along = radius - s
                if (along > 0.0 && along > this.depth) {
                    d.PointAt(0.0, p)
                    // vor dem Anfang (Nearest hält s fest): um den Abstand dahinter
                    float ax = x - p[0]
                    float ay = y - p[1]
                    float behind = -(ax * p[2] + ay * p[3])
                    if (behind > 0.0) { along = radius + behind }
                    this.depth = along
                    this.pushX = p[2]
                    this.pushY = p[3]
                }
            }
            if (!d.endJoined && !d.endLinked) {
                back = radius - (d.length - s)
                if (back > 0.0 && back > this.depth) {
                    d.PointAt(d.length, p)
                    float ax = x - p[0]
                    float ay = y - p[1]
                    float beyond = ax * p[2] + ay * p[3]
                    if (beyond > 0.0) { back = radius + beyond }
                    this.depth = back
                    this.pushX = -p[2]
                    this.pushY = -p[3]
                }
            }
        }

        // Liegt (x, y) (kachel-lokal) in einem anderen Tunnel bzw. einer Tiefgarage als self, auf der Höhe z (bis 0,7 m)?
        static defined bool OtherTube(Raser.BridgeDeck self, List<Raser.BridgeDeck> list, defined float x, defined float y, defined float z) {
            foreach (o in list) {
                if (o == self || !o.tunnel || !o.Covers(x, y, 0.0)) { continue }
                if (Math.Abs(o.HeightHit() - z) <= 0.7) { return true }
            }
            return false
        }

        // Steht an (e, n) ein Gebäude (mit margin m Abstand zur Wand, bis 1,9 m)?
        // level: die Ebene; in einem Tunnel bzw. einer Tiefgarage ist frei, was in ihm liegt (margin m von den Wänden).
        defined bool BlockedAt(defined float e, defined float n, defined float margin, defined int level) {
            if (level != 0 && this.Underground(e, n, level)) {
                var list = this.DecksAt(e, n)
                var key = Raser.TileKey.Of(e, n)
                float z = 0.0
                foreach (d in list) {
                    if (d.road == level) {
                        d.Nearest(e - key.East, n - key.North)
                        z = d.HeightHit()
                    }
                }
                return !this.InTube(e, n, z, margin)
            }
            return this.Blocked(e, n, margin)
        }

        // Steht an (e, n) ein Gebäude (mit margin m Abstand zur Wand, bis 1,9 m)?
        defined bool Blocked(defined float e, defined float n, defined float margin) {
            var key = Raser.TileKey.Of(e, n)
            string name = key + ""
            this.Need(key, name)
            var tile = this.tiles.Get(name, undefined)
            if (tile == undefined) { return false }
            var bx = this.boxes[name]
            float x = e - key.East
            float y = n - key.North
            // nur die Gebäude der Zelle (Raster)
            var grid = this.grids[name]
            int gcell = Raser.Obstacles.GridCell(y) * 16 + Raser.Obstacles.GridCell(x)
            for (int g = grid[gcell]; g < grid[gcell + 1]; g++) {
                int k = grid[g]
                if (!bx[k].Contains(x, y)) { continue }
                var b = tile.data.buildings[k]
                if (b.function != undefined && (b.function.StartsWith("alkis=51009") || b.function.StartsWith("alkis=53001"))) { continue }
                // im Grundriss oder näher als margin an einer Kante
                bool hit = Raser.Geo.Inside(b.footprint, x, y)
                if (!hit) {
                    int np = b.footprint.length / 2
                    for (int i = 0; i < np && !hit; i++) {
                        int j = (i + 1) % np
                        hit = Raser.Geo.DistanceToSegment(x, y, b.footprint[i * 2], b.footprint[i * 2 + 1], b.footprint[j * 2], b.footprint[j * 2 + 1]) < margin
                    }
                }
                if (!hit) { continue }
                if (!this.passages.ContainsKey(b.id)) {
                    var ps = Raser.Voxelizer.Passages(b, tile.data.roads)
                    this.passages[b.id] = ps
                    ps.TakeTo(this.passages)
                }
                var ways = this.passages[b.id]
                bool through = false
                for (int q = 0; q + 6 < ways.Count; q = q + 7) {
                    if (Raser.Voxelizer.PassageDistance(ways, q, x, y) < ways[q + 4] - margin * 0.5) { through = true }
                }
                if (!through) { return true }
            }
            return false
        }
    }
}
