// Die Tests von Raser.Tool (forge test src/Raser.Tool/Raser.Tool.fireproj).
#import "testing"
#import "compression"

class ToolTests {
    [Test "Argumente"]
    undefined Arguments() {
        string items[] = ["export", "png", "--tile", "1469_22284", "--force", "--step", "4"]
        var a = new Args(items)
        Testing.Assert.AreEqual(2, a.positional.Count)
        Testing.Assert.AreEqual("1469_22284", a.Get("tile"))
        Testing.Assert.AreEqual("true", a.Get("force"))
        Testing.Assert.AreEqual("4", a.Get("step"))
        Testing.Assert.AreEqual("x", a.Get("fehlt", "x"))
        Testing.Assert.AreEqual(4, Tool.TileRange("1_2:2_3").Count)
    }

    [Test "PNG: Signatur, Kopf, Bilddaten"]
    undefined Png() {
        int rgb[] = [0xFF0000, 0x00FF00, 0x0000FF, 0xFFFFFF]
        var bytes = Png.Encode(rgb, 2, 2)
        Testing.Assert.AreEqual(137, bytes[0])
        Testing.Assert.AreEqual(80, bytes[1])
        // IHDR: Länge 13, Breite 2, Höhe 2
        Testing.Assert.AreEqual(13, bytes[11])
        Testing.Assert.AreEqual(2, bytes[19])
        Testing.Assert.AreEqual(2, bytes[23])
        // IDAT beginnt bei 33: Länge (4), "IDAT" (4), dann zlib
        int n = (bytes[33] << 24) | (bytes[34] << 16) | (bytes[35] << 8) | bytes[36]
        byte packed[] = new byte[n]
        for (int i = 0; i < n; i++) { packed[i] = bytes[41 + i] }
        var raw = Compression.ZLib.Decompress(packed)
        Testing.Assert.AreEqual(14, raw.length)
        Testing.Assert.AreEqual(255, raw[1])
        Testing.Assert.AreEqual(255, raw[12])
    }
}
