// Raser.Tool: die Testregion ohne Shell-Skripte einrichten - dasselbe wie tools/fetch-bochum.sh und tools/build-bochum.sh, aber als fire-Programm
// (läuft so auch unter Windows).
//
//   raser fetch [--raw data/raw] [--region bochum | --bbox lon0,lat0,lon1,lat1]   die Rohdaten laden (DGM1, LoD2 von opengeodata.nrw.de, OSM in Teilen)
//   raser setup [--raw data/raw] [--world world] [--region ... | --bbox ...] [--meshes 1] [--jobs n]   laden (was fehlt), importieren, voxelisieren
//                                                       (auf allen Kernen), auf Wunsch den Netz-Cache
//
// Regionen (--region): bochum (Bochum-Innenstadt, die Vorgabe), lichtendorf (A1 an der Raststätte Lichtendorf bei Schwerte/Dortmund: Autobahn mit
// Rastanlage auf beiden Seiten, Anschlussstelle). Mit --bbox ein beliebiger Ausschnitt in Grad (WGS84): die 1-km-Kacheln von DGM1 und LoD2
// (ETRS89/UTM32) ergeben sich aus den vier Ecken (Raser.Utm), OSM kommt in Teilen von höchstens 0,008° x 0,005° (die API gibt je Anfrage
// höchstens 50 000 Knoten). Jede Region gehört in eigene Ordner (--raw, --world), sonst mischen sich die Daten.
//
// Was schon da ist, wird nicht noch einmal geladen; ein abgebrochener Download geht beim nächsten Mal weiter (Http.Download, Teildatei .part).
// Voxelisiert werden nur Kacheln, deren Chunks fehlen oder älter als der Generator sind (wie `raser voxelize`).
#import "filesystem"
#import "time"
#import "http"
#import "raser.core"
#import "raser.import"

class Setup {
    static readonly string Nrw = "https://www.opengeodata.nrw.de/produkte/geobasis"

    // Der Ausschnitt (Grad: lon0, lat0, lon1, lat1) aus --bbox oder --region (Vorgabe: bochum).
    static float[] Box(Args args) {
        if (args.Has("bbox")) {
            var parts = args.Get("bbox").Split(",")
            if (parts.length != 4) { throw new Raser.DataException("--bbox braucht lon0,lat0,lon1,lat1.") }
            float b[] = [parts[0].ToFloat(), parts[1].ToFloat(), parts[2].ToFloat(), parts[3].ToFloat()]
            if (b[2] <= b[0] || b[3] <= b[1]) { throw new Raser.DataException("--bbox: lon1 > lon0 und lat1 > lat0.") }
            return b
        }
        string region = args.Get("region", "bochum")
        // Bochum-Innenstadt (wie bisher)
        if (region == "bochum") { return [7.197979, 51.472416, 7.230418, 51.492670] }
        // A1 an der Raststätte Lichtendorf (Nord und Süd) mit Anschlussstelle, gut 2 x 2 km
        if (region == "lichtendorf") { return [7.582, 51.457, 7.612, 51.477] }
        throw new Raser.DataException("Unbekannte Region '" + region + "' (bekannt: bochum, lichtendorf; sonst --bbox).")
    }

    // Die 1-km-Kacheln (Ost_Nord in km, ETRS89/UTM32), die der Ausschnitt berührt. Bochum: die vier wie bisher.
    static List<string> Tiles(Args args) {
        var list = new List<string>()
        if (!args.Has("bbox") && args.Get("region", "bochum") == "bochum") {
            foreach (t in ["375_5704", "375_5705", "376_5704", "376_5705"]) { list.Add(t) }
            return list
        }
        float b[] = Setup.Box(args)
        float e0 = 1.0e30
        float e1 = -1.0e30
        float n0 = 1.0e30
        float n1 = -1.0e30
        foreach (lat in [b[1], b[3]]) {
            foreach (lon in [b[0], b[2]]) {
                float u[] = Raser.Utm.FromLatLon(lat, lon)
                e0 = Math.Min(e0, u[0])
                e1 = Math.Max(e1, u[0])
                n0 = Math.Min(n0, u[1])
                n1 = Math.Max(n1, u[1])
            }
        }
        for (int e = Math.Floor(e0 / 1000.0)!int; e <= Math.Floor(e1 / 1000.0)!int; e++) {
            for (int n = Math.Floor(n0 / 1000.0)!int; n <= Math.Floor(n1 / 1000.0)!int; n++) { list.Add(e + "_" + n) }
        }
        return list
    }

    static undefined Fetch(Args args) {
        string raw = args.Get("raw", IO.Path.Combine("data", "raw"))
        string dgm = IO.Path.Combine(raw, "dgm1")
        string lod2 = IO.Path.Combine(raw, "lod2")
        string osm = IO.Path.Combine(raw, "osm")
        IO.Directory.CreateDirectory(dgm)
        IO.Directory.CreateDirectory(lod2)
        IO.Directory.CreateDirectory(osm)
        var client = new Http.Client()
        client.userAgent = "ruhrpott-raser/0.1"
        client.timeout = 120000
        client.maxBodyBytes = 67108864
        // DGM1: der Dateiname trägt das Jahr der Befliegung - aus dem Verzeichnis holen (das jüngste)
        string dgmIndex = Setup.Nrw + "/hm/dgm1_tiff/dgm1_tiff/"
        string listing = undefined
        foreach (t in Setup.Tiles(args)) {
            if (Setup.HasPrefix(dgm, "dgm1_32_" + t + "_1_nw_")) {
                Tool.Log("DGM1 " + t + ": schon da")
            } else {
                if (listing == undefined) {
                    Tool.Log("DGM1: Verzeichnis laden")
                    var r = client.Get(dgmIndex)
                    if (r.status != 200) { throw new Raser.DataException("Das DGM1-Verzeichnis antwortet mit " + r.status + ".") }
                    listing = r.Text()
                }
                string name = Setup.Newest(listing, "dgm1_32_" + t + "_1_nw_", ".tif")
                if (name == undefined) { throw new Raser.DataException("Keine DGM1-Datei für " + t + " im Verzeichnis.") }
                Setup.Load(dgmIndex + name, IO.Path.Combine(dgm, name))
            }
            string gml = "LoD2_32_" + t + "_1_NW.gml"
            string gmlPath = IO.Path.Combine(lod2, gml)
            if (IO.File.Exists(gmlPath)) { Tool.Log("LoD2 " + t + ": schon da") } else { Setup.Load(Setup.Nrw + "/3dg/lod2_gml/lod2_gml/" + gml, gmlPath) }
        }
        // OSM: in Teilen (Bochum wie bisher 4 x 4), mit Pause dazwischen (die API mag keine Serien)
        float box[] = Setup.Box(args)
        int ni = Math.Max(1, Math.Ceiling((box[2] - box[0]) / 0.0082)!int)
        int nj = Math.Max(1, Math.Ceiling((box[3] - box[1]) / 0.0051)!int)
        for (int i = 0; i < ni; i++) {
            for (int j = 0; j < nj; j++) {
                string path = IO.Path.Combine(osm, "map_" + i + "_" + j + ".osm")
                if (IO.File.Exists(path)) { continue }
                float a = box[0] + (box[2] - box[0]) * i / ni
                float b = box[1] + (box[3] - box[1]) * j / nj
                float c = box[0] + (box[2] - box[0]) * (i + 1) / ni
                float d = box[1] + (box[3] - box[1]) * (j + 1) / nj
                string box = $"{a:F6},{b:F6},{c:F6},{d:F6}"
                // (die OSM-API antwortet chunked - das kann Http.Download nicht: ganz laden, dann schreiben, über eine Teildatei)
                Tool.Log("Laden: " + IO.Path.GetFileName(path))
                var r = client.Get("https://api.openstreetmap.org/api/0.6/map?bbox=" + box)
                if (r.status != 200) { throw new Raser.DataException("Die OSM-API antwortet für " + box + " mit " + r.status + ".") }
                IO.File.WriteAllBytes(path + ".part", r.body)
                IO.File.Move(path + ".part", path)
                Tool.Log("  fertig (" + (r.body.length / 1000) + " KB)")
                Sleep(2000ms)
            }
        }
        Tool.Log("Rohdaten vollständig in " + raw)
    }

    // Eine Datei laden (fortsetzbar); erst wenn sie ganz da ist, trägt sie ihren Namen.
    static undefined Load(string url, string path) {
        Tool.Log("Laden: " + IO.Path.GetFileName(path))
        var d = new Http.Download(url, path)
        d.userAgent = "ruhrpott-raser/0.1"
        d.timeout = 120000
        d.Start()
        int shown = 0
        while (d.Step()) {
            // alle 20 MB eine Zeile
            if (d.Received - shown >= 20000000) {
                shown = d.Received
                string total = ""
                if (d.Total > 0) { total = " von " + (d.Total / 1000000) + " MB" }
                Tool.Log("  " + (d.Received / 1000000) + " MB" + total)
            }
        }
        if (d.Error != "") { throw new Raser.DataException("Laden von " + url + " fehlgeschlagen: " + d.Error) }
        Tool.Log("  fertig (" + (d.Received / 1000) + " KB)")
    }

    // Liegt im Ordner eine Datei, deren Name mit prefix beginnt?
    static bool HasPrefix(string folder, string prefix) {
        if (!IO.Directory.Exists(folder)) { return false }
        foreach (f in IO.Directory.GetFiles(folder)) {
            string name = IO.Path.GetFileName(f)
            if (name.StartsWith(prefix) && !name.EndsWith(".part")) { return true }
        }
        return false
    }

    // Der größte (jüngste) Dateiname prefix…suffix im Text eines Verzeichnisses; undefined: keiner.
    static string Newest(string text, string prefix, string suffix) {
        string best = undefined
        int at = text.IndexOf(prefix)
        while (at >= 0) {
            int end = text.IndexOf(suffix, at)
            if (end < 0) { break }
            string name = text.Substring(at, end + suffix.Length - at)
            // nur Ziffern zwischen prefix und suffix (das Jahr)
            string year = name.Substring(prefix.Length, name.Length - prefix.Length - suffix.Length)
            bool digits = year.Length > 0
            for (int k = 0; k < year.Length; k++) {
                string ch = year.Substring(k, 1)
                if ("0123456789".IndexOf(ch) < 0) { digits = false }
            }
            if (digits && (best == undefined || name > best)) { best = name }
            at = text.IndexOf(prefix, end)
        }
        return best
    }

    // Alles in einem: laden, importieren, voxelisieren, auf Wunsch den Netz-Cache.
    static undefined Run(Args args) {
        string raw = args.Get("raw", IO.Path.Combine("data", "raw"))
        string world = args.Get("world", "world")
        Setup.Fetch(args)
        string imp[] = ["import", "--dgm", IO.Path.Combine(raw, "dgm1"), "--lod2", IO.Path.Combine(raw, "lod2"), "--osm", IO.Path.Combine(raw, "osm"), "--world", world]
        Tool.Import(new Args(imp))
        string vox[] = ["voxelize", "--world", world, "--overrides", args.Get("overrides", "overrides"), "--jobs", args.Get("jobs", "0")]
        if (!args.Has("jobs")) { vox = ["voxelize", "--world", world, "--overrides", args.Get("overrides", "overrides")] }
        Tool.VoxelizeAny(new Args(vox))
        if (args.Has("meshes")) {
            string mesh[] = ["meshes", "--world", world]
            if (args.Has("jobs")) { mesh = ["meshes", "--world", world, "--jobs", args.Get("jobs")] }
            Tool.MeshesAny(new Args(mesh))
        }
        Tool.Log("Die Welt liegt in " + world + " - starten: raser-game --world " + world)
    }
}
