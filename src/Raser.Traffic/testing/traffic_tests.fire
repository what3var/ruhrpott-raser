// Die Tests von Raser.Traffic (forge test src/Raser.Traffic/Raser.Traffic.fireproj).
#import "testing"
#import "raser.core"
#import "raser.world"
#import "raser.traffic"

// Kleine Straßennetze zum Testen (Kachel 0_0: global = lokal).
class Net {
    static Raser.Road Road(defined int id, string kind, float pts[], defined float width, defined int lanes = 0, string sidewalk = undefined) {
        var r = new Raser.Road()
        r.id = id
        r.source = "osm:way/" + id
        r.kind = "highway=" + kind
        r.points = copy pts
        r.width = width
        r.lanes = lanes
        r.layer = 0
        r.sidewalk = sidewalk
        return r
    }

    // Eine Kreuzung: Ost-West-Straße (Hauptstraße) und Nord-Süd-Straße (Wohnstraße) kreuzen sich bei (100, 100).
    static Raser.RoadGraph Cross() {
        var tile = new Raser.Tile(new Raser.TileKey(0, 0))
        tile.data.roads.Add(Net.Road(1, "secondary", [0.0, 100.0, 100.0, 100.0, 200.0, 100.0], 7.0, 0, "both"))
        tile.data.roads.Add(Net.Road(2, "residential", [100.0, 0.0, 100.0, 100.0, 100.0, 200.0], 5.5, 0, "both"))
        var g = new Raser.RoadGraph()
        g.AddTile(tile)
        g.Build()
        return g
    }
}

class GraphTests {
    [Test "Kreuzung: Knoten, Abschnitte, Abbiegespuren"]
    undefined Junction() {
        var g = Net.Cross()
        // 5 Knoten: die Mitte und vier Enden
        Testing.Assert.AreEqual(5, g.NodeCount)
        // 4 Abschnitte, je zwei Richtungen
        Testing.Assert.AreEqual(8, g.Count(Raser.LaneKind.Road))
        // an der Kreuzung: 4 ankommende x 3 abgehende (ohne Wenden), an den 4 Enden je eine Wende
        Testing.Assert.AreEqual(16, g.Count(Raser.LaneKind.Turn))
    }
}

class Scene {
    // Ein Spieler zu Fuß abseits (Ost, Nord), sonst nichts.
    static List<float> Walker(defined float e, defined float n) {
        var players = new List<float>()
        foreach (x in [e, n, 0.0, 0.0, 0.35, 0.0, 0.0]) { players.Add(x) }
        return players
    }

    // Eine Simulation ohne Erscheinen auf dem Graphen g (die Tests setzen Autos und Fußgänger selbst).
    static Raser.Traffic Of(Raser.RoadGraph g) {
        var t = new Raser.Traffic(0, 0, 7)
        replace t.graph = take g
        t.populated = true
        t.spawnClock = 1.0e9
        t.graphVersion = t.graph.version
        return t
    }

    // Ein Auto auf der Spur, die bei (e, n) in Richtung heading liegt.
    static Raser.NpcCar Car(Raser.Traffic t, defined float e, defined float n, defined float heading, defined float speed) {
        Testing.Assert.IsTrue(t.graph.Nearest(e, n, true, heading, 3.0))
        var c = t.AddCar(t.graph.foundLane, t.graph.foundS, new Raser.TrafficRandom(1))
        c.speed = speed
        return c
    }

    static defined float Gap(Raser.NpcCar a, Raser.NpcCar b) {
        // der kleinste Abstand ihrer Kreise (je zwei, wie Raser.Vehicle) minus die Radien
        float best = 1.0e30
        foreach (ka in [1.0, -1.0]) {
            foreach (kb in [1.0, -1.0]) {
                float ha = a.heading * Math.PI / 180.0
                float hb = b.heading * Math.PI / 180.0
                float ax = a.east - Math.Sin(ha) * a.body.spread * ka
                float ay = a.north + Math.Cos(ha) * a.body.spread * ka
                float bx = b.east - Math.Sin(hb) * b.body.spread * kb
                float by = b.north + Math.Cos(hb) * b.body.spread * kb
                float d = Math.Sqrt((ax - bx) * (ax - bx) + (ay - by) * (ay - by)) - a.body.radius - b.body.radius
                if (d < best) { best = d }
            }
        }
        return best
    }
}

class LaneTests {
    [Test "Fahrspuren rechts der Mitte, Einbahnstraße in der Mitte"]
    undefined RightSide() {
        var tile = new Raser.Tile(new Raser.TileKey(0, 0))
        tile.data.roads.Add(Net.Road(1, "residential", [0.0, 100.0, 200.0, 100.0], 6.0))
        tile.data.roads.Add(Net.Road(2, "residential", [0.0, 50.0, 200.0, 50.0], 6.0, 1))
        var g = new Raser.RoadGraph()
        g.AddTile(tile)
        g.Build()
        var p = new Raser.LanePoint()
        int seen = 0
        foreach (l in g.lanes) {
            if (l.kind != Raser.LaneKind.Road) { continue }
            l.At(l.length / 2.0, p)
            if (l.road == 1) {
                // nach Osten: rechts ist Süden (1,5 m = Breite / 4); nach Westen: Norden
                if (p.dx > 0.0) { Testing.Assert.IsTrue(Math.Abs(p.n - 98.5) < 0.01) } else { Testing.Assert.IsTrue(Math.Abs(p.n - 101.5) < 0.01) }
                seen++
            } else {
                Testing.Assert.IsTrue(p.dx > 0.0)
                Testing.Assert.IsTrue(Math.Abs(p.n - 50.0) < 0.01)
                seen = seen + 10
            }
        }
        Testing.Assert.AreEqual(12, seen)
    }

    [Test "Über den Kachelrand: eine Straße zählt einmal, Knoten verbinden die Kacheln"]
    undefined Stitch() {
        // Straße 1 liegt in beiden Kacheln (je kachel-lokal), Straße 2 nur in der östlichen und beginnt an ihrem Ende
        var a = new Raser.Tile(new Raser.TileKey(0, 0))
        var b = new Raser.Tile(new Raser.TileKey(1, 0))
        a.data.roads.Add(Net.Road(1, "residential", [200.0, 100.0, 300.0, 100.0], 5.5))
        b.data.roads.Add(Net.Road(1, "residential", [-56.0, 100.0, 44.0, 100.0], 5.5))
        b.data.roads.Add(Net.Road(2, "residential", [44.0, 100.0, 44.0, 200.0], 5.5))
        var g = new Raser.RoadGraph()
        g.AddTile(a)
        Testing.Assert.IsTrue(g.AddTile(b))
        Testing.Assert.IsTrue(!g.AddTile(b))
        g.Build()
        Testing.Assert.AreEqual(2, g.roads.Count)
        Testing.Assert.AreEqual(3, g.NodeCount)
        Testing.Assert.AreEqual(4, g.Count(Raser.LaneKind.Road))
        // am Stoß (300, 100): zwei hinein, je eine Verbindung (ohne Wenden); an den beiden Enden je eine Wende
        Testing.Assert.AreEqual(4, g.Count(Raser.LaneKind.Turn))
        // nur die östliche Kachel behalten: Straße 1 bleibt (steht auch dort)
        var keep = new List<string>()
        keep.Add("1_0")
        g.Keep(keep)
        Testing.Assert.AreEqual(2, g.roads.Count)
    }

    [Test "Gehwege: beidseitig auf dem Gehweg, an der Kreuzung gekürzt, mit Überwegen"]
    undefined Sidewalks() {
        var g = Net.Cross()
        var p = new Raser.LanePoint()
        int walks = 0
        foreach (l in g.lanes) {
            if (l.kind != Raser.LaneKind.Sidewalk) { continue }
            walks++
            // jeder Punkt neben jeder Fahrbahn
            for (float s = 0.0; s <= l.length; s = s + 0.5) {
                l.At(s, p)
                float dEW = Math.Abs(p.n - 100.0) - 3.5
                float dNS = Math.Abs(p.e - 100.0) - 2.75
                Testing.Assert.IsTrue(dEW > 0.5 || p.e < 95.0 || p.e > 105.0 || dNS > 0.5)
                if (l.road == 1 && (p.e < 90.0 || p.e > 110.0)) { Testing.Assert.IsTrue(Math.Abs(Math.Abs(p.n - 100.0) - (3.5 + 1.5)) < 0.05) }
            }
        }
        // 4 Abschnitte x 2 Seiten x 2 Richtungen
        Testing.Assert.AreEqual(16, walks)
        Testing.Assert.IsTrue(g.Count(Raser.LaneKind.Crossing) >= 8)
        Testing.Assert.IsTrue(g.Count(Raser.LaneKind.Link) >= 8)
    }
}

class DriveTests {
    [Test "IDM: das Auto dahinter bremst, keine Überlappung"]
    undefined Follow() {
        var tile = new Raser.Tile(new Raser.TileKey(0, 0))
        tile.data.roads.Add(Net.Road(1, "residential", [0.0, 100.0, 600.0, 100.0], 6.0))
        var g = new Raser.RoadGraph()
        g.AddTile(tile)
        g.Build()
        var t = Scene.Of(g)
        var lead = Scene.Car(t, 150.0, 98.5, -90.0, 5.0)
        var back = Scene.Car(t, 100.0, 98.5, -90.0, 8.0)
        var players = Scene.Walker(300.0, 150.0)
        float minGap = 1.0e30
        bool braked = false
        // (nach 3 s hinter einem stehenden Auto ohne Grund führe es vorbei: so lange nicht)
        for (int i = 0; i < 700; i++) {
            // der vordere hält nach 10 s an
            if (i > 300) { lead.wish = 0.0 }
            t.Step(1.0 / 30.0, players)
            if (back.accel < -0.5) { braked = true }
            minGap = Math.Min(minGap, Scene.Gap(lead, back))
        }
        Testing.Assert.IsTrue(braked)
        Testing.Assert.IsTrue(minGap > 0.5)
        Testing.Assert.IsTrue(back.speed < 0.2)
        Testing.Assert.IsTrue(lead.east - back.east > 4.5)
    }

    [Test "IDM: bremst vor dem Spieler auf der Spur"]
    undefined Player() {
        var tile = new Raser.Tile(new Raser.TileKey(0, 0))
        tile.data.roads.Add(Net.Road(1, "residential", [0.0, 100.0, 600.0, 100.0], 6.0))
        var g = new Raser.RoadGraph()
        g.AddTile(tile)
        g.Build()
        var t = Scene.Of(g)
        var c = Scene.Car(t, 100.0, 98.5, -90.0, 8.0)
        // ein stehender Wagen des Spielers 60 m voraus auf der Spur
        var players = new List<float>()
        foreach (x in [160.0, 98.5, -90.0, 0.0, 1.0, 1.1, 1.0]) { players.Add(x) }
        bool stopped = false
        for (int i = 0; i < 900; i++) {
            t.Step(1.0 / 30.0, players)
            // bis es vorbeifährt (nach 3 s Stehen): vor dem Wagen
            if (c.pass <= 0.0 && c.offset > -0.3 && c.east < 162.0) { Testing.Assert.IsTrue(c.east < 160.0 - 1.1 - 1.0 - 2.1 + 0.2) }
            if (c.speed < 0.1) { stopped = true }
        }
        Testing.Assert.IsTrue(stopped)
        // dann links vorbei
        Testing.Assert.IsTrue(c.east > 170.0)
    }

    [Test "Kreuzung: zwei Autos zugleich, nie überlappt, beide fahren durch"]
    undefined Yield() {
        var g = Net.Cross()
        var t = Scene.Of(g)
        // von Westen (Hauptstraße, nach Osten) und von Süden (Wohnstraße, nach Norden), beide 40 m vor der Mitte, geradeaus
        var a = Scene.Car(t, 60.0, 98.25, -90.0, 10.0)
        var b = Scene.Car(t, 101.375, 60.0, 0.0, 8.0)
        foreach (c in [a, b]) {
            c.plan.Clear()
            var l = t.graph.lanes[c.lane]
            foreach (n in l.next) {
                if (Math.Abs(t.graph.lanes[n].turn) < 10.0) { c.plan.Add(n) }
            }
            t.Plan(c)
        }
        var players = Scene.Walker(150.0, 150.0)
        float minGap = 1.0e30
        for (int i = 0; i < 600; i++) {
            t.Step(1.0 / 30.0, players)
            minGap = Math.Min(minGap, Scene.Gap(a, b))
        }
        Testing.Assert.IsTrue(minGap > 0.3)
        Testing.Assert.IsTrue(a.east > 120.0)
        Testing.Assert.IsTrue(b.north > 120.0)
    }

    [Test "Kreuzung: viele Autos 60 s, keine zwei überlappen"]
    undefined Busy() {
        var g = Net.Cross()
        var t = new Raser.Traffic(12, 0, 3)
        replace t.graph = take g
        var players = Scene.Walker(100.0, 100.0)
        float minGap = 1.0e30
        int seen = 0
        for (int i = 0; i < 1800; i++) {
            t.Step(1.0 / 30.0, players)
            seen = Math.Max(seen, t.cars.Count)
            for (int x = 0; x < t.cars.Count; x++) {
                for (int y = x + 1; y < t.cars.Count; y++) {
                    float gg = Scene.Gap(t.cars[x], t.cars[y])
                    if (gg < 0.0 && minGap >= 0.0) {
                        var u = t.cars[x]
                        var w = t.cars[y]
                        print("t " + i + " Überlappung: " + u.id + " lane " + u.lane + " kind " + t.graph.lanes[u.lane].kind + " s " + u.s + " at " + u.east + "," + u.north + " h " + u.heading + " v " + u.speed + " res " + u.reserved + " off " + u.offset + " / " + w.id + " lane " + w.lane + " kind " + t.graph.lanes[w.lane].kind + " s " + w.s + " at " + w.east + "," + w.north + " h " + w.heading + " v " + w.speed + " res " + w.reserved + " off " + w.offset)
                    }
                    minGap = Math.Min(minGap, gg)
                }
            }
        }
        print("Autos höchstens " + seen + ", kleinster Abstand " + minGap)
        Testing.Assert.IsTrue(seen >= 6)
        Testing.Assert.IsTrue(minGap > 0.0)
    }
}

class WalkTests {
    [Test "Fußgänger bleiben auf dem Gehweg (außer auf Überwegen)"]
    undefined StayOff() {
        var g = Net.Cross()
        var t = new Raser.Traffic(0, 30, 5)
        replace t.graph = take g
        var players = Scene.Walker(100.0, 100.0)
        int checks = 0
        for (int i = 0; i < 1800; i++) {
            t.Step(1.0 / 30.0, players)
            foreach (p in t.people) {
                var l = t.graph.lanes[p.lane]
                if (l.kind == Raser.LaneKind.Crossing || p.state == 3) { continue }
                // nicht auf einer Fahrbahn (Ost-West 7 m, Nord-Süd 5,5 m breit)
                bool onEW = Math.Abs(p.north - 100.0) < 3.5 && p.east > 0.0 && p.east < 200.0
                bool onNS = Math.Abs(p.east - 100.0) < 2.75 && p.north > 0.0 && p.north < 200.0
                Testing.Assert.IsTrue(!onEW && !onNS)
                checks++
            }
        }
        Testing.Assert.IsTrue(checks > 1000)
    }

    [Test "Fußgänger springen vor dem Spieler zur Seite oder fallen um"]
    undefined Dodge() {
        var tile = new Raser.Tile(new Raser.TileKey(0, 0))
        tile.data.roads.Add(Net.Road(1, "footway", [0.0, 100.0, 300.0, 100.0], 2.0))
        var g = new Raser.RoadGraph()
        g.AddTile(tile)
        g.Build()
        var t = Scene.Of(g)
        Testing.Assert.IsTrue(t.graph.Nearest(150.0, 100.0, false, -90.0, 2.0))
        var p = t.AddPerson(t.graph.foundLane, t.graph.foundS, new Raser.TrafficRandom(2))
        p.side = 0.0
        p.keep = 0.0
        // ein Wagen kommt mit 30 km/h von Osten entgegen, genau auf der Linie
        var players = new List<float>()
        float ce = 200.0
        foreach (x in [ce, 100.0, 90.0, 8.3, 1.0, 1.1, 1.0]) { players.Add(x) }
        for (int i = 0; i < 300; i++) {
            ce = ce - 8.3 / 30.0
            players[0] = ce
            t.Step(1.0 / 30.0, players)
        }
        // er ist ausgewichen (nicht umgefallen) und steht neben der Linie, oder er liegt
        Testing.Assert.IsTrue(p.state == 4 || Math.Abs(p.north - 100.0) > 1.0 || t.knocked == 0)
        Testing.Assert.AreEqual(0, t.knocked)
    }
}

class SpawnTests {
    [Test "Erscheinen: 80 .. 250 m vom Spieler, nicht im Blick; weit weg verschwinden"]
    undefined Ring() {
        // ein Gitter von 700 x 700 m, alle 100 m eine Straße
        var tile = new Raser.Tile(new Raser.TileKey(0, 0))
        int id = 1
        for (int k = 0; k <= 7; k++) {
            tile.data.roads.Add(Net.Road(id, "residential", [0.0, k * 100.0, 700.0, k * 100.0], 5.5))
            id++
            tile.data.roads.Add(Net.Road(id, "residential", [k * 100.0, 0.0, k * 100.0, 700.0], 5.5))
            id++
        }
        var g = new Raser.RoadGraph()
        g.AddTile(tile)
        g.Build()
        var t = new Raser.Traffic(30, 0, 11)
        replace t.graph = take g
        // der Spieler bei (350, 350), Blick nach Norden
        var players = Scene.Walker(350.0, 350.0)
        t.Step(0.1, players)
        print("am Anfang " + t.cars.Count + " Autos")
        Testing.Assert.IsTrue(t.cars.Count >= 20)
        // alle weg, dann neu: jetzt nur im Ring und außer Sicht
        t.cars.Clear()
        for (int i = 0; i < 40; i++) { t.Step(0.5, players) }
        print("nach 20 s " + t.cars.Count + " Autos")
        Testing.Assert.IsTrue(t.cars.Count >= 5)
        foreach (c in t.cars) {
            // (die ersten sind inzwischen gefahren: höchstens 20 s x 9 m/s näher)
            float d = Math.Sqrt((c.east - 350.0) * (c.east - 350.0) + (c.north - 350.0) * (c.north - 350.0))
            if (d > 310.0) { print("zu weit: " + d) }
            Testing.Assert.IsTrue(d <= 310.0)
        }
        // ein Schritt, der nur erscheinen lässt: prüfen, wo
        t.cars.Clear()
        for (int i = 0; i < 20 && t.cars.Count == 0; i++) {
            t.spawnClock = 0.0
            t.Step(0.001, players)
        }
        Testing.Assert.IsTrue(t.cars.Count > 0)
        foreach (c in t.cars) {
            float d = Math.Sqrt((c.east - 350.0) * (c.east - 350.0) + (c.north - 350.0) * (c.north - 350.0))
            print("neu bei " + d + " m, gesehen " + t.Seen(players, c.east, c.north))
            Testing.Assert.IsTrue(d >= 79.0 && d <= 251.0)
            Testing.Assert.IsTrue(!t.Seen(players, c.east, c.north))
        }
        // der Spieler geht 2 km weg: alle verschwinden
        players[0] = 2350.0
        t.spawnClock = 0.0
        t.Step(0.01, players)
        print("weit weg: " + t.cars.Count)
        Testing.Assert.AreEqual(0, t.cars.Count)
    }
}

class StateTests {
    [Test "Zustand: kodieren und lesen (cm, 1/100 Grad), Puffer gleitet zwischen zwei Snapshots"]
    undefined Roundtrip() {
        var a = new Raser.NpcState()
        a.id = 4711
        a.kind = Raser.NpcState.Person
        a.color = 0x3C6E46
        a.legs = 0x324664
        a.hair = 0x463223
        a.skin = 0xE1B496
        a.height = 1.78
        a.east = 376117.234
        a.north = 5705005.678
        a.heading = -90.5
        a.speed = 1.37
        a.state = 4
        a.honk = true
        var w = new Raser.ByteWriter(64)
        a.Encode(w)
        var r = new Raser.ByteReader(w.ToBytes())
        var b = Raser.NpcState.Decode(r)
        Testing.Assert.AreEqual(4711, b.id)
        Testing.Assert.AreEqual(2, b.kind)
        Testing.Assert.AreEqual(4, b.state)
        Testing.Assert.IsTrue(b.honk)
        Testing.Assert.AreEqual(0xE1B496, b.skin)
        Testing.Assert.IsTrue(Math.Abs(b.east - 376117.23) < 0.006 && Math.Abs(b.north - 5705005.68) < 0.006)
        Testing.Assert.IsTrue(Math.Abs(b.heading - 269.5) < 0.006 && Math.Abs(b.height - 1.78) < 0.006)
        // als Entität (Art 4) und zurück
        var c = new Raser.NpcState()
        c.FromEntity(a.id, a.EntityType, a.Variant, a.Bits, a.A, a.B)
        Testing.Assert.AreEqual(4, a.EntityType)
        Testing.Assert.AreEqual(2, c.kind)
        Testing.Assert.AreEqual(4, c.state)
        Testing.Assert.IsTrue(c.honk)
        Testing.Assert.AreEqual(0x3C6E46, c.color)
        Testing.Assert.AreEqual(0x324664, c.legs)
        Testing.Assert.AreEqual(0x463223, c.hair)
        Testing.Assert.AreEqual(0xE1B496, c.skin)
        Testing.Assert.IsTrue(Math.Abs(c.height - 1.78) < 0.006)
        a.kind = Raser.NpcState.Van
        a.state = 1
        c.FromEntity(a.id, a.EntityType, a.Variant, a.Bits, a.A, a.B)
        Testing.Assert.AreEqual(3, a.EntityType)
        Testing.Assert.AreEqual(1, c.kind)
        Testing.Assert.AreEqual(1, c.state)
        Testing.Assert.AreEqual(0x3C6E46, c.color)
        // der Puffer: zwei Snapshots, dazwischen halb
        var buf = new Raser.NpcBuffer()
        var one = new List<Raser.NpcState>()
        var s1 = new Raser.NpcState()
        s1.id = 1
        s1.east = 100.0
        s1.heading = 350.0
        one.Add(s1)
        buf.Push(1.0, one)
        var s2 = new Raser.NpcState()
        s2.id = 1
        s2.east = 102.0
        s2.heading = 10.0
        var two = new List<Raser.NpcState>()
        two.Add(s2)
        buf.Push(1.1, two)
        var out = new List<Raser.NpcState>()
        buf.Sample(1.05, out)
        Testing.Assert.AreEqual(1, out.Count)
        Testing.Assert.IsTrue(Math.Abs(out[0].east - 101.0) < 0.001)
        // über 0° hinweg auf dem kürzeren Weg
        Testing.Assert.IsTrue(Math.Abs(out[0].heading - 360.0) < 0.001)
    }

    [Test "Aufprall: der Spieler fährt in ein Auto - es wird ein Unfallwagen und rutscht"]
    undefined Impact() {
        var tile = new Raser.Tile(new Raser.TileKey(0, 0))
        tile.data.roads.Add(Net.Road(1, "residential", [0.0, 100.0, 600.0, 100.0], 6.0))
        var g = new Raser.RoadGraph()
        g.AddTile(tile)
        g.Build()
        var t = Scene.Of(g)
        var c = Scene.Car(t, 150.0, 98.5, -90.0, 0.0)
        c.wish = 0.0
        // der Spieler kommt mit 10 m/s von Süden quer hinein (nach Norden)
        var players = new List<float>()
        foreach (x in [150.0, 95.0, 0.0, 10.0, 1.0, 1.1, 1.0]) { players.Add(x) }
        for (int i = 0; i < 12; i++) {
            players[1] = players[1] + 10.0 / 30.0
            t.Step(1.0 / 30.0, players)
        }
        Testing.Assert.IsTrue(c.state >= 1)
        Testing.Assert.AreEqual(1, t.crashes)
        Testing.Assert.IsTrue(c.north > 98.6)
        var states = new List<Raser.NpcState>()
        t.States(states, 150.0, 100.0, 50.0)
        Testing.Assert.AreEqual(1, states.Count)
        Testing.Assert.IsTrue(states[0].state == 2 || states[0].state == 3)
        t.States(states, 1000.0, 100.0, 50.0)
        Testing.Assert.AreEqual(0, states.Count)
    }
}

class WorkerTests {
    static Raser.Tile West() {
        var a = new Raser.Tile(new Raser.TileKey(0, 0))
        a.data.roads.Add(Net.Road(1, "secondary", [0.0, 100.0, 100.0, 100.0, 300.0, 100.0], 7.0, 0, "both"))
        a.data.roads.Add(Net.Road(2, "residential", [100.0, 0.0, 100.0, 100.0, 100.0, 200.0], 5.5, 0, "both"))
        a.data.roads.Add(Net.Road(4, "footway", [20.0, 20.0, 60.0, 30.0], 2.0))
        return a
    }

    static Raser.Tile East() {
        var b = new Raser.Tile(new Raser.TileKey(1, 0))
        b.data.roads.Add(Net.Road(1, "secondary", [-256.0, 100.0, -156.0, 100.0, 44.0, 100.0], 7.0, 0, "both"))
        b.data.roads.Add(Net.Road(3, "residential", [44.0, 100.0, 44.0, 250.0], 5.5, 0, "right"))
        return b
    }

    [Test "Worker: derselbe Graph wie synchron, übernommen an den Verkehr"]
    undefined SameAsSync() {
        var g = new Raser.RoadGraph()
        g.AddTile(WorkerTests.West())
        g.AddTile(WorkerTests.East())
        g.Build()
        var w = new Raser.GraphWorker("")
        var tiles = new List<Raser.Tile>(Owns.Values)
        // in anderer Folge
        tiles.Add(WorkerTests.East())
        tiles.Add(WorkerTests.West())
        w.Request(new List<string>(), tiles)
        Testing.Assert.IsTrue(w.Wait(30.0))
        var h = w.ready.graph
        Testing.Assert.AreEqual(g.lanes.Count, h.lanes.Count)
        Testing.Assert.AreEqual(g.NodeCount, h.NodeCount)
        for (int i = 0; i < g.lanes.Count; i++) {
            var a = g.lanes[i]
            var b = h.lanes[i]
            Testing.Assert.AreEqual(a.kind, b.kind)
            Testing.Assert.AreEqual(a.pts.length, b.pts.length)
            for (int k = 0; k < a.pts.length; k++) { Testing.Assert.IsTrue(a.pts[k] == b.pts[k]) }
            Testing.Assert.AreEqual(a.next.Count, b.next.Count)
            for (int k = 0; k < a.next.Count; k++) { Testing.Assert.AreEqual(a.next[k], b.next[k]) }
        }
        // übernehmen: der Verkehr fährt auf dem neuen Graphen weiter (Rebind)
        var t = new Raser.Traffic(4, 0, 3)
        var players = Scene.Walker(100.0, 100.0)
        t.Step(0.1, players)
        Testing.Assert.AreEqual(0, t.cars.Count)
        Testing.Assert.IsTrue(w.Hand(t) >= 0)
        Testing.Assert.IsTrue(!w.Pending)
        Testing.Assert.AreEqual(g.lanes.Count, t.graph.lanes.Count)
        for (int i = 0; i < 60; i++) { t.Step(1.0 / 30.0, players) }
        Testing.Assert.IsTrue(t.cars.Count > 0)
        // ein zweiter Auftrag nur mit der westlichen Kachel: neuer Graph, die Autos suchen ihre Spur wieder
        var only = new List<Raser.Tile>(Owns.Values)
        only.Add(WorkerTests.West())
        w.Request(new List<string>(), only)
        Testing.Assert.IsTrue(w.Wait(30.0))
        w.Hand(t)
        for (int i = 0; i < 30; i++) { t.Step(1.0 / 30.0, players) }
        Testing.Assert.IsTrue(!t.graph.roads.ContainsKey(3))
        w.Close()
    }
}

class BridgeTests {
    [Test "Brücke: keine Kreuzung mit der Straße darunter, Höhe zwischen den Enden"]
    undefined Bridge() {
        var tile = new Raser.Tile(new Raser.TileKey(0, 0))
        // das Gelände: im Süden 60 m, im Norden 70 m, dazwischen ein Einschnitt auf 40 m
        var raster = new Raser.HeightRaster(0.0, 0.0, 4.0, 65, 65, 40.0)
        for (int r = 0; r < 65; r++) {
            for (int c = 0; c < 65; c++) {
                float y = r * 4.0
                if (y <= 16.0) { raster.Set(c, r, 60.0) }
                if (y >= 184.0) { raster.Set(c, r, 70.0) }
            }
        }
        tile.heights = take raster
        // unten die Straße (Ebene 0), oben die Brücke (layer 1) - sie teilen sich sogar einen Punkt (100, 100)
        tile.data.roads.Add(Net.Road(1, "residential", [0.0, 100.0, 100.0, 100.0, 200.0, 100.0], 5.5))
        var bridge = Net.Road(2, "residential", [100.0, 0.0, 100.0, 100.0, 100.0, 200.0], 5.5)
        bridge.layer = 1
        tile.data.roads.Add(take bridge)
        // an beiden Enden geht es auf dem Gelände weiter (Rampen)
        tile.data.roads.Add(Net.Road(3, "residential", [100.0, 200.0, 100.0, 250.0], 5.5))
        tile.data.roads.Add(Net.Road(4, "residential", [100.0, 0.0, 150.0, 0.0], 5.5))
        var g = new Raser.RoadGraph()
        g.AddTile(tile)
        g.Build()
        // keine Kreuzung: jede Straße ein Abschnitt (6 Enden), keine Abbiegespur zwischen der Straße unten (1) und der Brücke (2)
        Testing.Assert.AreEqual(6, g.NodeCount)
        Testing.Assert.AreEqual(8, g.Count(Raser.LaneKind.Road))
        foreach (l in g.lanes) {
            if (l.kind != Raser.LaneKind.Turn) { continue }
            int a = g.lanes[l.source].road
            int b = g.lanes[l.target].road
            Testing.Assert.IsTrue(!((a == 1 && b == 2) || (a == 2 && b == 1)))
        }
        // die Höhe auf der Brücke (Raser.Bridges): in der Mitte zwischen 60 und 70 (nicht im Einschnitt) + 15 cm, Ebene 1
        var p = new Raser.LanePoint()
        int seen = 0
        foreach (l in g.lanes) {
            if (l.kind != Raser.LaneKind.Road) { continue }
            l.At(l.length / 2.0, p)
            if (l.road == 2) {
                Testing.Assert.AreEqual(1, l.level)
                Testing.Assert.IsTrue(Math.Abs(p.z - 65.15) < 1.0)
                seen++
            } else if (l.road == 1) {
                Testing.Assert.AreEqual(0, l.level)
                Testing.Assert.IsTrue(p.z == 0.0)
            }
        }
        Testing.Assert.AreEqual(2, seen)
        // ein Auto auf der Brücke trägt seine Höhe; Autos unten bremsen nicht für es
        var t = Scene.Of(g)
        var up = Scene.Car(t, 98.625, 100.0, 0.0, 8.0)
        var down = Scene.Car(t, 96.0, 98.625, -90.0, 8.0)
        t.Step(1.0 / 30.0, Scene.Walker(300.0, 300.0))
        Testing.Assert.IsTrue(up.z > 60.0 && up.level == 1)
        Testing.Assert.IsTrue(down.z == 0.0 && down.level == 0)
        Testing.Assert.IsTrue(down.accel > -0.5)
        var states = new List<Raser.NpcState>()
        t.States(states, 100.0, 100.0, 50.0)
        bool found = false
        foreach (st in states) {
            if (st.id == up.id) {
                found = true
                var back = new Raser.NpcState()
                back.FromEntity(st.id, st.EntityType, st.Variant, st.Bits, st.A, st.B)
                Testing.Assert.IsTrue(Math.Abs(back.z - up.z) < 0.01)
            }
        }
        Testing.Assert.IsTrue(found)
    }
}

class MotorwayTests {
    static Raser.RoadGraph Graph(List<Raser.Road> roads) {
        var tile = new Raser.Tile(new Raser.TileKey(0, 0))
        foreach (r in roads) { tile.data.roads.Add(copy r) }
        var g = new Raser.RoadGraph()
        g.AddTile(tile)
        g.Build()
        return g
    }

    [Test "Autobahn: drei Fahrstreifen je Richtungsfahrbahn, rechts der Standstreifen, Nachbarn links und rechts"]
    undefined Lanes() {
        var roads = new List<Raser.Road>(Owns.Values)
        roads.Add(Net.Road(1, "motorway", [0.0, 100.0, 1500.0, 100.0], 14.25, 3))
        var g = MotorwayTests.Graph(roads)
        Testing.Assert.AreEqual(3, g.Count(Raser.LaneKind.Road))
        var p = new Raser.LanePoint()
        float expect[] = [97.25, 101.0, 104.75]
        foreach (l in g.lanes) {
            if (l.kind != Raser.LaneKind.Road) { continue }
            Testing.Assert.AreEqual(3, l.laneCount)
            l.At(500.0, p)
            Testing.Assert.IsTrue(Math.Abs(p.n - expect[l.laneIndex]) < 0.01)
            if (l.laneIndex < 2) { Testing.Assert.AreEqual(l.laneIndex + 1, g.lanes[l.leftLane].laneIndex) } else { Testing.Assert.AreEqual(-1, l.leftLane) }
            if (l.laneIndex > 0) { Testing.Assert.AreEqual(l.laneIndex - 1, g.lanes[l.rightLane].laneIndex) }
            Testing.Assert.IsTrue(Math.Abs(l.limit - 130.0 / 3.6) < 0.01)
        }
    }

    [Test "Autobahn: überholen links, wieder rechts, keine Überlappung"]
    undefined Overtake() {
        var roads = new List<Raser.Road>(Owns.Values)
        roads.Add(Net.Road(1, "motorway", [0.0, 100.0, 3000.0, 100.0], 14.25, 3))
        var t = Scene.Of(MotorwayTests.Graph(roads))
        // ein Lkw rechts mit 80 km/h, dahinter drei Autos
        var truck = Scene.Car(t, 400.0, 97.25, -90.0, 22.0)
        truck.cap = 22.0
        truck.wish = 1.0
        var cars = new List<Raser.NpcCar>()
        cars.Add(truck)
        foreach (x in [150.0, 220.0, 300.0]) {
            var c = Scene.Car(t, x, 97.25, -90.0, 30.0)
            c.wish = 1.0
            c.cap = 1.0e9
            cars.Add(c)
        }
        var players = Scene.Walker(400.0, 130.0)
        float minGap = 1.0e30
        bool left = false
        for (int i = 0; i < 2400; i++) {
            players[0] = truck.east
            t.Step(1.0 / 30.0, players)
            foreach (c in cars) { if (t.graph.lanes[c.lane].laneIndex > 0) { left = true } }
            for (int a = 0; a < cars.Count; a++) {
                for (int b = a + 1; b < cars.Count; b++) { minGap = Math.Min(minGap, Scene.Gap(cars[a], cars[b])) }
            }
        }
        Testing.Assert.IsTrue(left)
        Testing.Assert.IsTrue(minGap > 0.0)
        int ahead = 0
        int right = 0
        for (int k = 1; k < cars.Count; k++) {
            if (cars[k].east > truck.east + 5.0) { ahead++ }
            if (t.graph.lanes[cars[k].lane].laneIndex == 0) { right++ }
        }
        // alle vorbei, und (rechts fahren) mindestens einer wieder rechts
        Testing.Assert.AreEqual(3, ahead)
        Testing.Assert.IsTrue(right >= 1)
    }

    [Test "Autobahn: von der Auffahrt einfädeln, ohne zu berühren"]
    undefined Merge() {
        var roads = new List<Raser.Road>(Owns.Values)
        roads.Add(Net.Road(1, "motorway", [0.0, 100.0, 500.0, 100.0, 1500.0, 100.0], 10.5, 2))
        roads.Add(Net.Road(2, "motorway_link", [200.0, 40.0, 400.0, 85.0, 500.0, 100.0], 5.0, 1))
        var g = MotorwayTests.Graph(roads)
        // die Auffahrt führt nur auf den rechten Streifen
        foreach (l in g.lanes) {
            if (l.kind != Raser.LaneKind.Turn || g.lanes[l.source].road != 2) { continue }
            Testing.Assert.AreEqual(0, g.lanes[l.target].laneIndex)
        }
        var t = Scene.Of(g)
        var ramp = Scene.Car(t, 300.0, 62.5, -77.0, 15.0)
        var main = Scene.Car(t, 280.0, 98.5, -90.0, 30.0)
        foreach (c in [ramp, main]) {
            c.wish = 1.0
            c.cap = 1.0e9
        }
        var players = Scene.Walker(500.0, 140.0)
        float minGap = 1.0e30
        for (int i = 0; i < 1200; i++) {
            t.Step(1.0 / 30.0, players)
            minGap = Math.Min(minGap, Scene.Gap(ramp, main))
        }
        Testing.Assert.IsTrue(minGap > 0.0)
        Testing.Assert.AreEqual(1, t.graph.lanes[ramp.lane].road)
        Testing.Assert.IsTrue(ramp.east > 600.0)
    }
}
