// Raser.World: wie ein Gebäude aussieht (Konzept, Abschnitt 3: Fassaden-Grammatik, Fallback ohne Foto).
//
// Je Gebäude einmal gewählt, deterministisch aus Bautyp, Viertel und ID - Voxelizer und ferne Stufe wählen gleich.
// - Bautyp aus den Daten: Nutzung (ALKIS-Funktion, POI), Höhe, Geschosse, Dachform, Grundfläche und Streckung des Grundrisses:
//   Siedlungshaus (bis zwei Geschosse, Steildach), Zeilenbau der 50er/60er (lang und schmal, flaches Satteldach), Altbau (Blockrand,
//   Gründerzeit und Wiederaufbau), Hochhaus, Gewerbe, öffentlicher Bau, Kirche, Nebengebäude.
// - Familie: je Straße (die nächste bis 35 m, sonst ein Raster von 150 m in der Welt) und Bautyp eine Familie von Farben (eine Siedlung in
//   Ziegel, eine verputzt in Pastell, ein Dach für alle) - Nachbarn in einer Straße sehen verwandt aus; jedes Haus nimmt aus der Familie seine
//   Farbe nach seiner ID, jedes fünfte Altbau- und Siedlungshaus aus einer anderen.
// - Teile: kleine Gebäude, die an ein großes stoßen (LoD2-Gebäudeteile, Anbauten, Treppenhäuser), sehen aus wie dieses.
// - Dazu je Haus: Sockel (Klinker, Putz, Stein), Gesims, Giebel mit Schiefer oder Faserzement, Fachwerk, Rahmen, Fensterbänke, Haustür,
//   Fensterläden, Balkone - und die Dreckstufe für Wand und Dach.
// Ziel ist ein stimmiges Bild des Ruhrgebiets, nicht der echte Bestand (keine Baujahre, keine Fotos).
namespace Raser {
    // Was die Wahl eines Hauses über seine Umgebung weiß (Raser.HouseStyle.Assign).
    class HouseContext {
        TileData data
        defined float area
        defined float cx            // die Mitte (kachel-lokal, m)
        defined float cy
        defined int setting
        defined int type
        defined int id              // Hash der ID (mit Seed)
        defined int fam             // Hash der Familie

        construct() { }
    }

    class HouseStyle {
        // die Bautypen
        static readonly defined int Small = 0       // Siedlungs- und Zechenhaus, Einfamilienhaus
        static readonly defined int Row = 1         // Zeilenbau der 50er/60er
        static readonly defined int Old = 2         // Altbau: Gründerzeit, Blockrand, Wiederaufbau
        static readonly defined int High = 3        // Hochhaus (ab 19 m Traufe)
        static readonly defined int Work = 4        // Gewerbe, Büro, Halle, Markt
        static readonly defined int Civic = 5       // öffentlich: Rathaus, Schule, Verwaltung
        static readonly defined int Church = 6
        static readonly defined int Shed = 7        // Garagen, Nebengebäude, Überdachungen

        static readonly defined float Cell = 150.0  // das Raster der Viertel (m)

        // Ein Wert in [0, 1) aus Zahlen und einem Salz.
        static defined float Rand(defined int a, defined int b, defined int salt) {
            int h = Raser.Fnv.Mix(Raser.Fnv.AddInt(Raser.Fnv.AddInt(Raser.Fnv.AddInt(Raser.Fnv.Start(), a), b), salt))
            return ((h >> 20) & 65535) / 65536.0
        }

        // Eine aus n Möglichkeiten (0 .. n - 1).
        static defined int Pick(defined int a, defined int b, defined int salt, defined int n) {
            return Math.Min(Math.Floor(Raser.HouseStyle.Rand(a, b, salt) * n)!int, n - 1)
        }

        static defined int TypeOf(RoofModel m, defined float area) {
            Building b = m.building
            string f = b.function
            if (f == undefined) { f = "" }
            int style = Raser.Facade.StyleOf(b, area)
            float h = b.eaves - b.ground
            if (style == Raser.Facade.None || style == Raser.Facade.GarageStyle) { return Raser.HouseStyle.Shed }
            if (style == Raser.Facade.Church) { return Raser.HouseStyle.Church }
            if (style == Raser.Facade.Public) { return Raser.HouseStyle.Civic }
            if (style == Raser.Facade.Commercial || style == Raser.Facade.Market || style == Raser.Facade.Pavilion) { return Raser.HouseStyle.Work }
            // Wohnen (auch mit Läden unten)
            if (h >= 19.0) { return Raser.HouseStyle.High }
            if (h < 7.2) {
                if (area < 30.0 && !m.pitched) { return Raser.HouseStyle.Shed }
                return Raser.HouseStyle.Small
            }
            float stretch = m.halfAlong / Math.Max(m.halfAcross, 0.5)
            if (stretch >= 2.0 && area >= 150.0 && b.ridge - b.eaves < 4.5 && b.roofType != Raser.RoofType.Mansard) { return Raser.HouseStyle.Row }
            return Raser.HouseStyle.Old
        }

        // Wählt das Aussehen aller Gebäude einer Kachel (Ursprung der Kachel in der Welt: e0, n0 in m; roads: ihre Straßen).
        static undefined Assign(List<RoofModel> models, TileData data, defined float e0, defined float n0, defined int seed) {
            int n = models.Count
            defined float areas[n]
            for (int i = 0; i < n; i++) { areas[i] = Math.Abs(Raser.Geo.Area(models[i].building.footprint)) }
            List<Road> roads = undefined
            if (data != undefined) { roads = data.roads }
            for (int i = 0; i < n; i++) {
                var m = models[i]
                var ctx = new Raser.HouseContext()
                ctx.data = data
                ctx.area = areas[i]
                ctx.cx = (m.box.minX + m.box.maxX) / 2.0
                ctx.cy = (m.box.minY + m.box.maxY) / 2.0
                ctx.setting = Raser.HouseStyle.SettingOf(m, i, models, areas, data)
                Raser.HouseStyle.Choose(m, ctx, Raser.HouseStyle.Neighbourhood(m, roads, e0, n0), seed)
            }
            // Teile sehen aus wie das große Gebäude, an das sie stoßen (nicht an der Kachelgrenze: die Nachbarkachel kennt das große vielleicht nicht)
            for (int i = 0; i < n; i++) {
                if (areas[i] >= 90.0 || Raser.HouseStyle.OnEdge(models[i]) || models[i].kind != 0) { continue }
                int best = -1
                for (int j = 0; j < n; j++) {
                    if (j == i || areas[j] < areas[i] * 2.0 || areas[j] < 60.0) { continue }
                    if (best >= 0 && areas[j] <= areas[best]) { continue }
                    if (Raser.HouseStyle.Touches(models[i], models[j])) { best = j }
                }
                if (best >= 0) { Raser.HouseStyle.Follow(models[i], models[best]) }
            }
        }

        // die Orte (Raser.RoofModel.setting)
        static readonly defined int Town = 0           // Wohngebiet, Vorort
        static readonly defined int Center = 1         // Innenstadt: dicht, große Häuser
        static readonly defined int OldTown = 2        // Altstadt, alter Ortskern: dicht, kleine alte Häuser
        static readonly defined int Rural = 3          // Dorf, Hof, locker zwischen Feldern
        static readonly defined int Industrial = 4     // Industriegebiet
        static readonly defined int Commercial = 5     // Gewerbe- und Einkaufsgebiet

        // Liegt (x, y) in einem Gebiet der Art kind (Flächen mit Belag oder Gebiete ohne, Raser.TileData.zones)?
        static string ZoneAt(TileData data, defined float x, defined float y) {
            if (data == undefined) { return "" }
            string found = ""
            if (data.zones == undefined) { return "" }
            foreach (z in data.zones) {
                if (Raser.Geo.Inside(z.ring, x, y)) {
                    // die feinere Angabe gewinnt: Altstadt und Hof vor Ort, Ort vor Nutzung
                    if (z.kind == "historic=district" || (z.name != undefined && z.name.Contains("Altstadt"))) { return "historic=district" }
                    if (found == "" || z.kind == "landuse=farmyard" || z.kind == "landuse=industrial") { found = z.kind }
                }
            }
            if (found != "") { return found }
            foreach (a in data.areas) {
                if ((a.kind == "landuse=industrial" || a.kind == "landuse=commercial" || a.kind == "landuse=retail") && Raser.Geo.Inside(a.ring, x, y)) { return a.kind }
            }
            return ""
        }

        // Der Ort eines Hauses aus den Daten: Gebiete (OSM landuse, place, historic), Felder in der Nähe, wie dicht und wie groß die Häuser ringsum
        // sind, das Baujahr (OSM start_date). Häuser an der Kachelgrenze nur nach den Gebieten (die Nachbarkachel kennt andere Nachbarn).
        static defined int SettingOf(RoofModel m, defined int self, List<RoofModel> models, defined float areas[], TileData data) {
            Building b = m.building
            float cx = (m.box.minX + m.box.maxX) / 2.0
            float cy = (m.box.minY + m.box.maxY) / 2.0
            string zone = Raser.HouseStyle.ZoneAt(data, cx, cy)
            if (zone == "historic=district") { return Raser.HouseStyle.OldTown }
            if (zone == "landuse=industrial") { return Raser.HouseStyle.Industrial }
            if (zone == "landuse=commercial" || zone == "landuse=retail") { return Raser.HouseStyle.Commercial }
            if (zone == "landuse=farmyard" || zone == "place=hamlet" || zone == "place=farm" || zone == "place=isolated_dwelling") { return Raser.HouseStyle.Rural }
            string year = b.Tag("start_date")
            if (year != undefined && year.length >= 4) {
                any y = year.Substring(0, 4).TryToInt()
                if (y != undefined && y < 1850) { return Raser.HouseStyle.OldTown }
            }
            if (Raser.HouseStyle.OnEdge(m)) {
                if (zone == "place=village") { return Raser.HouseStyle.Rural }
                return Raser.HouseStyle.Town
            }
            // ringsum (50 m): wie viele Häuser, wie groß, wie viele mit Steildach; Felder und Wiesen bis 60 m
            int near = 0
            float sum = 0.0
            int pitched = 0
            for (int j = 0; j < models.Count; j++) {
                if (j == self || areas[j] < 25.0) { continue }
                float dx = (models[j].box.minX + models[j].box.maxX) / 2.0 - cx
                float dy = (models[j].box.minY + models[j].box.maxY) / 2.0 - cy
                if (dx * dx + dy * dy > 2500.0) { continue }
                near++
                sum = sum + areas[j]
                if (models[j].pitched) { pitched++ }
            }
            bool fields = false
            if (data != undefined) {
                foreach (a in data.areas) {
                    if (a.kind != "landuse=farmland" && a.kind != "landuse=forest") { continue }
                    if (Raser.Geo.Inside(a.ring, cx, cy) || Raser.HouseStyle.RingDistance(a.ring, cx, cy) < 60.0) { fields = true }
                }
                if (data.zones != undefined) { foreach (z in data.zones) {
                    if (z.kind != "landuse=farmland" && z.kind != "landuse=meadow") { continue }
                    if (Raser.HouseStyle.RingDistance(z.ring, cx, cy) < 60.0) { fields = true }
                } }
            }
            if (fields && near <= 8) { return Raser.HouseStyle.Rural }
            if (zone == "place=village" && near <= 14) { return Raser.HouseStyle.Rural }
            if (near >= 14) {
                float mean = sum / near
                if (mean < 220.0 && pitched * 10 >= near * 7) { return Raser.HouseStyle.OldTown }
                if (mean >= 350.0) { return Raser.HouseStyle.Center }
            }
            return Raser.HouseStyle.Town
        }

        static defined float RingDistance(float ring[], defined float x, defined float y) {
            int n = ring.length / 2
            float best = 1.0e30
            for (int k = 0; k < n; k++) {
                int l = (k + 1) % n
                float d = Raser.Geo.DistanceToSegment(x, y, ring[k * 2], ring[k * 2 + 1], ring[l * 2], ring[l * 2 + 1])
                if (d < best) { best = d }
            }
            return best
        }

        // Was der Ort am Aussehen ändert: Fachwerk in der Altstadt (Balken auf weißem Putz) und auf dem Land (Ausfachung aus rotem Backstein), dort
        // auch Scheunen; im Industrie- und Gewerbegebiet kein Fachwerk.
        static undefined Local(RoofModel m, HouseContext ctx) {
            Building b = m.building
            int type = ctx.type
            int id = ctx.id
            float h = b.eaves - b.ground
            bool small = type == Raser.HouseStyle.Small || (type == Raser.HouseStyle.Old && h < 12.0)
            if (ctx.setting == Raser.HouseStyle.Industrial || ctx.setting == Raser.HouseStyle.Commercial) {
                m.timberColor = 0
                return
            }
            if (ctx.setting == Raser.HouseStyle.OldTown && small && m.pitched) {
                if (Raser.HouseStyle.Rand(id, 0, 21) < 0.4) {
                    m.wallColor = Raser.HouseStyle.Of([Raser.Palette.Plaster, Raser.Palette.Plaster, Raser.Palette.PlasterCream], id, 22)
                    m.timberColor = Raser.Palette.Timber
                    m.plinthColor = Raser.Palette.Sandstone
                    m.plinthVoxels = 3
                    m.gableColor = 0
                }
                m.roofColor = Raser.HouseStyle.Of([Raser.Palette.RoofTiles, Raser.Palette.RoofDark, Raser.Palette.RoofSlate], id, 23)
            }
            if (ctx.setting == Raser.HouseStyle.Rural && m.pitched) {
                string f = b.function
                if (f == undefined) { f = "" }
                bool barn = f.StartsWith("alkis=31001_27") || b.Tag("building") == "barn" || b.Tag("building") == "farm_auxiliary" || b.Tag("building") == "stable"
                if (small || barn) {
                    float r = Raser.HouseStyle.Rand(id, 0, 24)
                    if (r < 0.35) {
                        m.wallColor = Raser.HouseStyle.Of([Raser.Palette.Brick, Raser.Palette.BrickDark, Raser.Palette.BrickLight], id, 25)
                        m.timberColor = Raser.Palette.Timber
                        m.gableColor = 0
                    } else if (r < 0.7 || barn) {
                        m.wallColor = Raser.HouseStyle.Of([Raser.Palette.Brick, Raser.Palette.BrickDark, Raser.Palette.Brick], id, 25)
                    }
                    m.plinthColor = Raser.Palette.StoneGrey
                    m.plinthVoxels = 2
                    m.roofColor = Raser.HouseStyle.Of([Raser.Palette.RoofTiles, Raser.Palette.RoofDark, Raser.Palette.RoofOrange], id, 26)
                    if (barn) {
                        m.dormers = false
                        m.sillColor = 0
                    }
                }
            }
        }

        // Wozu ein Haus gehört: zur nächsten Straße (bis 35 m; ihre ID ist über Kachelgrenzen gleich) - eine Siedlung, eine Zeile, ein Block an
        // einer Straße sehen verwandt aus; sonst zur Zelle des Viertels (150 m in der Welt).
        static defined int Neighbourhood(RoofModel m, List<Road> roads, defined float e0, defined float n0) {
            float cx = (m.box.minX + m.box.maxX) / 2.0
            float cy = (m.box.minY + m.box.maxY) / 2.0
            float best = 35.0
            int key = Math.Floor((cx + e0) / Raser.HouseStyle.Cell)!int * 100003 + Math.Floor((cy + n0) / Raser.HouseStyle.Cell)!int
            // ein Haus über der Kachelgrenze steht auch in der Nachbarkachel, die andere Straßen kennt: dort nur nach der Zelle (beide wählen gleich)
            if (roads == undefined || Raser.HouseStyle.OnEdge(m)) { return key }
            foreach (r in roads) {
                if (r.kind == undefined || !r.kind.StartsWith("highway=") || r.layer != 0 || r.points == undefined || r.points.length < 4) { continue }
                if (r.kind == "highway=footway" || r.kind == "highway=path" || r.kind == "highway=cycleway" || r.kind == "highway=steps" || r.kind == "highway=service") { continue }
                float d = Raser.Geo.DistanceToLine(r.points, cx, cy)
                if (d < best) {
                    best = d
                    key = r.id
                }
            }
            return key
        }

        // Reicht das Haus (fast) über den Rand der Kachel?
        static defined bool OnEdge(RoofModel m) { return m.box.minX < 0.5 || m.box.minY < 0.5 || m.box.maxX > 255.5 || m.box.maxY > 255.5 }

        // Berühren sich die Grundrisse (bis 30 cm)?
        static defined bool Touches(RoofModel a, RoofModel b) {
            if (!a.box.Overlaps(b.box.minX - 0.3, b.box.minY - 0.3, b.box.maxX + 0.3, b.box.maxY + 0.3)) { return false }
            float pa[] = a.building.footprint
            float pb[] = b.building.footprint
            int na = pa.length / 2
            int nb = pb.length / 2
            for (int i = 0; i < na; i++) {
                float x = pa[i * 2]
                float y = pa[i * 2 + 1]
                if (!b.box.Overlaps(x - 0.3, y - 0.3, x + 0.3, y + 0.3)) { continue }
                for (int k = 0; k < nb; k++) {
                    int l = (k + 1) % nb
                    if (Raser.Geo.DistanceToSegment(x, y, pb[k * 2], pb[k * 2 + 1], pb[l * 2], pb[l * 2 + 1]) < 0.3) { return true }
                }
            }
            return false
        }

        // Ein Teil übernimmt das Aussehen des Hauptgebäudes (das Dach nur bei gleicher Art).
        static undefined Follow(RoofModel part, RoofModel main) {
            part.wallColor = main.wallColor
            part.wallMaterial = main.wallMaterial
            part.plinthColor = main.plinthColor
            part.plinthVoxels = main.plinthVoxels
            part.groundColor = main.groundColor
            part.trimColor = main.trimColor
            part.gableColor = main.gableColor
            part.timberColor = main.timberColor
            part.frameColor = main.frameColor
            part.sillColor = main.sillColor
            part.doorColor = main.doorColor
            part.shutterColor = main.shutterColor
            part.balconyColor = 0
            part.dormers = false
            if (part.pitched == main.pitched) { part.roofColor = main.roofColor }
        }

        // Das Material zu einer Wandfarbe (Zerstörbarkeit, Raser.Materials).
        static defined int MaterialOf(defined int color) {
            int b = Raser.Palette.BaseOf(color)
            if (b == Raser.Palette.Brick || b == Raser.Palette.BrickDark || b == Raser.Palette.BrickLight || b == Raser.Palette.BrickYellow || b == Raser.Palette.BrickBrown || b == Raser.Palette.BrickCross || b == Raser.Palette.Clinker) { return Raser.Material.Brick!int }
            if (b == Raser.Palette.Sandstone || b == Raser.Palette.StoneGrey) { return Raser.Material.Rock!int }
            if (b == Raser.Palette.WashedConcrete || b == Raser.Palette.ConcretePanel || b == Raser.Palette.Concrete || b == Raser.Palette.Eternit) { return Raser.Material.Concrete!int }
            if (b == Raser.Palette.CurtainDark || b == Raser.Palette.MetalRibbed || b == Raser.Palette.MetalBlue || b == Raser.Palette.PanelWhite || b == Raser.Palette.PanelRed || b == Raser.Palette.Slate) { return Raser.Material.Metal!int }
            if (b == Raser.Palette.Timber) { return Raser.Material.Wood!int }
            return Raser.Material.Plaster!int
        }

        static defined bool IsBrick(defined int color) { return Raser.HouseStyle.MaterialOf(color) == Raser.Material.Brick!int }

        // Eine Farbe aus options, nach dem Wert h und einem Salz.
        static defined int Of(int options[], defined int h, defined int salt) { return options[Raser.HouseStyle.Pick(h, 0, salt, options.length)] }

        // Das Aussehen eines Gebäudes für sich.
        static undefined Choose(RoofModel m, HouseContext ctx, defined int place, defined int seed) {
            Building b = m.building
            float area = ctx.area
            int type = Raser.HouseStyle.TypeOf(m, area)
            m.setting = ctx.setting
            m.kind = 0
            m.facadeStyle = -1
            m.bandColor = 0
            m.canopy = false
            m.sheds = false
            m.houseType = type
            // die Familie: je Straße (oder Zelle des Viertels) und Bautyp; das Haus: nach seiner ID. Jedes fünfte Altbau- oder Siedlungshaus
            // tanzt aus der Reihe (eine andere Familie)
            int id = Raser.Fnv.AddInt(Raser.Fnv.AddInt(Raser.Fnv.Start(), b.id), seed)
            int fam = Raser.Fnv.AddInt(Raser.Fnv.AddInt(Raser.Fnv.AddInt(Raser.Fnv.Start(), place), type), seed)
            if ((type == Raser.HouseStyle.Old || type == Raser.HouseStyle.Small) && Raser.HouseStyle.Rand(id, 0, 14) < 0.2) { fam = Raser.Fnv.AddInt(fam, id) }
            ctx.id = id
            ctx.fam = fam
            ctx.type = type
            m.wallColor = Raser.Palette.Plaster
            m.roofColor = Raser.Palette.RoofTiles
            m.plinthColor = 0
            m.plinthVoxels = 0
            m.groundColor = 0
            m.trimColor = 0
            m.gableColor = 0
            m.timberColor = 0
            m.frameColor = Raser.Palette.Plaster
            m.sillColor = 0
            m.shutterColor = 0
            m.balconyColor = 0
            m.dormers = false
            m.doorColor = Raser.HouseStyle.Of([Raser.Palette.Wood + 64, Raser.Palette.Wood + 32, Raser.Palette.DoorGreen, Raser.Palette.DoorRed, Raser.Palette.Plaster, Raser.Palette.DoorBlue, Raser.Palette.Metal + 64, Raser.Palette.Wood + 64], id, 11)
            if (type == Raser.HouseStyle.Small) { Raser.HouseStyle.SmallHouse(m, fam, id) }
            else if (type == Raser.HouseStyle.Row) { Raser.HouseStyle.RowHouse(m, fam, id) }
            else if (type == Raser.HouseStyle.Old) { Raser.HouseStyle.OldHouse(m, fam, id, area) }
            else if (type == Raser.HouseStyle.High) { Raser.HouseStyle.HighHouse(m, fam, id) }
            else if (type == Raser.HouseStyle.Work) { Raser.HouseStyle.WorkHouse(m, id, area) }
            else if (type == Raser.HouseStyle.Civic) { Raser.HouseStyle.CivicHouse(m, id, area) }
            else if (type == Raser.HouseStyle.Church) {
                m.wallColor = Raser.HouseStyle.Of([Raser.Palette.BrickCross, Raser.Palette.Brick, Raser.Palette.Sandstone, Raser.Palette.StoneGrey, Raser.Palette.BrickDark], id, 2)
                m.roofColor = Raser.HouseStyle.Of([Raser.Palette.RoofSlate, Raser.Palette.RoofDark, Raser.Palette.RoofTiles], id, 3)
                m.plinthColor = Raser.Palette.StoneGrey
                m.plinthVoxels = 4
                m.frameColor = Raser.Palette.StoneGrey
            } else {
                m.wallColor = Raser.HouseStyle.Of([Raser.Palette.PlasterGrey, Raser.Palette.ConcretePanel, Raser.Palette.Brick, Raser.Palette.PlasterSilver, Raser.Palette.BrickYellow], id, 2)
                m.roofColor = Raser.Palette.RoofAnthracite
                m.frameColor = Raser.Palette.Metal + 64
            }
            // Rahmen: meist weiß, sonst dunkel (Kunststoff anthrazit) oder Holz
            if (type == Raser.HouseStyle.Small || type == Raser.HouseStyle.Row || type == Raser.HouseStyle.Old || type == Raser.HouseStyle.High) {
                float r = Raser.HouseStyle.Rand(id, 0, 12)
                if (r < 0.1) { m.frameColor = Raser.Palette.Metal + 64 } else if (r < 0.16) { m.frameColor = Raser.Palette.Wood + 64 }
            }
            // Gauben: auf Siedlungshäusern und Altbauten mit genug Dach (Zechensiedlungen fast immer)
            float rise = b.ridge - b.eaves
            if (m.pitched && rise >= 2.6 && b.roofType != Raser.RoofType.Flat) {
                // (Siedlungshäuser je Siedlung gleich, Altbauten je Haus)
                if (type == Raser.HouseStyle.Small) { m.dormers = Raser.HouseStyle.Rand(fam, 0, 13) < 0.6 }
                if (type == Raser.HouseStyle.Old) { m.dormers = Raser.HouseStyle.Rand(id, 0, 13) < 0.4 }
            }
            // der Ort: Fachwerk in der Altstadt (weiß verputzt) und auf dem Land (rote Ziegel zwischen den Balken), keins im Gewerbegebiet
            Raser.HouseStyle.Local(m, ctx)
            // besondere Gebäude mit eigenem Aussehen und eigenen Bausteinen (Raser.BuildingKinds)
            Raser.BuildingKinds.Apply(m, ctx)
            // ein Sockel in Wandfarbe ist keiner
            if (Raser.Palette.BaseOf(m.plinthColor) == Raser.Palette.BaseOf(m.wallColor)) { m.plinthColor = 0 }
            if (m.plinthColor == 0) { m.plinthVoxels = 0 }
            if (!m.pitched) {
                m.roofColor = Raser.Palette.RoofFlat
                m.gableColor = 0
            }
            // Wünsche aus den Overrides (Wandfarbe nicht Ziegelrot oder Weiß, Dach nicht Ziegel oder flach) bleiben
            if (b.wallColor != Raser.Palette.Brick && b.wallColor != Raser.Palette.Plaster) { m.wallColor = b.wallColor }
            if (b.roofColor != Raser.Palette.RoofTiles && b.roofColor != Raser.Palette.RoofFlat) { m.roofColor = b.roofColor }
            // je Gebäude eine Dreckstufe für Wand und Dach (wie bisher aus ID und Seed)
            int dh = Raser.Fnv.AddInt(Raser.Fnv.AddInt(Raser.Fnv.Start(), b.id), seed)
            // die Wand etwas sauberer als bisher (45 % sauber, 35 % leicht, 15 % mittel, 5 % stark): Pastell bleibt Pastell
            int dp = ((dh >> 8) & 1023) % 100
            int dirt = 0
            if (dp >= 45) { dirt = 1 }
            if (dp >= 80) { dirt = 2 }
            if (dp >= 95) { dirt = 3 }
            m.wallMaterial = Raser.HouseStyle.MaterialOf(m.wallColor)
            m.wallColor = Raser.Palette.Dirty(m.wallColor, dirt)
            m.roofColor = Raser.Palette.Dirty(m.roofColor, Raser.RoofModel.DirtLevel(dh >> 16))
            m.plinthColor = Raser.Palette.Dirty(m.plinthColor, dirt)
            m.groundColor = Raser.Palette.Dirty(m.groundColor, dirt)
            m.trimColor = Raser.Palette.Dirty(m.trimColor, Math.Max(dirt - 1, 0))
            m.gableColor = Raser.Palette.Dirty(m.gableColor, dirt)
        }

        // Siedlungs- und Zechenhäuser, Einfamilienhäuser.
        static undefined SmallHouse(RoofModel m, defined int fam, defined int id) {
            Building b = m.building
            int family = Raser.HouseStyle.Pick(fam, 0, 1, 6)
            if (family == 0) {
                // Zechensiedlung in Ziegel: rote Steine, helle Dächer, dunkler Sockel
                m.wallColor = Raser.HouseStyle.Of([Raser.Palette.Brick, Raser.Palette.BrickLight, Raser.Palette.Brick, Raser.Palette.BrickDark], id, 2)
                m.roofColor = Raser.HouseStyle.Of([Raser.Palette.RoofOrange, Raser.Palette.RoofTiles, Raser.Palette.RoofOrange], fam, 3)
                m.plinthColor = Raser.Palette.Clinker
                m.plinthVoxels = 2
                m.sillColor = Raser.Palette.BrickDark
            } else if (family == 1) {
                // Zechensiedlung verputzt: Creme, Weiß, Beige, Ocker; Sockel abgesetzt, manchmal grüne Läden
                m.wallColor = Raser.HouseStyle.Of([Raser.Palette.PlasterCream, Raser.Palette.Plaster, Raser.Palette.PlasterBeige, Raser.Palette.PlasterOchre], id, 2)
                m.roofColor = Raser.HouseStyle.Of([Raser.Palette.RoofOrange, Raser.Palette.RoofTiles, Raser.Palette.RoofOrange], fam, 3)
                m.plinthColor = Raser.HouseStyle.Of([Raser.Palette.PlasterTaupe, Raser.Palette.Clinker, Raser.Palette.PlasterGrey], fam, 4)
                m.plinthVoxels = 3
                m.sillColor = Raser.Palette.Plaster
                if (Raser.HouseStyle.Rand(fam, 0, 5) < 0.35) { m.shutterColor = Raser.Palette.DoorGreen }
            } else if (family == 2) {
                // alte Siedlung grau: Kratzputz, dunkle Dächer, Schiefer am Giebel
                m.wallColor = Raser.HouseStyle.Of([Raser.Palette.PlasterTaupe, Raser.Palette.PlasterGrey, Raser.Palette.PlasterSilver, Raser.Palette.PlasterBeige], id, 2)
                m.roofColor = Raser.HouseStyle.Of([Raser.Palette.RoofDark, Raser.Palette.RoofAnthracite, Raser.Palette.RoofTiles], fam, 3)
                m.plinthColor = Raser.Palette.Clinker
                m.plinthVoxels = 3
                m.sillColor = Raser.Palette.Concrete
                if (Raser.HouseStyle.Rand(id, 0, 6) < 0.4) { m.gableColor = Raser.Palette.Slate }
            } else if (family == 3) {
                // Nachkriegs-Einfamilienhaus: weiß oder gelber Ziegel, anthrazit
                m.wallColor = Raser.HouseStyle.Of([Raser.Palette.Plaster, Raser.Palette.BrickYellow, Raser.Palette.PlasterCream, Raser.Palette.BrickBrown], id, 2)
                m.roofColor = Raser.HouseStyle.Of([Raser.Palette.RoofAnthracite, Raser.Palette.RoofBrown, Raser.Palette.RoofDark], id, 3)
                m.plinthColor = Raser.Palette.PlasterGrey
                m.plinthVoxels = 2
                m.sillColor = Raser.Palette.Concrete
                if (Raser.HouseStyle.Rand(id, 0, 6) < 0.25) { m.gableColor = Raser.Palette.Eternit }
                if (Raser.HouseStyle.Rand(id, 0, 7) < 0.3) { m.frameColor = Raser.Palette.Wood + 64 }
            } else if (family == 4) {
                // bunte Reihe: Pastell nebeneinander
                m.wallColor = Raser.HouseStyle.Of([Raser.Palette.PlasterYellow, Raser.Palette.Plaster, Raser.Palette.PlasterPink, Raser.Palette.PlasterGreen, Raser.Palette.PlasterBlue, Raser.Palette.PlasterCream], id, 2)
                m.roofColor = Raser.HouseStyle.Of([Raser.Palette.RoofTiles, Raser.Palette.RoofAnthracite, Raser.Palette.RoofOrange], fam, 3)
                m.plinthColor = Raser.Palette.PlasterGrey
                m.plinthVoxels = 2
                m.sillColor = Raser.Palette.Plaster
            } else {
                // alter Ortskern: dunkler Ziegel, viel Fachwerk
                m.wallColor = Raser.HouseStyle.Of([Raser.Palette.BrickDark, Raser.Palette.Brick, Raser.Palette.Plaster], id, 2)
                m.roofColor = Raser.HouseStyle.Of([Raser.Palette.RoofTiles, Raser.Palette.RoofDark], id, 3)
                m.plinthColor = Raser.Palette.StoneGrey
                m.plinthVoxels = 2
                m.sillColor = Raser.Palette.Sandstone
                if (Raser.HouseStyle.Rand(id, 0, 8) < 0.45) {
                    m.wallColor = Raser.Palette.Plaster
                    m.timberColor = Raser.Palette.Timber
                }
            }
            // Fachwerk auch sonst ab und zu (steile Dächer)
            if (m.timberColor == 0 && b.ridge - b.eaves > 3.0 && Raser.HouseStyle.Rand(id, 0, 9) < 0.05) {
                m.wallColor = Raser.Palette.Plaster
                m.timberColor = Raser.Palette.Timber
            }
        }

        // Zeilenbau der 50er/60er: Pastell je Siedlung, ein Dach für alle, Balkone.
        static undefined RowHouse(RoofModel m, defined int fam, defined int id) {
            int family = Raser.HouseStyle.Pick(fam, 0, 1, 5)
            if (family == 0) {
                m.wallColor = Raser.HouseStyle.Of([Raser.Palette.PlasterYellow, Raser.Palette.PlasterCream, Raser.Palette.PlasterOchre, Raser.Palette.PlasterBeige], id, 2)
            } else if (family == 1) {
                m.wallColor = Raser.HouseStyle.Of([Raser.Palette.PlasterGreen, Raser.Palette.PlasterBlue, Raser.Palette.PlasterSilver, Raser.Palette.Plaster], id, 2)
            } else if (family == 2) {
                m.wallColor = Raser.HouseStyle.Of([Raser.Palette.PlasterPink, Raser.Palette.PlasterCream, Raser.Palette.PlasterBeige, Raser.Palette.Plaster], id, 2)
            } else if (family == 3) {
                m.wallColor = Raser.HouseStyle.Of([Raser.Palette.Brick, Raser.Palette.BrickBrown, Raser.Palette.BrickLight, Raser.Palette.Brick], id, 2)
            } else {
                m.wallColor = Raser.HouseStyle.Of([Raser.Palette.Plaster, Raser.Palette.PlasterSilver, Raser.Palette.PlasterGrey, Raser.Palette.PlasterCream], id, 2)
            }
            m.roofColor = Raser.HouseStyle.Of([Raser.Palette.RoofTiles, Raser.Palette.RoofBrown, Raser.Palette.RoofAnthracite, Raser.Palette.RoofDark], fam, 3)
            m.plinthColor = Raser.HouseStyle.Of([Raser.Palette.PlasterGrey, Raser.Palette.Concrete, Raser.Palette.PlasterTaupe], fam, 4)
            m.plinthVoxels = 3
            m.sillColor = Raser.Palette.Concrete
            if (Raser.HouseStyle.Rand(fam, 0, 5) < 0.75) { m.balconyColor = Raser.HouseStyle.Of([Raser.Palette.Plaster, Raser.Palette.ConcretePanel, Raser.Palette.MetalBlue, Raser.Palette.BaseOf(m.wallColor)], fam, 6) }
        }

        // Altbau: Gründerzeit verputzt oder Backstein, Wiederaufbau schlicht; Steinsockel, Gesims, Läden unten verkleidet.
        static undefined OldHouse(RoofModel m, defined int fam, defined int id, defined float area) {
            // verputzt doppelt so oft wie die anderen (die Innenstädte sind nach dem Krieg meist verputzt wieder aufgebaut)
            int family = Math.Max(Raser.HouseStyle.Pick(fam, 0, 1, 5) - 1, 0)
            if (family == 0) {
                m.wallColor = Raser.HouseStyle.Of([Raser.Palette.PlasterCream, Raser.Palette.PlasterYellow, Raser.Palette.Plaster, Raser.Palette.PlasterBeige, Raser.Palette.PlasterPink, Raser.Palette.PlasterGreen, Raser.Palette.PlasterSilver, Raser.Palette.PlasterOchre], id, 2)
            } else if (family == 1) {
                m.wallColor = Raser.HouseStyle.Of([Raser.Palette.Brick, Raser.Palette.BrickCross, Raser.Palette.BrickDark, Raser.Palette.BrickLight], id, 2)
            } else if (family == 2) {
                m.wallColor = Raser.HouseStyle.Of([Raser.Palette.PlasterCream, Raser.Palette.BrickCross, Raser.Palette.PlasterOchre, Raser.Palette.Brick, Raser.Palette.Plaster, Raser.Palette.PlasterGrey], id, 2)
            } else {
                m.wallColor = Raser.HouseStyle.Of([Raser.Palette.PlasterSilver, Raser.Palette.PlasterBeige, Raser.Palette.Plaster, Raser.Palette.PlasterGrey, Raser.Palette.PlasterYellow], id, 2)
            }
            m.roofColor = Raser.HouseStyle.Of([Raser.Palette.RoofDark, Raser.Palette.RoofSlate, Raser.Palette.RoofTiles, Raser.Palette.RoofAnthracite], id, 3)
            m.plinthColor = Raser.HouseStyle.Of([Raser.Palette.Sandstone, Raser.Palette.StoneGrey, Raser.Palette.PlasterTaupe, Raser.Palette.Clinker], id, 4)
            m.plinthVoxels = 4
            m.sillColor = Raser.Palette.Sandstone
            if (family != 3 && Raser.HouseStyle.Rand(id, 0, 5) < 0.6) {
                m.trimColor = Raser.Palette.Plaster
                if (Raser.HouseStyle.IsBrick(m.wallColor)) { m.trimColor = Raser.Palette.Sandstone }
            }
            if (Raser.Facade.StyleOf(m.building, area) == Raser.Facade.ShopStyle && Raser.HouseStyle.Rand(id, 0, 6) < 0.5) {
                m.groundColor = Raser.HouseStyle.Of([Raser.Palette.StoneGrey, Raser.Palette.Sandstone, Raser.Palette.Slate, Raser.Palette.WashedConcrete], id, 7)
            }
            if (family == 3 && Raser.HouseStyle.Rand(id, 0, 8) < 0.4) { m.balconyColor = Raser.Palette.Plaster }
        }

        // Hochhaus: Platten, heller Putz, Waschbeton; Balkone.
        static undefined HighHouse(RoofModel m, defined int fam, defined int id) {
            int walls[] = [Raser.Palette.ConcretePanel, Raser.Palette.Plaster, Raser.Palette.PlasterSilver, Raser.Palette.WashedConcrete, Raser.Palette.BrickBrown, Raser.Palette.PlasterBeige]
            m.wallColor = walls[(Raser.HouseStyle.Pick(fam, 0, 2, 6) + Raser.HouseStyle.Pick(id, 0, 2, 2)) % 6]
            m.roofColor = Raser.Palette.RoofFlat
            m.plinthColor = Raser.Palette.Concrete
            m.plinthVoxels = 4
            m.sillColor = Raser.Palette.Metal
            m.balconyColor = Raser.HouseStyle.Of([Raser.Palette.ConcretePanel, Raser.Palette.MetalBlue, Raser.Palette.Plaster, Raser.Palette.PlasterOchre], fam, 6)
        }

        // Gewerbe: Hallen in Blech, Büros in Glas, Platten, Waschbeton oder Ziegel.
        static undefined WorkHouse(RoofModel m, defined int id, defined float area) {
            Building b = m.building
            float h = b.eaves - b.ground
            m.frameColor = Raser.Palette.Metal + 64
            m.sillColor = Raser.Palette.Metal
            m.plinthColor = Raser.Palette.Concrete
            m.plinthVoxels = 2
            if (area > 1200.0 && h < 12.0) {
                m.wallColor = Raser.HouseStyle.Of([Raser.Palette.MetalRibbed, Raser.Palette.MetalBlue, Raser.Palette.BrickBrown, Raser.Palette.ConcretePanel], id, 2)
                m.plinthVoxels = 5
            } else if (h >= 10.0) {
                m.wallColor = Raser.HouseStyle.Of([Raser.Palette.CurtainDark, Raser.Palette.ConcretePanel, Raser.Palette.WashedConcrete, Raser.Palette.Brick, Raser.Palette.PlasterSilver, Raser.Palette.BrickBrown], id, 2)
            } else {
                m.wallColor = Raser.HouseStyle.Of([Raser.Palette.PlasterGrey, Raser.Palette.PlasterSilver, Raser.Palette.Brick, Raser.Palette.BrickYellow, Raser.Palette.ConcretePanel, Raser.Palette.Plaster], id, 2)
            }
            m.roofColor = Raser.Palette.RoofAnthracite
        }

        // Öffentliche Bauten: groß und mit Steildach Werkstein oder Backstein (Rathaus), groß und flach die 70er (Glas, Waschbeton), klein Ziegel
        // oder Putz.
        static undefined CivicHouse(RoofModel m, defined int id, defined float area) {
            Building b = m.building
            float h = b.eaves - b.ground
            m.frameColor = Raser.Palette.Metal + 64
            m.plinthColor = Raser.Palette.StoneGrey
            m.plinthVoxels = 4
            m.sillColor = Raser.Palette.Sandstone
            if (area > 800.0 || h > 15.0) {
                if (m.pitched) {
                    m.wallColor = Raser.HouseStyle.Of([Raser.Palette.Sandstone, Raser.Palette.StoneGrey, Raser.Palette.BrickCross, Raser.Palette.Brick], id, 2)
                    m.trimColor = Raser.Palette.Sandstone
                    m.frameColor = Raser.Palette.Plaster
                } else {
                    m.wallColor = Raser.HouseStyle.Of([Raser.Palette.CurtainDark, Raser.Palette.WashedConcrete, Raser.Palette.ConcretePanel, Raser.Palette.CurtainDark, Raser.Palette.BrickBrown], id, 2)
                    m.plinthColor = Raser.Palette.Concrete
                }
            } else {
                m.wallColor = Raser.HouseStyle.Of([Raser.Palette.Brick, Raser.Palette.Plaster, Raser.Palette.PlasterCream, Raser.Palette.BrickYellow, Raser.Palette.PlasterSilver], id, 2)
            }
            m.roofColor = Raser.HouseStyle.Of([Raser.Palette.RoofSlate, Raser.Palette.RoofTiles, Raser.Palette.RoofDark], id, 3)
        }
    }
}
