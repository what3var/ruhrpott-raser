// Raser.World: Stadtmöbel und Vegetation als grobe 3D-Pixelgrafik (Konzept: "als hätte man sie in Minecraft gebaut") - kleine Voxel-Modelle,
// prozedural aus Art, Höhe und Variante. Gleiche Eingaben geben dasselbe Modell (deterministisch); der Voxelizer stempelt sie in die Chunks.
//
// Ein Modell ist ein Block von sx x sy x sz Voxeln; sein Fußpunkt ist die Säule (ox, oy) in Höhe 0 - der erste Voxel über dem Gelände.
#import "raser.core"

namespace Raser {
    class VoxelModel {
        defined int sx
        defined int sy
        defined int sz
        defined int ox
        defined int oy
        byte materials[]
        byte colors[]

        construct(defined int sx, defined int sy, defined int sz) {
            this.sx = sx
            this.sy = sy
            this.sz = sz
            this.ox = sx / 2
            this.oy = sy / 2
            this.materials = new byte[sx * sy * sz]
            this.colors = new byte[sx * sy * sz]
        }

        defined bool Inside(defined int x, defined int y, defined int z) { return x >= 0 && y >= 0 && z >= 0 && x < this.sx && y < this.sy && z < this.sz }

        // Setzt einen Voxel relativ zum Fußpunkt.
        undefined Set(defined int dx, defined int dy, defined int z, defined int material, defined int color) {
            int x = this.ox + dx
            int y = this.oy + dy
            if (!this.Inside(x, y, z)) { return }
            int i = x + y * this.sx + z * this.sx * this.sy
            this.materials[i] = material
            this.colors[i] = color
        }

        defined int MaterialAt(defined int x, defined int y, defined int z) { return this.materials[x + y * this.sx + z * this.sx * this.sy] }
        defined int ColorAt(defined int x, defined int y, defined int z) { return this.colors[x + y * this.sx + z * this.sx * this.sy] }

        // Eine Vierteldrehung (gegen den Uhrzeigersinn um den Fußpunkt) quarters Mal; ohne Drehung das Modell selbst.
        VoxelModel Turned(defined int quarters) {
            int q = ((quarters % 4) + 4) % 4
            if (q == 0) { return this }
            var cur = this.TurnedOnce()
            for (int k = 1; k < q; k++) { cur = cur.TurnedOnce() }
            return cur
        }

        // (x, y) -> (sy - 1 - y, x)
        VoxelModel TurnedOnce() {
            var r = new Raser.VoxelModel(this.sy, this.sx, this.sz)
            r.ox = this.sy - 1 - this.oy
            r.oy = this.ox
            for (int z = 0; z < this.sz; z++) {
                for (int y = 0; y < this.sy; y++) {
                    for (int x = 0; x < this.sx; x++) {
                        int mat = this.MaterialAt(x, y, z)
                        if (mat == 0) { continue }
                        int i = (this.sy - 1 - y) + x * r.sx + z * r.sx * r.sy
                        r.materials[i] = mat
                        r.colors[i] = this.ColorAt(x, y, z)
                    }
                }
            }
            return r
        }
    }

    class Props {
        static readonly defined float TreePit = 0.7       // halbe Kantenlänge der Baumscheibe (m): grün um den Stamm, mindestens 30 cm neben dem dicksten Stamm

        // Fährt eine Straße für Autos hier? (keine Fuß- und Radwege, Bahnen, Brücken)
        static defined bool IsCarRoad(Road r) {
            if (r.kind == undefined || r.layer != 0 || !r.kind.StartsWith("highway=")) { return false }
            string k = r.kind.Substring(8)
            return !(k == "footway" || k == "path" || k == "cycleway" || k == "steps" || k == "pedestrian" || k == "track" || k == "bridleway" || k == "corridor" || k == "platform")
        }

        // Nach dem Laden einer Kachel: jeder Baum steht in seiner Baumscheibe, und die reicht nicht in die Fahrbahn - zu nahe Bäume rücken von der
        // Straße weg (nicht in ein Gebäude; dann bleiben sie). Wiederholt anwendbar (ein gerückter Baum steht schon richtig).
        static undefined Settle(Tile tile) {
            if (tile == undefined || tile.data == undefined || tile.data.props == undefined || tile.data.roads == undefined) { return }
            foreach (p in tile.data.props) {
                if (p.kind != "tree") { continue }
                if (p.source != undefined && p.source.StartsWith("green:")) { continue }        // im Grün gepflanzt (Raser.Greens): frei von Wegen
                float x = p.x
                float y = p.y
                for (int round = 0; round < 3; round++) {
                    bool moved = false
                    foreach (r in tile.data.roads) {
                        if (!Raser.Props.IsCarRoad(r)) { continue }
                        float need = r.width / 2.0 + Raser.Props.TreePit + 0.1
                        // der nächste Punkt der Mittellinie
                        float best = 1.0e30
                        float qx = 0.0
                        float qy = 0.0
                        float nx = 0.0
                        float ny = 0.0
                        for (int k = 0; k + 3 < r.points.length; k = k + 2) {
                            float ax = r.points[k]
                            float ay = r.points[k + 1]
                            float ex = r.points[k + 2] - ax
                            float ey = r.points[k + 3] - ay
                            float len2 = ex * ex + ey * ey
                            if (len2 <= 0.0) { continue }
                            float t = Math.Clamp(((x - ax) * ex + (y - ay) * ey) / len2, 0.0, 1.0)
                            float cx = ax + ex * t
                            float cy = ay + ey * t
                            float d2 = (x - cx) * (x - cx) + (y - cy) * (y - cy)
                            if (d2 < best) {
                                best = d2
                                qx = cx
                                qy = cy
                                float len = Math.Sqrt(len2)
                                nx = ey / len
                                ny = -ex / len
                            }
                        }
                        if (best > need * need) { continue }
                        float d = Math.Sqrt(best)
                        // weg von der Mittellinie (genau darauf: nach rechts)
                        float dx = nx
                        float dy = ny
                        if (d > 0.01) {
                            dx = (x - qx) / d
                            dy = (y - qy) / d
                        }
                        x = qx + dx * need
                        y = qy + dy * need
                        moved = true
                    }
                    if (!moved) { break }
                }
                if (x == p.x && y == p.y) { continue }
                bool blocked = false
                foreach (b in tile.data.buildings) {
                    if (b.footprint != undefined && Raser.Geo.Inside(b.footprint, x, y)) {
                        blocked = true
                        break
                    }
                }
                if (blocked) { continue }
                p.x = x
                p.y = y
            }
        }

        // Stadtmöbel, Spielgeräte und Pflanzen im öffentlichen Raum sind keine Voxel mehr, sondern Modelle im Netz der nahen Stufe
        // (Raser.PropMesher in Raser.Mesh): in jedem Winkel gedreht, wenige Flächen. Voxel bleiben nur Sandkasten, Laube, Grab - und alles in
        // Kleingärten (Grundstücke: dort bleibt es im Raster, wie gewünscht).
        static defined bool AsModel(string kind, string source) {
            if (kind == undefined) { return false }
            if (source != undefined && source.Contains("landuse=allotments")) { return false }
            return kind == "tree" || kind == "bush" || kind == "fern" || kind == "reed" || kind == "hedge" || kind == "lamp" || kind == "bench" || kind == "bin" || kind == "sign" || kind == "signal" || kind == "swing" || kind == "slide" || kind == "climber" || kind == "goal" || kind == "hoop"
        }

        // Der Kopf einer Laterne (Raser.PropMesher): so weit vor dem Mast (m, in Richtung angle) und so hoch über dem Fuß.
        static readonly defined float LampReach = 1.1
        static readonly defined float LampHead = 4.85

        // Ist der Baum ein Nadelbaum mit Kegel (Fichte, OSM needleleaved)?
        static defined bool Conical(string detail) { return detail == "needleleaved" || detail == "fichte" }

        // Die Höhe eines Baums (m): aus den Daten, sonst aus der ID (Laubbaum 8 .. 16 m, Nadelbaum 10 .. 20 m) - nah und fern dieselbe.
        static defined float TreeHeight(Prop p) {
            if (p.height > 0.0) { return Math.Clamp(p.height, 3.0, 35.0) }
            if (Raser.Props.Conical(p.detail)) { return 10.0 + Raser.Props.Rand(p.id, 1, 0) * 10.0 }
            return 8.0 + Raser.Props.Rand(p.id, 1, 0) * 8.0
        }

        // Nach dem Laden: Verkehrszeichen zeigen zum Verkehr, der auf sie zufährt (Rechtsverkehr: rechts der Fahrtrichtung, die Vorderseite
        // gegen sie), Bäume stehen in einer Drehung aus ihrer ID (die Modelle sind nicht rund). Wiederholt anwendbar.
        static undefined Face(Tile tile) {
            if (tile == undefined || tile.data == undefined || tile.data.props == undefined || tile.data.roads == undefined) { return }
            foreach (p in tile.data.props) {
                if (p.kind == "tree" || p.kind == "bush" || p.kind == "fern" || p.kind == "reed") {
                    if (p.angle == 0.0) { p.angle = Raser.Props.Rand(p.id, 7, 0) * 360.0 }
                    continue
                }
                if (p.kind != "sign") { continue }
                float best = 1.0e30
                float dx = 1.0
                float dy = 0.0
                float side = 0.0
                foreach (r in tile.data.roads) {
                    if (!Raser.Props.IsCarRoad(r)) { continue }
                    for (int k = 0; k + 3 < r.points.length; k = k + 2) {
                        float ax = r.points[k]
                        float ay = r.points[k + 1]
                        float ex = r.points[k + 2] - ax
                        float ey = r.points[k + 3] - ay
                        float len2 = ex * ex + ey * ey
                        if (len2 <= 0.0) { continue }
                        float t = Math.Clamp(((p.x - ax) * ex + (p.y - ay) * ey) / len2, 0.0, 1.0)
                        float cx = ax + ex * t
                        float cy = ay + ey * t
                        float d2 = (p.x - cx) * (p.x - cx) + (p.y - cy) * (p.y - cy)
                        if (d2 < best) {
                            best = d2
                            float len = Math.Sqrt(len2)
                            dx = ex / len
                            dy = ey / len
                            side = ex * (p.y - ay) - ey * (p.x - ax)
                        }
                    }
                }
                if (best > 900.0) { continue }
                // rechts der Linie (side < 0): der Verkehr fährt in Linienrichtung auf das Schild zu - es zeigt ihm entgegen
                if (side < 0.0) { p.angle = Math.Atan2(-dy, -dx) * 180.0 / Math.PI } else { p.angle = Math.Atan2(dy, dx) * 180.0 / Math.PI }
            }
        }

        // Ein Wert in [0, 1) aus Variante und Zahlen.
        static defined float Rand(defined int seed, defined int a, defined int b) {
            int h = Raser.Fnv.AddInt(Raser.Fnv.AddInt(Raser.Fnv.AddInt(Raser.Fnv.Start(), seed), a), b)
            return ((h >> 20) & 65535) / 65536.0
        }

        // Das Modell eines Props: Art, Höhe (m, 0: Standard), Variante (aus der ID), Richtung (Grad), Detail.
        static VoxelModel Make(string kind, defined float height, defined int variant, defined float angle, string detail) {
            int quarters = Math.Round(angle / 90.0)!int
            if (kind == "tree") {
                if (detail == "needleleaved" || detail == "fichte") { return Raser.Props.Conifer(height, variant) }
                return Raser.Props.Tree(height, variant, detail)
            }
            // Grün und Spiel (Raser.Greens)
            if (kind == "fern") { return Raser.Props.Fern(variant) }
            if (kind == "reed") { return Raser.Props.Reed(variant) }
            if (kind == "hedge") { return Raser.Props.Hedge(variant).Turned(quarters) }
            if (kind == "sandbox") { return Raser.Props.Sandbox() }
            if (kind == "swing") { return Raser.Props.Swing().Turned(quarters) }
            if (kind == "slide") { return Raser.Props.Slide().Turned(quarters) }
            if (kind == "climber") { return Raser.Props.Climber() }
            if (kind == "goal") { return Raser.Props.Goal().Turned(quarters) }
            if (kind == "hoop") { return Raser.Props.Hoop().Turned(quarters) }
            if (kind == "shed") { return Raser.Props.Shed(variant).Turned(quarters) }
            if (kind == "grave") { return Raser.Props.Grave(variant) }
            if (kind == "lamp") { return Raser.Props.Lamp().Turned(quarters) }
            if (kind == "bush") { return Raser.Props.Bush(variant, detail == "flowers") }
            if (kind == "bench") { return Raser.Props.Bench().Turned(quarters) }
            if (kind == "bin") { return Raser.Props.Bin() }
            if (kind == "sign") { return Raser.Props.Sign(detail).Turned(quarters) }
            if (kind == "signal") { return Raser.Props.Signal().Turned(quarters) }
            return undefined
        }

        // Ein niedriger Strauch im Beet (0,4 .. 0,6 m): ein löchriger Hügel aus Blättern, bei manchen ein paar Blüten (rosa, gelb oder weiß).
        static VoxelModel Bush(defined int v, defined bool flowers = false) {
            int r = 2 + Math.Floor(Raser.Props.Rand(v, 40, 0) * 2.0)!int          // Radius 2 .. 3 Voxel
            int h = 2 + Math.Floor(Raser.Props.Rand(v, 41, 0) * 2.0)!int          // Höhe 2 .. 3 Voxel
            int size = r * 2 + 1
            var m = new Raser.VoxelModel(size, size, h + 1)
            int flower = 0
            float pick = Raser.Props.Rand(v, 42, 0)
            if (pick < 0.3) { flower = Raser.Palette.FlowerPink } else if (pick < 0.45) { flower = Raser.Palette.FlowerYellow } else if (pick < 0.6) { flower = Raser.Palette.FlowerWhite }
            // ein Blumenbeet: immer Blüten, mehr davon
            float bloom = 0.18
            if (flowers) {
                int fl[] = [Raser.Palette.FlowerPink, Raser.Palette.FlowerYellow, Raser.Palette.FlowerWhite, Raser.Palette.SignRed, Raser.Palette.FlowerPink, Raser.Palette.SignBlue]
                flower = fl[((v % 6) + 6) % 6]
                bloom = 0.5
            }
            int leaves = Raser.Material.Leaves!int
            for (int z = 0; z < h; z++) {
                for (int y = 0; y < size; y++) {
                    for (int x = 0; x < size; x++) {
                        float dx = (x - r) * 1.0
                        float dy = (y - r) * 1.0
                        float dz = z * 1.0
                        float d = Math.Sqrt(dx * dx + dy * dy) / (r + 0.5) + dz / (h + 0.5)
                        if (d > 1.0 || Raser.Props.Rand(v, 43 + z, x * 31 + y) < 0.2) { continue }
                        int color = Raser.Palette.LeavesDark
                        if (z == h - 1 || Raser.Props.Rand(v, 50 + z, x * 31 + y) < 0.35) { color = Raser.Palette.Leaves }
                        if (flower != 0 && z >= h - 2 && Raser.Props.Rand(v, 60 + z, x * 31 + y) < bloom) { color = flower }
                        m.Set(x - r, y - r, z, leaves, color)
                    }
                }
            }
            return m
        }

        // Ein Laubbaum: Stamm, schräg aufsteigende Äste, an ihren Enden und oben löchrige Blattbüschel (oben heller, unten dunkler).
        // species (Raser.Greens): buche (dichte, tief ansetzende Krone), eiche (breit, knorrig, dunkel), birke (schlank, weißer Stamm, hell),
        // ahorn (rund), kiefer (hoher rötlicher Stamm, flache Krone oben); sonst ein Laubbaum wie bisher.
        static VoxelModel Tree(defined float height, defined int v, string species = undefined) {
            float h = height
            if (h <= 0.0) { h = 8.0 + Raser.Props.Rand(v, 1, 0) * 8.0 }
            h = Math.Clamp(h, 4.0, 30.0)
            int hv = Math.Round(h / 0.2)!int
            if (species == "kiefer") { return Raser.Props.Pine(hv, v) }
            float crownF = 0.32
            float trunkF = 0.55
            int bark = Raser.Palette.Bark
            int tone = 0
            if (species == "buche") {
                crownF = 0.3
                trunkF = 0.45
            } else if (species == "eiche") {
                crownF = 0.38
                trunkF = 0.42
                tone = 2
            } else if (species == "birke") {
                crownF = 0.2
                trunkF = 0.5
                bark = Raser.Palette.Plaster
                tone = 1
            }
            int crown = Math.Round(hv * crownF)!int                 // Radius der Krone (Voxel)
            int size = crown * 2 + 9
            // hoch genug für die Krone: der Stamm bis höchstens 0,7 hv, darüber die Krone (Mitte 0,55 crown, Halbachse 0,7 crown, ausgefranst) - dazu Rand
            var m = new Raser.VoxelModel(size, size, hv + crown + 8)
            int wood = Raser.Material.Wood!int
            int thick = 1
            if (h > 9.0 && species != "birke") { thick = 2 }
            int trunkTop = Math.Round(hv * (trunkF + Raser.Props.Rand(v, 2, 0) * 0.15))!int
            for (int z = 0; z < trunkTop; z++) {
                for (int a = 0; a < thick; a++) {
                    for (int b = 0; b < thick; b++) {
                        int bc = bark
                        // die Birke: dunkle Querstreifen im weißen Stamm
                        if (species == "birke" && Raser.Props.Rand(v, z, 5) < 0.2) { bc = Raser.Palette.Metal + 96 }
                        m.Set(a, b, z, wood, bc)
                    }
                }
            }
            // Äste
            int branches = 3 + Math.Floor(Raser.Props.Rand(v, 3, 0) * 4.0)!int
            for (int k = 0; k < branches; k++) {
                float dir = Raser.Props.Rand(v, 10, k) * 6.2832
                float start = hv * (0.35 + Raser.Props.Rand(v, 11, k) * 0.3)
                float len = crown * (0.45 + Raser.Props.Rand(v, 12, k) * 0.4)
                float rise = 0.5 + Raser.Props.Rand(v, 13, k) * 0.8
                float ex = 0.0
                float ey = 0.0
                float ez = start
                int steps = Math.Max(1, Math.Round(len)!int)
                for (int t = 0; t <= steps; t++) {
                    ex = Math.Cos(dir) * t
                    ey = Math.Sin(dir) * t
                    ez = start + rise * t
                    m.Set(Math.Round(ex)!int, Math.Round(ey)!int, Math.Round(ez)!int, wood, bark)
                }
                float r = crown * (0.45 + Raser.Props.Rand(v, 14, k) * 0.25)
                Raser.Props.Blob(m, ex, ey, ez + r * 0.3, r, r * 0.75, v * 31 + k, hv, tone)
            }
            // die Krone oben
            Raser.Props.Blob(m, 0.0, 0.0, trunkTop + crown * 0.55, crown * 0.8, crown * 0.7, v * 31 + 99, hv, tone)
            return m
        }

        // Ein Blattbüschel: ein Ellipsoid mit Löchern und ausgefranstem Rand; die Farbe nach Höhe und Zufall.
        // tone: 0 gemischt, 1 hell (Birke), 2 dunkel (Eiche, Kiefer).
        static undefined Blob(VoxelModel m, defined float cx, defined float cy, defined float cz, defined float r, defined float rz, defined int seed, defined int top, defined int tone = 0) {
            int ri = Math.Ceiling(r)!int + 1
            int rzi = Math.Ceiling(rz)!int + 1
            int leaves = Raser.Material.Leaves!int
            for (int dz = -rzi; dz <= rzi; dz++) {
                for (int dy = -ri; dy <= ri; dy++) {
                    for (int dx = -ri; dx <= ri; dx++) {
                        float d = (dx * dx + dy * dy) / (r * r) + (dz * dz) / (rz * rz)
                        float n = Raser.Props.Rand(seed, dx * 977 + dy, dz)
                        if (d > 1.0 - n * 0.35) { continue }              // ausgefranst
                        if (d > 0.35 && n < 0.18) { continue }            // Löcher (innen dicht, der Stamm verschwindet nicht)
                        int x = Math.Round(cx)!int + dx
                        int y = Math.Round(cy)!int + dy
                        int z = Math.Round(cz)!int + dz
                        int color = Raser.Palette.Leaves
                        float up = z * 1.0 / top
                        float pick = Raser.Props.Rand(seed + 7, x * 131 + y, z)
                        float dark = 0.25 - up * 0.2
                        float light = 0.85 - up * 0.3
                        if (tone == 1) {
                            dark = 0.05
                            light = 0.45
                        } else if (tone == 2) {
                            dark = 0.55
                            light = 0.97
                        }
                        if (pick < dark) { color = Raser.Palette.LeavesDark } else if (pick > light) { color = Raser.Palette.LeavesLight }
                        m.Set(x, y, z, leaves, color)
                    }
                }
            }
        }

        // Ein Nadelbaum: ein Kegel aus Ringen, unten breit, dunkel.
        static VoxelModel Conifer(defined float height, defined int v) {
            float h = height
            if (h <= 0.0) { h = 10.0 + Raser.Props.Rand(v, 1, 0) * 10.0 }
            h = Math.Clamp(h, 4.0, 35.0)
            int hv = Math.Round(h / 0.2)!int
            int radius = Math.Round(hv * 0.2)!int
            var m = new Raser.VoxelModel(radius * 2 + 5, radius * 2 + 5, hv + 2)
            int start = Math.Round(hv * 0.15)!int
            for (int z = 0; z < hv; z++) { m.Set(0, 0, z, Raser.Material.Wood!int, Raser.Palette.Bark) }
            for (int z = start; z <= hv; z++) {
                float t = (z - start) * 1.0 / (hv - start)
                // Stufen: alle paar Voxel wieder breiter (Etagen der Äste)
                float r = radius * (1.0 - t) * (0.75 + 0.25 * ((z - start) % 4) / 3.0) + 0.6
                int ri = Math.Ceiling(r)!int
                for (int dy = -ri; dy <= ri; dy++) {
                    for (int dx = -ri; dx <= ri; dx++) {
                        float d = Math.Sqrt(dx * dx + dy * dy * 1.0)
                        float n = Raser.Props.Rand(v, dx * 977 + dy, z)
                        if (d > r - n * 0.8) { continue }
                        int color = Raser.Palette.LeavesDark
                        if (n > 0.8) { color = Raser.Palette.Leaves }
                        m.Set(dx, dy, z, Raser.Material.Leaves!int, color)
                    }
                }
            }
            return m
        }

        // Kiefer: hoher, rötlicher Stamm (bis 70 %), oben eine flache, dunkle Krone aus zwei, drei Schirmen.
        static VoxelModel Pine(defined int hv, defined int v) {
            int crown = Math.Round(hv * 0.2)!int
            int size = crown * 2 + 7
            var m = new Raser.VoxelModel(size, size, hv + 6)
            int top = Math.Round(hv * 0.72)!int
            for (int z = 0; z < top; z++) { m.Set(0, 0, z, Raser.Material.Wood!int, Raser.Palette.BrickLight + 32) }
            for (int k = 0; k < 3; k++) {
                float dir = Raser.Props.Rand(v, 70, k) * 6.2832
                float off = crown * 0.35 * k / 2.0
                float cz = top + 1.0 + k * 3.0 + Raser.Props.Rand(v, 71, k) * 2.0
                float cx = Math.Cos(dir) * off
                float cy = Math.Sin(dir) * off
                for (int t = 0; t <= Math.Round(off)!int; t++) { m.Set(Math.Round(Math.Cos(dir) * t)!int, Math.Round(Math.Sin(dir) * t)!int, Math.Round(cz)!int - 1, Raser.Material.Wood!int, Raser.Palette.Bark) }
                Raser.Props.Blob(m, cx, cy, cz, crown * (0.75 - k * 0.15), crown * 0.28, v * 37 + k, hv, 2)
            }
            return m
        }

        // Farn: ein paar Wedel flach über dem Boden (40 cm).
        static VoxelModel Fern(defined int v) {
            var m = new Raser.VoxelModel(7, 7, 3)
            int leaves = Raser.Material.Leaves!int
            for (int k = 0; k < 5; k++) {
                float dir = k * 1.2566 + Raser.Props.Rand(v, 80, 0)
                for (int t = 0; t <= 3; t++) {
                    int z = 0
                    if (t >= 1 && t <= 2) { z = 1 }
                    int c = Raser.Palette.LeavesLight
                    if (t == 3) { c = Raser.Palette.Leaves }
                    m.Set(Math.Round(Math.Cos(dir) * t)!int, Math.Round(Math.Sin(dir) * t)!int, z, leaves, c)
                }
            }
            m.Set(0, 0, 0, leaves, Raser.Palette.Leaves)
            return m
        }

        // Schilf: dünne Halme (bis 1,6 m), oben bräunlich.
        static VoxelModel Reed(defined int v) {
            var m = new Raser.VoxelModel(5, 5, 9)
            int leaves = Raser.Material.Leaves!int
            for (int k = 0; k < 6; k++) {
                int dx = Math.Floor(Raser.Props.Rand(v, 90, k) * 5.0)!int - 2
                int dy = Math.Floor(Raser.Props.Rand(v, 91, k) * 5.0)!int - 2
                int h = 5 + Math.Floor(Raser.Props.Rand(v, 92, k) * 4.0)!int
                for (int z = 0; z < h; z++) {
                    int c = Raser.Palette.LeavesLight
                    if (z >= h - 1) { c = Raser.Palette.Field }
                    m.Set(dx, dy, z, leaves, c)
                }
            }
            return m
        }

        // Hecke: ein Stück von 2 m (entlang x), 80 cm breit, 1,2 m hoch, dicht geschnitten.
        static VoxelModel Hedge(defined int v) {
            var m = new Raser.VoxelModel(11, 4, 6)
            m.ox = 5
            m.oy = 2
            int leaves = Raser.Material.Leaves!int
            for (int z = 0; z < 6; z++) {
                for (int y = -2; y <= 1; y++) {
                    for (int x = -5; x <= 5; x++) {
                        int c = Raser.Palette.LeavesDark
                        float r = Raser.Props.Rand(v, x * 31 + y, z)
                        if (r > 0.75 || z == 5) { c = Raser.Palette.Leaves }
                        if (z == 5 && r < 0.15) { continue }
                        m.Set(x, y, z, leaves, c)
                    }
                }
            }
            return m
        }

        // Sandkasten: Holzrand 3 x 3 m (30 cm hoch), innen Sand.
        static VoxelModel Sandbox() {
            var m = new Raser.VoxelModel(15, 15, 2)
            int wood = Raser.Material.Wood!int
            for (int y = -7; y <= 7; y++) {
                for (int x = -7; x <= 7; x++) {
                    bool rim = x == -7 || x == 7 || y == -7 || y == 7
                    if (rim) {
                        m.Set(x, y, 0, wood, Raser.Palette.Wood)
                        m.Set(x, y, 1, wood, Raser.Palette.Wood)
                    } else { m.Set(x, y, 0, Raser.Material.Sand!int, Raser.Palette.Sand) }
                }
            }
            return m
        }

        // Schaukel: zwei A-Gestelle (2,4 m) mit Querbalken (3 m entlang x), zwei Sitze an Ketten.
        static VoxelModel Swing() {
            var m = new Raser.VoxelModel(17, 9, 13)
            m.ox = 8
            m.oy = 4
            int metal = Raser.Material.Metal!int
            foreach (x in [-8, 8]) {
                for (int z = 0; z < 12; z++) {
                    int spread = Math.Max(0, (11 - z) / 3)
                    m.Set(x, -spread, z, metal, Raser.Palette.SignRed)
                    m.Set(x, spread, z, metal, Raser.Palette.SignRed)
                }
            }
            for (int x = -8; x <= 8; x++) { m.Set(x, 0, 12, metal, Raser.Palette.SignRed) }
            foreach (sx in [-4, 4]) {
                for (int z = 3; z < 12; z++) {
                    m.Set(sx - 1, 0, z, metal, Raser.Palette.Metal)
                    m.Set(sx + 1, 0, z, metal, Raser.Palette.Metal)
                }
                for (int x = sx - 1; x <= sx + 1; x++) { m.Set(x, 0, 2, Raser.Material.Wood!int, Raser.Palette.SignBlue) }
            }
            return m
        }

        // Rutsche: Leiter hinten, Plattform (1,4 m), die Bahn nach vorn (+x) bis zum Boden.
        static VoxelModel Slide() {
            var m = new Raser.VoxelModel(18, 5, 9)
            m.ox = 3
            m.oy = 2
            int metal = Raser.Material.Metal!int
            for (int z = 0; z < 8; z++) {
                m.Set(-3, -2, z, metal, Raser.Palette.SignYellow)
                m.Set(-3, 2, z, metal, Raser.Palette.SignYellow)
                if (z % 2 == 1) {
                    for (int y = -1; y <= 1; y++) { m.Set(-3, y, z, metal, Raser.Palette.Metal) }
                }
            }
            for (int y = -2; y <= 2; y++) {
                for (int x = -3; x <= 0; x++) { m.Set(x, y, 7, Raser.Material.Wood!int, Raser.Palette.Wood) }
            }
            for (int x = 1; x <= 14; x++) {
                int z = 7 - Math.Round((x - 1) * 7.0 / 13.0)!int
                for (int y = -1; y <= 1; y++) { m.Set(x, y, z, metal, Raser.Palette.SignBlue) }
                m.Set(x, -2, z + 1, metal, Raser.Palette.SignBlue)
                m.Set(x, 2, z + 1, metal, Raser.Palette.SignBlue)
            }
            return m
        }

        // Klettergerüst: ein Würfel aus Stangen (2 m), Sprossen alle 40 cm.
        static VoxelModel Climber() {
            var m = new Raser.VoxelModel(11, 11, 11)
            int metal = Raser.Material.Metal!int
            for (int z = 0; z <= 10; z++) {
                for (int y = -5; y <= 5; y++) {
                    for (int x = -5; x <= 5; x++) {
                        bool edgeX = x == -5 || x == 5
                        bool edgeY = y == -5 || y == 5
                        bool post = edgeX && edgeY
                        bool rung = z % 2 == 0 && z > 0 && (edgeX || edgeY) && (x % 5 == 0 || y % 5 == 0)
                        bool top = z == 10 && (edgeX || edgeY || x == 0 || y == 0)
                        if (post || rung || top) {
                            int c = Raser.Palette.SignGreen
                            if (z == 10) { c = Raser.Palette.SignYellow }
                            m.Set(x, y, z, metal, c)
                        }
                    }
                }
            }
            return m
        }

        // Fußballtor: 5 m breit (entlang y), 2 m hoch, weiß, das Netz nach hinten (-x) angedeutet.
        static VoxelModel Goal() {
            var m = new Raser.VoxelModel(6, 27, 11)
            m.ox = 5
            m.oy = 13
            int metal = Raser.Material.Metal!int
            for (int z = 0; z <= 10; z++) {
                m.Set(0, -13, z, metal, Raser.Palette.SignWhite)
                m.Set(0, 13, z, metal, Raser.Palette.SignWhite)
            }
            for (int y = -13; y <= 13; y++) {
                m.Set(0, y, 10, metal, Raser.Palette.SignWhite)
                if (y % 3 == 0) {
                    for (int x = -5; x <= -1; x++) { m.Set(x, y, Math.Round(10.0 + x * 1.6)!int, metal, Raser.Palette.Metal) }
                }
            }
            for (int x = -5; x <= 0; x++) {
                m.Set(x, -13, 0, metal, Raser.Palette.SignWhite)
                m.Set(x, 13, 0, metal, Raser.Palette.SignWhite)
            }
            return m
        }

        // Basketballkorb: Mast (3 m), Brett und Ring nach vorn (+x).
        static VoxelModel Hoop() {
            var m = new Raser.VoxelModel(8, 7, 18)
            m.ox = 1
            m.oy = 3
            int metal = Raser.Material.Metal!int
            for (int z = 0; z < 17; z++) { m.Set(0, 0, z, metal, Raser.Palette.Metal + 64) }
            for (int z = 12; z <= 17; z++) {
                for (int y = -3; y <= 3; y++) { m.Set(2, y, z, metal, Raser.Palette.SignWhite) }
            }
            for (int y = -1; y <= 1; y++) {
                m.Set(3, y, 13, metal, Raser.Palette.SignRed)
                m.Set(5, y, 13, metal, Raser.Palette.SignRed)
            }
            m.Set(4, -1, 13, metal, Raser.Palette.SignRed)
            m.Set(4, 1, 13, metal, Raser.Palette.SignRed)
            m.Set(1, 0, 15, metal, Raser.Palette.Metal + 64)
            return m
        }

        // Gartenlaube: 2,4 x 2 m aus Holz (grün, braun oder rot gestrichen), Satteldach, Tür vorn.
        static VoxelModel Shed(defined int v) {
            var m = new Raser.VoxelModel(13, 11, 14)
            int wood = Raser.Material.Wood!int
            int colors[] = [Raser.Palette.Wood, Raser.Palette.DoorGreen, Raser.Palette.Wood + 32, Raser.Palette.DoorRed, Raser.Palette.Wood, Raser.Palette.DoorBlue]
            int c = colors[((v % 6) + 6) % 6]
            for (int z = 0; z < 10; z++) {
                for (int y = -5; y <= 5; y++) {
                    for (int x = -6; x <= 6; x++) {
                        bool wall = x == -6 || x == 6 || y == -5 || y == 5
                        if (!wall) { continue }
                        int col = c
                        if (x == 6 && y >= -1 && y <= 1 && z < 9) { col = Raser.Palette.Wood + 64 }      // die Tür
                        if (y == -5 && x >= -2 && x <= 2 && z >= 4 && z <= 6) { col = Raser.Palette.Glass }
                        m.Set(x, y, z, wood, col)
                    }
                }
            }
            for (int k = 0; k <= 5; k++) {
                for (int x = -7; x <= 7; x++) {
                    m.Set(x, -6 + k, 10 + k / 2, Raser.Material.RoofTiles!int, Raser.Palette.RoofDark)
                    m.Set(x, 6 - k, 10 + k / 2, Raser.Material.RoofTiles!int, Raser.Palette.RoofDark)
                }
            }
            return m
        }

        // Grab: Stein (60 x 20 cm, 80 cm hoch; grau, Sandstein oder dunkel) am Kopfende, davor das bepflanzte Beet.
        static VoxelModel Grave(defined int v) {
            var m = new Raser.VoxelModel(5, 10, 5)
            m.ox = 2
            m.oy = 8
            int stones[] = [Raser.Palette.StoneGrey, Raser.Palette.Sandstone, Raser.Palette.Metal + 96, Raser.Palette.StoneGrey]
            int stone = stones[((v % 4) + 4) % 4]
            for (int z = 0; z < 4; z++) {
                for (int x = -1; x <= 1; x++) { m.Set(x, 1, z, Raser.Material.Rock!int, stone) }
            }
            m.Set(0, 1, 4, Raser.Material.Rock!int, stone)
            for (int y = -7; y <= 0; y++) {
                for (int x = -2; x <= 2; x++) {
                    bool rim = x == -2 || x == 2 || y == -7
                    if (rim) { m.Set(x, y, 0, Raser.Material.Rock!int, Raser.Palette.Concrete) } else { m.Set(x, y, 0, Raser.Material.Leaves!int, Raser.Palette.LeavesDark) }
                    if (!rim && Raser.Props.Rand(v, x, y) < 0.25) { m.Set(x, y, 1, Raser.Material.Leaves!int, Raser.Palette.FlowerPink) }
                }
            }
            return m
        }

        // Eine Laterne: Mast (5 m), oben ein Ausleger nach vorn (+x), daran die Leuchte.
        static VoxelModel Lamp() {
            var m = new Raser.VoxelModel(9, 3, 27)
            int metal = Raser.Material.Metal!int
            for (int z = 0; z < 25; z++) { m.Set(0, 0, z, metal, Raser.Palette.Metal) }
            for (int x = 1; x <= 3; x++) { m.Set(x, 0, 25, metal, Raser.Palette.Metal) }
            m.Set(3, 0, 24, Raser.Material.Glass!int, Raser.Palette.Lamp)
            m.Set(4, 0, 24, Raser.Material.Glass!int, Raser.Palette.Lamp)
            m.Set(4, 0, 25, metal, Raser.Palette.Metal)
            return m
        }

        // Eine Bank: 1,8 m lang (entlang y), Sitz aus Holz in 40 cm Höhe, Lehne hinten (-x), Füße aus Metall; die Vorderseite zeigt nach +x.
        static VoxelModel Bench() {
            var m = new Raser.VoxelModel(3, 9, 5)
            m.ox = 1
            m.oy = 4
            int wood = Raser.Material.Wood!int
            int metal = Raser.Material.Metal!int
            for (int y = -4; y <= 4; y++) {
                m.Set(0, y, 2, wood, Raser.Palette.Wood)
                m.Set(-1, y, 2, wood, Raser.Palette.Wood)
                m.Set(-1, y, 3, wood, Raser.Palette.Wood)
                m.Set(-1, y, 4, wood, Raser.Palette.Wood)
            }
            foreach (y in [-4, 4]) {
                m.Set(0, y, 0, metal, Raser.Palette.Metal)
                m.Set(0, y, 1, metal, Raser.Palette.Metal)
                m.Set(-1, y, 0, metal, Raser.Palette.Metal)
                m.Set(-1, y, 1, metal, Raser.Palette.Metal)
            }
            return m
        }

        // Ein Papierkorb: 20 x 20 cm, 80 cm hoch, oben offen (dunkel).
        static VoxelModel Bin() {
            var m = new Raser.VoxelModel(1, 1, 4)
            for (int z = 0; z < 4; z++) { m.Set(0, 0, z, Raser.Material.Metal!int, Raser.Palette.Metal) }
            m.Set(0, 0, 3, Raser.Material.Metal!int, Raser.Palette.Asphalt)
            return m
        }

        // Ein Verkehrszeichen: Mast 2,2 m, oben ein Schild 3 x 3 Voxel (60 cm) als Pixelbild, die Vorderseite nach +x.
        // detail: OSM traffic_sign ("DE:206" Stop, "DE:205" Vorfahrt achten, "DE:274..." Tempo, "DE:306" Vorfahrtstraße), sonst ein blaues Hinweisschild.
        static VoxelModel Sign(string detail) {
            var m = new Raser.VoxelModel(2, 3, 14)
            m.ox = 0
            m.oy = 1
            int metal = Raser.Material.Metal!int
            for (int z = 0; z < 11; z++) { m.Set(0, 0, z, metal, Raser.Palette.Metal) }
            // Pixel: Rand und Mitte
            int edge = Raser.Palette.SignBlue
            int center = Raser.Palette.SignBlue
            int corner = Raser.Palette.SignBlue
            string d = ""
            if (detail != undefined) { d = detail }
            if (d.Contains("206")) {
                edge = Raser.Palette.SignRed
                center = Raser.Palette.SignWhite
                corner = Raser.Palette.SignRed
            } else if (d.Contains("205")) {
                edge = Raser.Palette.SignRed
                center = Raser.Palette.SignWhite
                corner = 0
            } else if (d.Contains("274") || d.Contains("250") || d.Contains("267")) {
                edge = Raser.Palette.SignRed
                center = Raser.Palette.SignWhite
                corner = 0
            } else if (d.Contains("306")) {
                edge = Raser.Palette.SignWhite
                center = Raser.Palette.SignYellow
                corner = 0
            } else if (d.Contains("350") || d.Contains("314")) {
                edge = Raser.Palette.SignBlue
                center = Raser.Palette.SignWhite
                corner = Raser.Palette.SignBlue
            }
            for (int dz = 0; dz < 3; dz++) {
                for (int dy = -1; dy <= 1; dy++) {
                    int c = edge
                    if (dz == 1 && dy == 0) { c = center }
                    if (dz != 1 && dy != 0) { c = corner }
                    if (c == 0) { continue }
                    m.Set(1, dy, 11 + dz, Raser.Material.Metal!int, c)
                }
            }
            return m
        }

        // Eine Ampel: Mast 3 m, oben ein dunkler Kasten mit Rot, Gelb, Grün nach vorn (+x).
        static VoxelModel Signal() {
            var m = new Raser.VoxelModel(2, 1, 18)
            m.ox = 0
            m.oy = 0
            int metal = Raser.Material.Metal!int
            for (int z = 0; z < 18; z++) { m.Set(0, 0, z, metal, Raser.Palette.Asphalt) }
            m.Set(1, 0, 17, metal, Raser.Palette.SignRed)
            m.Set(1, 0, 16, metal, Raser.Palette.SignYellow)
            m.Set(1, 0, 15, metal, Raser.Palette.SignGreen)
            return m
        }
    }
}
