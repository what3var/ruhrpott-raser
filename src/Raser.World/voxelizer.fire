// Raser.World: die deterministische Voxelisierung (Konzept, Abschnitt 2). Zwischenlayer + Overrides + Seed ergeben immer denselben Chunk.
//
// Gelände: In jeder Voxel-Säule liegt die Oberfläche im Voxel der höchsten Ecke; die vier Eckhöhen kommen aus dem Höhenraster an den Ecken der Säule
// (gerundet auf 5 cm). Nachbarn rechnen dieselbe Ecke aus denselben Daten - die Höhen-Schnitte schließen lückenlos aneinander (Konzept, Abschnitt 1).
// Unter der Oberfläche: ein paar Voxel Erde (unter Straßen Schotter), darunter Fels.
// Gebäude: Säulen, deren Mitte im Grundriss liegt, sind Gebäude vom Boden bis zum Dach; Säulen am Rand sind Wand (mit Fensterreihen je Geschoss),
// innen liegen Decken alle 2,8 m. Das Dach ist das Voxel unter der Dachfläche, wie beim Gelände mit Eckhöhen abgeschnitten. Mit LoD2-Dachflächen
// kommt die Höhe aus deren Ebenen, sonst aus Dachform, Traufe und First.
#import "raser.core"
#import "json"

namespace Raser {
    // Was die Voxelisierung über ein Gebäude vorab berechnet.
    class RoofModel {
        Building building
        Box2 box
        defined float dx        // Firstrichtung
        defined float dy
        defined float midAlong
        defined float midAcross
        defined float halfAlong
        defined float halfAcross
        defined int groundVoxel
        defined bool pitched
        defined int wallColor
        defined int roofColor
        float planes[]          // je Dachfläche: a, b, c (z = a x + b y + c), gültig (1) oder senkrecht (0)
        float faceBoxes[]       // je Dachfläche: minX, minY, maxX, maxY

        construct(Building b, defined int seed) {
            this.building = b
            this.box = Raser.Box2.Of(b.footprint)
            try this.box.TakeTo(this)
            var dir = Raser.Geo.LongestEdge(b.footprint)
            this.dx = dir[0]
            this.dy = dir[1]
            float minA = 1.0e30
            float maxA = -1.0e30
            float minC = 1.0e30
            float maxC = -1.0e30
            for (int i = 0; i + 1 < b.footprint.length; i = i + 2) {
                float a = b.footprint[i] * this.dx + b.footprint[i + 1] * this.dy
                float c = -b.footprint[i] * this.dy + b.footprint[i + 1] * this.dx
                if (a < minA) { minA = a }
                if (a > maxA) { maxA = a }
                if (c < minC) { minC = c }
                if (c > maxC) { maxC = c }
            }
            this.midAlong = (minA + maxA) / 2.0
            this.midAcross = (minC + maxC) / 2.0
            this.halfAlong = (maxA - minA) / 2.0
            this.halfAcross = (maxC - minC) / 2.0
            if (this.halfAcross < 0.1) { this.halfAcross = 0.1 }
            if (this.halfAlong < 0.1) { this.halfAlong = 0.1 }
            this.groundVoxel = Raser.Grid.VoxelOf(b.ground)
            this.pitched = b.roofs.Count > 0 || (b.ridge - b.eaves > 0.3 && b.roofType != Raser.RoofType.Flat)
            int h = Raser.Fnv.AddInt(Raser.Fnv.AddInt(Raser.Fnv.Start(), b.id), seed)
            this.wallColor = Raser.RoofModel.Variant(b.wallColor, h)
            this.roofColor = b.roofColor
            if (!this.pitched && b.roof == Raser.Material.RoofTiles) { this.roofColor = Raser.Palette.RoofFlat }
            // je Gebäude eine Dreckstufe für Wand und Dach (Raser.Palette.Dirty; aus ID und Seed, also stabil)
            this.wallColor = Raser.Palette.Dirty(this.wallColor, Raser.RoofModel.DirtLevel(h >> 8))
            this.roofColor = Raser.Palette.Dirty(this.roofColor, Raser.RoofModel.DirtLevel(h >> 16))
            int nf = b.roofs.Count
            this.planes = new float[nf * 4]
            this.faceBoxes = new float[nf * 4]
            for (int f = 0; f < nf; f++) {
                float pts[] = b.roofs[f].points
                var plane = Raser.Geo.Plane(pts)
                for (int k = 0; k < 4; k++) { this.planes[f * 4 + k] = plane[k] }
                var box = Raser.Box2.Of(pts, 3)
                this.faceBoxes[f * 4] = box.minX
                this.faceBoxes[f * 4 + 1] = box.minY
                this.faceBoxes[f * 4 + 2] = box.maxX
                this.faceBoxes[f * 4 + 3] = box.maxY
            }
        }

        // Wie schmutzig: 0 sauber (35 %), 1 (35 %), 2 (20 %), 3 stark (10 %).
        static defined int DirtLevel(defined int h) {
            int p = (h & 1023) % 100
            if (p < 35) { return 0 }
            if (p < 70) { return 1 }
            if (p < 90) { return 2 }
            return 3
        }

        // Ziegel und Putz in leichten Varianten (aus ID und Seed, also stabil).
        static defined int Variant(defined int color, defined int h) {
            int pick = (h >> 33) & 3
            if (color == Raser.Palette.Brick) {
                int options[] = [Raser.Palette.Brick, Raser.Palette.BrickDark, Raser.Palette.BrickLight, Raser.Palette.Brick]
                return options[pick]
            }
            if (color == Raser.Palette.Plaster) {
                int options[] = [Raser.Palette.Plaster, Raser.Palette.PlasterCream, Raser.Palette.PlasterGrey, Raser.Palette.PlasterYellow]
                return options[pick]
            }
            return color
        }

        defined bool Contains(defined float x, defined float y) {
            if (!this.box.Contains(x, y)) { return false }
            return Raser.Geo.Inside(this.building.footprint, x, y)
        }

        // Die Höhe der Dachfläche an (x, y).
        defined float RoofAt(defined float x, defined float y) {
            Building b = this.building
            if (b.roofs.Count > 0) { return this.FacesAt(x, y) }
            if (!this.pitched) { return b.eaves }
            float rise = b.ridge - b.eaves
            float across = Math.Abs(-x * this.dy + y * this.dx - this.midAcross) / this.halfAcross
            float along = Math.Abs(x * this.dx + y * this.dy - this.midAlong)
            float h = b.ridge
            switch (b.roofType) {
                case Raser.RoofType.Shed:
                    float t = (-x * this.dy + y * this.dx - this.midAcross) / this.halfAcross
                    h = b.eaves + rise * (t + 1.0) / 2.0
                case Raser.RoofType.Hip:
                    float end = (along - (this.halfAlong - this.halfAcross)) / this.halfAcross
                    if (end < 0.0) { end = 0.0 }
                    h = b.ridge - rise * Math.Max(across, end)
                case Raser.RoofType.Mansard:
                    float end2 = (along - (this.halfAlong - this.halfAcross)) / this.halfAcross
                    if (end2 < 0.0) { end2 = 0.0 }
                    h = b.ridge - rise * Math.Max(across, end2)
                case Raser.RoofType.Pyramid:
                    h = b.ridge - rise * Math.Max(across, along / this.halfAlong)
                case default:
                    h = b.ridge - rise * across
            }
            return Math.Clamp(h, b.eaves, b.ridge)
        }

        // Aus LoD2-Dachflächen: die höchste Ebene, in deren Polygon der Punkt liegt; sonst die Ebene der nächsten Fläche, auf Traufe..First begrenzt.
        defined float FacesAt(defined float x, defined float y) {
            Building b = this.building
            float best = -1.0e30
            bool found = false
            float nearDist = 1.0e30
            float nearHeight = b.eaves
            int nf = b.roofs.Count
            for (int f = 0; f < nf; f++) {
                if (this.planes[f * 4 + 3] == 0.0) { continue }
                float h = this.planes[f * 4] * x + this.planes[f * 4 + 1] * y + this.planes[f * 4 + 2]
                bool inBox = x >= this.faceBoxes[f * 4] && y >= this.faceBoxes[f * 4 + 1] && x <= this.faceBoxes[f * 4 + 2] && y <= this.faceBoxes[f * 4 + 3]
                if (inBox && Raser.Geo.Inside(b.roofs[f].points, x, y, 3)) {
                    if (h > best) { best = h }
                    found = true
                } else if (!found) {
                    float d = Raser.RoofModel.DistanceToRing(b.roofs[f].points, x, y)
                    if (d < nearDist) {
                        nearDist = d
                        nearHeight = h
                    }
                }
            }
            float top = b.ridge
            if (top < b.eaves) { top = b.eaves }
            if (found) { return Math.Clamp(best, b.ground, top + 0.5) }
            return Math.Clamp(nearHeight, b.ground, top)
        }

        static defined float DistanceToRing(float poly[], defined float x, defined float y) {
            int n = poly.length / 3
            float best = 1.0e30
            int j = n - 1
            for (int i = 0; i < n; i++) {
                float d = Raser.Geo.DistanceToSegment(x, y, poly[j * 3], poly[j * 3 + 1], poly[i * 3], poly[i * 3 + 1])
                if (d < best) { best = d }
                j = i
            }
            return best
        }
    }

    class Voxelizer {
        // 2: neu erzeugt, weil native Builds vor fire 8a0292a die unterste Ebene zu hoch setzten (HeightRaster.Min falsch gelesen)
        // 3: bei Gleichstand (Straßenbreite, Flächenpriorität, überlappende Gebäude) gewinnt die kleinere ID - unabhängig von der Reihenfolge der Merkmale
        // 4: Dreckstufen je Gebäude (Palette 32 .. 127)
        // 5: Stadtmöbel und Vegetation (Raser.Prop, Modelle aus Raser.Props)
        static readonly defined int Version = 5
        static readonly defined float StoreyHeight = 2.8

        Tile tile
        defined int seed
        defined int overridesHash
        defined int dataHash
        List<RoofModel> models
        List<Box2> roadBoxes
        List<Box2> areaBoxes
        // die Props als gestempelte Modelle: das Modell (geteilt) und der Fußpunkt in Voxeln der Welt
        List<VoxelModel> propModels
        List<int> propAt                  // je Prop: x, y, z (Voxel der Welt) und der Index des Modells
        defined float propTop             // die höchste Spitze (m)

        // Wendet die Overrides auf die Kachel an (an Ort und Stelle) und bereitet die Merkmale vor.
        construct(Tile tile, OverrideSet overrides, defined int seed) {
            this.tile = tile
            try tile.TakeTo(this)
            this.seed = seed
            if (overrides != undefined) {
                try overrides.TakeTo(this)
                this.overridesHash = overrides.HashFor(tile)
                overrides.Apply(tile)
            }
            this.dataHash = tile.DataHash()
            this.models = new List<RoofModel>()
            foreach (b in tile.data.buildings) {
                if (b.footprint == undefined || b.footprint.length < 6) { continue }
                if (b.ridge <= b.ground) { continue }
                this.models.Add(new Raser.RoofModel(b, seed))
            }
            this.roadBoxes = new List<Box2>()
            foreach (r in tile.data.roads) {
                var box = Raser.Box2.Of(r.points)
                box.Grow(r.width / 2.0 + 0.2)
                this.roadBoxes.Add(take box)
            }
            this.areaBoxes = new List<Box2>()
            foreach (a in tile.data.areas) { this.areaBoxes.Add(Raser.Box2.Of(a.ring)) }
            this.propModels = new List<VoxelModel>()
            this.propAt = new List<int>()
            this.propIndex = new Dictionary<string, int>()
            this.AddProps(this.tile, 0.0, 0.0)
        }

        Dictionary<string, int> propIndex

        // Die Modelle der Props einer Kachel (gleiche Art, Höhe, Variante, Richtung: ein Modell) und ihre Fußpunkte: auf dem obersten Gelände-Voxel
        // ihrer Säule. (ox, oy): wo die Kachel `t` liegt, von dieser aus (m) - für die Nachbarn, deren Bäume über die Grenze ragen; von ihnen nur
        // die Props bis 12 m an dieser Kachel.
        undefined AddProps(Tile t, defined float ox, defined float oy) {
            int vx0 = this.tile.key.x * 1280
            int vy0 = this.tile.key.y * 1280
            foreach (p in t.data.props) {
                float px = p.x + ox
                float py = p.y + oy
                if (px < -12.0 || py < -12.0 || px > 268.0 || py > 268.0) { continue }
                int variant = Math.Abs(p.id) % 6
                float height = Math.Round(p.height)
                int quarters = (Math.Round(p.angle / 90.0)!int % 4 + 4) % 4
                string key = p.kind + "/" + height + "/" + variant + "/" + quarters + "/" + p.detail
                if (!this.propIndex.ContainsKey(key)) {
                    var m = Raser.Props.Make(p.kind, height, Raser.Fnv.AddInt(Raser.Fnv.Start(), variant + 17 * p.kind.Length), quarters * 90.0, p.detail)
                    if (m == undefined) { continue }
                    this.propIndex[key] = this.propModels.Count
                    this.propModels.Add(take m)
                }
                int mi = this.propIndex[key]
                int cx = Math.Floor(px / 0.2)!int
                int cy = Math.Floor(py / 0.2)!int
                // das Gelände aus dem Raster der Kachel des Props (kachel-lokal dort)
                float lx = cx * 0.2 - ox
                float ly = cy * 0.2 - oy
                float h0 = 0.0
                float h1 = 0.0
                float h2 = 0.0
                float h3 = 0.0
                if (t.heights != undefined) {
                    h0 = t.heights.At(lx, ly)
                    h1 = t.heights.At(lx + 0.2, ly)
                    h2 = t.heights.At(lx + 0.2, ly + 0.2)
                    h3 = t.heights.At(lx, ly + 0.2)
                }
                int z = Raser.Voxelizer.TopVoxel(h0, h1, h2, h3) + 1
                this.propAt.Add(vx0 + cx)
                this.propAt.Add(vy0 + cy)
                this.propAt.Add(z)
                this.propAt.Add(mi)
                float top = (z + this.propModels[mi].sz) * 0.2
                if (top > this.propTop) { this.propTop = top }
            }
        }

        // Stempelt die Props in einen Chunk: nur in Luft (Gebäude und Gelände bleiben).
        undefined StampProps(Chunk chunk) {
            int kx = chunk.key.VoxelX
            int ky = chunk.key.VoxelY
            int kz = chunk.key.VoxelZ
            for (int p = 0; p + 3 < this.propAt.Count; p = p + 4) {
                var m = this.propModels[this.propAt[p + 3]]
                // die Ecke des Modells in Voxeln der Welt
                int mx = this.propAt[p] - m.ox
                int my = this.propAt[p + 1] - m.oy
                int mz = this.propAt[p + 2]
                if (mx + m.sx <= kx || my + m.sy <= ky || mz + m.sz <= kz || mx >= kx + 64 || my >= ky + 64 || mz >= kz + 64) { continue }
                chunk.Allocate()
                byte mats[] = chunk.materials
                byte cols[] = chunk.colors
                byte mm[] = m.materials
                byte mc[] = m.colors
                int x0 = Math.Max(mx, kx)
                int x1 = Math.Min(mx + m.sx, kx + 64)
                int y0 = Math.Max(my, ky)
                int y1 = Math.Min(my + m.sy, ky + 64)
                int z0 = Math.Max(mz, kz)
                int z1 = Math.Min(mz + m.sz, kz + 64)
                for (int z = z0; z < z1; z++) {
                    for (int y = y0; y < y1; y++) {
                        for (int x = x0; x < x1; x++) {
                            int src = (x - mx) + (y - my) * m.sx + (z - mz) * m.sx * m.sy
                            int mat = mm[src]
                            if (mat == 0) { continue }
                            int dst = (x - kx) + ((y - ky) << 6) + ((z - kz) << 12)
                            if (mats[dst] != 0) { continue }
                            mats[dst] = mat
                            cols[dst] = mc[src]
                        }
                    }
                }
            }
        }

        // Die Höhe des Geländes an einem kachel-lokalen Punkt.
        defined float TerrainAt(defined float x, defined float y) {
            if (this.tile.heights == undefined) { return 0.0 }
            return this.tile.heights.At(x, y)
        }

        // Die Chunk-Ebenen (z), die die Kachel braucht: [unterste, oberste].
        int[] ChunkLayers() {
            float low = 0.0
            float high = 0.0
            if (this.tile.heights != undefined) {
                low = this.tile.heights.Min()
                high = this.tile.heights.Max()
            }
            foreach (m in this.models) {
                if (m.building.ridge > high) { high = m.building.ridge }
                if (m.building.eaves > high) { high = m.building.eaves }
                float bottom = m.building.ground - m.building.cellars * Raser.Voxelizer.StoreyHeight
                if (bottom < low) { low = bottom }
            }
            if (this.propTop > high) { high = this.propTop }
            int result[] = [Raser.Grid.FloorDiv(Raser.Grid.VoxelOf(low - 3.0), 64), Raser.Grid.FloorDiv(Raser.Grid.VoxelOf(high + 1.0), 64)]
            return result
        }

        // Alle Chunk-Schlüssel der Kachel (20 x 20 Säulen x die Ebenen aus ChunkLayers).
        List<ChunkKey> ChunkKeys() {
            var layers = this.ChunkLayers()
            var keys = new List<ChunkKey>()
            int cx0 = this.tile.key.x * 20
            int cy0 = this.tile.key.y * 20
            for (int cy = 0; cy < 20; cy++) {
                for (int cx = 0; cx < 20; cx++) {
                    for (int cz = layers[0]; cz <= layers[1]; cz++) { keys.Add(new Raser.ChunkKey(cx0 + cx, cy0 + cy, cz)) }
                }
            }
            return keys
        }

        // Die Viertel-Höhe (1..4) einer Ecke über der Unterkante des Voxels k.
        static defined int Quarter(defined float h, defined int k) {
            int q = Math.Round((h - k * 0.2) / 0.05)!int
            if (q < 1) { return 1 }
            if (q > 4) { return 4 }
            return q
        }

        // Das Voxel, in dem die höchste der vier Ecken liegt.
        static defined int TopVoxel(defined float a, defined float b, defined float c, defined float d) {
            float m = Math.Max(Math.Max(a, b), Math.Max(c, d))
            return Math.Floor(m * 5.0 - 0.0001)!int
        }

        // Der Plan der Säulen der letzten Chunk-Säule (die Chunks einer Säule kommen nacheinander, siehe ChunkKeys).
        ColumnPlan plan
        defined int planX
        defined int planY

        Chunk Generate(ChunkKey key) {
            if (this.plan == undefined || this.planX != key.x || this.planY != key.y) {
                this.plan = this.Plan(key.x, key.y)
                this.planX = key.x
                this.planY = key.y
            }
            var chunk = new Raser.Chunk(new Raser.ChunkKey(key.x, key.y, key.z))
            chunk.generatorVersion = Raser.Voxelizer.Version
            chunk.overridesHash = this.overridesHash
            chunk.seed = this.seed
            this.plan.Fill(chunk)
            this.StampProps(chunk)
            return chunk
        }

        // Was in jeder der 64 x 64 Säulen einer Chunk-Säule steht - unabhängig von der Höhe, also einmal für alle Chunks darüber und darunter.
        // Alle Lagen werden aus dem kachel-lokalen Voxel-Index gerechnet ((lx + 0,5) * 0,2), damit jeder Chunk dieselbe Säule gleich sieht.
        // Grundrisse und Flächen werden zeilenweise gerastert (Schnittpunkte der Zeile mit dem Ring, Gerade-Ungerade wie Geo.Inside),
        // Straßen segmentweise (nur die Säulen im Rechteck um das Segment).
        ColumnPlan Plan(defined int cx, defined int cy) {
            var plan = new Raser.ColumnPlan()
            int lx0 = cx * 64 - this.tile.key.VoxelX
            int ly0 = cy * 64 - this.tile.key.VoxelY
            float mx0 = lx0 * 0.2
            float my0 = ly0 * 0.2
            float mx1 = (lx0 + 64) * 0.2
            float my1 = (ly0 + 64) * 0.2

            // Was die Säule berührt.
            var models = new List<RoofModel>()
            foreach (m in this.models) {
                if (m.box.Overlaps(mx0 - 0.4, my0 - 0.4, mx1 + 0.4, my1 + 0.4)) { models.Add(m) }
            }

            // Geländehöhen an den 65 x 65 Ecken.
            float[32] corners[4225]
            for (int j = 0; j <= 64; j++) {
                for (int i = 0; i <= 64; i++) { corners[j * 65 + i] = this.TerrainAt((lx0 + i) * 0.2, (ly0 + j) * 0.2) }
            }

            // Welches Gebäude in welcher Säule steht (-1: keins); eine Spalte und Zeile Rand rundherum für die Wände. Bei Überlappung gewinnt die kleinere ID (unabhängig von der Reihenfolge der Merkmale).
            int owner[4356]
            for (int k = 0; k < 4356; k++) { owner[k] = -1 }
            var crossings = new List<float>()
            for (int m = 0; m < models.Count; m++) {
                float ring[] = models[m].building.footprint
                for (int j = -1; j <= 64; j++) {
                    float py = (ly0 + j + 0.5) * 0.2
                    Raser.Geo.Crossings(ring, 2, py, crossings)
                    for (int q = 0; q + 1 < crossings.Count; q = q + 2) {
                        int i0 = Raser.Voxelizer.FirstColumn(crossings[q], lx0, -1)
                        int i1 = Raser.Voxelizer.FirstColumn(crossings[q + 1], lx0, -1) - 1
                        if (i1 > 64) { i1 = 64 }
                        for (int i = i0; i <= i1; i++) {
                            int o = (j + 1) * 66 + (i + 1)
                            if (owner[o] < 0 || models[m].building.id < models[owner[o]].building.id) { owner[o] = m }
                        }
                    }
                }
            }

            // Flächen: die höchste Priorität gewinnt, bei gleicher die kleinere ID.
            int areaPriority[4096]
            int areaMaterial[4096]
            int areaColor[4096]
            int areaId[4096]
            for (int k = 0; k < 4096; k++) {
                areaPriority[k] = -1000000
                areaMaterial[k] = Raser.Material.Grass!int
                areaColor[k] = Raser.Palette.Grass
                areaId[k] = 0
            }
            for (int ai = 0; ai < this.tile.data.areas.Count; ai++) {
                if (!this.areaBoxes[ai].Overlaps(mx0, my0, mx1, my1)) { continue }
                var a = this.tile.data.areas[ai]
                for (int j = 0; j < 64; j++) {
                    float py = (ly0 + j + 0.5) * 0.2
                    Raser.Geo.Crossings(a.ring, 2, py, crossings)
                    for (int q = 0; q + 1 < crossings.Count; q = q + 2) {
                        int i0 = Raser.Voxelizer.FirstColumn(crossings[q], lx0, 0)
                        int i1 = Raser.Voxelizer.FirstColumn(crossings[q + 1], lx0, 0) - 1
                        if (i1 > 63) { i1 = 63 }
                        for (int i = i0; i <= i1; i++) {
                            int k = j * 64 + i
                            if (a.priority > areaPriority[k] || (a.priority == areaPriority[k] && a.id < areaId[k])) {
                                areaPriority[k] = a.priority
                                areaId[k] = a.id
                                areaMaterial[k] = a.surface!int
                                areaColor[k] = a.color
                            }
                        }
                    }
                }
            }

            // Straßen: die breiteste gewinnt, bei gleicher Breite die kleinere ID.
            float[32] roadWidth[4096]
            int roadMaterial[4096]
            int roadColor[4096]
            int roadId[4096]
            for (int k = 0; k < 4096; k++) {
                roadWidth[k] = 0.0
                roadId[k] = 0
            }
            for (int ri = 0; ri < this.tile.data.roads.Count; ri++) {
                if (!this.roadBoxes[ri].Overlaps(mx0, my0, mx1, my1)) { continue }
                var r = this.tile.data.roads[ri]
                float hw = r.width / 2.0
                int n = r.points.length / 2
                for (int sgi = 0; sgi < n; sgi++) {
                    if (n > 1 && sgi == n - 1) { break }
                    float ax = r.points[sgi * 2]
                    float ay = r.points[sgi * 2 + 1]
                    float bx = ax
                    float by = ay
                    if (n > 1) {
                        bx = r.points[sgi * 2 + 2]
                        by = r.points[sgi * 2 + 3]
                    }
                    int i0 = Math.Floor((Math.Min(ax, bx) - hw) * 5.0)!int - lx0 - 1
                    int i1 = Math.Floor((Math.Max(ax, bx) + hw) * 5.0)!int - lx0 + 1
                    int j0 = Math.Floor((Math.Min(ay, by) - hw) * 5.0)!int - ly0 - 1
                    int j1 = Math.Floor((Math.Max(ay, by) + hw) * 5.0)!int - ly0 + 1
                    if (i0 < 0) { i0 = 0 }
                    if (j0 < 0) { j0 = 0 }
                    if (i1 > 63) { i1 = 63 }
                    if (j1 > 63) { j1 = 63 }
                    for (int j = j0; j <= j1; j++) {
                        float py = (ly0 + j + 0.5) * 0.2
                        for (int i = i0; i <= i1; i++) {
                            int k = j * 64 + i
                            if (r.width < roadWidth[k] || (r.width == roadWidth[k] && r.id >= roadId[k])) { continue }
                            float px = (lx0 + i + 0.5) * 0.2
                            if (Raser.Geo.DistanceToSegment(px, py, ax, ay, bx, by) <= hw) {
                                roadWidth[k] = r.width
                                roadId[k] = r.id
                                roadMaterial[k] = r.surface!int
                                roadColor[k] = r.color
                            }
                        }
                    }
                }
            }

            // Dachhöhen an den Ecken, je Gebäude einmal gerechnet.
            float roofCorner[4225]
            int cornerOwner[4225]
            for (int k = 0; k < 4225; k++) { cornerOwner[k] = -1 }

            int storey = Math.Round(Raser.Voxelizer.StoreyHeight * 5.0)!int
            plan.storey = storey
            for (int y = 0; y < 64; y++) {
                for (int x = 0; x < 64; x++) {
                    int c = y * 64 + x
                    float h0 = corners[y * 65 + x]
                    float h1 = corners[y * 65 + x + 1]
                    float h2 = corners[(y + 1) * 65 + x + 1]
                    float h3 = corners[(y + 1) * 65 + x]
                    int terrainTop = Raser.Voxelizer.TopVoxel(h0, h1, h2, h3)
                    plan.floor[c] = terrainTop
                    int b = owner[(y + 1) * 66 + (x + 1)]
                    if (b >= 0) {
                        var model = models[b]
                        Building bd = model.building
                        int k0 = y * 65 + x
                        int k1 = k0 + 1
                        int k2 = k0 + 66
                        int k3 = k0 + 65
                        if (cornerOwner[k0] != b) {
                            roofCorner[k0] = model.RoofAt((lx0 + x) * 0.2, (ly0 + y) * 0.2)
                            cornerOwner[k0] = b
                        }
                        if (cornerOwner[k1] != b) {
                            roofCorner[k1] = model.RoofAt((lx0 + x + 1) * 0.2, (ly0 + y) * 0.2)
                            cornerOwner[k1] = b
                        }
                        if (cornerOwner[k2] != b) {
                            roofCorner[k2] = model.RoofAt((lx0 + x + 1) * 0.2, (ly0 + y + 1) * 0.2)
                            cornerOwner[k2] = b
                        }
                        if (cornerOwner[k3] != b) {
                            roofCorner[k3] = model.RoofAt((lx0 + x) * 0.2, (ly0 + y + 1) * 0.2)
                            cornerOwner[k3] = b
                        }
                        float r0 = roofCorner[k0]
                        float r1 = roofCorner[k1]
                        float r2 = roofCorner[k2]
                        float r3 = roofCorner[k3]
                        int ground = model.groundVoxel
                        int roof = Raser.Voxelizer.TopVoxel(r0, r1, r2, r3)
                        if (roof < ground) { roof = ground }
                        plan.kind[c] = 1
                        plan.top[c] = roof
                        plan.ground[c] = ground
                        plan.cellar[c] = ground - bd.cellars * storey
                        plan.shape[c] = Raser.Shape.Make(Raser.Voxelizer.Quarter(r0, roof), Raser.Voxelizer.Quarter(r1, roof), Raser.Voxelizer.Quarter(r2, roof), Raser.Voxelizer.Quarter(r3, roof))
                        plan.material[c] = bd.roof!int
                        plan.color[c] = model.roofColor
                        plan.below[c] = bd.wall!int
                        plan.belowColor[c] = model.wallColor
                        int o = (y + 1) * 66 + (x + 1)
                        int flags = 0
                        if (owner[o - 1] != b || owner[o + 1] != b || owner[o - 66] != b || owner[o + 66] != b) { flags = 1 }
                        // Fensterraster entlang der Wand: aus der Lage in der Welt, also über Chunk-Grenzen gleich.
                        int along = Raser.Grid.FloorMod(cx * 64 + x + cy * 64 + y, 9)
                        if (along >= 3 && along <= 6) { flags = flags | 2 }
                        plan.flags[c] = flags
                        if (terrainTop > plan.highest) { plan.highest = terrainTop }
                        if (roof > plan.highest) { plan.highest = roof }
                        continue
                    }
                    int material = areaMaterial[c]
                    int color = areaColor[c]
                    int below = Raser.Material.Soil!int
                    int belowColor = Raser.Palette.Soil
                    if (roadWidth[c] > 0.0) {
                        material = roadMaterial[c]
                        color = roadColor[c]
                        below = Raser.Material.Gravel!int
                        belowColor = Raser.Palette.Gravel
                    }
                    if (material == Raser.Material.Water!int) {
                        below = Raser.Material.Sand!int
                        belowColor = Raser.Palette.Sand
                    }
                    plan.kind[c] = 0
                    plan.top[c] = terrainTop
                    plan.shape[c] = Raser.Shape.Make(Raser.Voxelizer.Quarter(h0, terrainTop), Raser.Voxelizer.Quarter(h1, terrainTop), Raser.Voxelizer.Quarter(h2, terrainTop), Raser.Voxelizer.Quarter(h3, terrainTop))
                    plan.material[c] = material
                    plan.color[c] = color
                    plan.below[c] = below
                    plan.belowColor[c] = belowColor
                    if (terrainTop > plan.highest) { plan.highest = terrainTop }
                }
            }
            return plan
        }

        // Die erste Säule (ab first), deren Mitte (lx0 + i + 0,5) * 0,2 nicht links von x liegt.
        static defined int FirstColumn(defined float x, defined int lx0, defined int first) {
            int i = Math.Ceiling(x * 5.0 - 0.5)!int - lx0
            // genau prüfen, wie Geo.Inside es täte (Rundung der Formel oben)
            while ((lx0 + i - 1 + 0.5) * 0.2 >= x) { i = i - 1 }
            while ((lx0 + i + 0.5) * 0.2 < x) { i = i + 1 }
            if (i < first) { return first }
            return i
        }
    }

    // Der Plan der 64 x 64 Säulen einer Chunk-Säule; Fill schreibt daraus einen Chunk beliebiger Höhe.
    // Gelände: top = oberstes Voxel, shape seine Form, material/color die Oberfläche, below/belowColor die zwei Voxel darunter.
    // Gebäude: top = Dach-Voxel, ground = Boden, material/color das Dach, below/belowColor die Wand, flags Bit 0 = Wand, Bit 1 = Fensterspalte.
    // floor: das oberste Voxel des Geländes in der Säule (unter Gebäuden das Fundament).
    class ColumnPlan {
        int kind[4096]
        int top[4096]
        int shape[4096]
        int material[4096]
        int color[4096]
        int below[4096]
        int belowColor[4096]
        int ground[4096]
        int cellar[4096]        // Gebäude: das unterste Voxel des untersten Kellers (= ground ohne Keller)
        int floor[4096]
        int flags[4096]
        defined int storey
        defined int highest

        construct() { this.highest = -1000000 }

        undefined Fill(Chunk chunk) {
            int vz0 = chunk.key.VoxelZ
            if (this.highest < vz0) { return }      // alles liegt unter diesem Chunk: nur Luft
            chunk.Allocate()
            int soil = Raser.Material.Soil!int
            int soilColor = Raser.Palette.Soil
            int rock = Raser.Material.Rock!int
            int rockColor = Raser.Palette.Rock
            int concrete = Raser.Material.Concrete!int
            int concreteColor = Raser.Palette.Concrete
            int glass = Raser.Material.Glass!int
            int glassColor = Raser.Palette.Glass
            for (int c = 0; c < 4096; c++) {
                int top = this.top[c]
                int floor = this.floor[c]
                if (this.kind[c] == 0) {
                    if (top < vz0) { continue }
                    int zEnd = top - vz0
                    if (zEnd > 63) { zEnd = 63 }
                    for (int z = 0; z <= zEnd; z++) {
                        int i = c + (z << 12)
                        int depth = top - (vz0 + z)
                        if (depth == 0) {
                            chunk.materials[i] = this.material[c]
                            chunk.colors[i] = this.color[c]
                            if (this.shape[c] != 255) { chunk.shapes[i] = this.shape[c] }
                        } else if (depth <= 2) {
                            chunk.materials[i] = this.below[c]
                            chunk.colors[i] = this.belowColor[c]
                        } else if (depth <= 10) {
                            chunk.materials[i] = soil
                            chunk.colors[i] = soilColor
                        } else {
                            chunk.materials[i] = rock
                            chunk.colors[i] = rockColor
                        }
                    }
                    continue
                }
                // Gebäude
                int ground = this.ground[c]
                int cellar = this.cellar[c]
                bool wall = (this.flags[c] & 1) != 0
                bool windows = (this.flags[c] & 2) != 0
                int bottom = floor
                if (cellar - 1 < bottom) { bottom = cellar - 1 }
                int zEnd = top - vz0
                if (zEnd > 63) { zEnd = 63 }
                for (int z = 0; z <= zEnd; z++) {
                    int vz = vz0 + z
                    int i = c + (z << 12)
                    if (vz < ground && vz >= cellar) {
                        // Keller: das Gelände ist ausgehoben, die Außenwand läuft durch, je Geschoss eine Decke
                        if (wall) {
                            chunk.materials[i] = this.below[c]
                            chunk.colors[i] = this.belowColor[c]
                        } else if ((vz - cellar) % this.storey == 0) {
                            chunk.materials[i] = concrete
                            chunk.colors[i] = concreteColor
                        }
                        continue
                    }
                    if (vz < ground) {
                        if (vz >= cellar - 1 || vz > floor) {
                            chunk.materials[i] = concrete           // Fundament (auch wo das Gelände tiefer liegt)
                            chunk.colors[i] = concreteColor
                        } else if (bottom - vz <= 10) {
                            chunk.materials[i] = soil
                            chunk.colors[i] = soilColor
                        } else {
                            chunk.materials[i] = rock
                            chunk.colors[i] = rockColor
                        }
                        continue
                    }
                    if (vz == top) {
                        chunk.materials[i] = this.material[c]
                        chunk.colors[i] = this.color[c]
                        if (this.shape[c] != 255) { chunk.shapes[i] = this.shape[c] }
                        continue
                    }
                    int inStorey = (vz - ground) % this.storey
                    if (wall) {
                        if (windows && inStorey >= 5 && inStorey <= 11 && vz < top - 1) {
                            chunk.materials[i] = glass
                            chunk.colors[i] = glassColor
                        } else {
                            chunk.materials[i] = this.below[c]
                            chunk.colors[i] = this.belowColor[c]
                        }
                    } else if (inStorey == 0) {
                        chunk.materials[i] = concrete
                        chunk.colors[i] = concreteColor
                    }
                }
            }
        }
    }
}
