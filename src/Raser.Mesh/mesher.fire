// Raser.Mesh: aus einem Chunk ein Netz aus Vierecken (Roadmap M2: Chunk-Meshing inkl. Höhen-Schnitten).
//
// - Volle Voxel: nur Flächen zu Nachbarn, die sie nicht verdecken; gleichfarbige Flächen in einer Ebene werden zu großen Rechtecken
//   zusammengefasst (Greedy Meshing, je Richtung und Schicht).
// - Geschnittene Voxel (Höhen-Schnitt): die Oberseite schräg aus den vier Eckhöhen, die Seiten als Trapeze bis zur Oberkante; die Unterseite
//   ist ein volles Quadrat und läuft mit den vollen Voxeln.
// - Durchsichtige Voxel (Glas, Wasser) kommen in einen eigenen Teil des Netzes; zwischen zwei Voxeln desselben durchsichtigen Materials
//   gibt es keine Fläche.
// Verdecken kann nur ein volles, undurchsichtiges Voxel. An den Rändern des Chunks wird der Nachbar-Chunk gefragt (fehlt er: Luft).
// Koordinaten: Meter relativ zur unteren Südwest-Ecke des Chunks, x Ost, y Nord, z oben. Jedes Viereck ist von außen gesehen gegen den Uhrzeigersinn.
#import "raser.core"

namespace Raser {
    class MeshPart {
        List<float> positions     // 12 je Viereck (4 Ecken x, y, z)
        List<float> normals       // 3 je Viereck
        List<int> colors          // 1 je Viereck (Palettenindex)
        List<int> materials       // 1 je Viereck

        construct() {
            this.positions = new List<float>()
            this.normals = new List<float>()
            this.colors = new List<int>()
            this.materials = new List<int>()
        }

        defined int Count { get { return this.colors.Count } }

        // Ein Viereck; die Reihenfolge der Ecken wird so gedreht, dass es zur Normale (nx, ny, nz) zeigt.
        undefined Quad(defined float ax, defined float ay, defined float az, defined float bx, defined float by, defined float bz, defined float cx, defined float cy, defined float cz, defined float dx, defined float dy, defined float dz, defined float nx, defined float ny, defined float nz, defined int color, defined int material) {
            float ux = bx - ax
            float uy = by - ay
            float uz = bz - az
            float vx = cx - ax
            float vy = cy - ay
            float vz = cz - az
            float px = uy * vz - uz * vy
            float py = uz * vx - ux * vz
            float pz = ux * vy - uy * vx
            if (px * nx + py * ny + pz * nz < 0.0) {
                this.Add(ax, ay, az)
                this.Add(dx, dy, dz)
                this.Add(cx, cy, cz)
                this.Add(bx, by, bz)
            } else {
                this.Add(ax, ay, az)
                this.Add(bx, by, bz)
                this.Add(cx, cy, cz)
                this.Add(dx, dy, dz)
            }
            this.normals.Add(nx)
            this.normals.Add(ny)
            this.normals.Add(nz)
            this.colors.Add(color)
            this.materials.Add(material)
        }

        undefined Add(defined float x, defined float y, defined float z) {
            this.positions.Add(x)
            this.positions.Add(y)
            this.positions.Add(z)
        }
    }

    class ChunkMesh {
        ChunkKey key
        MeshPart opaque
        MeshPart transparent

        construct(ChunkKey key) {
            this.key = key
            try key.TakeTo(this)
            this.opaque = new Raser.MeshPart()
            this.transparent = new Raser.MeshPart()
        }

        defined int Count { get { return this.opaque.Count + this.transparent.Count } }
    }

    class Mesher {
        Chunk center
        defined bool skipTerrain    // Gelände-Voxel (Material 1..8: Erde bis Pflaster, Wasser) bekommen keine Flächen - das Gelände kommt als glattes Netz
        byte hardColumns[]          // mit skipTerrain: Säulen (x + 64 y, 1), in denen das Gelände doch Flächen bekommt (Raser.GroundCut); undefined: keine
        ChunkFace west          // die Randschichten der Nachbarn, die diesen Chunk berühren (undefined: Luft)
        ChunkFace east
        ChunkFace south
        ChunkFace north
        ChunkFace below
        ChunkFace above

        // Die Nachbarn kommen als Randschichten (ChunkFace): mehr braucht das Vernetzen von ihnen nicht, und eine Randschicht ist ein Bruchteil
        // eines Chunks (gespeichert als .rrb neben dem Chunk).
        construct(Chunk center, ChunkFace west = undefined, ChunkFace east = undefined, ChunkFace south = undefined, ChunkFace north = undefined, ChunkFace below = undefined, ChunkFace above = undefined) {
            this.center = center
            this.west = west
            try west??.TakeTo(this)
            this.east = east
            try east??.TakeTo(this)
            this.south = south
            try south??.TakeTo(this)
            this.north = north
            try north??.TakeTo(this)
            this.below = below
            try below??.TakeTo(this)
            this.above = above
            try above??.TakeTo(this)
        }

        // Mit den ganzen Nachbar-Chunks (je undefined: Luft): nimmt von jedem die Randschicht, die diesen Chunk berührt.
        static Mesher Around(Chunk center, Chunk west, Chunk east, Chunk south, Chunk north, Chunk below, Chunk above) {
            return new Raser.Mesher(center, Raser.ChunkFace.Of(west, 1), Raser.ChunkFace.Of(east, 0), Raser.ChunkFace.Of(south, 3), Raser.ChunkFace.Of(north, 2), Raser.ChunkFace.Of(below, 5), Raser.ChunkFace.Of(above, 4))
        }

        // Voll und undurchsichtig in allen 64³ Voxeln (ohne Schnitte)?
        static defined bool Solid(Chunk c) {
            if (c == undefined || c.IsEmpty || c.shapes.Count > 0) { return false }
            return c.materials.IndexOf(0) < 0 && c.materials.IndexOf(6) < 0 && c.materials.IndexOf(11) < 0
        }

        // Je Schicht z: 1 = nur Luft, 2 = nur feste, undurchsichtige, ungeschnittene Voxel, 0 = gemischt (mit IndexOf/Compare, ohne Schleife über die Voxel).
        static int[] LayerStates(byte mats[], byte cut[], int cutsPerLayer[]) {
            int states[64]
            byte air[4096]
            for (int z = 0; z < 64; z++) {
                byte layer[] = mats.Slice(z << 12, 4096)
                states[z] = 0
                if (layer.Compare(air) == 0) {
                    states[z] = 1
                    continue
                }
                if (cutsPerLayer[z] > 0) { continue }
                if (layer.IndexOf(0) < 0 && layer.IndexOf(11) < 0 && layer.IndexOf(6) < 0) { states[z] = 2 }
            }
            return states
        }

        // Ein durchsichtiges Material: Glas und Wasser.
        static defined bool IsTransparent(defined int m) { return m == 11 || m == 6 }

        // Die Randschicht, in der die Zelle (x, y, z) liegt, wenn sie außerhalb des Chunks ist (höchstens eine Koordinate liegt außerhalb 0..63).
        ChunkFace FaceFor(defined int x, defined int y, defined int z) {
            if (x < 0) { return this.west }
            if (x > 63) { return this.east }
            if (y < 0) { return this.south }
            if (y > 63) { return this.north }
            if (z < 0) { return this.below }
            return this.above
        }

        static defined int FaceCell(defined int x, defined int y, defined int z) {
            if (x < 0 || x > 63) { return (y & 63) + ((z & 63) << 6) }
            if (y < 0 || y > 63) { return (x & 63) + ((z & 63) << 6) }
            return (x & 63) + ((y & 63) << 6)
        }

        static defined bool Inside(defined int x, defined int y, defined int z) { return x >= 0 && y >= 0 && z >= 0 && x < 64 && y < 64 && z < 64 }

        defined int MaterialAt(defined int x, defined int y, defined int z) {
            if (Raser.Mesher.Inside(x, y, z)) { return this.center.MaterialAt(x, y, z) }
            var f = this.FaceFor(x, y, z)
            if (f == undefined) { return 0 }
            return f.materials[Raser.Mesher.FaceCell(x, y, z)]
        }

        defined int ShapeAt(defined int x, defined int y, defined int z) {
            if (Raser.Mesher.Inside(x, y, z)) { return this.center.ShapeAt(x, y, z) }
            var f = this.FaceFor(x, y, z)
            if (f == undefined) { return 255 }
            return f.shapes[Raser.Mesher.FaceCell(x, y, z)]
        }

        static defined bool SolidFace(ChunkFace f) { return f != undefined && f.solid }

        // Verdeckt die Zelle (x, y, z) die Fläche eines Voxels aus material? Volle undurchsichtige Voxel immer; ein durchsichtiges Voxel nur
        // eine Fläche desselben Materials.
        // fromBelow: die Zelle liegt über der Fläche - ihre Unterseite ist immer ein volles Quadrat, ein Schnitt ändert daran nichts.
        defined bool Hides(defined int x, defined int y, defined int z, defined int material, defined bool fromBelow = false) {
            int m = this.MaterialAt(x, y, z)
            if (m == 0) { return false }
            if (!fromBelow && !Raser.Shape.IsFull(this.ShapeAt(x, y, z))) { return false }
            if (Raser.Mesher.IsTransparent(m)) { return m == material }
            return true
        }

        // Bekommt dieses Gelände-Voxel (Index i im Chunk) keine Flächen?
        defined bool Skips(defined int i) { return this.hardColumns == undefined || this.hardColumns[i & 4095] == 0 }

        ChunkMesh Build() {
            var mesh = new Raser.ChunkMesh(new Raser.ChunkKey(this.center.key.x, this.center.key.y, this.center.key.z))
            if (this.center.IsEmpty) { return mesh }
            // ganz verschüttet: ein voller Chunk zwischen vollen Nachbarn hat keine sichtbare Fläche
            if (Raser.Mesher.Solid(this.center) && Raser.Mesher.SolidFace(this.west) && Raser.Mesher.SolidFace(this.east) && Raser.Mesher.SolidFace(this.south) && Raser.Mesher.SolidFace(this.north) && Raser.Mesher.SolidFace(this.below) && Raser.Mesher.SolidFace(this.above)) { return mesh }
            int mask[4096]
            // Direkt auf die Puffer des Chunks; die geschnittenen Voxel einmal als Byte-Karte (statt je Voxel im Dictionary nachzuschlagen).
            byte mats[] = this.center.materials
            byte cols[] = this.center.colors
            byte cut[262144]
            int cutsPerLayer[64]
            for (int z = 0; z < 64; z++) { cutsPerLayer[z] = 0 }
            foreach (pair in this.center.shapes) {
                cut[pair.Key] = 1
                cutsPerLayer[pair.Key >> 12] = cutsPerLayer[pair.Key >> 12] + 1
            }
            var states = Raser.Mesher.LayerStates(mats, cut, cutsPerLayer)
            // Richtungen: 0 -x, 1 +x, 2 -y, 3 +y, 4 -z, 5 +z
            for (int dir = 0; dir < 6; dir++) {
                int axis = dir / 2
                int sign = (dir % 2) * 2 - 1
                for (int s = 0; s < 64; s++) {
                    bool found = false
                    // nach z: eine Schicht aus Luft hat keine Flächen, eine feste nur dort, wo die Nachbarschicht nicht fest ist
                    if (axis == 2) {
                        if (states[s] == 1) { continue }
                        if (states[s] == 2 && s + sign >= 0 && s + sign < 64 && states[s + sign] == 2) { continue }
                    }
                    for (int v = 0; v < 64; v++) {
                        // nach x/y ist v die Schicht z: aus Luft, oder fest mit dem Nachbarn im selben Chunk - keine Fläche in dieser Zeile
                        if (axis < 2 && (states[v] == 1 || (states[v] == 2 && s + sign >= 0 && s + sign < 64))) {
                            for (int u = 0; u < 64; u++) { mask[v * 64 + u] = 0 }
                            continue
                        }
                        for (int u = 0; u < 64; u++) {
                            int x = 0
                            int y = 0
                            int z = 0
                            if (axis == 0) {
                                x = s
                                y = u
                                z = v
                            } else if (axis == 1) {
                                x = u
                                y = s
                                z = v
                            } else {
                                x = u
                                y = v
                                z = s
                            }
                            int value = 0
                            int i = x + (y << 6) + (z << 12)
                            int m = mats[i]
                            // geschnittene Voxel: nur die Unterseite läuft hier mit
                            if (m != 0 && (cut[i] == 0 || dir == 4) && !(this.skipTerrain && m <= 8 && this.Skips(i))) {
                                int nx = x
                                int ny = y
                                int nz = z
                                if (axis == 0) { nx = x + sign } else if (axis == 1) { ny = y + sign } else { nz = z + sign }
                                bool hidden = false
                                if (nx >= 0 && ny >= 0 && nz >= 0 && nx < 64 && ny < 64 && nz < 64) {
                                    int ni = nx + (ny << 6) + (nz << 12)
                                    int nm = mats[ni]
                                    hidden = nm != 0 && (dir == 5 || cut[ni] == 0) && (!Raser.Mesher.IsTransparent(nm) || nm == m)
                                } else {
                                    hidden = this.Hides(nx, ny, nz, m, dir == 5)
                                }
                                if (!hidden) { value = 1 + cols[i] + (m << 8) }
                            }
                            mask[v * 64 + u] = value
                            if (value != 0) { found = true }
                        }
                    }
                    if (found) { this.Greedy(mesh, mask, axis, sign, s) }
                }
            }
            // die schrägen Oberseiten (je Schicht zusammengefasst) und die Trapez-Seiten der geschnittenen Voxel
            this.SlopedFaces(mesh, mats, cols, cut, cutsPerLayer)
            return mesh
        }

        // Fasst gleiche Einträge der Maske zu Rechtecken zusammen und gibt sie aus.
        undefined Greedy(ChunkMesh mesh, int mask[], defined int axis, defined int sign, defined int s) {
            for (int v = 0; v < 64; v++) {
                int u = 0
                while (u < 64) {
                    int value = mask[v * 64 + u]
                    if (value == 0) {
                        u++
                        continue
                    }
                    int w = 1
                    while (u + w < 64 && mask[v * 64 + u + w] == value) { w++ }
                    int h = 1
                    bool grow = true
                    while (v + h < 64 && grow) {
                        for (int k = 0; k < w; k++) {
                            if (mask[(v + h) * 64 + u + k] != value) {
                                grow = false
                                break
                            }
                        }
                        if (grow) { h++ }
                    }
                    for (int dv = 0; dv < h; dv++) {
                        for (int k = 0; k < w; k++) { mask[(v + dv) * 64 + u + k] = 0 }
                    }
                    this.Rect(mesh, axis, sign, s, u, v, w, h, value)
                    u = u + w
                }
            }
        }

        undefined Rect(ChunkMesh mesh, defined int axis, defined int sign, defined int s, defined int u, defined int v, defined int w, defined int h, defined int value) {
            int color = (value - 1) & 255
            int material = (value - 1) >> 8
            float p = s * 0.2
            if (sign > 0) { p = (s + 1) * 0.2 }
            float u0 = u * 0.2
            float u1 = (u + w) * 0.2
            float v0 = v * 0.2
            float v1 = (v + h) * 0.2
            var part = mesh.opaque
            if (Raser.Mesher.IsTransparent(material)) { part = mesh.transparent }
            float n = sign * 1.0
            if (axis == 0) {
                part.Quad(p, u0, v0, p, u1, v0, p, u1, v1, p, u0, v1, n, 0.0, 0.0, color, material)
            } else if (axis == 1) {
                part.Quad(u0, p, v0, u1, p, v0, u1, p, v1, u0, p, v1, 0.0, n, 0.0, color, material)
            } else {
                part.Quad(u0, v0, p, u1, v0, p, u1, v1, p, u0, v1, p, 0.0, 0.0, n, color, material)
            }
        }

        // Die geschnittenen Voxel Schicht für Schicht: die Seiten je Voxel, die Oberseiten zusammengefasst (GreedyTops).
        undefined SlopedFaces(ChunkMesh mesh, byte mats[], byte cols[], byte cut[], int cutsPerLayer[]) {
            int top[4096]
            for (int z = 0; z < 64; z++) {
                if (cutsPerLayer[z] == 0) { continue }
                for (int k = 0; k < 4096; k++) { top[k] = 0 }
                for (int k = 0; k < 4096; k++) {
                    int i = k + (z << 12)
                    if (cut[i] == 0) { continue }
                    int m = mats[i]
                    if (m == 0 || (this.skipTerrain && m <= 8 && this.Skips(i))) { continue }
                    int x = k & 63
                    int y = k >> 6
                    int shape = this.center.ShapeAt(x, y, z)
                    top[k] = 1 + shape + (cols[i] << 8) + (m << 16)
                    this.SlopedSides(mesh, x, y, z, m, cols[i], shape)
                }
                this.GreedyTops(mesh, top, z)
            }
        }

        // Fasst die Oberseiten einer Schicht zu Rechtecken zusammen, solange die Fläche eben bleibt: gleiche Form, Farbe und Material, und
        // eine Form, die in der Richtung des Zusammenfassens nicht steigt (flach: in beide Richtungen; steigt sie nur in x: entlang y; nur in y:
        // entlang x; schräg in beide: einzeln). Weil Nachbarn ihre Ecken teilen, ist eine Reihe gleicher Formen dann eine durchgehende Ebene.
        undefined GreedyTops(ChunkMesh mesh, int top[], defined int z) {
            float z0 = z * 0.2
            for (int v = 0; v < 64; v++) {
                int u = 0
                while (u < 64) {
                    int value = top[v * 64 + u]
                    if (value == 0) {
                        u++
                        continue
                    }
                    int shape = (value - 1) & 255
                    int color = ((value - 1) >> 8) & 255
                    int material = (value - 1) >> 16
                    int c0 = Raser.Shape.Corner(shape, 0)
                    int c1 = Raser.Shape.Corner(shape, 1)
                    int c2 = Raser.Shape.Corner(shape, 2)
                    int c3 = Raser.Shape.Corner(shape, 3)
                    bool alongX = c0 == c1 && c3 == c2
                    bool alongY = c0 == c3 && c1 == c2
                    int w = 1
                    if (alongX) {
                        while (u + w < 64 && top[v * 64 + u + w] == value) { w++ }
                    }
                    int h = 1
                    if (alongY) {
                        bool grow = true
                        while (v + h < 64 && grow) {
                            for (int k = 0; k < w; k++) {
                                if (top[(v + h) * 64 + u + k] != value) {
                                    grow = false
                                    break
                                }
                            }
                            if (grow) { h++ }
                        }
                    }
                    for (int dv = 0; dv < h; dv++) {
                        for (int k = 0; k < w; k++) { top[(v + dv) * 64 + u + k] = 0 }
                    }
                    var part = mesh.opaque
                    if (Raser.Mesher.IsTransparent(material)) { part = mesh.transparent }
                    float x0 = u * 0.2
                    float x1 = (u + w) * 0.2
                    float y0 = v * 0.2
                    float y1 = (v + h) * 0.2
                    float h0 = z0 + c0 * 0.05
                    float h1 = z0 + c1 * 0.05
                    float h2 = z0 + c2 * 0.05
                    float h3 = z0 + c3 * 0.05
                    // Normale aus der Neigung eines Voxels (die Ebene ist dieselbe)
                    float nx = ((c0 + c3) - (c1 + c2)) * 0.05 * 0.5 / 0.2
                    float ny = ((c0 + c1) - (c2 + c3)) * 0.05 * 0.5 / 0.2
                    float len = Math.Sqrt(nx * nx + ny * ny + 1.0)
                    part.Quad(x0, y0, h0, x1, y0, h1, x1, y1, h2, x0, y1, h3, nx / len, ny / len, 1.0 / len, color, material)
                    u = u + w
                }
            }
        }

        // Verdeckt der Nachbar (nx, ny, nz) die Seite eines geschnittenen Voxels, deren Oberkante die Viertel a und b hat? Ein voller
        // undurchsichtiger Nachbar immer; ein geschnittener, wenn seine Kante dort (seine Ecken ca, cb) mindestens so hoch ist.
        defined bool HidesSide(defined int nx, defined int ny, defined int nz, defined int material, defined int a, defined int b, defined int ca, defined int cb) {
            int m = this.MaterialAt(nx, ny, nz)
            if (m == 0) { return false }
            if (Raser.Mesher.IsTransparent(m) && m != material) { return false }
            int ns = this.ShapeAt(nx, ny, nz)
            if (Raser.Shape.IsFull(ns)) { return true }
            return Raser.Shape.Corner(ns, ca) >= a && Raser.Shape.Corner(ns, cb) >= b
        }

        // Die Trapez-Seiten eines geschnittenen Voxels (bis zu seinen Eckhöhen), wo der Nachbar sie nicht verdeckt.
        undefined SlopedSides(ChunkMesh mesh, defined int x, defined int y, defined int z, defined int material, defined int color, defined int shape) {
            var part = mesh.opaque
            if (Raser.Mesher.IsTransparent(material)) { part = mesh.transparent }
            int c0 = Raser.Shape.Corner(shape, 0)
            int c1 = Raser.Shape.Corner(shape, 1)
            int c2 = Raser.Shape.Corner(shape, 2)
            int c3 = Raser.Shape.Corner(shape, 3)
            float x0 = x * 0.2
            float x1 = x0 + 0.2
            float y0 = y * 0.2
            float y1 = y0 + 0.2
            float z0 = z * 0.2
            float h0 = z0 + c0 * 0.05
            float h1 = z0 + c1 * 0.05
            float h2 = z0 + c2 * 0.05
            float h3 = z0 + c3 * 0.05
            // Ecken: 0 = (x0, y0), 1 = (x1, y0), 2 = (x1, y1), 3 = (x0, y1); der Nachbar teilt die gegenüberliegenden
            if (!this.HidesSide(x - 1, y, z, material, c0, c3, 1, 2)) { part.Quad(x0, y1, z0, x0, y0, z0, x0, y0, h0, x0, y1, h3, -1.0, 0.0, 0.0, color, material) }
            if (!this.HidesSide(x + 1, y, z, material, c1, c2, 0, 3)) { part.Quad(x1, y0, z0, x1, y1, z0, x1, y1, h2, x1, y0, h1, 1.0, 0.0, 0.0, color, material) }
            if (!this.HidesSide(x, y - 1, z, material, c0, c1, 3, 2)) { part.Quad(x0, y0, z0, x1, y0, z0, x1, y0, h1, x0, y0, h0, 0.0, -1.0, 0.0, color, material) }
            if (!this.HidesSide(x, y + 1, z, material, c3, c2, 0, 1)) { part.Quad(x1, y1, z0, x0, y1, z0, x0, y1, h3, x1, y1, h2, 0.0, 1.0, 0.0, color, material) }
        }
    }
}
