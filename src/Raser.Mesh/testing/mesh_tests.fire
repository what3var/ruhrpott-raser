// Die Tests von Raser.Mesh (forge test src/Raser.Mesh/Raser.Mesh.fireproj).
#import "testing"
#import "raser.core"

class MeshTests {
    static Raser.Chunk Empty() { return new Raser.Chunk(new Raser.ChunkKey(0, 0, 0)) }

    [Test "Ein Voxel: sechs Flächen"]
    undefined One() {
        var c = MeshTests.Empty()
        c.Set(5, 5, 5, Raser.Material.Brick!int, Raser.Palette.Brick)
        var mesh = new Raser.Mesher(c).Build()
        Testing.Assert.AreEqual(6, mesh.opaque.Count)
        Testing.Assert.AreEqual(0, mesh.transparent.Count)
    }

    [Test "Greedy: ein Quader aus gleichen Voxeln hat sechs Flächen"]
    undefined Box() {
        var c = MeshTests.Empty()
        c.Fill(2, 3, 4, 9, 6, 8, Raser.Material.Concrete!int, Raser.Palette.Concrete)
        var mesh = new Raser.Mesher(c).Build()
        Testing.Assert.AreEqual(6, mesh.opaque.Count)
        // Oberseite bei z = 9 * 0,2, über 8 x 4 Voxel
        var p = mesh.opaque.positions
        bool top = false
        for (int q = 0; q < mesh.opaque.Count; q++) {
            if (mesh.opaque.normals[q * 3 + 2] > 0.5) {
                top = Math.Abs(p[q * 12 + 2] - 1.8) < 0.0001
            }
        }
        Testing.Assert.IsTrue(top)
    }

    [Test "Zwei Farben bleiben getrennt"]
    undefined Colors() {
        var c = MeshTests.Empty()
        c.Set(0, 0, 0, Raser.Material.Brick!int, Raser.Palette.Brick)
        c.Set(1, 0, 0, Raser.Material.Brick!int, Raser.Palette.BrickDark)
        var mesh = new Raser.Mesher(c).Build()
        // je Voxel 5 sichtbare Flächen (die gemeinsame Seite ist verdeckt)
        Testing.Assert.AreEqual(10, mesh.opaque.Count)
    }

    [Test "Höhen-Schnitt: schräge Oberseite, Trapez-Seiten"]
    undefined Sloped() {
        var c = MeshTests.Empty()
        c.Set(5, 5, 5, Raser.Material.Grass!int, Raser.Palette.Grass, Raser.Shape.Make(1, 2, 3, 4))
        var mesh = new Raser.Mesher(c).Build()
        // Unterseite + schräge Oberseite + 4 Seiten
        Testing.Assert.AreEqual(6, mesh.opaque.Count)
        int slopes = 0
        for (int q = 0; q < mesh.opaque.Count; q++) {
            float nz = mesh.opaque.normals[q * 3 + 2]
            if (nz > 0.1 && nz < 0.999) { slopes++ }
        }
        Testing.Assert.AreEqual(1, slopes)
        // Ein volles Voxel darunter zeigt keine Oberseite: die Unterseite des Schnitts verdeckt sie.
        c.Set(5, 5, 4, Raser.Material.Soil!int, Raser.Palette.Soil)
        var lower = new Raser.Mesher(c).Build()
        Testing.Assert.AreEqual(6 + 4, lower.opaque.Count)
        c.Set(5, 5, 4, 0, 0)
        // Ein Voxel darüber verdeckt die schräge Fläche nicht.
        c.Set(5, 5, 6, Raser.Material.Brick!int, Raser.Palette.Brick)
        var again = new Raser.Mesher(c).Build()
        Testing.Assert.AreEqual(6 + 6, again.opaque.Count)       // auch der Ziegel zeigt seine Unterseite: der Schnitt darunter verdeckt sie nicht
    }

    [Test "Gleiche Schnitte werden zu einer Fläche, verdeckte Seiten fallen weg"]
    undefined MergedSlopes() {
        var c = MeshTests.Empty()
        c.Fill(0, 0, 0, 9, 9, 4, Raser.Material.Soil!int, Raser.Palette.Soil)
        // eine flach geschnittene Schicht (alle Ecken auf 2/4) über 10 x 10 Voxeln
        for (int y = 0; y < 10; y++) {
            for (int x = 0; x < 10; x++) { c.Set(x, y, 5, Raser.Material.Grass!int, Raser.Palette.Grass, Raser.Shape.Make(2, 2, 2, 2)) }
        }
        var mesh = new Raser.Mesher(c).Build()
        // Erde: Unterseite + 4 Seiten (die Oberseite verdeckt der Schnitt); Gras: 1 Oberseite + 40 Außenseiten (innen verdeckt)
        Testing.Assert.AreEqual(1 + 4 + 1 + 40, mesh.opaque.Count)
        // eine Rampe, die in x steigt (1/4 -> 2/4) und in y gleich bleibt: je Spalte eine Fläche entlang y
        var r = MeshTests.Empty()
        for (int y = 0; y < 10; y++) {
            for (int x = 0; x < 10; x++) { r.Set(x, y, 5, Raser.Material.Grass!int, Raser.Palette.Grass, Raser.Shape.Make(1, 2, 2, 1)) }
        }
        var rm = new Raser.Mesher(r).Build()
        int tops = 0
        for (int q = 0; q < rm.opaque.Count; q++) {
            if (rm.opaque.normals[q * 3 + 2] > 0.5) { tops++ }
        }
        Testing.Assert.AreEqual(10, tops)              // 10 schräge Streifen, je einer pro Spalte
    }

    [Test "Ohne Gelände: nur was darauf steht, im Boden verdeckt"]
    undefined SkipTerrain() {
        var c = MeshTests.Empty()
        c.Fill(0, 0, 0, 9, 9, 4, Raser.Material.Soil!int, Raser.Palette.Soil)
        c.Set(0, 0, 5, Raser.Material.Grass!int, Raser.Palette.Grass, Raser.Shape.Make(1, 2, 2, 1))
        c.Fill(3, 3, 2, 4, 4, 8, Raser.Material.Brick!int, Raser.Palette.Brick)
        var m = new Raser.Mesher(c)
        m.skipTerrain = true
        var mesh = m.Build()
        // die Säule aus Ziegel (2 x 2 x 7): oben 1, Seiten über dem Boden (z 5..8) je 1 = 5; im Boden verdeckt die Erde
        Testing.Assert.AreEqual(5, mesh.opaque.Count)
    }

    [Test "Glas: eigener Teil, keine Flächen zwischen Glas"]
    undefined Glass() {
        var c = MeshTests.Empty()
        c.Set(0, 0, 0, Raser.Material.Glass!int, Raser.Palette.Glass)
        c.Set(1, 0, 0, Raser.Material.Glass!int, Raser.Palette.Glass)
        c.Set(2, 0, 0, Raser.Material.Brick!int, Raser.Palette.Brick)
        var mesh = new Raser.Mesher(c).Build()
        // Glas: ein 2 x 1 Quader ohne die Seite zum Ziegel = 5 Flächen; Ziegel: 6 (Glas verdeckt nichts)
        Testing.Assert.AreEqual(5, mesh.transparent.Count)
        Testing.Assert.AreEqual(6, mesh.opaque.Count)
    }

    [Test "Nachbar-Chunks verdecken den Rand"]
    undefined Neighbours() {
        var c = MeshTests.Empty()
        c.Set(63, 0, 0, Raser.Material.Brick!int, Raser.Palette.Brick)
        var east = new Raser.Chunk(new Raser.ChunkKey(1, 0, 0))
        east.Set(0, 0, 0, Raser.Material.Brick!int, Raser.Palette.Brick)
        var mesh = Raser.Mesher.Around(c, undefined, east, undefined, undefined, undefined, undefined).Build()
        Testing.Assert.AreEqual(5, mesh.opaque.Count)
    }

    [Test "Randschichten statt ganzer Nachbarn: dasselbe Netz"]
    undefined Faces() {
        var c = MeshTests.Empty()
        c.Fill(0, 0, 0, 63, 63, 10, Raser.Material.Soil!int, Raser.Palette.Soil)
        c.Set(63, 5, 11, Raser.Material.Grass!int, Raser.Palette.Grass, Raser.Shape.Make(1, 3, 2, 4))
        var east = new Raser.Chunk(new Raser.ChunkKey(1, 0, 0))
        east.Fill(0, 0, 0, 63, 63, 12, Raser.Material.Rock!int, Raser.Palette.Rock)
        east.Set(0, 5, 13, Raser.Material.Grass!int, Raser.Palette.Grass, Raser.Shape.Make(2, 2, 3, 1))
        var a = Raser.Mesher.Around(c, undefined, east, undefined, undefined, undefined, undefined).Build()
        // dieselbe Randschicht über die gespeicherte Form (.rrb)
        var bytes = Raser.ChunkFace.EncodeAll(east)
        var b = new Raser.Mesher(c, undefined, Raser.ChunkFace.Decode(bytes, 0)).Build()
        Testing.Assert.AreEqual(a.opaque.Count, b.opaque.Count)
        for (int i = 0; i < a.opaque.positions.Count; i++) { Testing.Assert.AreEqual(a.opaque.positions[i], b.opaque.positions[i]) }
        Testing.Assert.IsFalse(Raser.ChunkFace.Of(east, 0).solid)
        Testing.Assert.IsTrue(Raser.ChunkFace.Of(east, 4).solid)
    }

    [Test "Flächen zeigen nach außen"]
    undefined Winding() {
        var c = MeshTests.Empty()
        c.Set(5, 5, 5, Raser.Material.Brick!int, Raser.Palette.Brick)
        var mesh = new Raser.Mesher(c).Build()
        var p = mesh.opaque.positions
        for (int q = 0; q < 6; q++) {
            int o = q * 12
            float ux = p[o + 3] - p[o]
            float uy = p[o + 4] - p[o + 1]
            float uz = p[o + 5] - p[o + 2]
            float vx = p[o + 6] - p[o]
            float vy = p[o + 7] - p[o + 1]
            float vz = p[o + 8] - p[o + 2]
            float cx = uy * vz - uz * vy
            float cy = uz * vx - ux * vz
            float cz = ux * vy - uy * vx
            float dot = cx * mesh.opaque.normals[q * 3] + cy * mesh.opaque.normals[q * 3 + 1] + cz * mesh.opaque.normals[q * 3 + 2]
            Testing.Assert.IsTrue(dot > 0.0)
        }
    }
}

class FarTests {
    static Raser.Tile Sample() {
        var tile = new Raser.Tile(new Raser.TileKey(0, 0))
        var raster = new Raser.HeightRaster(-0.5, -0.5, 1.0, 258, 258, 50.0)
        tile.heights = take raster
        var b = new Raser.Building()
        b.source = "test:haus"
        b.id = Raser.Ids.Stable(Raser.IdKind.Building, b.source)
        b.footprint = [10.0, 10.0, 20.0, 10.0, 20.0, 18.0, 10.0, 18.0]
        b.ground = 50.0
        b.eaves = 56.0
        b.ridge = 59.0
        b.roofType = Raser.RoofType.Gable
        tile.data.buildings.Add(take b)
        return tile
    }

    [Test "Ferne Stufe: Gelände als Raster, Gebäude aus Grundriss und Dach"]
    undefined Block() {
        var far = new Raser.FarMesher(FarTests.Sample(), 1)
        var part = far.Block(0.0, 0.0, 51.2, 3.2)
        // 16 x 16 Geländezellen; Wände: 2 x 10 m (je 5 Stücke) + 2 x 8 m (je 4 Stücke) = 18; Dach: der Grundriss (2 Dreiecke)
        Testing.Assert.AreEqual(256 + 18 + 2, part.Count)
        // Giebel: die Wand an der Schmalseite (x = 10) reicht in der Mitte (y = 14) bis fast zum First
        float top = 0.0
        for (int q = 256; q < 256 + 18; q++) {
            for (int c = 0; c < 4; c++) {
                float x = part.positions[q * 12 + c * 3]
                float z = part.positions[q * 12 + c * 3 + 2]
                if (Math.Abs(x - 10.0) < 0.001 && z > top) { top = z }
            }
        }
        Testing.Assert.IsTrue(top > 58.0)
        // ein Block ohne die Mitte des Gebäudes hat nur Gelände
        Testing.Assert.AreEqual(256, far.Block(51.2, 0.0, 51.2, 3.2).Count)
    }

    [Test "Hartes Gelände: wo etwas in den Boden greift oder gegraben ist"]
    undefined GroundCut() {
        var far = new Raser.FarMesher(FarTests.Sample(), 1)
        // ein Chunk bei 38,4..51,2 m: Gelände bis 50 m (Voxel 249 = z 57), ein Fundament bei 4 m / 4 m, eine Grube bei 8 m / 8 m
        var c = new Raser.Chunk(new Raser.ChunkKey(0, 0, 3))
        c.Fill(0, 0, 0, 63, 63, 57, Raser.Material.Soil!int, Raser.Palette.Soil)
        c.Fill(20, 20, 57, 21, 21, 57, Raser.Material.Concrete!int, Raser.Palette.Concrete)
        c.Fill(40, 40, 50, 41, 41, 57, 0, 0)
        var cut = new Raser.GroundCut()
        cut.Add(c)
        var hard = cut.Hard(far, 0.0, 0.0)
        // je eine Zelle von 4 x 4 Säulen
        Testing.Assert.AreEqual(1, hard[20 + 20 * 64])
        Testing.Assert.AreEqual(1, hard[23 + 23 * 64])
        Testing.Assert.AreEqual(1, hard[40 + 43 * 64])
        Testing.Assert.AreEqual(0, hard[24 + 20 * 64])
        Testing.Assert.AreEqual(0, hard[5 + 5 * 64])
        int count = 0
        for (int k = 0; k < 4096; k++) { count = count + hard[k] }
        Testing.Assert.AreEqual(32, count)
        // das glatte Gelände spart die beiden Zellen aus
        byte skip[] = new byte[256]
        for (int k = 0; k < 256; k++) { skip[k] = hard[(k & 15) * 4 + (k >> 4) * 4 * 64] }
        Testing.Assert.AreEqual(254, far.Block(0.0, 0.0, 12.8, 0.8, false, skip).Count)
    }
}
