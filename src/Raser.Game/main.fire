// Raser.Game: das Spiel (Roadmap M3: Fahren) - ein Auto durch die Voxel-Welt fahren.
//
//   raser [--world world] [--at ost,nord] [--date 07-01] [--time 14:00] [--weather klar|regen|...] [--size 960x600] [--gpu 1]
//         [--near 1] [--far 5] [--workers 3]
//   raser ... --auto 20 [--steer 0.2] --shot bild.png     ohne Fenster: so viele Sekunden Vollgas (mit festem Lenkeinschlag), dann ein Bild
//
// W/S oder Pfeile: Gas und Bremse (im Stand: Rückwärtsgang), A/D: lenken, Leertaste: Handbremse, C: Kamera (hinter dem Wagen / Haube),
// E: aussteigen (im Stand) und am Wagen wieder einsteigen; zu Fuß: W/S gehen, A/D drehen, Umschalt rennen, C: aus den Augen des Spielers.
// T/G: die Uhr vor und zurück, R: das nächste Wetter. Der Wagen startet auf der nächsten Straße am Startpunkt, in ihrer Richtung.
// Physik: Raser.Vehicle (Grip aus der Nässe des Wetters); Gebäude halten auf (Obstacles), das Gelände trägt (Ground).
#import "windows"
#import "scene3d"
#import "scene3d.effects"
#import "filesystem"
#import "time"
#import "raser.core"
#import "raser.world"
#import "raser.mesh"
#import "raser.client"

// Das Auto in der Szene: Karosserie, Kabine, vier Räder, Lichter - aus Quadern, an Lage und Richtung des Fahrzeugs gesetzt.
class CarModel {
    List<Object> parts
    List<float> offsets         // je Teil: rechts, hoch, vorn (m)
    Light beam                  // das Scheinwerferlicht: ein Punktlicht vor dem Wagen (nachts an)

    construct(Scene scene, defined int color) {
        this.parts = new List<Object>()
        this.offsets = new List<float>()
        // Karosserie 1,8 x 0,55 x 4,2 m, Kabine, Räder, Scheinwerfer und Rücklichter
        this.Add(scene, 0.0, 0.55, 0.0, 1.8, 0.55, 4.2, color)
        this.Add(scene, 0.0, 1.05, -0.3, 1.6, 0.5, 2.2, S3D.Rgb(40, 50, 60))
        foreach (side in [-1.0, 1.0]) {
            this.Add(scene, side * 0.85, 0.32, 1.35, 0.25, 0.64, 0.64, S3D.Rgb(25, 25, 28))
            this.Add(scene, side * 0.85, 0.32, -1.35, 0.25, 0.64, 0.64, S3D.Rgb(25, 25, 28))
            this.Add(scene, side * 0.6, 0.62, 2.11, 0.35, 0.16, 0.04, S3D.Rgb(255, 244, 210))
            this.parts[this.parts.Count - 1].Lit = false
            this.Add(scene, side * 0.6, 0.62, -2.11, 0.35, 0.14, 0.04, S3D.Rgb(200, 30, 30))
            this.parts[this.parts.Count - 1].Lit = false
        }
        var l = Light.Point(0m, 0m, 0m, S3D.Rgb(255, 240, 210), 2.2)
        l.Range = 9m
        l.Cutoff = 32m
        l.CastShadows = false
        l.Enabled = false
        this.beam = l
        scene.Add(take l)
    }

    undefined Add(Scene scene, defined float right, defined float up, defined float front, defined float w, defined float h, defined float d, defined int color) {
        var o = new Object(Template.Box, 0m, 0m, 0m, w * 1m, h * 1m, d * 1m)
        o.Color = color
        this.parts.Add(o)
        this.offsets.Add(right)
        this.offsets.Add(up)
        this.offsets.Add(front)
        scene.Add(take o)
    }

    // (x, y, z): die Lage in der Szene (y: der Boden unter dem Wagen), heading in Grad (vorwärts ist (-sin, -cos) in x, z).
    undefined Place(defined float x, defined float y, defined float z, defined float heading) {
        float h = heading * Math.PI / 180.0
        float fx = -Math.Sin(h)
        float fz = -Math.Cos(h)
        float rx = Math.Cos(h)
        float rz = -Math.Sin(h)
        for (int i = 0; i < this.parts.Count; i++) {
            float r = this.offsets[i * 3]
            float u = this.offsets[i * 3 + 1]
            float f = this.offsets[i * 3 + 2]
            this.parts[i].SetPosition((x + rx * r + fx * f) * 1m, (y + u) * 1m, (z + rz * r + fz * f) * 1m)
            this.parts[i].RotationY = heading * 1deg
        }
        // das Licht 7 m voraus, 1,2 m über der Straße
        this.beam.X = (x + fx * 7.0) * 1m
        this.beam.Y = (y + 1.2) * 1m
        this.beam.Z = (z + fz * 7.0) * 1m
    }
}

// Der Spieler in der Szene: Beine, Rumpf, Kopf, Arme aus Quadern; Beine und Arme schwingen mit dem gelaufenen Weg.
class PersonModel {
    List<Object> parts
    List<float> offsets         // je Teil: rechts, hoch, vorn (m)
    List<float> swing           // je Teil: so weit schwingt es vor und zurück (m, Vorzeichen: die Seite)

    construct(Scene scene) {
        this.parts = new List<Object>()
        this.offsets = new List<float>()
        this.swing = new List<float>()
        int jeans = S3D.Rgb(50, 70, 110)
        int jacket = S3D.Rgb(60, 110, 70)
        int skin = S3D.Rgb(225, 180, 150)
        this.Add(scene, -0.11, 0.42, 0.0, 0.17, 0.84, 0.2, jeans, 0.2)
        this.Add(scene, 0.11, 0.42, 0.0, 0.17, 0.84, 0.2, jeans, -0.2)
        this.Add(scene, 0.0, 1.14, 0.0, 0.44, 0.6, 0.24, jacket, 0.0)
        this.Add(scene, 0.0, 1.6, 0.0, 0.24, 0.26, 0.24, skin, 0.0)
        this.Add(scene, 0.0, 1.76, -0.01, 0.26, 0.08, 0.26, S3D.Rgb(70, 50, 35), 0.0)
        this.Add(scene, -0.29, 1.12, 0.0, 0.12, 0.6, 0.14, jacket, -0.14)
        this.Add(scene, 0.29, 1.12, 0.0, 0.12, 0.6, 0.14, jacket, 0.14)
    }

    undefined Add(Scene scene, defined float right, defined float up, defined float front, defined float w, defined float h, defined float d, defined int color, defined float swing) {
        var o = new Object(Template.Box, 0m, 0m, 0m, w * 1m, h * 1m, d * 1m)
        o.Color = color
        this.parts.Add(o)
        this.offsets.Add(right)
        this.offsets.Add(up)
        this.offsets.Add(front)
        this.swing.Add(swing)
        scene.Add(take o)
    }

    undefined Show(defined bool visible) {
        for (int i = 0; i < this.parts.Count; i++) { this.parts[i].Visible = visible }
    }

    // (x, y, z): die Lage in der Szene (y: der Boden), heading in Grad; stride: der gelaufene Weg (ein Doppelschritt je 1,5 m).
    undefined Place(defined float x, defined float y, defined float z, defined float heading, defined float stride) {
        float h = heading * Math.PI / 180.0
        float fx = -Math.Sin(h)
        float fz = -Math.Cos(h)
        float rx = Math.Cos(h)
        float rz = -Math.Sin(h)
        float phase = Math.Sin(stride * 2.0 * Math.PI / 1.5)
        for (int i = 0; i < this.parts.Count; i++) {
            float r = this.offsets[i * 3]
            float u = this.offsets[i * 3 + 1]
            float f = this.offsets[i * 3 + 2] + this.swing[i] * phase
            this.parts[i].SetPosition((x + rx * r + fx * f) * 1m, (y + u) * 1m, (z + rz * r + fz * f) * 1m)
            this.parts[i].RotationY = heading * 1deg
        }
    }
}

// Die Verfolgerkamera: ihr Abstand hinter dem Wagen (m).
class Chase {
    defined float distance
    construct() { this.distance = 7.0 }
}

class Game {
    // Der Startpunkt: auf der nächsten Straße für Autos (bis 80 m), in ihrer Richtung; sonst der Punkt selbst nach Norden. Gibt Ost, Nord, Richtung.
    static float[] Start(Raser.FileTileStore store, defined float e, defined float n) {
        float result[] = [e, n, 0.0]
        var key = Raser.TileKey.Of(e, n)
        var tile = store.Load(key)
        if (tile == undefined) { return result }
        float x = e - key.East
        float y = n - key.North
        float best = 80.0 * 80.0
        foreach (r in tile.data.roads) {
            if (!Raser.Props.IsCarRoad(r)) { continue }
            for (int k = 0; k + 3 < r.points.length; k = k + 2) {
                float ax = r.points[k]
                float ay = r.points[k + 1]
                float ex = r.points[k + 2] - ax
                float ey = r.points[k + 3] - ay
                float len2 = ex * ex + ey * ey
                if (len2 < 1.0) { continue }
                float t = Math.Clamp(((x - ax) * ex + (y - ay) * ey) / len2, 0.1, 0.9)
                float px = ax + ex * t
                float py = ay + ey * t
                float d2 = (px - x) * (px - x) + (py - y) * (py - y)
                if (d2 < best) {
                    best = d2
                    result[0] = px + key.East
                    result[1] = py + key.North
                    // vorwärts ist (-sin, cos) in (Ost, Nord)
                    result[2] = Math.Atan2(-ex, ey) * 180.0 / Math.PI
                }
            }
        }
        return result
    }

    static defined int Main(string items[]) {
        var options = new Options(items)
        string world = options.Get("world", "world")
        var store = new Raser.FileTileStore(world)
        var at = options.Get("at", "376117,5705005").Split(",")
        var start = Game.Start(store, at[0].ToFloat(), at[1].ToFloat())
        var size = options.Get("size", "960x600").Split("x")
        int width = size[0].ToInt()
        int height = size[1].ToInt()

        var terrain = new Ground(world)
        float ground = 0.0
        any g0 = terrain.At(start[0], start[1])
        if (g0 != undefined) { ground = g0 }

        var fb = new Framebuffer(width, height)
        var scene = new Scene()
        scene.Threads = options.Get("render-threads", "0").ToInt()
        var cam = new Camera(fb)
        cam.FieldOfView = 65deg
        cam.Near = 0.2m
        cam.Far = 3000m
        scene.Add(cam)
        var weather = new Raser.Weather()
        var date = options.Get("date", "07-01").Split("-")
        weather.day = Raser.Weather.DayOf(date[0].ToInt(), date[1].ToInt())
        var clock = options.Get("time", "14:00").Split(":")
        weather.hour = clock[0].ToFloat() + clock[1].ToFloat() / 60.0
        weather.Preset(options.Get("weather", "klar"))

        int near = options.Get("near", "1").ToInt()
        int far = options.Get("far", "5").ToInt()
        int workers = options.Get("workers", "3").ToInt()
        var view = new WorldView(world, scene, start[0], start[1], ground, near, far, 3.2, false, workers, true)
        view.farAhead = far
        view.nearAhead = 2
        view.memory.minFree = 20.0
        if (options.Get("gpu", "") != "") { scene.Renderer = RenderMode.Hardware }
        var atmosphere = new Atmosphere(weather, scene, cam, view, world)
        atmosphere.Apply()
        var obstacles = new Obstacles(world)

        var car = new Raser.Vehicle()
        car.east = start[0]
        car.north = start[1]
        car.heading = start[2]
        var model = new CarModel(scene, S3D.Rgb(190, 40, 35))
        float carY = 0.0
        float camHeading = car.heading
        bool hood = false
        var chase = new Chase()
        var walker = new Raser.Walker()
        var person = new PersonModel(scene)
        person.Show(false)
        bool onFoot = false
        Game.Place(car, model, cam, terrain, view, obstacles, chase, camHeading, hood, 0.0)
        view.Fill(car.east, car.north)

        var hud = new Renderer(fb)
        var ink = new SolidBrush(0xFFFFFFFF)
        var shade = new SolidBrush(0xA0000000)

        // ohne Fenster: eine Probefahrt
        float auto = options.Get("auto", "0").ToFloat()
        string shot = options.Get("shot", "")
        if (auto > 0.0 || shot != "") {
            float steer = options.Get("steer", "0").ToFloat()
            float dt = 1.0 / 30.0
            int hits = 0
            float top = 0.0
            for (float t = 0.0; t < auto; t = t + dt) {
                if (Game.Advance(car, obstacles, dt, 1.0, 0.0, steer, false, weather.wetness)) { hits++ }
                top = Math.Max(top, car.speed)
            }
            camHeading = car.heading + options.Get("look", "0").ToFloat()
            Game.Place(car, model, cam, terrain, view, obstacles, chase, camHeading, hood, 0.0)
            // --foot s: anhalten, aussteigen und so viele Sekunden gehen (--turn: drehen dabei, --sprint 1)
            float foot = options.Get("foot", "0").ToFloat()
            if (foot > 0.0) {
                car.speed = 0.0
                bool out = Game.GetOut(car, walker, obstacles)
                float turn = options.Get("turn", "0").ToFloat()
                for (float t = 0.0; t < foot; t = t + dt) { Game.Walk(walker, car, obstacles, dt, 1.0, turn, options.Get("sprint", "") != "") }
                camHeading = walker.heading + options.Get("look", "0").ToFloat()
                Game.PlaceWalker(walker, person, cam, terrain, view, obstacles, chase, camHeading, hood, 0.0)
                print("zu Fuß " + foot + " s (ausgestiegen: " + out + "): " + Game.Distance(car, walker) + " m vom Wagen, Richtung " + Math.Round(walker.heading) + "°, Kamera " + chase.distance + " m")
                onFoot = true
            }
            view.lead = Math.Abs(car.speed) * 2.5
            view.Fill(car.east, car.north)
            atmosphere.Update(car.east, car.north, 0.0)
            model.beam.Enabled = weather.lampsOn
            if (weather.rain > 0.0) {
                for (int k = 0; k < 30; k++) { scene.Advance(0.1s) }
            }
            cam.Render()
            Game.Hud(hud, ink, shade, car, weather, height, onFoot, onFoot && Game.Distance(car, walker) < 3.5)
            print("Probefahrt " + auto + " s: bis " + Math.Round(top * 3.6) + " km/h, jetzt " + Math.Round(car.speed * 3.6) + " km/h bei " + car.east + ", " + car.north + " (Richtung " + Math.Round(car.heading) + "°), " + hits + " Aufpralle, Grip " + car.grip + ", Kamera " + chase.distance + " m")
            if (shot != "") {
                IO.File.WriteAllBytes(shot, fb.ToPng())
                print(shot)
            }
            view.Close()
            return 0
        }

        var win = new Window(fb, "Ruhrpott-Raser")
        win.EnableEvents()
        bool gas = false
        bool brake = false
        bool left = false
        bool right = false
        bool handbrake = false
        bool reverse = false
        bool sprint = false
        string presets[] = ["klar", "wolkig", "bedeckt", "niesel", "regen", "starkregen", "dunst", "nebel", "dichter-nebel"]
        int presetIndex = 0
        int last = DateTime.Now.Ticks
        while (win.Tick()) {
            any ev = win.NextEvent()
            while (ev != undefined) {
                if (ev[0] == EventType.KeyDown || ev[0] == EventType.KeyUp) {
                    bool pressed = ev[0] == EventType.KeyDown
                    int key = ev[1]
                    if (key == 119 || key == 1073741906) { gas = pressed }
                    else if (key == 115 || key == 1073741905) { brake = pressed }
                    else if (key == 97 || key == 1073741904) { left = pressed }
                    else if (key == 100 || key == 1073741903) { right = pressed }
                    else if (key == 32) { handbrake = pressed }
                    else if (key == 1073742049 || key == 1073742053) { sprint = pressed }
                    else if (pressed && key == 101) {
                        // E: aussteigen (im Stand) bzw. einsteigen (am Wagen)
                        if (onFoot) {
                            if (Game.Distance(car, walker) < 3.5) {
                                onFoot = false
                                person.Show(false)
                                camHeading = car.heading
                                reverse = false
                            }
                        } else if (Math.Abs(car.speed) < 1.5 && Game.GetOut(car, walker, obstacles)) {
                            car.speed = 0.0
                            onFoot = true
                            camHeading = walker.heading
                        }
                    }
                    else if (pressed && key == 99) { hood = !hood }
                    else if (pressed && (key == 116 || key == 103)) {
                        float step = 0.5
                        if (key == 103) { step = 23.5 }
                        weather.hour = (weather.hour + step) % 24.0
                        weather.Update()
                        atmosphere.Apply()
                    } else if (pressed && key == 114) {
                        presetIndex = (presetIndex + 1) % presets.length
                        weather.Preset(presets[presetIndex])
                        atmosphere.Apply()
                    }
                }
                ev = win.NextEvent()
            }
            int now = DateTime.Now.Ticks
            float dt = Math.Min((now - last) / 10000000.0, 0.1)
            last = now
            // S bremst; im Stand legt es den Rückwärtsgang ein, W wieder den Vorwärtsgang
            float throttle = 0.0
            float braking = 0.0
            if (gas) {
                if (reverse && car.speed < -0.5) { braking = 1.0 } else {
                    reverse = false
                    throttle = 1.0
                }
            }
            if (brake) {
                if (!reverse && car.speed > 0.5) { braking = 1.0 } else {
                    reverse = true
                    throttle = 1.0
                }
            }
            if (handbrake) { braking = 1.0 }
            float steer = 0.0
            if (left) { steer = 1.0 }
            if (right) { steer = -1.0 }
            if (onFoot) {
                // der Wagen steht (rollt aus), der Spieler geht: W/S vor und zurück, A/D drehen, Umschalt rennt
                Game.Advance(car, obstacles, dt, 0.0, 1.0, 0.0, false, weather.wetness)
                float forward = 0.0
                if (gas) { forward = 1.0 }
                if (brake) { forward = -1.0 }
                Game.Walk(walker, car, obstacles, dt, forward, steer, sprint)
                float diff = walker.heading - camHeading
                camHeading = camHeading + diff * Math.Min(1.0, dt * 6.0)
                Game.PlaceCar(car, model, terrain, view)
                Game.PlaceWalker(walker, person, cam, terrain, view, obstacles, chase, camHeading, hood, dt)
                view.lead = 0.0
                view.near = near
                view.Update(walker.east, walker.north, 12.0)
                atmosphere.Update(walker.east, walker.north, dt)
            } else {
                Game.Advance(car, obstacles, dt, throttle, braking, steer, reverse, weather.wetness)
                // die Kamera dreht dem Wagen weich nach
                float diff = car.heading - camHeading
                camHeading = camHeading + diff * Math.Min(1.0, dt * 4.0)
                Game.Place(car, model, cam, terrain, view, obstacles, chase, camHeading, hood, dt)
                view.lead = Math.Abs(car.speed) * 2.5
                if (Math.Abs(car.speed) > 35.0) { view.near = -1 } else { view.near = near }
                float h = car.heading * Math.PI / 180.0
                view.Update(car.east - Math.Sin(h) * view.lead, car.north + Math.Cos(h) * view.lead, 12.0)
                atmosphere.Update(car.east, car.north, dt)
            }
            model.beam.Enabled = weather.lampsOn && !onFoot
            scene.Advance(dt * 1s)
            cam.Render()
            Game.Hud(hud, ink, shade, car, weather, height, onFoot, onFoot && Game.Distance(car, walker) < 3.5)
        }
        view.Close()
        return 0
    }

    // Ein Schritt des Wagens mit Aufprall an Gebäuden (in Teilschritten von höchstens 0,5 m): der Wagen rutscht an Wänden entlang. true: aufgeprallt.
    static defined bool Advance(Raser.Vehicle car, Obstacles obstacles, defined float dt, defined float throttle, defined float brake, defined float steer, defined bool reverse, defined float wetness) {
        int parts = Math.Max(1, Math.Ceiling(Math.Abs(car.speed) * dt / 0.5)!int)
        bool hit = false
        for (int i = 0; i < parts; i++) {
            float e0 = car.east
            float n0 = car.north
            car.Step(dt / parts, throttle, brake, steer, reverse, wetness)
            // zwei Kreise (vorn, hinten) gegen die Wände
            for (int c = 0; c < 2; c++) {
                float offset = 1.2 - 2.4 * c
                float h = car.heading * Math.PI / 180.0
                if (obstacles.Push(car.east - Math.Sin(h) * offset, car.north + Math.Cos(h) * offset, 1.0)) {
                    if (car.Collide(offset, obstacles.pushX, obstacles.pushY, obstacles.depth) > 0.5) { hit = true }
                }
            }
        }
        return hit
    }

    // Der Wagen in die Szene, auf das Gelände.
    static undefined PlaceCar(Raser.Vehicle car, CarModel model, Ground terrain, WorldView view) {
        float y = 0.0
        any g = terrain.At(car.east, car.north)
        if (g != undefined) { y = g - view.originZ }
        model.Place(car.east - view.originE, y, -(car.north - view.originN), car.heading)
    }

    // Die Kamera zu einem Punkt (Wagen oder Spieler, Richtung heading): reach m dahinter und up m hoch, Blick voraus; first: aus seinen Augen
    // (eye m hoch). Vor einer Wand rückt sie heran und höher, weich wieder hinaus.
    static undefined Look(Camera cam, Ground terrain, WorldView view, Obstacles obstacles, Chase chase, defined float east, defined float north, defined float heading, defined float camHeading, defined bool first, defined float dt, defined float reach, defined float up, defined float eye) {
        float x = east - view.originE
        float z = -(north - view.originN)
        float y = 0.0
        any g = terrain.At(east, north)
        if (g != undefined) { y = g - view.originZ }
        if (first) {
            float ch = heading * Math.PI / 180.0
            cam.SetPosition((x - Math.Sin(ch) * 0.4) * 1m, (y + eye) * 1m, (z - Math.Cos(ch) * 0.4) * 1m)
            cam.LookAt((x - Math.Sin(ch) * 30.0) * 1m, (y + eye - 0.25) * 1m, (z - Math.Cos(ch) * 30.0) * 1m)
            return
        }
        float h = camHeading * Math.PI / 180.0
        float fx = -Math.Sin(h)
        float fz = -Math.Cos(h)
        float free = reach
        float nearest = 1.0
        if (reach > 5.0) { nearest = 1.5 }
        for (float d = nearest; d <= reach; d = d + 0.5) {
            if (obstacles.Blocked(east - fx * d, north + fz * d, 0.6)) {
                free = d - 0.5
                break
            }
        }
        if (dt <= 0.0 || free < chase.distance) { chase.distance = free } else { chase.distance = Math.Min(free, chase.distance + 4.0 * dt) }
        float back = Math.Max(chase.distance, nearest - 0.5)
        float cx = x - fx * back
        float cz = z - fz * back
        // dicht dran höher: der Blick geht über das Dach bzw. den Kopf
        float cy = y + up + Math.Max(0.0, reach * 0.5 - back) * 0.6
        any gc = terrain.At(view.originE + cx, view.originN - cz)
        if (gc != undefined) { cy = Math.Max(cy, gc - view.originZ + 1.0) }
        cam.SetPosition(cx * 1m, cy * 1m, cz * 1m)
        cam.LookAt((x + fx * reach) * 1m, (y + up * 0.5) * 1m, (z + fz * reach) * 1m)
    }

    // Wagen und Kamera (hinter dem Wagen oder auf der Haube).
    static undefined Place(Raser.Vehicle car, CarModel model, Camera cam, Ground terrain, WorldView view, Obstacles obstacles, Chase chase, defined float camHeading, defined bool hood, defined float dt) {
        Game.PlaceCar(car, model, terrain, view)
        Game.Look(cam, terrain, view, obstacles, chase, car.east, car.north, car.heading, camHeading, hood, dt, 7.0, 2.6, 1.25)
    }

    // Aussteigen: der Spieler neben die Fahrertür (links), sonst rechts; false: kein Platz.
    static defined bool GetOut(Raser.Vehicle car, Raser.Walker walker, Obstacles obstacles) {
        float h = car.heading * Math.PI / 180.0
        foreach (side in [1.0, -1.0]) {
            float e = car.east - Math.Cos(h) * 1.7 * side
            float n = car.north - Math.Sin(h) * 1.7 * side
            if (obstacles.Blocked(e, n, 0.4)) { continue }
            walker.east = e
            walker.north = n
            walker.heading = car.heading
            walker.speed = 0.0
            return true
        }
        return false
    }

    // Ein Schritt des Spielers: Wände und der Wagen halten ihn auf.
    static undefined Walk(Raser.Walker walker, Raser.Vehicle car, Obstacles obstacles, defined float dt, defined float forward, defined float turn, defined bool sprint) {
        walker.Step(dt, forward, turn, sprint)
        if (obstacles.Push(walker.east, walker.north, 0.35)) { walker.Push(obstacles.pushX, obstacles.pushY, obstacles.depth) }
        float h = car.heading * Math.PI / 180.0
        foreach (offset in [1.2, 0.0, -1.2]) {
            walker.Avoid(car.east - Math.Sin(h) * offset, car.north + Math.Cos(h) * offset, 0.95)
        }
    }

    // Spieler (Figur) und Kamera zu Fuß.
    static undefined PlaceWalker(Raser.Walker walker, PersonModel person, Camera cam, Ground terrain, WorldView view, Obstacles obstacles, Chase chase, defined float camHeading, defined bool first, defined float dt) {
        float y = 0.0
        any g = terrain.At(walker.east, walker.north)
        if (g != undefined) { y = g - view.originZ }
        person.Place(walker.east - view.originE, y, -(walker.north - view.originN), walker.heading, walker.stride)
        person.Show(!first)
        Game.Look(cam, terrain, view, obstacles, chase, walker.east, walker.north, walker.heading, camHeading, first, dt, 3.5, 2.1, 1.65)
    }

    static defined float Distance(Raser.Vehicle car, Raser.Walker walker) {
        return Math.Sqrt((car.east - walker.east) * (car.east - walker.east) + (car.north - walker.north) * (car.north - walker.north))
    }

    // Die Anzeige: Tempo, Uhrzeit, Wetter; "rutscht", wenn die Reifen nicht halten.
    static undefined Hud(Renderer hud, Brush ink, Brush shade, Raser.Vehicle car, Raser.Weather weather, defined int height, defined bool onFoot, defined bool atCar) {
        hud.FillRect(12, height - 44, 330, 32, shade)
        int minutes = Math.Floor(weather.hour * 60.0)!int
        string clock = (minutes / 60) + ":" + ((minutes % 60) / 10) + ((minutes % 60) % 10)
        string text = Math.Round(Math.Abs(car.speed) * 3.6) + " km/h   " + clock
        // (die Schrift der Anzeige kennt kein ß)
        if (onFoot) { text = "zu Fuss   " + clock }
        if (atCar) { text = text + "   E: einsteigen" }
        if (weather.rain > 0.0) { text = text + "   Regen" } else if (weather.fog > 0.0) { text = text + "   Nebel" }
        if (car.sliding && !onFoot) { text = text + "   rutscht" }
        hud.DrawText(22, height - 36, text, ink)
    }
}

Environment.Exit(Game.Main(Environment.Args))
