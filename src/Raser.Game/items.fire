// Raser.Game: Inventar, Gegenstände und Anzeigen im Spiel - das Inventar des Spielers (Raser.Inventory) und sein Körper (Raser.Body), die
// Gegenstände am Boden, der Rucksack auf dem Rücken und das Ding in der Hand als Modelle (ItemModels), die Taschenlampe als Licht, Rauch beim
// Rauchen, ein Passant zum Umfahren (Raser.Knockdown), das Fenster mit der Leiste (InventoryScreen), die Karte (Minimap) und der Tacho
// (Speedometer). main.fire ruft nur Handle, Sprint, Update, Draw und Shot.
//
// Tasten (siehe docs/INVENTAR.md): I/Tab Inventar, 1-6, Y/X (engl. Z/X), Q, Mausrad: Leiste; U oder rechte Maustaste: benutzen; T wegwerfen;
// F aufheben (ein Rucksack: auf den Rücken, wenn der frei ist, sonst öffnen); B den Rucksack absetzen; H Handy; M Karte; +/- Zoom der Karte.
#import "scene3d"
#import "scene3d.effects"
#import "graphics"
#import "time"
#import "filesystem"
#import "windows"
#import "raser.core"
#import "raser.client"

// Ein Passant zum Ausprobieren: steht am Straßenrand vor dem Start, hat ein Inventar und Bargeld; wer ihn anfährt (ab 2 m/s), haut ihn um
// (Raser.Knockdown) - seine Sachen liegen dann auf der Straße. Er bleibt 6 s liegen und steht wieder auf.
class Passant {
    PersonModel person
    Raser.Inventory inv
    defined float east
    defined float north
    defined float heading
    defined float down              // so lange liegt er noch (s)
    defined int knocks

    construct(Scene scene, Raser.ContainerStore store, Raser.ItemDrops drops, defined float east, defined float north, defined float heading) {
        this.person = new PersonModel(scene)
        // eine orange Jacke statt der grünen
        foreach (o in this.person.parts) {
            if (o.Color == S3D.Rgb(60, 110, 70)) { o.Color = S3D.Rgb(210, 110, 40) }
        }
        this.inv = new Raser.Inventory(store, drops)
        this.east = east
        this.north = north
        this.heading = heading
        this.down = 0.0
        this.knocks = 0
        this.inv.east = east
        this.inv.north = north
        this.inv.cash = 4720
        this.inv.Give(Raser.Items.Turnbeutel, 1)
        this.inv.Give(Raser.Items.Handy, 1)
        this.inv.Give(Raser.Items.Broetchen, 2)
        this.inv.Give(Raser.Items.Wasser, 2)
        this.inv.Give(Raser.Items.Zigaretten, 6)
        this.inv.Give(Raser.Items.Taschenlampe, 1)
    }

    // Je Bild: angefahren? Dann umhauen (der Samen aus der Uhr - online entscheidet das später der Server). Gibt das Ergebnis oder undefined.
    Raser.KnockResult Hit(Raser.Vehicle car, defined bool driving, defined float dt) {
        this.down = Math.Max(0.0, this.down - dt)
        if (!driving || this.down > 0.0 || Math.Abs(car.speed) < 2.0) { return undefined }
        float h = car.heading * Math.PI / 180.0
        foreach (part in [1.0, 0.0, -1.0]) {
            float ce = car.east - Math.Sin(h) * car.spread * part
            float cn = car.north + Math.Cos(h) * car.spread * part
            float d = Math.Sqrt((ce - this.east) * (ce - this.east) + (cn - this.north) * (cn - this.north))
            if (d < car.radius + 0.3) { return this.Knock(DateTime.Now.Ticks & 2147483647, Math.Abs(car.speed)) }
        }
        return undefined
    }

    Raser.KnockResult Knock(defined int seed, defined float impact) {
        this.down = 6.0
        this.knocks++
        this.inv.east = this.east
        this.inv.north = this.north
        return Raser.Knockdown.Apply(this.inv, seed, impact)
    }

    undefined Place(Ground terrain, WorldView view) {
        float y = 0.0
        any g = terrain.At(this.east, this.north)
        if (g != undefined) { y = g - view.originZ }
        float x = this.east - view.originE
        float z = -(this.north - view.originN)
        if (this.down > 0.0) { this.person.Sit(x, y, z, this.heading, 0.12, 84.0) } else { this.person.Place(x, y, z, this.heading, 0.0) }
        this.person.Show(true)
    }
}

class Gear {
    Raser.ContainerStore store
    Raser.ItemDrops drops
    Raser.Inventory inv
    Raser.Body body
    InventoryScreen screen
    Minimap map
    Speedometer tacho
    ItemModels models
    Scene scene
    List<Object> dropObjects        // je Gegenstand am Boden ein Objekt (dropIds: zu welchem)
    List<int> dropIds
    List<int> dropItems
    defined int seen                // drops.changes beim letzten Abgleich
    Object bag                      // der Rucksack auf dem Rücken (bagItem: welcher)
    defined int bagItem
    Object held                     // das Ding in der Hand (heldItem: welches)
    defined int heldItem
    Light lamp
    Emitter smoke
    Object cigarette
    Passant passant
    string hint                     // was F gerade täte ("": nichts)
    defined bool sprinting
    defined int frames

    defined float knockAt           // --knock v: im ersten Bild zu Fuß den Spieler mit v m/s umhauen (0: nicht)
    defined float hitPassant        // --hit-passant v: im ersten Bild den Passanten mit v m/s umfahren (wie angefahren, Samen 11)

    construct(Scene scene, Obstacles obstacles, Raser.Vehicle car, Options options) {
        this.knockAt = options.Get("knock", "0").ToFloat()
        this.hitPassant = options.Get("hit-passant", "0").ToFloat()
        this.scene = scene
        this.store = new Raser.ContainerStore()
        this.drops = new Raser.ItemDrops()
        this.inv = new Raser.Inventory(this.store, this.drops, 5, 4)
        this.body = new Raser.Body()
        this.inv.body = this.body
        this.screen = new InventoryScreen(this.inv)
        this.screen.body = this.body
        this.map = new Minimap(obstacles)
        this.tacho = new Speedometer()
        this.models = new ItemModels()
        this.dropObjects = new List<Object>()
        this.dropIds = new List<int>()
        this.dropItems = new List<int>()
        this.seen = -1
        this.bag = undefined
        this.bagItem = 0
        this.held = undefined
        this.heldItem = 0
        var l = Light.Point(0m, 0m, 0m, S3D.Rgb(255, 245, 215), 1.8)
        l.Range = 14m
        l.Cutoff = 20m
        l.CastShadows = false
        l.Enabled = false
        this.lamp = l
        scene.Add(take l)
        var e = Emitter.Smoke(0m, 0m, 0m)
        e.Rate = 7.0
        e.MaxParticles = 40
        e.Lifetime = 2.2s
        e.Speed = 0.25m / 1s
        e.Spread = 25deg
        e.StartSize = 0.04m
        e.EndSize = 0.3m
        e.StartColor = S3D.Rgba(225, 225, 225, 150)
        e.EndColor = S3D.Rgba(200, 200, 205, 0)
        e.SetGravity(0m / 1s / 1s, 0.15m / 1s / 1s, 0m / 1s / 1s)
        e.Running = false
        this.smoke = e
        scene.Add(take e)
        var cig = new Object(Template.Box, 0m, 0m, 0m, 0.012m, 0.012m, 0.08m)
        cig.Color = S3D.Rgb(245, 245, 240)
        cig.Visible = false
        this.cigarette = cig
        scene.Add(take cig)
        this.hint = ""
        this.sprinting = false
        this.frames = 0
        this.Starter()
        this.Scatter(obstacles, car)
        // der Passant: 22 m vor dem Start am rechten Rand der Fahrbahn, mit Blick zur Straße
        float h = car.heading * Math.PI / 180.0
        this.passant = new Passant(scene, this.store, this.drops, car.east - Math.Sin(h) * 22.0 + Math.Cos(h) * 1.2, car.north + Math.Cos(h) * 22.0 + Math.Sin(h) * 1.2, car.heading + 90.0)
    }

    // Was der Spieler am Anfang dabeihat: Handy, Schlüssel, 23,50 € Bargeld, Brötchen, Zigaretten - und einen Rucksack mit Wasser, Lampe, Werkzeug.
    undefined Starter() {
        var inv = this.inv
        inv.Give(Raser.Items.Handy, 1)
        inv.Give(Raser.Items.Schluessel, 1)
        inv.cash = 2350
        inv.Give(Raser.Items.Broetchen, 3)
        inv.Give(Raser.Items.Zigaretten, 7)
        inv.Give(Raser.Items.Rucksack, 1)
        inv.Give(Raser.Items.Wasser, 2)
        inv.Give(Raser.Items.Taschenlampe, 1)
        inv.Give(Raser.Items.Werkzeug, 1)
    }

    // Zum Ausprobieren liegen links neben dem Wagen ein Turnbeutel (mit Pommes, Wasser, Zigaretten), ein leerer Trekkingrucksack, ein Kanister,
    // 12,50 € Kleingeld, Brötchen und Pommes - je 2 bis 10 m vom Startpunkt, nicht in Gebäuden.
    undefined Scatter(Obstacles obstacles, Raser.Vehicle car) {
        int kinds[] = [Raser.Items.Turnbeutel, Raser.Items.Trekkingrucksack, Raser.Items.Kanister, Raser.Items.Geld, Raser.Items.Broetchen, Raser.Items.Pommes]
        int counts[] = [1, 1, 1, 1250, 4, 1]
        float along[] = [1.0, 4.0, -2.0, 6.5, -4.5, 9.0]
        float h = car.heading * Math.PI / 180.0
        float fe = -Math.Sin(h)
        float fn = Math.Cos(h)
        // links ist (-cos, -sin): dort steigt der Spieler aus
        float le = -Math.Cos(h)
        float ln = -Math.Sin(h)
        for (int i = 0; i < kinds.length; i++) {
            foreach (side in [2.6, 3.6, 1.8, 4.6, -2.6]) {
                float e = car.east + fe * along[i] + le * side
                float n = car.north + fn * along[i] + ln * side
                if (obstacles.Blocked(e, n, 0.3)) { continue }
                int data = this.store.DataFor(kinds[i])
                this.drops.Add(e, n, kinds[i], counts[i], data)
                if (kinds[i] == Raser.Items.Turnbeutel) {
                    var c = this.store.Find(data)
                    c.Add(Raser.Items.Pommes, 1, 0)
                    c.Add(Raser.Items.Wasser, 3, 0)
                    c.Add(Raser.Items.Zigaretten, 10, 0)
                }
                break
            }
        }
    }

    defined bool Busy { get { return this.screen.open } }

    // Ein Ereignis des Fensters (nach Chat und Konsole); true: verbraucht.
    defined bool Handle(any ev, defined bool onFoot, Raser.Walker walker) {
        if (this.screen.Handle(ev)) { return true }
        if (ev[0] != EventType.KeyDown) { return false }
        int key = ev[1]
        if (this.map.Key(key)) { return true }
        if (key == 102) {
            if (onFoot) { this.Interact() }
            return true
        }
        if (key == 98) {
            // B: den Rucksack absetzen (mit Inhalt)
            if (!onFoot) { return true }
            if (this.inv.BackpackItem() == 0) { this.screen.Say("Kein Rucksack auf dem Rücken") } else { this.screen.Record(this.inv.DropAll(this.inv.backpackSlot, 0)) }
            return true
        }
        return false
    }

    // Rennen nur mit Puste (main.fire fragt je Bild): gibt, ob er rennen darf.
    defined bool Sprint(defined bool want, defined float forward) {
        this.sprinting = want && forward > 0.0 && this.body.CanSprint
        return this.sprinting
    }

    // F: den nächsten Gegenstand aufheben - ein Rucksack kommt auf den Rücken, wenn der frei ist; sonst wird er geöffnet. Geld wird Bargeld.
    undefined Interact() {
        var d = this.drops.Nearest(this.inv.east, this.inv.north, this.inv.reach)
        if (d == undefined) { return }
        var t = Raser.Items.Get(d.item)
        if (t.IsBackpack && this.inv.BackpackItem() != 0) {
            if (this.inv.Open(d.id)) { this.screen.Show() }
            return
        }
        int count = d.count
        var op = new Raser.InvOp(Raser.InvOp.PickUp, 0, 0, 0, 0, 0)
        op.drop = d.id
        if (this.inv.Apply(op)) {
            if (t.id == Raser.Items.Geld) { this.screen.Say(HudStyle.Money(count) + " aufgehoben") } else { this.screen.Say(t.name + " aufgehoben") }
            this.screen.Record(op)
        } else { this.screen.Say("Kein Platz für " + t.name) }
    }

    // Das nächste Fahrzeug bis reach m (für Kanister und Werkzeug); undefined: keins.
    static Raser.Vehicle NearestVehicle(List<Raser.Vehicle> vehicles, defined float e, defined float n, defined float reach) {
        Raser.Vehicle found = undefined
        float best = reach * reach
        foreach (v in vehicles) {
            float d2 = (v.east - e) * (v.east - e) + (v.north - n) * (v.north - n)
            if (d2 <= best) {
                best = d2
                found = v
            }
        }
        return found
    }

    // Je Bild (vor dem Rendern): Körper, Lage fürs Inventar, Tempo aus der Last, das Fahrzeug für Kanister und Werkzeug, die Modelle am Boden, auf
    // dem Rücken und in der Hand, Lampe und Rauch, der Passant, der Hinweis für F.
    undefined Update(defined float dt, Raser.Walker walker, defined bool onFoot, Raser.Vehicle car, PersonModel person, Ground terrain, WorldView view, Raser.Weather weather, List<Raser.Vehicle> vehicles) {
        this.frames++
        this.body.Step(dt, onFoot && this.sprinting)
        if (onFoot) {
            this.inv.east = walker.east
            this.inv.north = walker.north
            this.inv.vehicle = Gear.NearestVehicle(vehicles, walker.east, walker.north, this.inv.vehicleReach)
        } else {
            this.inv.east = car.east
            this.inv.north = car.north
            this.inv.vehicle = car
        }
        if (this.knockAt > 0.0 && onFoot) {
            // --knock: umgehauen (Samen 7)
            var r = Raser.Knockdown.Apply(this.inv, 7, this.knockAt)
            print("Umgehauen mit " + this.knockAt + " m/s: " + r.ToString() + ", Bargeld jetzt " + HudStyle.Money(this.inv.cash))
            this.knockAt = 0.0
        }
        walker.load = this.inv.SpeedFactor()
        this.screen.clockMinutes = Math.Floor(weather.hour * 60.0)!int
        // der Passant
        var hit = this.passant.Hit(car, !onFoot, dt)
        if (this.hitPassant > 0.0) {
            hit = this.passant.Knock(11, this.hitPassant)
            this.hitPassant = 0.0
        }
        if (hit != undefined) {
            this.screen.Say("Passant umgefahren: " + hit.ToString())
            print("Passant umgefahren: " + hit.ToString())
        }
        this.passant.Place(terrain, view)
        if (this.seen != this.drops.changes) {
            this.seen = this.drops.changes
            this.Sync(terrain, view)
        }
        float y = 0.0
        any g = terrain.At(walker.east, walker.north)
        if (g != undefined) { y = g - view.originZ }
        bool visible = onFoot && person.visible && !person.sitting
        this.PlaceBag(walker, visible, y, view)
        this.PlaceHeld(walker, visible, y, view)
        // die Lampe: 3 m vor dem Spieler, 1,2 m hoch
        float h = walker.heading * Math.PI / 180.0
        this.lamp.Enabled = onFoot && this.inv.LampShining()
        if (this.lamp.Enabled) {
            this.lamp.X = (walker.east - Math.Sin(h) * 3.0 - view.originE) * 1m
            this.lamp.Y = (y + 1.2) * 1m
            this.lamp.Z = -(walker.north + Math.Cos(h) * 3.0 - view.originN) * 1m
        }
        // Rauch vor dem Gesicht
        bool smoking = onFoot && this.body.smoke > 0.0
        this.smoke.Running = smoking
        this.cigarette.Visible = smoking && visible
        if (smoking) {
            float me = walker.east - Math.Sin(h) * 0.2
            float mn = walker.north + Math.Cos(h) * 0.2
            this.smoke.SetPosition((me - Math.Sin(h) * 0.05 - view.originE) * 1m, (y + 1.56) * 1m, -(mn + Math.Cos(h) * 0.05 - view.originN) * 1m)
            this.cigarette.SetPosition((me - view.originE) * 1m, (y + 1.55) * 1m, -(mn - view.originN) * 1m)
            this.cigarette.RotationY = walker.heading * 1deg
        }
        this.hint = ""
        if (onFoot && !this.screen.open) {
            var d = this.drops.Nearest(this.inv.east, this.inv.north, this.inv.reach)
            if (d != undefined) {
                var t = Raser.Items.Get(d.item)
                if (t.IsBackpack && this.inv.BackpackItem() != 0) { this.hint = "F: " + t.name + " öffnen" }
                else if (d.item == Raser.Items.Geld) { this.hint = "F: " + HudStyle.Money(d.count) + " aufheben" }
                else { this.hint = "F: " + t.name + " aufheben" }
            }
        }
    }

    // Die Objekte der Gegenstände am Boden: je Gegenstand eins (das Modell seiner Art), auf das Gelände gestellt, etwas gedreht. Objekte, deren
    // Gegenstand weg ist, werden versteckt und für dieselbe Art wieder benutzt.
    undefined Sync(Ground terrain, WorldView view) {
        // erst alle frei
        var used = new List<bool>()
        for (int i = 0; i < this.dropObjects.Count; i++) { used.Add(false) }
        foreach (d in this.drops.all) {
            int at = this.dropIds.IndexOf(d.id)
            if (at < 0 || this.dropItems[at] != d.item) {
                // ein freies Objekt derselben Art, sonst ein neues
                at = -1
                for (int i = 0; i < this.dropObjects.Count && at < 0; i++) {
                    if (!used[i] && this.dropItems[i] == d.item && this.drops.Find(this.dropIds[i]) == undefined) { at = i }
                }
                if (at < 0) {
                    var o = this.models.Make(d.item, false)
                    this.dropObjects.Add(o)
                    this.scene.Add(take o)
                    this.dropIds.Add(d.id)
                    this.dropItems.Add(d.item)
                    used.Add(false)
                    at = this.dropObjects.Count - 1
                }
                this.dropIds[at] = d.id
            }
            used[at] = true
            float y = 0.0
            any g = terrain.At(d.east, d.north)
            if (g != undefined) { y = g - view.originZ }
            var obj = this.dropObjects[at]
            obj.SetPosition((d.east - view.originE) * 1m, y * 1m, -(d.north - view.originN) * 1m)
            obj.RotationY = ((d.id * 47) % 360) * 1deg
            obj.Visible = true
        }
        for (int i = 0; i < this.dropObjects.Count; i++) {
            if (!used[i]) {
                this.dropObjects[i].Visible = false
                this.dropIds[i] = 0
            }
        }
    }

    // Der Rucksack auf dem Rücken: sein Modell mit Riemen, oben an den Schultern (1,42 m), am Rücken (0,12 m hinter der Mitte).
    undefined PlaceBag(Raser.Walker walker, defined bool visible, defined float y, WorldView view) {
        int item = this.inv.BackpackItem()
        if (item != this.bagItem) {
            if (this.bag != undefined) { this.bag.Visible = false }
            this.bag = undefined
            this.bagItem = item
            if (item != 0) {
                var o = this.models.Make(item, true)
                this.bag = o
                this.scene.Add(take o)
            }
        }
        if (this.bag == undefined) { return }
        this.bag.Visible = visible
        if (!visible) { return }
        var t = Raser.Items.Get(item)
        float bh = 0.42
        if (item == Raser.Items.Turnbeutel) { bh = 0.4 }
        if (item == Raser.Items.Trekkingrucksack) { bh = 0.62 }
        float h = walker.heading * Math.PI / 180.0
        float e = walker.east + Math.Sin(h) * 0.12
        float n = walker.north - Math.Cos(h) * 0.12
        this.bag.SetPosition((e - view.originE) * 1m, (y + 1.42 - bh) * 1m, -(n - view.originN) * 1m)
        this.bag.RotationY = walker.heading * 1deg
    }

    // Das Ding in der Hand: der ausgewählte Gegenstand der Leiste, an der rechten Hand.
    undefined PlaceHeld(Raser.Walker walker, defined bool visible, defined float y, WorldView view) {
        int item = this.screen.HeldItem()
        if (item != this.heldItem) {
            if (this.held != undefined) { this.held.Visible = false }
            this.held = undefined
            this.heldItem = item
            if (item != 0) {
                var o = this.models.Make(item, false)
                this.held = o
                this.scene.Add(take o)
            }
        }
        if (this.held == undefined) { return }
        this.held.Visible = visible
        if (!visible) { return }
        float h = walker.heading * Math.PI / 180.0
        // rechts ist (cos, sin), vorn (-sin, cos)
        float right = 0.33
        float front = 0.06
        float up = 0.74
        var t = Raser.Items.Get(item)
        if (t.size == 3) { up = 0.3 }
        float e = walker.east + Math.Cos(h) * right - Math.Sin(h) * front
        float n = walker.north + Math.Sin(h) * right + Math.Cos(h) * front
        this.held.SetPosition((e - view.originE) * 1m, (y + up) * 1m, -(n - view.originN) * 1m)
        this.held.RotationY = walker.heading * 1deg
    }

    // Nach der Anzeige: Karte, Tacho (nur im Fahrzeug), der Hinweis für F, Leiste bzw. Fenster.
    undefined Draw(Renderer hud, defined int width, defined int height, Raser.Vehicle car, Raser.Walker walker, defined bool onFoot, List<Raser.Vehicle> vehicles) {
        float e = car.east
        float n = car.north
        float h = car.heading
        Raser.Vehicle driven = car
        if (onFoot) {
            e = walker.east
            n = walker.north
            h = walker.heading
            driven = undefined
        }
        this.map.Draw(hud, width, e, n, h, vehicles, driven, this.drops)
        if (!onFoot && !this.screen.open) { this.tacho.Draw(hud, width, height, car) }
        if (this.hint != "") {
            int w = this.screen.Width(hud, this.hint, 18, false) + 20
            int y = height - InventoryScreen.Size - 116
            this.screen.paint.Color = HudStyle.Color(0xA0101418)
            hud.FillRoundRect((width - w) / 2, y, w, this.screen.Height(hud, 18) + 10, 6, this.screen.paint)
            this.screen.Text(hud, (width - w) / 2 + 10, y + 5, this.hint, 0xFFFFFFFF, 18, false)
        }
        this.screen.Draw(hud, width, height)
    }

    // --inventory-test 1: eine Probe mit künstlichen Ereignissen wie vom Fenster (Tasten, Maus) - druckt, was geschah.
    undefined Rehearse(Raser.Walker walker, defined int width, defined int height) {
        var scratch = new Framebuffer(width, height)
        var sr = new Renderer(scratch)
        this.inv.east = walker.east
        this.inv.north = walker.north
        int before = this.drops.all.Count
        bool opened = this.Handle([EventType.KeyDown!int, 105, 0, 0, 0], true, walker) && this.screen.open
        this.screen.Draw(sr, width, height)
        // links auf den ersten Platz der Hosentaschen (der Schlüssel), dann neben das Fenster: weggeworfen
        SlotSpot first = undefined
        foreach (s in this.screen.spots) { if (s.container == this.inv.pockets && s.slot == 0) { first = s } }
        this.Handle([EventType.MouseMove!int, first.x + 10, first.y + 10, 0], true, walker)
        this.Handle([EventType.MouseDown!int, 1, first.x + 10, first.y + 10], true, walker)
        bool held = this.inv.Cursor().Item(0) == Raser.Items.Schluessel
        this.Handle([EventType.MouseDown!int, 1, 4, 4], true, walker)
        bool thrown = this.drops.all.Count == before + 1 && this.inv.Cursor().Empty(0)
        // Escape schließt; F hebt den Schlüssel wieder auf
        this.Handle([EventType.KeyDown!int, 27, 0, 0, 0], true, walker)
        bool closed = !this.screen.open
        this.Handle([EventType.KeyDown!int, 102, 0, 0, 0], true, walker)
        bool back = this.inv.Pockets().CountOf(Raser.Items.Schluessel) == 1 && this.drops.all.Count == before
        // B setzt den Rucksack ab, F nimmt ihn wieder auf den Rücken (mit Inhalt)
        int inside = this.inv.Backpack().Used()
        this.Handle([EventType.KeyDown!int, 98, 0, 0, 0], true, walker)
        bool down = this.inv.BackpackItem() == 0 && this.drops.all.Count == before + 1
        this.Handle([EventType.KeyDown!int, 102, 0, 0, 0], true, walker)
        bool up = this.inv.BackpackItem() == Raser.Items.Rucksack && this.inv.Backpack().Used() == inside
        // Umschalt+Klick auf das Wasser im Rucksack: in die Hände
        this.Handle([EventType.KeyDown!int, 105, 0, 0, 0], true, walker)
        this.screen.Draw(sr, width, height)
        var bp = this.inv.Backpack()
        foreach (s in this.screen.spots) {
            if (s.container == bp.id && s.slot == 0) {
                this.Handle([EventType.KeyDown!int, 1073742049, 0, 0, 0], true, walker)
                this.Handle([EventType.MouseDown!int, 1, s.x + 5, s.y + 5], true, walker)
                this.Handle([EventType.KeyUp!int, 1073742049, 0, 0, 0], true, walker)
            }
        }
        bool quick = this.inv.Hands().CountOf(Raser.Items.Wasser) == 2
        this.Handle([EventType.KeyDown!int, 9, 0, 0, 0], true, walker)
        print("Probe: offen " + opened + ", Schluessel an der Maus " + held + ", weggeworfen " + thrown + ", zu " + closed + ", wieder aufgehoben " + back + ", Rucksack abgesetzt " + down + ", wieder auf dem Ruecken " + up + ", Umschalt+Klick " + quick + ", Tab zu " + !this.screen.open + "; " + this.screen.done.Count + " Operationen")
        // die Leiste: 3 wählt die erste Hand (das Wasser), U trinkt; 1, X (Scancode 27) eins weiter, Y (29) zweimal: um die Ecke ans Ende, Q zurück
        this.body.water = 30.0
        this.Handle([EventType.KeyDown!int, 51, 0, 0, 0], true, walker)
        int sel3 = this.screen.selected
        this.Handle([EventType.KeyDown!int, 117, 0, 0, 0], true, walker)
        bool drank = this.body.water > 70.0 && this.inv.Hands().CountOf(Raser.Items.Wasser) == 1
        this.Handle([EventType.KeyDown!int, 49, 0, 0, 0], true, walker)
        this.Handle([EventType.KeyDown!int, 120, 27, 0, 0], true, walker)
        int afterX = this.screen.selected
        this.Handle([EventType.KeyDown!int, 121, 29, 0, 0], true, walker)
        this.Handle([EventType.KeyDown!int, 121, 29, 0, 0], true, walker)
        int wrapped = this.screen.selected
        this.Handle([EventType.KeyDown!int, 113, 0, 0, 0], true, walker)
        int back2 = this.screen.selected
        // T wirft den ausgewählten Stapel weg (das letzte Wasser), F hebt es wieder auf
        this.Handle([EventType.KeyDown!int, 51, 0, 0, 0], true, walker)
        int count0 = this.drops.all.Count
        this.Handle([EventType.KeyDown!int, 116, 0, 0, 0], true, walker)
        bool tossed = this.drops.all.Count == count0 + 1
        this.Handle([EventType.KeyDown!int, 102, 0, 0, 0], true, walker)
        print("Leiste: 3 -> " + sel3 + ", getrunken " + drank + ", 1 und X -> " + afterX + ", zweimal Y -> " + wrapped + ", Q -> " + back2 + ", T weggeworfen " + tossed + ", F wieder da " + (this.drops.all.Count == count0))
        // zurück wie vorher: das Wasser wieder in den Rucksack
        this.inv.Click(this.inv.hands, 0, 1, true)
        this.screen.Select(2)
    }

    // Ohne Fenster (--shot): mit --minimap 1 Karte und Schnellleiste ins Bild (--minimap north: genordet, --map-zoom 0|1|2); --inventory-shot bild.png: dazu ein zweites Bild mit offenem
    // Inventar - neben dem Turnbeutel am Boden (geöffnet), drei Brötchen an der Maus über dem Rucksack.
    undefined Shot(Options options, Renderer hud, Framebuffer fb, defined int width, defined int height, Raser.Vehicle car, Raser.Walker walker, defined bool onFoot, List<Raser.Vehicle> vehicles) {
        string path = options.Get("inventory-shot", "")
        if (options.Get("minimap", "") == "" && path == "") { return }
        // --select 3: diesen Platz der Leiste wählen (1 Tasche, 2 Handy, 3-6 Hände, 7-11 Hosentaschen); --use 1: ihn benutzen
        if (options.Get("select", "") != "") {
            this.screen.Select(options.Get("select", "1").ToInt() - 1)
            if (options.Get("use", "") != "") {
                this.screen.UseSelected()
                print("Benutzt: " + this.inv.message)
            }
        }
        // --minimap north: genordet; --map-zoom 0|1|2
        if (options.Get("minimap", "") == "north") { this.map.mode = 1 }
        this.map.zoom = Math.Clamp(options.Get("map-zoom", "1").ToInt(), 0, 2)
        int p0 = DateTime.Now.Ticks
        this.map.Prepare(car.east, car.north, 9)
        if (onFoot) { this.map.Prepare(walker.east, walker.north, 9) }
        print("Karte: " + this.map.tiles.Count + " Kacheln gezeichnet in " + ((DateTime.Now.Ticks - p0) / 10000.0) + " ms")
        // die Karte messen: 20-mal neu abgetastet (wie bei jeder Bewegung)
        int b0 = DateTime.Now.Ticks
        for (int i = 0; i < 20; i++) { this.map.Compose(car.east + i * 0.5, car.north, car.heading + i) }
        print("Karte abtasten: " + ((DateTime.Now.Ticks - b0) / 20 / 10000.0) + " ms je Bild")
        if (path == "") {
            this.Draw(hud, width, height, car, walker, onFoot, vehicles)
            print("Karte: " + (this.map.spentTicks / 10000.0) + " ms")
            return
        }
        if (options.Get("inventory-test", "") != "") { this.Rehearse(walker, width, height) }
        // der Kanister: daneben stellen und aufheben (in die Hände: das Tempo sinkt); der Turnbeutel: daneben stellen und öffnen; die Brötchen an
        // die Maus
        var all = new List<int>()
        foreach (d in this.drops.all) { if (d.item == Raser.Items.Kanister) { all.Add(d.id) } }
        foreach (id in all) {
            var k = this.drops.Find(id)
            this.inv.east = k.east
            this.inv.north = k.north
            var pick = new Raser.InvOp(Raser.InvOp.PickUp, 0, 0, 0, 0, 0)
            pick.drop = id
            print("Kanister aufgehoben: " + this.inv.Apply(pick) + ", Tempo " + this.inv.SpeedFactor())
        }
        foreach (d in this.drops.all) {
            if (d.item != Raser.Items.Turnbeutel) { continue }
            this.inv.east = d.east + 0.5
            this.inv.north = d.north
            this.inv.Open(d.id)
        }
        this.screen.Show()
        // --phone 1: dazu das Handy
        if (options.Get("phone", "") != "") { this.screen.phoneOpen = true }
        // (einmal zur Probe, für die Lage der Plätze)
        var scratch = new Framebuffer(width, height)
        var sr = new Renderer(scratch)
        this.screen.Draw(sr, width, height)
        var pockets = this.inv.Pockets()
        for (int i = 0; i < pockets.Size; i++) {
            if (pockets.Item(i) == Raser.Items.Broetchen) { this.inv.Click(this.inv.pockets, i, 1, false) }
        }
        // die Maus über einem freien Platz des Rucksacks
        var bp = this.inv.Backpack()
        foreach (s in this.screen.spots) {
            if (bp != undefined && s.container == bp.id && s.slot == 5) {
                this.screen.mouseX = s.x + 30
                this.screen.mouseY = s.y + 26
            }
        }
        this.screen.Draw(sr, width, height)
        this.screen.pointer = true
        this.hint = ""
        int t0 = DateTime.Now.Ticks
        this.Draw(hud, width, height, car, walker, onFoot, vehicles)
        print("Inventar und Karte: " + ((DateTime.Now.Ticks - t0) / 10000.0) + " ms (Karte " + (this.map.spentTicks / 10000.0) + " ms)")
        IO.File.WriteAllBytes(path, fb.ToPng())
        print(path)
    }
}
