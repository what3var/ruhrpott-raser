// Raser.Viewer: die Voxel-Welt mit scene3d betrachten (Roadmap M2: fahrbare Kamera durch die Testregion - der erste Renderer, noch ohne GPU).
//
//   raser-viewer [--world world] --at ost,nord [--radius 2] [--yaw 30] [--pitch -35] [--distance 60] [--size 960x600]
//   raser-viewer ... --shot bild.png      ein Bild ohne Fenster
//   raser-viewer ... --opaque             ohne Glas und Wasser
//   raser-viewer ... --workers 3          so viele Threads laden und vernetzen (0: im Hauptprogramm)
//   raser-viewer ... --fly 300 [--speed 15] [--budget 2] [--shot ende.png]
//                                         ohne Fenster geradeaus fliegen, nachladen und rendern; die Zeiten am Ende
//
// Im Fenster: W/S vor und zurück, A/D seitwärts, Q/E hoch und runter, Pfeile drehen, Umschalt schneller.
// Die Chunk-Säulen im Umkreis (radius in Chunks, 12,8 m) werden geladen und mit Raser.Mesh vernetzt; je Chunk und Farbe ein scene3d-Modell.
// Bewegt sich die Kamera, schickt das Hauptprogramm die nächsten fehlenden Säulen an Worker-Threads (lesen, vernetzen, Arrays bauen) und übernimmt
// je Bild höchstens `budget` fertige Säulen; Säulen weiter als radius + 1 werden entladen.
// Szene: x = Ost, y = oben, z = -Nord (scene3d: Y oben, die Kamera blickt nach -Z), Ursprung beim Zielpunkt.
#import "windows"
#import "scene3d"
#import "filesystem"
#import "time"
#import "raser.core"
#import "raser.world"
#import "raser.mesh"

class Options {
    Dictionary<string, string> values

    construct(string items[]) {
        this.values = new Dictionary<string, string>()
        int i = 0
        while (i < items.length) {
            string a = items[i]
            if (a.StartsWith("--") && i + 1 < items.length && !items[i + 1].StartsWith("--")) {
                this.values[a.Substring(2)] = items[i + 1]
                i = i + 2
            } else {
                if (a.StartsWith("--")) { this.values[a.Substring(2)] = "true" }
                i = i + 1
            }
        }
    }

    string Get(string name, string fallback) { return this.values.Get(name, fallback) }
}

// Ein Auftrag an die Worker: eine Chunk-Säule laden und vernetzen.
class ColumnJob {
    defined int cx
    defined int cy
    construct(defined int cx, defined int cy) { this.cx = cx; this.cy = cy }
}

// Was scene3d für ein Netz braucht (ein Chunk, eine Farbe, höchstens 16.000 Vierecke) - im Worker gebaut, im Hauptprogramm nur noch zu Model und Object.
class MeshBatch {
    defined int color
    defined float opacity
    defined int triangles
    float positions[]
    float uvs[]
    int indices[]
    construct() { }
}

// Das Ergebnis eines Auftrags.
class ColumnMesh {
    defined int cx
    defined int cy
    defined int chunks
    defined int loadTicks
    defined int meshTicks
    List<MeshBatch> batches
    construct(defined int cx, defined int cy) {
        this.cx = cx
        this.cy = cy
        this.batches = new List<MeshBatch>()
    }
}

// Ein Worker: liest Chunks (eigener Store, eigener Cache), vernetzt sie und baut die Arrays - alles ohne die Szene. Läuft im eigenen fire-Thread
// oder (ohne Worker) im Hauptprogramm.
class ColumnBuilder {
    Raser.FileTileStore store
    Dictionary<string, Raser.Chunk> chunks
    Dictionary<string, byte[]> faces                  // die Randschichten der Nachbarn (.rrb, entpackt)
    Dictionary<string, List<int>> layers
    HashSet<string> manifests
    defined float originE
    defined float originN
    defined float originZ
    defined bool opaqueOnly

    construct(string root, defined float e, defined float n, defined float z, defined bool opaqueOnly) {
        this.store = new Raser.FileTileStore(root)
        this.chunks = new Dictionary<string, Raser.Chunk>()
        this.faces = new Dictionary<string, byte[]>()
        this.layers = new Dictionary<string, List<int>>()
        this.manifests = new HashSet<string>()
        this.originE = e
        this.originN = n
        this.originZ = z
        this.opaqueOnly = opaqueOnly
    }

    Raser.Chunk ChunkAt(defined int cx, defined int cy, defined int cz) {
        string name = cx + "_" + cy + "_" + cz
        if (this.chunks.ContainsKey(name)) { return this.chunks[name] }
        var c = this.store.LoadChunk(new Raser.ChunkKey(cx, cy, cz))
        this.chunks[name] = c
        if (c != undefined) { c.TakeTo(this.chunks) }
        return c
    }

    // Eine Randschicht eines Chunks: aus seiner .rrb (zwischengespeichert), sonst aus dem Chunk selbst; undefined, wo kein Chunk ist.
    Raser.ChunkFace FaceOf(defined int cx, defined int cy, defined int cz, defined int side) {
        string name = cx + "_" + cy + "_" + cz
        if (this.chunks.ContainsKey(name)) { return Raser.ChunkFace.Of(this.chunks[name], side) }
        if (!this.faces.ContainsKey(name)) {
            var key = new Raser.ChunkKey(cx, cy, cz)
            if (this.LayersOf(cx, cy).Contains(cz)) {
                var bytes = this.store.LoadFaces(key)
                if (bytes == undefined) { return Raser.ChunkFace.Of(this.ChunkAt(cx, cy, cz), side) }
                this.faces[name] = bytes
                bytes.TakeTo(this.faces)
            } else {
                this.faces[name] = undefined
            }
        }
        var data = this.faces[name]
        if (data == undefined) { return undefined }
        return Raser.ChunkFace.Decode(data, side)
    }

    // Die Chunk-Ebenen einer Säule (leer: dort gibt es nichts).
    List<int> LayersOf(defined int cx, defined int cy) {
        string key = cx + "_" + cy
        string tile = new Raser.ChunkKey(cx, cy, 0).Tile().ToString()
        if (!this.manifests.Contains(tile)) {
            this.manifests.Add(tile)
            var m = this.store.LoadManifest(Raser.TileKey.Parse(tile))
            if (m != undefined) {
                foreach (s in m.keys) {
                    var k = Raser.ChunkKey.Parse(s)
                    string col = k.x + "_" + k.y
                    if (!this.layers.ContainsKey(col)) { this.layers[col] = new List<int>() }
                    this.layers[col].Add(k.z)
                }
            }
        }
        if (!this.layers.ContainsKey(key)) { this.layers[key] = new List<int>() }
        return this.layers[key]
    }

    ColumnMesh Build(defined int cx, defined int cy) {
        var result = new ColumnMesh(cx, cy)
        // ein einfacher Cache: zu groß geworden, fängt er neu an (die Nachbarn der nächsten Säulen kommen von der Platte)
        if (this.chunks.Count > 200) { this.chunks.Clear() }
        if (this.faces.Count > 2000) { this.faces.Clear() }
        foreach (z in this.LayersOf(cx, cy)) {
            int t0 = DateTime.Now.Ticks
            var chunk = this.ChunkAt(cx, cy, z)
            if (chunk == undefined) { continue }
            // von den Nachbarn nur die Randschicht, die diesen Chunk berührt
            var w = this.FaceOf(cx - 1, cy, z, 1)
            var e = this.FaceOf(cx + 1, cy, z, 0)
            var so = this.FaceOf(cx, cy - 1, z, 3)
            var no = this.FaceOf(cx, cy + 1, z, 2)
            var be = this.FaceOf(cx, cy, z - 1, 5)
            var ab = this.FaceOf(cx, cy, z + 1, 4)
            int t1 = DateTime.Now.Ticks
            var mesh = new Raser.Mesher(chunk, w, e, so, no, be, ab).Build()
            var key = new Raser.ChunkKey(cx, cy, z)
            this.Batches(result, key, mesh.opaque, 1.0)
            if (!this.opaqueOnly) { this.Batches(result, key, mesh.transparent, 0.45) }
            int t2 = DateTime.Now.Ticks
            result.loadTicks = result.loadTicks + (t1 - t0)
            result.meshTicks = result.meshTicks + (t2 - t1)
            result.chunks++
        }
        return result
    }

    undefined Batches(ColumnMesh result, Raser.ChunkKey k, Raser.MeshPart part, defined float opacity) {
        if (part.Count == 0) { return }
        float ox = k.VoxelX * 0.2 - this.originE
        float oy = k.VoxelY * 0.2 - this.originN
        float oz = k.VoxelZ * 0.2 - this.originZ
        var byColor = new Dictionary<int, List<int>>()
        for (int q = 0; q < part.Count; q++) {
            int c = part.colors[q]
            if (!byColor.ContainsKey(c)) { byColor[c] = new List<int>() }
            byColor[c].Add(q)
        }
        foreach (pair in byColor) {
            var all = pair.Value
            // höchstens 16.000 Vierecke (64.000 Ecken) je Netz: scene3d hält die Indizes in 16 Bit
            for (int first = 0; first < all.Count; first = first + 16000) {
                int n = Math.Min(16000, all.Count - first)
                var batch = new MeshBatch()
                batch.color = pair.Key
                batch.opacity = opacity
                batch.triangles = n * 2
                batch.positions = new float[n * 12]
                batch.uvs = new float[n * 8]
                batch.indices = new int[n * 6]
                for (int i = 0; i < n; i++) {
                    int q = all[first + i]
                    for (int c = 0; c < 4; c++) {
                        int src = q * 12 + c * 3
                        int dst = i * 12 + c * 3
                        batch.positions[dst] = ox + part.positions[src]
                        batch.positions[dst + 1] = oz + part.positions[src + 2]
                        batch.positions[dst + 2] = -(oy + part.positions[src + 1])
                        batch.uvs[i * 8 + c * 2] = 0.0
                        batch.uvs[i * 8 + c * 2 + 1] = 0.0
                    }
                    // die Vierecke sind von außen gegen den Uhrzeigersinn - so sieht scene3d die Vorderseite
                    batch.indices[i * 6] = i * 4
                    batch.indices[i * 6 + 1] = i * 4 + 1
                    batch.indices[i * 6 + 2] = i * 4 + 2
                    batch.indices[i * 6 + 3] = i * 4
                    batch.indices[i * 6 + 4] = i * 4 + 2
                    batch.indices[i * 6 + 5] = i * 4 + 3
                }
                result.batches.Add(take batch)
            }
        }
    }

    // Der Worker-Thread: Aufträge bis der Kanal zu ist.
    static undefined Work(Channel<ColumnJob> jobs, Channel<ColumnMesh> results, string root, defined float e, defined float n, defined float z, defined bool opaqueOnly) {
        var builder = new ColumnBuilder(root, e, n, z, opaqueOnly)
        foreach (job in jobs) { results.Send(builder.Build(job.cx, job.cy)) }
    }
}

// Die Welt um die Kamera, in Chunk-Säulen (12,8 x 12,8 m, alle Höhen), als scene3d-Objekte in der Szene. Geladen und vernetzt wird in Worker-Threads
// (oder, ohne Worker, im Hauptprogramm); das Hauptprogramm macht aus den fertigen Arrays Modelle und Objekte.
class WorldView {
    Scene scene
    ColumnBuilder local                                // ohne Worker
    Channel<ColumnJob> jobs
    Channel<ColumnMesh> results
    HashSet<string> pending                            // Aufträge unterwegs
    Dictionary<string, List<Model>> columnModels       // je Säule die Netze (gehören hierher)
    Dictionary<string, List<Object>> columnObjects     // je Säule die Objekte (gehören der Szene)
    defined float originE
    defined float originN
    defined float originZ
    defined int radius
    defined int workers
    defined int inFlight                               // so viele Aufträge höchstens gleichzeitig (die nächsten zuerst)
    defined int objects
    defined int triangles
    defined int loadedColumns
    defined int unloadedColumns
    defined int droppedColumns
    defined int loadTicks       // Zeit für Chunks lesen und entpacken (in den Workern)
    defined int meshTicks       // Zeit für Vernetzen und Arrays (in den Workern)
    defined int modelTicks      // Zeit für die scene3d-Modelle (im Hauptprogramm)

    construct(string root, Scene scene, defined float e, defined float n, defined float z, defined int radius, defined int workers, defined bool opaqueOnly) {
        this.scene = scene
        this.pending = new HashSet<string>()
        this.columnModels = new Dictionary<string, List<Model>>()
        this.columnObjects = new Dictionary<string, List<Object>>()
        this.originE = e
        this.originN = n
        this.originZ = z
        this.radius = radius
        this.workers = workers
        this.inFlight = workers * 2
        if (workers == 0) {
            this.local = new ColumnBuilder(root, e, n, z, opaqueOnly)
            return
        }
        this.jobs = new Channel<ColumnJob>(1024)
        this.results = new Channel<ColumnMesh>(1024)
        var jobs = this.jobs
        var results = this.results
        for (int i = 0; i < workers; i++) {
            fire taking root taking e taking n taking z taking opaqueOnly with jobs, results {
                ColumnBuilder.Work(jobs, results, root, e, n, z, opaqueOnly)
            }
        }
    }

    // Schließt den Auftragskanal: die Worker enden, wenn sie fertig sind.
    undefined Close() {
        if (this.jobs != undefined) { this.jobs.Close() }
    }

    defined bool Wanted(string col, defined int ccx, defined int ccy) {
        var p = col.Split("_")
        return Math.Abs(p[0].ToInt() - ccx) <= this.radius + 1 && Math.Abs(p[1].ToInt() - ccy) <= this.radius + 1
    }

    // Nimmt eine Säule aus der Szene und gibt ihre Netze frei.
    undefined UnloadColumn(string col) {
        foreach (o in this.columnObjects[col]) {
            this.triangles = this.triangles - o.Triangles
            this.objects--
            this.scene.Remove(o)
        }
        this.columnObjects.Remove(col)
        this.columnModels.Remove(col)
        this.unloadedColumns++
    }

    // Macht aus einem Ergebnis die Objekte der Säule.
    undefined Show(ColumnMesh cm) {
        int t0 = DateTime.Now.Ticks
        string col = cm.cx + "_" + cm.cy
        this.columnModels[col] = new List<Model>()
        this.columnObjects[col] = new List<Object>()
        foreach (b in cm.batches) {
            var model = Model.FromArrays(b.positions, b.uvs, b.indices)
            var obj = new Object(model)
            obj.KeepMeshCoordinates = true          // die Koordinaten des Netzes sind Welt-Koordinaten (Ursprung des Netzes an der Position 0, 0, 0)
            this.columnModels[col].Add(take model)
            int rgb = Raser.Palette.Rgb(b.color)
            obj.Color = S3D.Rgb((rgb >> 16) & 255, (rgb >> 8) & 255, rgb & 255)
            if (b.opacity < 1.0) { obj.Opacity = b.opacity }
            this.columnObjects[col].Add(obj)
            this.scene.Add(take obj)
            this.objects++
            this.triangles = this.triangles + b.triangles
        }
        this.loadedColumns++
        this.loadTicks = this.loadTicks + cm.loadTicks
        this.meshTicks = this.meshTicks + cm.meshTicks
        this.modelTicks = this.modelTicks + (DateTime.Now.Ticks - t0)
    }

    // Ein Schritt: entlädt Säulen weiter als radius + 1, übernimmt fertige Ergebnisse (höchstens `budget`; ohne Worker: lädt höchstens `budget`
    // Säulen selbst) und schickt die nächsten fehlenden Säulen an die Worker. Gibt zurück, wie viele Säulen im Umkreis noch fehlen.
    defined int Update(defined float e, defined float n, defined int budget) {
        int ccx = Raser.Grid.FloorDiv(Raser.Grid.VoxelOf(e), 64)
        int ccy = Raser.Grid.FloorDiv(Raser.Grid.VoxelOf(n), 64)
        var far = new List<string>()
        foreach (pair in this.columnObjects) {
            if (!this.Wanted(pair.Key, ccx, ccy)) { far.Add(pair.Key) }
        }
        foreach (col in far) { this.UnloadColumn(col) }
        if (this.workers > 0) {
            for (int i = 0; i < budget; i++) {
                var cm = this.results.TryReceive()
                if (cm == undefined) { break }
                string col = cm.cx + "_" + cm.cy
                this.pending.Remove(col)
                if (this.Wanted(col, ccx, ccy) && !this.columnObjects.ContainsKey(col)) { this.Show(cm) } else { this.droppedColumns++ }
            }
        }
        int missing = 0
        int localBudget = budget
        for (int r = 0; r <= this.radius; r++) {
            for (int dy = -r; dy <= r; dy++) {
                for (int dx = -r; dx <= r; dx++) {
                    if (Math.Max(Math.Abs(dx), Math.Abs(dy)) != r) { continue }
                    string col = (ccx + dx) + "_" + (ccy + dy)
                    if (this.columnObjects.ContainsKey(col)) { continue }
                    missing++
                    if (this.workers == 0) {
                        if (localBudget > 0) {
                            this.Show(this.local.Build(ccx + dx, ccy + dy))
                            localBudget--
                            missing--
                        }
                        continue
                    }
                    if (this.pending.Contains(col) || this.pending.Count >= this.inFlight) { continue }
                    this.pending.Add(col)
                    this.jobs.Send(new ColumnJob(ccx + dx, ccy + dy))
                }
            }
        }
        return missing
    }

    // Wartet, bis alles im Umkreis geladen ist (der Anfang).
    undefined Fill(defined float e, defined float n) {
        while (this.Update(e, n, 1000) > 0) {
            if (this.workers > 0) { Sleep(5ms) }
        }
    }

    // Wohin die Kamera am Boden blickt (Ost, Nord): der Schnitt des Blicks mit der Höhe des Ursprungs, höchstens 150 m vor der Kamera
    // (beim Blick nach oben oder geradeaus: 150 m). Um diesen Punkt wird geladen.
    float[] WorldOf(Camera cam) {
        float yaw = cam.RotationY / 1deg * Math.PI / 180.0
        float pitch = cam.RotationX / 1deg * Math.PI / 180.0
        float height = cam.Y / 1m
        float ahead = 150.0
        if (pitch < -0.01 && height > 0.0) { ahead = Math.Min(150.0, height / Math.Tan(-pitch)) }
        float x = cam.X / 1m - Math.Sin(yaw) * ahead
        float z = cam.Z / 1m - Math.Cos(yaw) * ahead
        float result[] = [this.originE + x, this.originN - z]
        return result
    }
}

class Viewer {
    static defined int Main(string items[]) {
        var options = new Options(items)
        var store = new Raser.FileTileStore(options.Get("world", "world"))
        string at = options.Get("at", "376130,5704900")
        var parts = at.Split(",")
        float e = parts[0].ToFloat()
        float n = parts[1].ToFloat()
        int radius = options.Get("radius", "2").ToInt()
        float yaw = options.Get("yaw", "30").ToFloat()
        float pitch = options.Get("pitch", "-35").ToFloat()
        float distance = options.Get("distance", "60").ToFloat()
        var size = options.Get("size", "960x600").Split("x")
        int width = size[0].ToInt()
        int height = size[1].ToInt()

        // Höhe des Bodens am Ziel aus dem Höhenraster der Kachel
        var tileKey = Raser.TileKey.Of(e, n)
        var tile = store.Load(tileKey)
        float ground = 0.0
        if (tile != undefined && tile.heights != undefined) { ground = tile.heights.At(e - tileKey.East, n - tileKey.North) }

        var fb = new Framebuffer(width, height)
        var scene = new Scene()
        scene.Shadows = false
        scene.AmbientIntensity = 0.45
        scene.Add(Light.Directional(-0.45, -1.0, -0.3))
        var cam = new Camera(fb)
        cam.FieldOfView = 60deg
        cam.Near = 0.2m
        cam.Far = 2000m
        cam.Background = S3D.Rgb(150, 170, 190)
        float yr = yaw * Math.PI / 180.0
        float pr = pitch * Math.PI / 180.0
        // Kamera hinter dem Ziel, Blick auf das Ziel
        float cx = Math.Sin(yr) * Math.Cos(pr) * distance
        float cz = Math.Cos(yr) * Math.Cos(pr) * distance
        float cy = -Math.Sin(pr) * distance
        cam.SetPosition(cx * 1m, cy * 1m, cz * 1m)
        cam.LookAt(0m, 0m, 0m)
        scene.Add(cam)
        int workers = options.Get("workers", "3").ToInt()
        var view = new WorldView(options.Get("world", "world"), scene, e, n, ground, radius, workers, options.Get("opaque", "") != "")
        int start = DateTime.Now.Ticks
        print("Lade Chunks um " + e + ", " + n + " (Radius " + radius + ", " + workers + " Worker)")
        var here = view.WorldOf(cam)
        view.Fill(here[0], here[1])
        print(view.objects + " Objekte, " + view.triangles + " Dreiecke in " + ((DateTime.Now.Ticks - start) / 10000000.0) + " s")

        // Ein Flug ohne Fenster in Echtzeit: geradeaus in Blickrichtung mit `speed` m/s, je Bild nachladen (höchstens `budget` fertige Säulen
        // übernehmen) und rendern; am Ende die Zeiten.
        float fly = options.Get("fly", "0").ToFloat()
        if (fly > 0.0) {
            float speed = options.Get("speed", "15").ToFloat()
            int budget = options.Get("budget", "2").ToInt()
            float h = cam.RotationY / 1deg * Math.PI / 180.0
            float fx = -Math.Sin(h)
            float fz = -Math.Cos(h)
            int renderTicks = 0
            int updateTicks = 0
            int worstUpdate = 0
            int worstRender = 0
            int behind = 0
            int frames = 0
            float flown = 0.0
            int last = DateTime.Now.Ticks
            while (flown < fly) {
                int now = DateTime.Now.Ticks
                float step = speed * (now - last) / 10000000.0
                last = now
                flown = flown + step
                cam.SetPosition(cam.X + fx * step * 1m, cam.Y, cam.Z + fz * step * 1m)
                int t0 = DateTime.Now.Ticks
                var w = view.WorldOf(cam)
                int missing = view.Update(w[0], w[1], budget)
                if (missing > 0) { behind++ }
                int t1 = DateTime.Now.Ticks
                cam.Render()
                int t2 = DateTime.Now.Ticks
                updateTicks = updateTicks + (t1 - t0)
                renderTicks = renderTicks + (t2 - t1)
                worstUpdate = Math.Max(worstUpdate, t1 - t0)
                worstRender = Math.Max(worstRender, t2 - t1)
                frames++
            }
            print(frames + " Bilder über " + fly + " m: Nachladen im Mittel " + (updateTicks / frames / 10000.0) + " ms (höchstens " + (worstUpdate / 10000.0) + " ms), Rendern " + (renderTicks / frames / 10000.0) + " ms (höchstens " + (worstRender / 10000.0) + " ms)")
            print("je Säule: Chunks lesen " + (view.loadTicks / view.loadedColumns / 10000.0) + " ms, vernetzen " + (view.meshTicks / view.loadedColumns / 10000.0) + " ms (Worker), scene3d-Modelle " + (view.modelTicks / view.loadedColumns / 10000.0) + " ms (Hauptprogramm); " + view.droppedColumns + " Ergebnisse kamen zu spät")
            print(view.loadedColumns + " Säulen geladen, " + view.unloadedColumns + " entladen, jetzt " + view.objects + " Objekte mit " + view.triangles + " Dreiecken; in " + behind + " Bildern fehlten noch Säulen")
        }


        string shot = options.Get("shot", "")
        if (shot != "") {
            int t0 = DateTime.Now.Ticks
            cam.Render()
            print("Bild in " + ((DateTime.Now.Ticks - t0) / 10000.0) + " ms")
            IO.File.WriteAllBytes(shot, fb.ToPng())
            print(shot)
            view.Close()
            return 0
        }

        var win = new Window(fb, "Ruhrpott-Raser - " + e + ", " + n)
        win.EnableEvents()
        bool forward = false
        bool back = false
        bool left = false
        bool right = false
        bool rise = false
        bool sink = false
        bool turnLeft = false
        bool turnRight = false
        bool lookUp = false
        bool lookDown = false
        bool fast = false
        float heading = cam.RotationY / 1deg
        float tilt = cam.RotationX / 1deg
        int last = DateTime.Now.Ticks
        while (win.Tick()) {
            any ev = win.NextEvent()
            while (ev != undefined) {
                if (ev[0] == EventType.KeyDown || ev[0] == EventType.KeyUp) {
                    bool pressed = ev[0] == EventType.KeyDown
                    int key = ev[1]
                    if (key == 119) { forward = pressed }
                    else if (key == 115) { back = pressed }
                    else if (key == 97) { left = pressed }
                    else if (key == 100) { right = pressed }
                    else if (key == 101) { rise = pressed }
                    else if (key == 113) { sink = pressed }
                    else if (key == 1073741904) { turnLeft = pressed }
                    else if (key == 1073741903) { turnRight = pressed }
                    else if (key == 1073741906) { lookUp = pressed }
                    else if (key == 1073741905) { lookDown = pressed }
                    else if (key == 1073742049 || key == 1073742053) { fast = pressed }
                }
                ev = win.NextEvent()
            }
            int now = DateTime.Now.Ticks
            float dt = (now - last) / 10000000.0
            last = now
            float speed = 15.0
            if (fast) { speed = 60.0 }
            if (turnLeft) { heading = heading + 60.0 * dt }
            if (turnRight) { heading = heading - 60.0 * dt }
            if (lookUp) { tilt = Math.Min(tilt + 45.0 * dt, 89.0) }
            if (lookDown) { tilt = Math.Max(tilt - 45.0 * dt, -89.0) }
            float h = heading * Math.PI / 180.0
            float fx = -Math.Sin(h)
            float fz = -Math.Cos(h)
            float mx = 0.0
            float mz = 0.0
            float my = 0.0
            if (forward) {
                mx = mx + fx
                mz = mz + fz
            }
            if (back) {
                mx = mx - fx
                mz = mz - fz
            }
            if (left) {
                mx = mx + fz
                mz = mz - fx
            }
            if (right) {
                mx = mx - fz
                mz = mz + fx
            }
            if (rise) { my = my + 1.0 }
            if (sink) { my = my - 1.0 }
            cam.SetPosition(cam.X + mx * speed * dt * 1m, cam.Y + my * speed * dt * 1m, cam.Z + mz * speed * dt * 1m)
            cam.RotationY = heading * 1deg
            cam.RotationX = tilt * 1deg
            var w = view.WorldOf(cam)
            view.Update(w[0], w[1], 2)
            cam.Render()
        }
        view.Close()
        return 0
    }
}

Environment.Exit(Viewer.Main(Environment.Args))
