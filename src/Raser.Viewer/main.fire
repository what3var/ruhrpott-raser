// Raser.Viewer: die Voxel-Welt mit scene3d betrachten (Roadmap M2: fahrbare Kamera durch die Testregion - der erste Renderer, noch ohne GPU).
//
//   raser-viewer [--world world] --at ost,nord [--yaw 30] [--pitch -35] [--distance 60] [--size 960x600]
//                [--near 1] [--far 6] [--spacing 3.2]     Voxel bis `near` Blöcke um den Blickpunkt, fern bis `far` Blöcke (je 51,2 m)
//   raser-viewer ... --shot bild.png      ein Bild ohne Fenster
//   raser-viewer ... --opaque             ohne Glas und Wasser
//   raser-viewer ... --render-threads 1   so viele Threads rendern (0: alle Kerne)
//   raser-viewer ... --workers 3          so viele Threads bauen die nahen Blöcke (0: im Hauptprogramm)
//   raser-viewer ... --no-mesh-cache      nahe Blöcke immer neu bauen (sonst aus <welt>/meshes, gebaute werden dort gespeichert)
//   raser-viewer ... [--far-ahead far] [--near-ahead 2] [--min-free 20] [--memory-mb 0]
//                                         ist Zeit übrig, so viele Ringe über die Radien hinaus vorausladen (versteckt); was aus den Radien fällt, bleibt
//                                         im Vorrat, bis weniger als min-free Prozent des Speichers frei sind (oder der Viewer mehr als memory-mb belegt)
//   raser-viewer ... --fly 1500 [--speed 83] [--budget-ms 30] [--lead m] [--shot ende.png]   (lead: Ladepunkt voraus, Standard Tempo x 2,5 s)
//                                         ohne Fenster in Echtzeit geradeaus fliegen, nachladen und rendern; die Zeiten am Ende
//
// Im Fenster: W/S vor und zurück, A/D seitwärts, Q/E hoch und runter, Pfeile drehen, Umschalt schneller.
// Detailstufen (Roadmap M2): nah die Voxel-Chunks, vernetzt mit Raser.Mesh (Stufe 0); weiter weg Netze direkt aus dem Zwischenlayer (Raser.FarMesher:
// Höhenraster, Grundrisse, LoD2-Dächer). Je Block ein scene3d-Objekt, die Farben aus einer Palette-Textur. Je Bild wird bis zu einem Zeitbudget
// nachgeladen: grob vor fein, vom Blickpunkt nach außen; zu weit weg wird entladen.
// Szene: x = Ost, y = oben, z = -Nord (scene3d: Y oben, die Kamera blickt nach -Z), Ursprung beim Zielpunkt.
#import "windows"
#import "scene3d"
#import "filesystem"
#import "time"
#import "raser.core"
#import "raser.world"
#import "raser.mesh"

class Options {
    Dictionary<string, string> values

    construct(string items[]) {
        this.values = new Dictionary<string, string>()
        int i = 0
        while (i < items.length) {
            string a = items[i]
            if (a.StartsWith("--") && i + 1 < items.length && !items[i + 1].StartsWith("--")) {
                this.values[a.Substring(2)] = items[i + 1]
                i = i + 2
            } else {
                if (a.StartsWith("--")) { this.values[a.Substring(2)] = "true" }
                i = i + 1
            }
        }
    }

    string Get(string name, string fallback) { return this.values.Get(name, fallback) }
}

// Wie viel Speicher frei ist. fire hat dafür (noch) keine Abfrage: unter Linux aus /proc/meminfo (MemAvailable / MemTotal) und /proc/self/status
// (VmRSS), sonst unbekannt (-1). Gelesen höchstens einmal je Sekunde - mit Read, weil IO.File.ReadAllText bei /proc leer bleibt (docs/FIRE.md).
class MemoryWatch {
    defined float freePercent       // frei in Prozent des ganzen Speichers (-1: unbekannt)
    defined int totalMb
    defined int processMb           // was der Viewer belegt (-1: unbekannt)
    defined float minFree           // darunter wird entladen (Prozent)
    defined int budgetMb            // mehr belegt der Viewer nicht (0: ohne Grenze)
    defined int checkedAt

    construct() {
        this.freePercent = -1.0
        this.processMb = -1
        this.minFree = 20.0
        this.checkedAt = -100000000
    }

    // Der Wert (kB) einer Zeile "Name:   1234 kB".
    static defined int Kb(string text, string name) {
        int at = text.IndexOf(name + ":")
        if (at < 0) { return -1 }
        int end = text.IndexOf("\n", at)
        if (end < 0) { end = text.Length }
        string v = text.Substring(at + name.Length + 1, end - at - name.Length - 1).Replace("kB", "").Trim()
        any n = v.TryToInt()
        if (n == undefined) { return -1 }
        return n
    }

    static string ReadProc(string path) {
        var stream = IO.File.OpenRead(path)
        byte buf[] = new byte[16384]
        int n = stream.Read(buf, 0, 16384)
        stream.Close()
        if (n <= 0) { return "" }
        return IO.Utf8.GetString(buf.Slice(0, n))
    }

    undefined Check() {
        int now = DateTime.Now.Ticks
        if (now - this.checkedAt < 10000000) { return }
        this.checkedAt = now
        if (Environment.Platform != "linux") { return }
        try {
            string info = MemoryWatch.ReadProc("/proc/meminfo")
            int total = MemoryWatch.Kb(info, "MemTotal")
            int available = MemoryWatch.Kb(info, "MemAvailable")
            if (total > 0 && available >= 0) {
                this.totalMb = total / 1024
                this.freePercent = available * 100.0 / total
            }
            int rss = MemoryWatch.Kb(MemoryWatch.ReadProc("/proc/self/status"), "VmRSS")
            if (rss >= 0) { this.processMb = rss / 1024 }
        } catch (Exception ex) {
            this.freePercent = -1.0
        }
    }

    // Zu wenig frei: entladen.
    defined bool Tight {
        get {
            if (this.freePercent >= 0.0 && this.freePercent < this.minFree) { return true }
            return this.budgetMb > 0 && this.processMb > this.budgetMb
        }
    }

    // Reichlich frei: vorausladen (mit Abstand zu Tight, damit es nicht hin und her geht).
    defined bool Roomy {
        get {
            if (this.freePercent >= 0.0 && this.freePercent < this.minFree + 10.0) { return false }
            if (this.budgetMb > 0 && this.processMb > this.budgetMb * 8 / 10) { return false }
            return true
        }
    }
}

// Die Netze einer Detailstufe eines Blocks. Zu sehen: je Netz ein Objekt in der Szene; im Vorrat nur die Netze (Objekte, auch versteckte,
// kosten beim Rendern).
class LodSet {
    List<Model> models
    List<float> opacities
    List<Object> objects
    defined int triangles
    defined float spacing           // ferne Stufe: das Geländeraster, mit dem sie gebaut ist
    defined bool shown

    construct() {
        this.models = new List<Model>()
        this.opacities = new List<float>()
        this.objects = new List<Object>()
    }
}

// Ein Block von 4 x 4 Chunk-Säulen (51,2 m; 5 x 5 Blöcke sind eine Kachel): seine nahe und seine ferne Stufe, jede gebaut oder nicht.
class BlockState {
    defined int bx
    defined int by
    LodSet nearSet
    LodSet farSet

    construct(defined int bx, defined int by) {
        this.bx = bx
        this.by = by
    }

    // Die Stufe, die zu sehen ist (0 nah, 1 fern, -1 keine).
    defined int lod {
        get {
            if (this.nearSet != undefined && this.nearSet.shown) { return 0 }
            if (this.farSet != undefined && this.farSet.shown) { return 1 }
            return -1
        }
    }
}

// Die Welt um die Kamera in Blöcken: nah Voxel (Stufe 0), bis zum Fernradius Netze aus dem Zwischenlayer (Raser.FarMesher). Je Bild wird bis zu einem
// Zeitbudget gearbeitet: erst fehlende ferne Blöcke vom Blickpunkt nach außen (billig), dann die nahen (in den Workern). Bleibt Zeit, wird über die Radien
// hinaus vorausgeladen (versteckt), solange reichlich Speicher frei ist. Was aus den Radien fällt, bleibt versteckt im Vorrat; entladen wird erst, wenn
// der Speicher knapp wird - das Entfernteste zuerst.
class WorldView {
    Scene scene
    Texture palette
    Raser.NearBuilder local                       // die fernen Blöcke, und ohne Worker auch die nahen
    Channel<Raser.NearJob> jobs
    Channel<Raser.NearResult> results
    HashSet<string> inWork                  // nahe Blöcke bei den Workern
    MemoryWatch memory
    defined int workers
    Dictionary<string, BlockState> blocks
    defined float originE
    defined float originN
    defined float originZ
    defined int near                // Radius der Stufe 0 in Blöcken (0: nur der Block des Blickpunkts, -1: keiner)
    defined int far                 // Radius der fernen Stufe in Blöcken
    defined int farAhead            // so viele Ringe über `far` hinaus wird die ferne Stufe vorausgeladen
    defined int nearAhead           // so viele Ringe über `near` hinaus die nahe
    defined float spacing           // Geländeraster der fernen Stufe (ab dem dritten Ring doppelt so grob)
    defined float lead              // so weit voraus (m) in Blickrichtung liegt der Punkt, um den geladen wird
    defined bool opaqueOnly
    defined int objects             // sichtbar
    defined int triangles           // sichtbar
    defined int cachedTriangles     // im Vorrat (versteckt)
    defined int farBuilt
    defined int nearBuilt
    defined int dropped
    defined int farTicks
    defined int nearTicks           // Zeit für die nahen Blöcke (in den Workern)
    defined int nearShowTicks       // Zeit für ihre scene3d-Modelle (im Hauptprogramm)
    defined int late                // Ergebnisse, deren Block inzwischen entladen war
    defined int fromCache           // Stufen, die aus dem Vorrat wieder sichtbar wurden
    defined int lastBx              // der Block des Ladepunkts im letzten Bild, und seit wann er es ist
    defined int lastBy
    defined int stillSince
    defined bool filling            // in Fill: vorausladen auch ohne Stillstand

    construct(string root, Scene scene, defined float e, defined float n, defined float z, defined int near, defined int far, defined float spacing, defined bool opaqueOnly, defined int workers, defined bool useCache) {
        this.scene = scene
        this.local = new Raser.NearBuilder(root, e, n, z, opaqueOnly)
        this.local.useCache = useCache
        this.inWork = new HashSet<string>()
        this.memory = new MemoryWatch()
        this.workers = workers
        if (workers > 0) {
            this.jobs = new Channel<Raser.NearJob>(1024)
            this.results = new Channel<Raser.NearResult>(1024)
            var jobs = this.jobs
            var results = this.results
            for (int i = 0; i < workers; i++) {
                fire taking root taking e taking n taking z taking opaqueOnly taking useCache with jobs, results {
                    Raser.NearBuilder.Work(jobs, results, root, e, n, z, opaqueOnly, useCache)
                }
            }
        }
        this.blocks = new Dictionary<string, BlockState>()
        this.originE = e
        this.originN = n
        this.originZ = z
        this.near = near
        this.far = far
        this.farAhead = far
        this.nearAhead = 2
        this.spacing = spacing
        this.opaqueOnly = opaqueOnly
        byte rgba[1024]
        for (int i = 0; i < 256; i++) {
            int c = Raser.Palette.Rgb(i)
            rgba[i * 4] = (c >> 16) & 255
            rgba[i * 4 + 1] = (c >> 8) & 255
            rgba[i * 4 + 2] = c & 255
            rgba[i * 4 + 3] = 255
        }
        this.palette = new Texture(256, 1, rgba)
    }

    // Schließt den Auftragskanal: die Worker enden, wenn sie fertig sind.
    undefined Close() {
        if (this.jobs != undefined) { this.jobs.Close() }
    }

    BlockState BlockAt(defined int bx, defined int by) {
        string key = bx + "_" + by
        if (!this.blocks.ContainsKey(key)) { this.blocks[key] = new BlockState(bx, by) }
        return this.blocks[key]
    }

    // Die Netze einer Stufe (noch nicht in der Szene).
    LodSet Make(List<Raser.MeshBatch> batches) {
        var set = new LodSet()
        foreach (batch in batches) {
            var model = Model.FromArrays(batch.positions, batch.uvs, batch.indices)
            set.models.Add(take model)
            set.opacities.Add(batch.opacity)
            set.triangles = set.triangles + batch.quads * 2
        }
        this.cachedTriangles = this.cachedTriangles + set.triangles
        return set
    }

    undefined Show(LodSet set, defined bool shown) {
        if (set == undefined || set.shown == shown) { return }
        set.shown = shown
        if (shown) {
            for (int i = 0; i < set.models.Count; i++) {
                var obj = new Object(set.models[i])
                obj.KeepMeshCoordinates = true          // die Koordinaten des Netzes sind Welt-Koordinaten (Ursprung des Netzes an der Position 0, 0, 0)
                obj.Texture = this.palette
                if (set.opacities[i] < 1.0) { obj.Opacity = set.opacities[i] }
                set.objects.Add(obj)
                this.scene.Add(take obj)
            }
        } else {
            this.objects = this.objects - set.objects.Count
            foreach (o in set.objects) { this.scene.Remove(o) }
            set.objects.Clear()
        }
        if (shown) {
            this.triangles = this.triangles + set.triangles
            this.cachedTriangles = this.cachedTriangles - set.triangles
            this.objects = this.objects + set.objects.Count
        } else {
            this.triangles = this.triangles - set.triangles
            this.cachedTriangles = this.cachedTriangles + set.triangles
        }
    }

    undefined Drop(LodSet set) {
        if (set == undefined) { return }
        this.Show(set, false)
        this.cachedTriangles = this.cachedTriangles - set.triangles
        set.models.Clear()
    }

    // Die ferne Stufe eines Blocks (Geländeraster sp), versteckt.
    undefined BuildFar(BlockState b, defined float sp) {
        int t0 = DateTime.Now.Ticks
        var mesh = new Raser.BlockMesh()
        float east = b.bx * 51.2
        float north = b.by * 51.2
        var tileKey = Raser.TileKey.Of(east + 1.0, north + 1.0)
        var fm = this.local.FarFor(tileKey)
        if (fm != undefined) {
            var part = fm.Block(east - tileKey.East, north - tileKey.North, 51.2, sp)
            mesh.Add(take part, tileKey.East - this.originE, tileKey.North - this.originN, -this.originZ)
        }
        var batches = new List<Raser.MeshBatch>()
        mesh.Batches(1.0, batches)
        this.Drop(b.farSet)
        b.farSet = this.Make(batches)
        b.farSet.spacing = sp
        this.farBuilt++
        this.farTicks = this.farTicks + (DateTime.Now.Ticks - t0)
    }

    // Was zu sehen ist: nah die nahe Stufe (wenn da, sonst die ferne), bis zum Fernradius die ferne, darüber nichts.
    undefined Arrange(BlockState b, defined int ring) {
        bool nearShown = ring <= this.near && b.nearSet != undefined
        bool farShown = !nearShown && ring <= this.far && b.farSet != undefined
        if (nearShown && b.nearSet != undefined && !b.nearSet.shown) { this.fromCache++ }
        this.Show(b.nearSet, nearShown)
        this.Show(b.farSet, farShown)
    }

    // Die Blöcke eines Rings um (cx, cy), vom Ring r.
    static List<int> Ring(defined int cx, defined int cy, defined int r) {
        var cells = new List<int>()
        for (int dy = -r; dy <= r; dy++) {
            for (int dx = -r; dx <= r; dx++) {
                if (Math.Max(Math.Abs(dx), Math.Abs(dy)) != r) { continue }
                cells.Add(cx + dx)
                cells.Add(cy + dy)
            }
        }
        return cells
    }

    // Arbeitet bis zum Zeitbudget (ms). Gibt zurück, wie viele Blöcke noch nicht in der gewünschten Stufe sind.
    defined int Update(defined float e, defined float n, defined float budgetMs) {
        int deadline = DateTime.Now.Ticks + Math.Round(budgetMs * 10000.0)!int
        int fbx = Raser.Grid.FloorDiv(Raser.Grid.VoxelOf(e), 256)
        int fby = Raser.Grid.FloorDiv(Raser.Grid.VoxelOf(n), 256)
        this.memory.Check()
        if (this.memory.Tight) { this.Evict(fbx, fby) }
        if (fbx != this.lastBx || fby != this.lastBy) {
            this.lastBx = fbx
            this.lastBy = fby
            this.stillSince = DateTime.Now.Ticks
        }
        // was zu sehen ist (auch aus dem Vorrat)
        foreach (pair in this.blocks) {
            var b = pair.Value
            this.Arrange(b, Math.Max(Math.Abs(b.bx - fbx), Math.Abs(b.by - fby)))
        }
        int pending = 0
        // erst grob: jeder Block im Fernradius bekommt seine ferne Stufe (vom Blickpunkt nach außen; nah mit feinem Raster)
        for (int r = 0; r <= this.far; r++) {
            float sp = this.spacing
            if (r > 2) { sp = this.spacing * 2.0 }
            var cells = WorldView.Ring(fbx, fby, r)
            for (int i = 0; i < cells.Count; i = i + 2) {
                var b = this.BlockAt(cells[i], cells[i + 1])
                if (b.farSet != undefined && b.farSet.spacing <= sp) { continue }
                if (b.nearSet != undefined && b.nearSet.shown) { continue }
                if (DateTime.Now.Ticks > deadline) {
                    pending++
                    continue
                }
                this.BuildFar(b, sp)
                this.Arrange(b, r)
            }
        }
        // dann fein: fertige nahe Blöcke der Worker übernehmen (auch die vorausgeladenen, versteckt) ...
        if (this.workers > 0) {
            while (DateTime.Now.Ticks <= deadline) {
                var res = this.results.TryReceive()
                if (res == undefined) { break }
                string key = res.bx + "_" + res.by
                this.inWork.Remove(key)
                this.nearTicks = this.nearTicks + res.ticks
                if (!this.blocks.ContainsKey(key)) {
                    this.late++
                    continue
                }
                var b = this.blocks[key]
                int t0 = DateTime.Now.Ticks
                this.Drop(b.nearSet)
                b.nearSet = this.Make(res.batches)
                this.Arrange(b, Math.Max(Math.Abs(res.bx - fbx), Math.Abs(res.by - fby)))
                this.nearShowTicks = this.nearShowTicks + (DateTime.Now.Ticks - t0)
                this.nearBuilt++
            }
        }
        // ... und die fehlenden vom Blickpunkt nach außen bestellen (ohne Worker: selbst bauen)
        for (int r = 0; r <= this.near; r++) {
            var cells = WorldView.Ring(fbx, fby, r)
            for (int i = 0; i < cells.Count; i = i + 2) {
                var b = this.BlockAt(cells[i], cells[i + 1])
                if (b.nearSet != undefined) { continue }
                pending++
                if (this.workers == 0) {
                    if (DateTime.Now.Ticks > deadline) { continue }
                    var res = this.local.Build(b.bx, b.by)
                    this.nearTicks = this.nearTicks + res.ticks
                    b.nearSet = this.Make(res.batches)
                    this.Arrange(b, r)
                    this.nearBuilt++
                    pending--
                    continue
                }
                this.Order(b)
            }
        }
        // Stillstand (der Ladepunkt seit einer halben Sekunde im selben Block) oder der Anfang, alles da und Speicher reichlich: über die Radien hinaus
        // vorausladen (vom Ladepunkt nach außen, in den Vorrat)
        bool still = this.filling || DateTime.Now.Ticks - this.stillSince > 5000000
        if (pending == 0 && still && this.memory.Roomy) {
            if (this.workers > 0 && this.near >= 0) {
                for (int r = this.near + 1; r <= this.near + this.nearAhead && this.inWork.Count < this.workers; r++) {
                    var cells = WorldView.Ring(fbx, fby, r)
                    for (int i = 0; i < cells.Count && this.inWork.Count < this.workers; i = i + 2) {
                        var b = this.BlockAt(cells[i], cells[i + 1])
                        if (b.nearSet == undefined) { this.Order(b) }
                    }
                }
            }
            for (int r = this.far + 1; r <= this.far + this.farAhead && DateTime.Now.Ticks <= deadline; r++) {
                var cells = WorldView.Ring(fbx, fby, r)
                for (int i = 0; i < cells.Count && DateTime.Now.Ticks <= deadline; i = i + 2) {
                    var b = this.BlockAt(cells[i], cells[i + 1])
                    if (b.farSet == undefined) { this.BuildFar(b, this.spacing * 2.0) }
                }
            }
        }
        return pending
    }

    // Einen nahen Block bei den Workern bestellen (höchstens zwei je Worker unterwegs).
    undefined Order(BlockState b) {
        string key = b.bx + "_" + b.by
        if (this.inWork.Contains(key) || this.inWork.Count >= this.workers * 2) { return }
        this.inWork.Add(key)
        this.jobs.Send(new Raser.NearJob(b.bx, b.by))
    }

    // Speicher knapp: ein Viertel des Vorrats weg, das Entfernteste zuerst - erst nahe Stufen außerhalb des nahen Radius, dann ganze Blöcke außerhalb
    // des Fernradius. Was zu sehen ist, bleibt.
    undefined Evict(defined int fbx, defined int fby) {
        var order = new List<int>()             // Abstand * 2 + Art (0: nahe Stufe, 1: ganzer Block), dahinter der Index
        var keys = new List<string>()
        foreach (pair in this.blocks) {
            var b = pair.Value
            int ring = Math.Max(Math.Abs(b.bx - fbx), Math.Abs(b.by - fby))
            if (b.nearSet != undefined && ring > this.near) {
                order.Add((ring * 2) * 1000000 + keys.Count)
                keys.Add(pair.Key)
            }
            if (ring > this.far) {
                order.Add((ring * 2 + 1) * 1000000 + keys.Count)
                keys.Add(pair.Key)
            }
        }
        order.Sort()
        int n = Math.Max(1, order.Count / 4)
        for (int i = order.Count - 1; i >= 0 && n > 0; i--) {
            int what = (order[i] / 1000000) % 2
            string key = keys[order[i] % 1000000]
            if (!this.blocks.ContainsKey(key)) { continue }
            var b = this.blocks[key]
            if (what == 0) {
                this.Drop(b.nearSet)
                b.nearSet = undefined
            } else {
                this.Drop(b.nearSet)
                this.Drop(b.farSet)
                this.blocks.Remove(key)
            }
            this.dropped++
            n--
        }
        this.memory.checkedAt = -100000000      // gleich wieder nachsehen
    }

    // Arbeitet, bis alles im Umkreis in der gewünschten Stufe ist (der Anfang).
    undefined Fill(defined float e, defined float n) {
        this.filling = true
        while (this.Update(e, n, 1000.0) > 0) {
            if (this.workers > 0) { Sleep(5ms) }
        }
        this.filling = false
    }

    // Wohin die Kamera am Boden blickt (Ost, Nord): der Schnitt des Blicks mit der Höhe des Ursprungs, höchstens 150 m vor der Kamera
    // (beim Blick nach oben oder geradeaus: 150 m). Um diesen Punkt wird geladen.
    float[] WorldOf(Camera cam) {
        float yaw = cam.RotationY / 1deg * Math.PI / 180.0
        float pitch = cam.RotationX / 1deg * Math.PI / 180.0
        float height = cam.Y / 1m
        float ahead = 150.0
        if (pitch < -0.01 && height > 0.0) { ahead = Math.Min(150.0, height / Math.Tan(-pitch)) }
        // in Fahrt: weiter voraus (aber im Fernradius)
        ahead = Math.Min(Math.Max(ahead, this.lead), this.far * 51.2 * 0.6)
        float x = cam.X / 1m - Math.Sin(yaw) * ahead
        float z = cam.Z / 1m - Math.Cos(yaw) * ahead
        float result[] = [this.originE + x, this.originN - z]
        return result
    }
}

class Viewer {
    static defined int Main(string items[]) {
        var options = new Options(items)
        var store = new Raser.FileTileStore(options.Get("world", "world"))
        string at = options.Get("at", "376130,5704900")
        var parts = at.Split(",")
        float e = parts[0].ToFloat()
        float n = parts[1].ToFloat()
        float yaw = options.Get("yaw", "30").ToFloat()
        float pitch = options.Get("pitch", "-35").ToFloat()
        float distance = options.Get("distance", "60").ToFloat()
        var size = options.Get("size", "960x600").Split("x")
        int width = size[0].ToInt()
        int height = size[1].ToInt()

        // Höhe des Bodens am Ziel aus dem Höhenraster der Kachel
        var tileKey = Raser.TileKey.Of(e, n)
        var tile = store.Load(tileKey)
        float ground = 0.0
        if (tile != undefined && tile.heights != undefined) { ground = tile.heights.At(e - tileKey.East, n - tileKey.North) }

        var fb = new Framebuffer(width, height)
        var scene = new Scene()
        scene.Shadows = false
        scene.Threads = options.Get("render-threads", "0").ToInt()     // 0: so viele wie die Maschine hat (scene3d); weniger lässt den Workern Kerne
        scene.AmbientIntensity = 0.45
        scene.Add(Light.Directional(-0.45, -1.0, -0.3))
        var cam = new Camera(fb)
        cam.FieldOfView = 60deg
        cam.Near = 0.2m
        cam.Far = 2000m
        cam.Background = S3D.Rgb(150, 170, 190)
        float yr = yaw * Math.PI / 180.0
        float pr = pitch * Math.PI / 180.0
        // Kamera hinter dem Ziel, Blick auf das Ziel
        float cx = Math.Sin(yr) * Math.Cos(pr) * distance
        float cz = Math.Cos(yr) * Math.Cos(pr) * distance
        float cy = -Math.Sin(pr) * distance
        cam.SetPosition(cx * 1m, cy * 1m, cz * 1m)
        cam.LookAt(0m, 0m, 0m)
        scene.Add(cam)
        int near = options.Get("near", "1").ToInt()
        int far = options.Get("far", "6").ToInt()
        float spacing = options.Get("spacing", "3.2").ToFloat()
        int workers = options.Get("workers", "3").ToInt()
        var view = new WorldView(options.Get("world", "world"), scene, e, n, ground, near, far, spacing, options.Get("opaque", "") != "", workers, options.Get("no-mesh-cache", "") == "")
        view.farAhead = options.Get("far-ahead", far + "").ToInt()
        view.nearAhead = options.Get("near-ahead", "2").ToInt()
        view.memory.minFree = options.Get("min-free", "20").ToFloat()
        view.memory.budgetMb = options.Get("memory-mb", "0").ToInt()
        int start = DateTime.Now.Ticks
        print("Lade um " + e + ", " + n + " (Voxel im Radius " + near + ", fern bis " + far + " Blöcke à 51,2 m, " + workers + " Worker)")
        var here = view.WorldOf(cam)
        view.Fill(here[0], here[1])
        print(view.objects + " Objekte, " + view.triangles + " Dreiecke in " + ((DateTime.Now.Ticks - start) / 10000000.0) + " s (" + view.farBuilt + " ferne, " + view.nearBuilt + " nahe Blöcke)")

        // Ein Flug ohne Fenster in Echtzeit: geradeaus in Blickrichtung mit `speed` m/s, je Bild nachladen (bis `budget-ms`) und rendern;
        // am Ende die Zeiten.
        float fly = options.Get("fly", "0").ToFloat()
        if (fly > 0.0) {
            float speed = options.Get("speed", "15").ToFloat()
            float budget = options.Get("budget-ms", "30").ToFloat()
            view.lead = options.Get("lead", (speed * 2.5) + "").ToFloat()
            float h = cam.RotationY / 1deg * Math.PI / 180.0
            float fx = -Math.Sin(h)
            float fz = -Math.Cos(h)
            int renderTicks = 0
            int updateTicks = 0
            int worstUpdate = 0
            int worstRender = 0
            int behind = 0
            int frames = 0
            float flown = 0.0
            int last = DateTime.Now.Ticks
            while (flown < fly) {
                int now = DateTime.Now.Ticks
                float step = speed * (now - last) / 10000000.0
                last = now
                flown = flown + step
                cam.SetPosition(cam.X + fx * step * 1m, cam.Y, cam.Z + fz * step * 1m)
                int t0 = DateTime.Now.Ticks
                var w = view.WorldOf(cam)
                int missing = view.Update(w[0], w[1], budget)
                if (missing > 0) { behind++ }
                int t1 = DateTime.Now.Ticks
                cam.Render()
                int t2 = DateTime.Now.Ticks
                updateTicks = updateTicks + (t1 - t0)
                renderTicks = renderTicks + (t2 - t1)
                worstUpdate = Math.Max(worstUpdate, t1 - t0)
                worstRender = Math.Max(worstRender, t2 - t1)
                frames++
            }
            print(frames + " Bilder über " + fly + " m: Nachladen im Mittel " + (updateTicks / frames / 10000.0) + " ms (höchstens " + (worstUpdate / 10000.0) + " ms), Rendern " + (renderTicks / frames / 10000.0) + " ms (höchstens " + (worstRender / 10000.0) + " ms)")
            print("ferne Blöcke: " + view.farBuilt + " (je " + (view.farTicks / Math.Max(1, view.farBuilt) / 10000.0) + " ms), nahe Blöcke: " + view.nearBuilt + " (je " + (view.nearTicks / Math.Max(1, view.nearBuilt) / 10000.0) + " ms, davon Modelle im Hauptprogramm " + (view.nearShowTicks / Math.Max(1, view.nearBuilt) / 10000.0) + " ms; " + view.late + " zu spät), aus dem Vorrat: " + view.fromCache + ", entladen: " + view.dropped + "; jetzt " + view.objects + " Objekte mit " + view.triangles + " Dreiecken sichtbar, " + view.cachedTriangles + " im Vorrat (" + view.blocks.Count + " Blöcke, Viewer " + view.memory.processMb + " MB, frei " + Math.Round(view.memory.freePercent) + " %); in " + behind + " von " + frames + " Bildern war noch nicht alles in der gewünschten Stufe")
        }


        string shot = options.Get("shot", "")
        if (shot != "") {
            int t0 = DateTime.Now.Ticks
            cam.Render()
            print("Bild in " + ((DateTime.Now.Ticks - t0) / 10000.0) + " ms")
            IO.File.WriteAllBytes(shot, fb.ToPng())
            print(shot)
            view.Close()
            return 0
        }

        var win = new Window(fb, "Ruhrpott-Raser - " + e + ", " + n)
        win.EnableEvents()
        bool forward = false
        bool back = false
        bool left = false
        bool right = false
        bool rise = false
        bool sink = false
        bool turnLeft = false
        bool turnRight = false
        bool lookUp = false
        bool lookDown = false
        bool fast = false
        float heading = cam.RotationY / 1deg
        float tilt = cam.RotationX / 1deg
        int last = DateTime.Now.Ticks
        while (win.Tick()) {
            any ev = win.NextEvent()
            while (ev != undefined) {
                if (ev[0] == EventType.KeyDown || ev[0] == EventType.KeyUp) {
                    bool pressed = ev[0] == EventType.KeyDown
                    int key = ev[1]
                    if (key == 119) { forward = pressed }
                    else if (key == 115) { back = pressed }
                    else if (key == 97) { left = pressed }
                    else if (key == 100) { right = pressed }
                    else if (key == 101) { rise = pressed }
                    else if (key == 113) { sink = pressed }
                    else if (key == 1073741904) { turnLeft = pressed }
                    else if (key == 1073741903) { turnRight = pressed }
                    else if (key == 1073741906) { lookUp = pressed }
                    else if (key == 1073741905) { lookDown = pressed }
                    else if (key == 1073742049 || key == 1073742053) { fast = pressed }
                }
                ev = win.NextEvent()
            }
            int now = DateTime.Now.Ticks
            float dt = (now - last) / 10000000.0
            last = now
            float speed = 15.0
            if (fast) { speed = 60.0 }
            if (turnLeft) { heading = heading + 60.0 * dt }
            if (turnRight) { heading = heading - 60.0 * dt }
            if (lookUp) { tilt = Math.Min(tilt + 45.0 * dt, 89.0) }
            if (lookDown) { tilt = Math.Max(tilt - 45.0 * dt, -89.0) }
            float h = heading * Math.PI / 180.0
            float fx = -Math.Sin(h)
            float fz = -Math.Cos(h)
            float mx = 0.0
            float mz = 0.0
            float my = 0.0
            if (forward) {
                mx = mx + fx
                mz = mz + fz
            }
            if (back) {
                mx = mx - fx
                mz = mz - fz
            }
            if (left) {
                mx = mx + fz
                mz = mz - fx
            }
            if (right) {
                mx = mx - fz
                mz = mz + fx
            }
            if (rise) { my = my + 1.0 }
            if (sink) { my = my - 1.0 }
            cam.SetPosition(cam.X + mx * speed * dt * 1m, cam.Y + my * speed * dt * 1m, cam.Z + mz * speed * dt * 1m)
            cam.RotationY = heading * 1deg
            cam.RotationX = tilt * 1deg
            var w = view.WorldOf(cam)
            view.Update(w[0], w[1], 15.0)
            cam.Render()
        }
        view.Close()
        return 0
    }
}

Environment.Exit(Viewer.Main(Environment.Args))
