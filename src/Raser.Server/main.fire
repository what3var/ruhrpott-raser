// Raser.Server: der Server (docs/SERVER.md) - jetzt ein Prozess mit Koordinator, einem Regionsserver und den globalen Diensten.
//
//   raser-server [--data data] [--release release] [--admin name] [--host ""] [--http 7480] [--game 7481] [--time 14:00] [--weather klar]
//                [--timescale 1] [--rounds 20000] [--world world]
//
// Die Launcher-API läuft in einem eigenen Thread (`fire dedicated`: sie wartet im Netz), das Spiel im Hauptthread mit festen 30 Takten je s
// (Raser.SimWorld: die Physik aller Spieler und Fahrzeuge, mit den Hindernissen der Kacheln aus --world; Snapshots 15-mal je s, das Wetter alle
// 10 s und bei jeder Änderung).
#import "time"
#import "net"
#import "filesystem"
#import "http"
#import "raser.core"
#import "raser.net"
#import "raser.sim"

// Die Optionen der Kommandozeile (--name wert).
class ServerOptions {
    Dictionary<string, string> values

    construct(string items[]) {
        this.values = new Dictionary<string, string>()
        int i = 0
        while (i < items.length) {
            string a = items[i]
            if (a.StartsWith("--") && i + 1 < items.length && !items[i + 1].StartsWith("--")) {
                this.values[a.Substring(2)] = items[i + 1]
                i = i + 2
            } else {
                if (a.StartsWith("--")) { this.values[a.Substring(2)] = "true" }
                i = i + 1
            }
        }
    }

    string Get(string name, string fallback) { return this.values.Get(name, fallback) }
}

class Server {
    // Der Host zum Lauschen: leer heißt alle Adressen (IPv6 und IPv4). Geht IPv6 nicht (ein Rechner ohne IPv6: "Address family not supported"),
    // fällt fire nicht selbst auf IPv4 zurück (docs/FIRE.md) - dann 0.0.0.0.
    static string ListenHost(string host, defined int port) {
        if (host != "") { return host }
        try {
            var probe = new Net.TcpListener("", port, 1)
            probe.Close()
            return ""
        } catch (Exception e) {
            print("Lauschen auf allen Adressen geht nicht (" + e.message + "): nur IPv4 (0.0.0.0)")
        }
        return "0.0.0.0"
    }

    static defined int Main(string items[]) {
        var options = new ServerOptions(items)
        string data = options.Get("data", "data")
        string release = options.Get("release", "")
        string admin = options.Get("admin", "")
        string host = Server.ListenHost(options.Get("host", ""), options.Get("game", "7481").ToInt())
        int httpPort = options.Get("http", "7480").ToInt()
        int gamePort = options.Get("game", "7481").ToInt()
        int rounds = options.Get("rounds", "20000").ToInt()
        if (!IO.Directory.Exists(data)) { IO.Directory.CreateDirectory(data) }
        string dbPath = IO.Path.Combine(data, "raser.db")
        ServerStatus.started = Accounts.Now()

        // globale Dienste: Konten, Uhr und Wetter
        var accounts = new Accounts(dbPath, admin, rounds)
        accounts.PromoteConfigured()
        var clock = new WorldClock(Raser.Commands.Clock(options.Get("time", "14:00")), options.Get("weather", "klar"), options.Get("timescale", "1").ToFloat())
        // Koordinator und Regionsserver
        var coordinator = new Coordinator()
        string world = options.Get("world", "")
        var region = new RegionServer(coordinator.regions[0], world)
        // der Verkehr (Raser.Traffic): höchstens so viele Autos und Fußgänger um jeden Spieler (0: keine)
        region.SetTraffic(options.Get("traffic", "24").ToInt(), options.Get("people", "30").ToInt(), options.Get("traffic-seed", "1").ToInt())
        region.trafficWetness = clock.weather
        ServerStatus.region = region.region.name
        var gateway = new Gateway(host, gamePort, accounts, coordinator, region, clock)
        Gateway.Log("Spielprotokoll v" + Raser.Protocol.Version + " auf Port " + gamePort + ", Region " + region.region.name + ", " + accounts.Count() + " Konten in " + dbPath + ", " + Math.Round(Raser.SimWorld.Hz) + " Takte je s, Welt " + (world == "" ? "keine (ohne Hindernisse)" : world))

        // die Launcher-API im eigenen Thread
        fire dedicated taking dbPath taking admin taking release taking data taking host taking httpPort taking rounds {
            try {
                var api = new LauncherApi(dbPath, admin, release, data)
                api.accounts.rounds = rounds
                var http = new Http.Server(host, httpPort, 32)
                http.Fallback(func (Http.Request r) on api => Handle(r))
                Gateway.Log("Launcher-API auf Port " + httpPort + ", Release " + api.version + " mit " + api.files.Count + " Dateien")
                http.Run()
            } catch (Exception e) {
                Gateway.Log("Launcher-API: " + e.message)
                terminate(1)
            }
        }

        // das Spiel: feste 30 Takte je s (hinkt der Server hinterher, holt er bis zu 5 Takte auf einmal nach, dann lässt er Zeit fallen)
        int tickTicks = Math.Round(10000000.0 / Raser.SimWorld.Hz)!int
        int last = DateTime.UtcNow.Ticks
        int due = last
        int lastWeather = 0
        int changes = clock.changes
        int worst = 0               // der längste Takt seit der letzten Meldung (Ticks), gemeldet alle 10 s, wenn über 50 ms
        int worstAt = last
        while (true) {
            int start = DateTime.UtcNow.Ticks
            float dt = (start - last) / 10000000.0
            last = start
            clock.Advance(dt)
            try {
                gateway.Tick()
            } catch (Exception e) {
                Gateway.Log("FEHLER im Gateway: " + e.message)
                throw e
            }
            int steps = 0
            while (start >= due && steps < 5) {
                int t0 = DateTime.UtcNow.Ticks
                try {
                    region.Step(Gateway.Millis())
                } catch (Exception e) {
                    Gateway.Log("FEHLER im Takt " + region.tick + ": " + e.message)
                    throw e
                }
                // alle 10 s die Stände der Spieler in die Datenbank
                if (region.tick % 300 == 0) { gateway.SaveAll() }
                worst = Math.Max(worst, DateTime.UtcNow.Ticks - t0)
                due = due + tickTicks
                steps++
            }
            if (start - due > tickTicks * 5) { due = start }
            if (start - worstAt > 100000000) {
                if (worst > 500000) { Gateway.Log("laengster Takt " + (worst / 10000) + " ms") }
                worst = 0
                worstAt = start
            }
            if (clock.changes != changes || start - lastWeather > 100000000) {
                changes = clock.changes
                lastWeather = start
                gateway.Broadcast(clock.Packet(), undefined)
            }
            ServerStatus.players = gateway.Online()
            int rest = (due - DateTime.UtcNow.Ticks) / 10000
            if (rest > 0) { Sleep(rest * 1ms) }
        }
        return 0
    }
}

Environment.Exit(Server.Main(Environment.Args))
