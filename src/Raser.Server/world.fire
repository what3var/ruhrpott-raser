// Raser.Server: Koordinator, Regionsserver und die Uhr der Welt (docs/SERVER.md).
//
// Der Koordinator teilt die Karte in Regionen aus ganzen Kacheln und weiß, welcher Regionsserver wofür zuständig ist; jetzt gibt es eine Region
// für alles. Der Regionsserver hält die Spieler seiner Region und schickt jedem, was in seiner Nähe ist (seine Kachel und die 8 Nachbarn).
// Die Uhr ist ein globaler Dienst: Datum, Uhrzeit (mit Zeitraffer) und Wetter, maßgeblich für alle Clients.
#import "time"
#import "raser.core"
#import "raser.net"
#import "raser.sim"
#import "raser.world"
#import "raser.traffic"

// Eine Region: ein Rechteck aus ganzen Kacheln (min .. max, einschließlich) und der Server, der für sie zuständig ist.
class Region {
    defined int id
    string name
    defined int server              // Server-Nummer (Raser.IdAllocator)
    defined int minX
    defined int minY
    defined int maxX
    defined int maxY

    construct(defined int id, string name, defined int server, defined int minX, defined int minY, defined int maxX, defined int maxY) {
        this.id = id
        this.name = name
        this.server = server
        this.minX = minX
        this.minY = minY
        this.maxX = maxX
        this.maxY = maxY
    }

    defined bool Contains(defined int tileX, defined int tileY) {
        return tileX >= this.minX && tileX <= this.maxX && tileY >= this.minY && tileY <= this.maxY
    }
}

class Coordinator {
    List<Region> regions

    construct() {
        this.regions = new List<Region>()
        // vorerst eine Region für ganz NRW (und alles drumherum)
        this.regions.Add(new Region(1, "ruhr-1", 1, -1000000, -1000000, 1000000, 1000000))
    }

    // Die Region einer Kachel (undefined: keine - dann bleibt der Spieler, wo er ist).
    Region RegionOf(defined int tileX, defined int tileY) {
        foreach (r in this.regions) {
            if (r.Contains(tileX, tileY)) { return r }
        }
        return undefined
    }
}

// Die Uhr und das Wetter der Welt.
class WorldClock {
    Raser.Weather weather
    string preset
    defined float scale             // Spielsekunden je Sekunde
    defined float seconds           // Uhrzeit (s am Tag)
    defined int changes             // zählt jede Änderung von Hand (für das sofortige Senden)

    construct(defined float hour, string preset, defined float scale) {
        this.weather = new Raser.Weather()
        var today = DateTime.Now
        this.weather.year = today.Year
        this.weather.day = Raser.Weather.DayOf(today.Month, today.Day)
        this.seconds = hour * 3600.0
        this.scale = scale
        this.preset = "klar"
        this.changes = 0
        this.SetPreset(preset)
    }

    // dt Sekunden weiter (mit Zeitraffer); nach Mitternacht der nächste Tag.
    undefined Advance(defined float dt) {
        this.seconds = this.seconds + dt * this.scale
        while (this.seconds >= 86400.0) {
            this.seconds = this.seconds - 86400.0
            this.weather.day = this.weather.day + 1
            if (this.weather.day > 365) {
                this.weather.day = 1
                this.weather.year = this.weather.year + 1
            }
        }
        this.weather.hour = this.seconds / 3600.0
    }

    undefined SetHour(defined float hour) {
        this.seconds = Math.Clamp(hour, 0.0, 23.999) * 3600.0
        this.weather.hour = hour
        this.weather.Update()
        this.changes = this.changes + 1
    }

    undefined SetPreset(string name) {
        if (!Raser.Commands.IsPreset(name)) { name = "klar" }
        this.preset = name
        this.weather.hour = this.seconds / 3600.0
        this.weather.Preset(name)
        this.changes = this.changes + 1
    }

    string Clock() {
        int minutes = Math.Floor(this.seconds / 60.0)!int
        return Accounts.Two(minutes / 60) + ":" + Accounts.Two(minutes % 60)
    }

    Raser.Packet Packet() {
        var p = new Raser.Packet(Raser.Protocol.Weather)
        p.year = this.weather.year
        p.day = this.weather.day
        p.seconds = Math.Floor(this.seconds)!int % 86400
        p.scale = this.scale
        p.text = this.preset
        return p
    }
}

// Der Regionsserver (Protokoll v2): rechnet seine Region im festen Takt (30 je s, Raser.SimWorld) - die Eingaben der Spieler mit derselben
// Physik wie der Client (Raser.Physics: Fahrzeuge, Aufprall an Gebäuden und Pfosten aus den Kacheln, Stöße zwischen Fahrzeugen, Gehen), die
// Fahrzeuge der Region (eigene der Spieler und geparkte, mit IDs), die Inventare (Behälter und Gegenstände am Boden) - und schickt jedem
// Spieler 15-mal je s, was in seiner Nähe ist (seine Kachel und die 8 Nachbarn), nur was sich geändert hat.
class RegionServer {
    static readonly defined int Burst = 8               // so viele Eingaben darf ein Spieler aufholen (nach einer Lücke)
    static readonly defined int Backlog = 32            // so viele warten höchstens (mehr: die ältesten weg)
    static readonly defined float FarLod = 100.0        // weiter weg (m) gehen Änderungen nur in jedem 2. Snapshot
    static readonly defined int ParkedPerTile = 6       // geparkte Fahrzeuge je Kachel (beim ersten Besuch)
    static readonly defined float KnockSpeed = 5.0      // ab diesem Tempo (m/s) haut ein Fahrzeug einen Spieler um
    static readonly defined int LyingTicks = 90         // so lange (Takte) liegt er
    static readonly defined int TileDelay = 15          // so viele Takte nach der Bestellung werden Kacheln der Hindernisse übernommen (0,5 s)
    static readonly defined int TrafficDelay = 90       // so viele Takte nach der Bestellung wird ein neuer Straßengraph übernommen (3 s; der Worker braucht für 9 neue Kacheln gut 1,5 s)

    Region region
    List<Player> players            // (Verweise: die Spieler gehören dem Gateway)
    Raser.IdAllocator ids           // Spieler, Fahrzeuge, Behälter, Gegenstände am Boden
    Raser.SimWorld sim
    Raser.ContainerStore store
    Raser.ItemDrops drops
    HashSet<string> parked          // Kacheln, auf denen schon geparkt wurde
    defined int tick
    defined float defaultEast
    defined float defaultNorth
    // der Verkehr (Raser.Traffic, docs/SERVER.md): NPC-Autos und Fußgänger um alle Spieler
    Raser.Traffic traffic           // undefined: kein Verkehr
    Raser.Weather trafficWetness    // die Nässe für die Physik der Unfallwagen (das Wetter der Uhr)
    List<float> trafficPlayers
    List<Raser.NpcState> npcStates
    Raser.GraphWorker trafficWorker // baut den Straßengraphen in einem eigenen Thread
    string trafficWant              // die zuletzt bestellten Kacheln
    defined int trafficDue          // in diesem Takt wird der bestellte Graph übernommen
    defined int trafficWaitTicks    // so lange (Ticks) hat der Takt insgesamt auf den Worker gewartet
    string world
    // die Kacheln der Hindernisse (Raser.TileWorker): bestellt bei T, übernommen bei T + TileDelay
    Raser.TileWorker tileWorker
    Dictionary<string, int> tilesDue    // bestellt, noch nicht da: der Takt der Übernahme
    List<int> tileOrders
    List<int> tileOrderDue
    defined int tileWaitTicks           // so lange hat der Takt höchstens auf den Worker gewartet (Ticks)
    defined int tilesLoaded
    defined int builds
    defined int buildTicks

    // world: das Verzeichnis der Welt (Kacheln unter world/tiles); "": ohne Hindernisse.
    construct(Region region, string world) {
        this.region = region
        this.players = new List<Player>()
        this.ids = new Raser.IdAllocator(region.server)
        this.sim = new Raser.SimWorld(new Raser.Obstacles(world))
        this.store = new Raser.ContainerStore()
        this.store.ids = this.ids
        this.drops = new Raser.ItemDrops()
        this.drops.ids = this.ids
        this.parked = new HashSet<string>()
        this.tick = 0
        this.defaultEast = 376117.0
        this.defaultNorth = 5705005.0
        this.traffic = undefined
        this.trafficPlayers = new List<float>()
        this.npcStates = new List<Raser.NpcState>()
        this.trafficWorker = undefined
        this.trafficWant = ""
        this.world = world
        this.tileWorker = undefined
        this.tilesDue = new Dictionary<string, int>()
        this.tileOrders = new List<int>()
        this.tileOrderDue = new List<int>()
        this.tileWaitTicks = 0
        this.tilesLoaded = 0
        if (world != "") {
            // die Hindernisse lädt ein eigener Thread (Raser.TileWorker), der Takt übernimmt sie
            this.sim.obstacles.manual = true
            this.tileWorker = new Raser.TileWorker(world)
        }
    }

    // Den Verkehr einschalten (ohne Welt: keiner - es gibt keine Straßen).
    undefined SetTraffic(defined int cars, defined int people, defined int seed) {
        if ((cars <= 0 && people <= 0) || this.sim.obstacles.store == undefined) { return }
        var t = new Raser.Traffic(cars, people, seed)
        t.idBase = this.ids.Next(Raser.IdKind.Npc)
        // (die NPCs zählen von idBase hoch: dieselbe Art, derselbe Server, eigene Zahlen über dem Zähler der IDs)
        t.idBase = t.idBase + 1099511627776 / 2
        this.traffic = take t
        this.trafficWorker = new Raser.GraphWorker(this.world)
    }

    // Ein Spieler kommt in die Region: sein Inventar (gespeichert, sonst die Anfangsausstattung) gleich, in die Welt erst, wenn die Kacheln um
    // seine Lage da sind (bestellt jetzt, übernommen zu fester Taktgrenze: Spawn). Die Lage wählt der Server: die gespeicherte, sonst der
    // Spawn-Punkt der Region (auf der nächsten Straße).
    undefined Enter(Player p) {
        p.region = this.region.id
        this.players.Add(p)
        SavedPlace place = undefined
        if (p.saved != undefined) { place = PlayerSave.Read(p.saved, p, this.store, this.drops) }
        if (place != undefined && !this.region.Contains(Raser.TileKey.Of(place.east, place.north).x, Raser.TileKey.Of(place.east, place.north).y)) { place = undefined }
        if (p.inv == undefined) {
            var inv = new Raser.Inventory(this.store, this.drops, 5, 4)
            p.inv = take inv
            RegionServer.Starter(p.inv)
            // das Bargeld aus der Datenbank (wer schon einmal da war); neu: das Startgeld
            if (p.storedCash >= 0) { p.inv.cash = p.storedCash }
        }
        p.storedCash = p.inv.cash
        p.inv.body = p.body
        p.spawn = take place
        float e = this.defaultEast
        float n = this.defaultNorth
        if (p.spawn != undefined) {
            e = p.spawn.east
            n = p.spawn.north
        }
        p.inv.east = e
        p.inv.north = n
        var tile = Raser.TileKey.Of(e, n)
        p.tileX = tile.x
        p.tileY = tile.y
        p.spawnAt = this.tick
        if (this.tileWorker != undefined) { p.spawnAt = this.OrderTiles(RegionServer.Around(tile.x, tile.y)) }
    }

    // Die 3 x 3 Kacheln um (x, y).
    static List<string> Around(defined int x, defined int y) {
        var list = new List<string>()
        for (int dy = -1; dy <= 1; dy++) {
            for (int dx = -1; dx <= 1; dx++) { list.Add((x + dx) + "_" + (y + dy)) }
        }
        return list
    }

    // Bestellt, was von names noch nicht da oder bestellt ist; gibt den Takt, ab dem alle da sind.
    defined int OrderTiles(List<string> names) {
        int due = this.tick
        var fresh = new List<string>()
        foreach (n in names) {
            if (this.tilesDue.ContainsKey(n)) { due = Math.Max(due, this.tilesDue[n]) } else if (!this.sim.obstacles.tiles.ContainsKey(n)) { fresh.Add(n) }
        }
        if (fresh.Count == 0) { return due }
        int at = this.tick + RegionServer.TileDelay
        int id = this.tileWorker.Request(fresh)
        this.tileOrders.Add(id)
        this.tileOrderDue.Add(at)
        foreach (n in fresh) { this.tilesDue[n] = at }
        return at
    }

    // Je Takt: die Kacheln um alle Spieler bestellen; was zu diesem Takt fällig ist, übernehmen (wartet, falls der Worker noch lädt).
    undefined Tiles() {
        if (this.tileWorker == undefined) { return }
        foreach (p in this.players) { this.OrderTiles(RegionServer.Around(p.tileX, p.tileY)) }
        while (this.tileOrders.Count > 0 && this.tileOrderDue[0] <= this.tick) {
            int t0 = DateTime.UtcNow.Ticks
            var job = this.tileWorker.Take(this.tileOrders[0])
            this.tileWaitTicks = Math.Max(this.tileWaitTicks, DateTime.UtcNow.Ticks - t0)
            if (job != undefined) {
                foreach (n in job.names) {
                    var key = Raser.TileKey.Parse(n)
                    int k = job.found.IndexOf(n)
                    if (k >= 0) {
                        var tile = job.tiles.TakeAt(k)
                        job.found.RemoveAt(k)
                        this.sim.obstacles.Install(key, n, take tile)
                    } else { this.sim.obstacles.Install(key, n, undefined) }
                    this.tilesDue.Remove(n)
                }
                this.tilesLoaded = this.tilesLoaded + job.names.Count
            }
            this.tileOrders.RemoveAt(0)
            this.tileOrderDue.RemoveAt(0)
        }
    }

    // Kommt p jetzt in die Welt: an die gespeicherte Lage (mit seinem Fahrzeug) oder neu auf den Spawn-Punkt mit einem Fahrzeug der gewünschten
    // Art. Die Eingaben bis jetzt zählen nicht (der Client verwirft sie mit dem ersten Snapshot).
    undefined Spawn(Player p) {
        var place = p.spawn
        var pawn = new Raser.Pawn(p.id)
        pawn.seq = p.lastSeq
        p.inputs.Clear()
        p.pawn = take pawn
        var w = p.pawn.walker
        if (place != undefined) {
            w.east = place.east
            w.north = place.north
            w.heading = place.heading
            if (place.kind > 0) {
                var v = this.sim.Add(this.ids.Next(Raser.IdKind.Vehicle), Raser.Protocol.VehicleOf(place.kind), place.carEast, place.carNorth, place.carHeading)
                v.body.health = place.health
                v.body.fuel = place.fuel
                v.owner = p.id
                if (place.inVehicle) {
                    v.driver = p.id
                    p.pawn.vehicle = v.id
                    w.east = v.body.east
                    w.north = v.body.north
                    w.heading = v.body.heading
                }
            }
        } else {
            float e = this.defaultEast
            float n = this.defaultNorth
            float start[] = [e, n, 0.0]
            if (this.sim.obstacles.store != undefined) { start = Raser.Physics.StartIn(this.sim.obstacles.TileAt(e, n), e, n) }
            // steht dort schon ein Fahrzeug (ein anderer kam an denselben Punkt), je 7 m weiter zurück entlang der Straße
            float sh = start[2] * Math.PI / 180.0
            for (int k = 0; k < 8 && this.Occupied(start[0], start[1]); k++) {
                start[0] = start[0] + Math.Sin(sh) * 7.0
                start[1] = start[1] - Math.Cos(sh) * 7.0
            }
            w.east = start[0]
            w.north = start[1]
            w.heading = start[2]
            if (p.wantKind > 0) {
                var v = this.sim.Add(this.ids.Next(Raser.IdKind.Vehicle), Raser.Protocol.VehicleOf(p.wantKind), start[0], start[1], start[2])
                v.owner = p.id
                v.driver = p.id
                p.pawn.vehicle = v.id
            } else {
                // zu Fuß: 3 m neben die Straße
                w.east = start[0] - Math.Cos(sh) * 3.0
                w.north = start[1] - Math.Sin(sh) * 3.0
            }
        }
        // zu Fuß nicht in einen anderen hinein: je 1 m weiter
        for (int k = 0; k < 10 && p.pawn.OnFoot && this.Crowded(w.east, w.north); k++) { w.east = w.east + 1.0 }
        this.sim.pawns.Add(p.pawn)
        p.placed = true
        this.Follow(p)
        this.Park(p)
        string how = "neu am Spawn-Punkt"
        if (place != undefined) { how = "an der gespeicherten Lage" }
        Gateway.Log(p.name + " in der Welt " + how + " (" + Math.Round(w.east) + ", " + Math.Round(w.north) + ")")
    }

    // Steht ein anderer Spieler zu Fuß näher als 0,8 m an (e, n)?
    defined bool Crowded(defined float e, defined float n) {
        foreach (o in this.sim.pawns) {
            if (!o.OnFoot) { continue }
            if ((o.walker.east - e) * (o.walker.east - e) + (o.walker.north - n) * (o.walker.north - n) < 0.64) { return true }
        }
        return false
    }

    // Der Stand von p für die Datenbank (PlayerSave); undefined: er ist noch nicht in der Welt.
    byte[] SaveOf(Player p) {
        if (p.pawn == undefined || p.inv == undefined) { return undefined }
        var car = this.sim.Find(p.pawn.vehicle)
        bool inside = car != undefined
        if (car == undefined) {
            foreach (v in this.sim.vehicles) { if (v.owner == p.id) { car = v } }
        }
        Raser.Vehicle body = undefined
        if (car != undefined) { body = car.body }
        return PlayerSave.Write(p, body, inside)
    }

    // Steht ein Fahrzeug näher als 6 m an (e, n)?
    defined bool Occupied(defined float e, defined float n) {
        foreach (v in this.sim.vehicles) {
            if ((v.body.east - e) * (v.body.east - e) + (v.body.north - n) * (v.body.north - n) < 36.0) { return true }
        }
        return false
    }

    // Was jeder am Anfang dabeihat (wie offline): Handy, Schlüssel, Kleingeld, Brötchen, Zigaretten, ein Rucksack mit Wasser, Lampe, Werkzeug.
    static undefined Starter(Raser.Inventory inv) {
        inv.Give(Raser.Items.Handy, 1)
        inv.Give(Raser.Items.Schluessel, 1)
        inv.Give(Raser.Items.Geld, 23)
        inv.Give(Raser.Items.Broetchen, 3)
        inv.Give(Raser.Items.Zigaretten, 7)
        inv.Give(Raser.Items.Rucksack, 1)
        inv.Give(Raser.Items.Wasser, 2)
        inv.Give(Raser.Items.Taschenlampe, 1)
        inv.Give(Raser.Items.Werkzeug, 1)
    }

    undefined Leave(Player p) {
        for (int i = 0; i < this.players.Count; i++) {
            if (this.players[i] == p) {
                this.players.RemoveAt(i)
                break
            }
        }
        if (p.pawn == undefined) { return }
        for (int i = 0; i < this.sim.pawns.Count; i++) {
            if (this.sim.pawns[i] == p.pawn) {
                this.sim.pawns.RemoveAt(i)
                break
            }
        }
        // sein Fahrzeug bleibt stehen; das für ihn erzeugte verschwindet, wenn niemand darin sitzt
        var car = this.sim.Find(p.pawn.vehicle)
        if (car != undefined && car.driver == p.id) { car.driver = 0 }
        var mine = new List<int>()
        foreach (v in this.sim.vehicles) { if (v.owner == p.id && v.driver == 0) { mine.Add(v.id) } }
        foreach (id in mine) { this.sim.Remove(id) }
        // (der Stand ist schon in der Datenbank: Gateway.Save vor Leave)
    }

    defined int Count { get { return this.players.Count } }

    // Eingaben des Clients in die Warteschlange (nur neuere; bei zu vielen die ältesten weg).
    undefined Queue(Player p, Raser.Packet m) {
        foreach (c in m.controls) {
            if (c.seq <= p.lastSeq) { continue }
            p.lastSeq = c.seq
            p.inputs.Add(c.Clone())
        }
        while (p.inputs.Count > RegionServer.Backlog) {
            p.inputs.RemoveAt(0)
            p.dropped++
        }
    }

    // Setzt den Spieler an eine Lage (Befehl /tp): sein Fahrzeug mit, sonst er selbst.
    undefined Place(Player p, defined float e, defined float n, defined float heading) {
        if (p.pawn == undefined) { return }
        var car = this.sim.Find(p.pawn.vehicle)
        if (car != undefined) {
            car.body.east = e
            car.body.north = n
            car.body.heading = heading
            car.body.speed = 0.0
            car.body.pushE = 0.0
            car.body.pushN = 0.0
        }
        p.pawn.walker.east = e
        p.pawn.walker.north = n
        p.pawn.walker.heading = heading
        p.pawn.walker.speed = 0.0
        this.Follow(p)
    }

    // Die Felder des Spielers (Kachel, Lage für Befehle und Interesse) aus der Welt.
    undefined Follow(Player p) {
        float place[] = this.sim.PlaceOf(p.pawn)
        p.east = place[0]
        p.north = place[1]
        p.heading = place[2]
        p.speed = place[3]
        p.kind = 0
        var car = this.sim.Find(p.pawn.vehicle)
        if (car != undefined) { p.kind = Raser.Protocol.KindOf(car.body.kind, false) }
        var tile = Raser.TileKey.Of(p.east, p.north)
        p.tileX = tile.x
        p.tileY = tile.y
        p.seq = p.pawn.seq
        p.inv.east = p.east
        p.inv.north = p.north
    }

    // Geparkte Fahrzeuge auf der Kachel des Spielers, wenn dort noch keine stehen (am Straßenrand um die Mitte der Kachel).
    undefined Park(Player p) {
        string name = p.tileX + "_" + p.tileY
        if (this.parked.Contains(name) || this.sim.obstacles.store == undefined || !this.sim.obstacles.tiles.ContainsKey(name)) { return }
        this.parked.Add(name)
        string kinds[] = ["auto", "transporter", "auto", "motorrad", "auto", "fahrrad"]
        float ce = p.tileX * 256.0 + 128.0
        float cn = p.tileY * 256.0 + 128.0
        var spots = Raser.Physics.ParkingIn(this.sim.obstacles.TileAt(ce, cn), this.sim.obstacles, ce, cn, RegionServer.ParkedPerTile)
        for (int k = 0; k * 3 < spots.Count; k++) {
            this.sim.Add(this.ids.Next(Raser.IdKind.Vehicle), kinds[k % kinds.length], spots[k * 3], spots[k * 3 + 1], spots[k * 3 + 2])
        }
    }

    // Ein Takt der Region: die Eingaben der Spieler (je Takt eine, nach einer Lücke bis Burst auf einmal - schneller als die Uhr geht keiner),
    // Spieler gegen Fahrzeuge, der Verkehr, die Fahrzeuge ohne Fahrer; alle 2 Takte die Snapshots.
    undefined Step(defined int time) {
        this.tick++
        this.Tiles()
        foreach (p in this.players) { if (p.pawn == undefined && this.tick >= p.spawnAt) { this.Spawn(p) } }
        // die Fußgänger des Verkehrs (Lage nach dem letzten Takt): man weicht ihnen aus
        this.sim.discs.Clear()
        if (this.traffic != undefined) {
            foreach (q in this.traffic.people) {
                this.sim.discs.Add(q.east)
                this.sim.discs.Add(q.north)
            }
        }
        foreach (p in this.players) {
            if (p.pawn == undefined) { continue }
            p.credit = Math.Min(p.credit + 1.0, RegionServer.Burst * 1.0)
            while (p.credit >= 1.0 && p.inputs.Count > 0) {
                var c = p.inputs[0]
                // umgehauen: er liegt, die Eingaben zählen nicht (nur ihre Nummer)
                if (this.tick < p.lyingUntil) {
                    p.pawn.seq = c.seq
                } else {
                    p.pawn.walker.load = p.inv.SpeedFactor()
                    this.sim.Control(p.pawn, c)
                }
                p.inputs.RemoveAt(0)
                p.credit = p.credit - 1.0
            }
            this.Follow(p)
            this.Ops(p)
        }
        this.Knocks()
        this.Npcs()
        this.sim.Coast()
        foreach (p in this.players) { if (p.pawn != undefined) { this.Park(p) } }
        // alle 10 s: die Kacheln vergessen, auf denen niemand ist (Hindernisse werden bei Bedarf neu geladen)
        if (this.tick % 300 == 0) {
            var keep = new HashSet<string>()
            foreach (p in this.players) {
                for (int dy = -1; dy <= 1; dy++) {
                    for (int dx = -1; dx <= 1; dx++) { keep.Add((p.tileX + dx) + "_" + (p.tileY + dy)) }
                }
            }
            foreach (pair in this.tilesDue) { keep.Add(pair.Key) }
            this.sim.obstacles.Keep(keep)
        }
        if (this.tick % Raser.Protocol.SnapshotEvery == 0) { this.SendSnapshots(time) }
    }

    // Der Verkehr, ein Takt (docs/SERVER.md, "Verkehr und Fußgänger"): die Straßen der Kacheln um alle Spieler in den Graphen (je Takt
    // höchstens eine neue Kachel, gebaut wird, wenn alle da sind), die Spieler als Liste (zu Fuß, am Steuer, abgestellte Fahrzeuge),
    // Traffic.Step - der rechnet auch die Stöße der Spieler gegen die NPCs (Unfallwagen, umgefallene Fußgänger). Danach prallen die Fahrzeuge
    // der Spieler an den NPC-Autos ab, und Spieler zu Fuß werden von ihnen aufgehalten (wie an anderen Fahrzeugen).
    undefined Npcs() {
        var t = this.traffic
        if (t == undefined) { return }
        this.FeedTraffic()
        if (t.graph.lanes.Count == 0 && t.cars.Count == 0 && t.people.Count == 0) { return }
        var list = this.trafficPlayers
        list.Clear()
        foreach (p in this.players) {
            if (p.pawn == undefined) { continue }
            if (p.pawn.OnFoot) {
                var w = p.pawn.walker
                foreach (x in [w.east, w.north, w.heading, w.speed, 0.35, 0.0, 0.0]) { list.Add(x) }
            }
        }
        foreach (v in this.sim.vehicles) {
            var b = v.body
            float kind = 2.0
            if (v.driver != 0) { kind = 1.0 }
            foreach (x in [b.east, b.north, b.heading, b.speed, b.radius, b.spread, kind]) { list.Add(x) }
        }
        if (this.trafficWetness != undefined) { t.wetness = this.trafficWetness.wetness }
        t.Step(Raser.SimWorld.Tick, list)
        // Unfallwagen gegen die Wände (dieselben Hindernisse wie für die Spieler, Raser.Obstacles): wie im Spiel offline (TrafficView)
        var walls = this.sim.obstacles
        foreach (c in t.cars) {
            if (c.state == 0) { continue }
            var wb = c.body
            if (Math.Abs(wb.speed) + Math.Abs(wb.pushE) + Math.Abs(wb.pushN) < 0.05) { continue }
            float wh = wb.heading * Math.PI / 180.0
            for (int k = 0; k < 2; k++) {
                float offset = wb.spread - 2.0 * wb.spread * k
                if (walls.Push(wb.east - Math.Sin(wh) * offset, wb.north + Math.Cos(wh) * offset, wb.radius)) { wb.Collide(offset, walls.pushX, walls.pushY, walls.depth) }
            }
            c.east = wb.east
            c.north = wb.north
            c.heading = wb.heading
        }
        foreach (ev in t.events) {
            if (ev == "unfall" || ev == "umgefahren") { Gateway.Log("Verkehr: " + ev) }
        }
        // Spieler gegen NPC-Autos: abprallen (Fahrzeug) bzw. aufgehalten werden (zu Fuß)
        foreach (c in t.cars) {
            // (Autos auf einer Brücke sind über den Spielern)
            if (c.level != 0) { continue }
            float ch = c.heading * Math.PI / 180.0
            var cb = c.body
            foreach (v in this.sim.vehicles) {
                var b = v.body
                if ((b.east - c.east) * (b.east - c.east) + (b.north - c.north) * (b.north - c.north) > 144.0) { continue }
                float h = b.heading * Math.PI / 180.0
                for (int k = 0; k < 2; k++) {
                    float offset = b.spread - 2.0 * b.spread * k
                    for (float q = 1.0; q > -1.5; q = q - 2.0) {
                        float dx = b.east - Math.Sin(h) * offset - (c.east - Math.Sin(ch) * cb.spread * q)
                        float dy = b.north + Math.Cos(h) * offset - (c.north + Math.Cos(ch) * cb.spread * q)
                        float d = Math.Sqrt(dx * dx + dy * dy)
                        float deep = b.radius + cb.radius - d
                        if (deep > 0.0 && d > 0.0001) { b.Collide(offset, dx / d, dy / d, deep) }
                    }
                }
            }
            foreach (p in this.players) {
                if (p.pawn == undefined || !p.pawn.OnFoot) { continue }
                var w = p.pawn.walker
                for (float q = 1.0; q > -1.5; q = q - 1.0) { w.Avoid(c.east - Math.Sin(ch) * cb.spread * q, c.north + Math.Cos(ch) * cb.spread * q, cb.radius - 0.05) }
            }
        }
    }

    // Die Straßen der 3 x 3 Kacheln um jeden Spieler: ändert sich die Menge, bestellt der Server beim Worker (Raser.GraphWorker, eigener
    // Thread: Laden und Bauen halten den Takt nicht an) einen neuen Graphen; übernommen wird er genau TrafficDelay Takte nach der Bestellung -
    // ist er dann noch nicht fertig, wartet der Takt dort auf ihn. So hängt der Verkehr nie vom Timing des Threads ab (dieselben Eingaben:
    // derselbe Verkehr), und bis zur Übernahme fährt er auf dem alten Graphen weiter.
    undefined FeedTraffic() {
        var t = this.traffic
        var want = new List<string>()
        foreach (p in this.players) {
            if (p.pawn == undefined) { continue }
            for (int dy = -1; dy <= 1; dy++) {
                for (int dx = -1; dx <= 1; dx++) {
                    string name = (p.tileX + dx) + "_" + (p.tileY + dy)
                    if (!want.Contains(name)) { want.Add(name) }
                }
            }
        }
        want.Sort()
        string joined = ""
        foreach (name in want) { joined = joined + name + ";" }
        // (ohne Spieler bleibt der alte Graph: niemand braucht einen neuen)
        if (joined != this.trafficWant && want.Count > 0) {
            this.trafficWant = joined
            this.trafficWorker.Request(want)
            this.trafficDue = this.tick + RegionServer.TrafficDelay
        }
        if (this.tick < this.trafficDue || !this.trafficWorker.Pending) { return }
        int t0 = DateTime.Now.Ticks
        if (!this.trafficWorker.Poll()) {
            this.trafficWorker.Wait()
            int waited = DateTime.Now.Ticks - t0
            this.trafficWaitTicks = this.trafficWaitTicks + waited
            Gateway.Log("Verkehr: der Takt wartet " + (waited / 10000) + " ms auf den Graphen")
        }
        int ticks = this.trafficWorker.Hand(t)
        if (ticks < 0) { return }
        this.buildTicks = ticks
        this.builds++
        Gateway.Log("Verkehr: Graph übernommen (" + t.graph.lanes.Count + " Spuren, im Worker " + (ticks / 10000) + " ms), " + t.cars.Count + " Autos, " + t.people.Count + " Fussgaenger")
    }

    // Die NPCs bis 200 m um p als Entitäten (Raser.NpcState: EntityType.NpcCar bzw. Pedestrian, variant, bits, a, b).
    undefined NpcEntities(Player p, List<Raser.Entity> into) {
        var t = this.traffic
        if (t == undefined) { return }
        t.States(this.npcStates, p.east, p.north, 200.0)
        foreach (st in this.npcStates) {
            var e = new Raser.Entity(st.id, st.EntityType)
            e.variant = st.Variant
            e.bits = st.Bits
            e.east = st.east
            e.north = st.north
            e.heading = st.heading
            e.speed = st.speed
            e.a = st.A
            e.b = st.B
            into.Add(take e)
        }
    }

    // Spieler gegen Fahrzeuge: wer zu Fuß von einem Fahrzeug mit mehr als KnockSpeed erwischt wird, ist umgehauen (der Fahrer ist der
    // Verursacher). Den Stoß aus dem Weg rechnet schon Raser.Physics.Walk.
    undefined Knocks() {
        foreach (v in this.sim.vehicles) {
            var b = v.body
            if (Math.Abs(b.speed) < RegionServer.KnockSpeed) { continue }
            float h = b.heading * Math.PI / 180.0
            foreach (q in this.players) {
                if (q.pawn == undefined || !q.pawn.OnFoot || this.tick < q.lyingUntil) { continue }
                var w = q.pawn.walker
                bool hit = false
                foreach (part in [1.0, 0.0, -1.0]) {
                    float de = w.east - (b.east - Math.Sin(h) * b.spread * part)
                    float dn = w.north - (b.north + Math.Cos(h) * b.spread * part)
                    if (de * de + dn * dn < (b.radius + 0.45) * (b.radius + 0.45)) { hit = true }
                }
                if (hit) { this.KnockedDown(q, v.driver, b) }
            }
        }
    }

    // Ereignis "Spieler umgehauen" (victim, Verursacher: Spieler-ID, 0: niemand; by: das Fahrzeug). Der Server entscheidet, was er verliert
    // (Raser.Knockdown aus Raser.Core: Inventar zu Boden, ein Teil des Kleingelds, Kaputtes - Zufall aus Takt und ID, also nachrechenbar); er
    // liegt LyingTicks lang (die Eingaben zählen nicht), alle in der Nähe bekommen das Ereignis, er selbst den neuen Stand seines Inventars.
    undefined KnockedDown(Player victim, defined int causer, Raser.Vehicle by) {
        victim.lyingUntil = this.tick + RegionServer.LyingTicks
        victim.pawn.walker.speed = 0.0
        this.Follow(victim)
        float impact = Math.Abs(by.speed)
        var result = Raser.Knockdown.Apply(victim.inv, this.tick * 7919 + (victim.id & 1048575), impact)
        Gateway.Log(victim.name + " umgehauen (von " + Raser.Ids.Format(causer) + ", " + Math.Round(impact * 3.6) + " km/h): " + result.dropped + " Stapel am Boden, " + result.cashLost + " Cent verloren, " + result.broken + " kaputt, " + result.destroyed + " weg")
        var ev = new Raser.Packet(Raser.Protocol.Event)
        ev.kind = Raser.Protocol.KnockedDown
        ev.id = victim.id
        ev.other = causer
        ev.east = victim.east
        ev.north = victim.north
        byte frame[] = Raser.Wire.Frame(ev)
        foreach (p in this.players) { if (RegionServer.Near(p, victim)) { p.link.SendFrame(frame) } }
        this.SendInventory(victim, victim.opSeq, true)
    }

    // Sieht p den Spieler q? Gleiche Kachel oder eine der 8 Nachbarn.
    static defined bool Near(Player p, Player q) {
        return Math.Abs(p.tileX - q.tileX) <= 1 && Math.Abs(p.tileY - q.tileY) <= 1
    }

    static defined bool InSight(Player p, defined float e, defined float n) {
        var t = Raser.TileKey.Of(e, n)
        return Math.Abs(p.tileX - t.x) <= 1 && Math.Abs(p.tileY - t.y) <= 1
    }

    // Was p jetzt sehen kann: die anderen Spieler, die Fahrzeuge (ohne sein eigenes: das rechnet er voraus), die Gegenstände am Boden, die NPCs.
    List<Raser.Entity> EntitiesFor(Player p) {
        var list = new List<Raser.Entity>()
        foreach (q in this.players) {
            if (q == p || q.pawn == undefined || !RegionServer.Near(p, q)) { continue }
            var e = new Raser.Entity(q.id, Raser.EntityType.Player)
            e.east = q.east
            e.north = q.north
            e.heading = q.heading
            e.speed = q.speed
            if (!q.pawn.OnFoot) {
                e.bits = Raser.EntityType.InVehicle
                e.a = q.pawn.vehicle
            }
            if (this.tick < q.lyingUntil) { e.bits = e.bits | Raser.EntityType.Lying }
            if (q.inv != undefined && q.inv.LampShining()) { e.bits = e.bits | Raser.EntityType.Lamp }
            list.Add(take e)
        }
        foreach (v in this.sim.vehicles) {
            if (v.id == p.pawn.vehicle || !RegionServer.InSight(p, v.body.east, v.body.north)) { continue }
            list.Add(Raser.Entity.OfVehicle(v))
        }
        foreach (d in this.drops.all) {
            if (!RegionServer.InSight(p, d.east, d.north)) { continue }
            var e = new Raser.Entity(d.id, Raser.EntityType.Item)
            e.variant = d.item
            e.east = d.east
            e.north = d.north
            e.a = d.count
            e.b = d.data
            list.Add(take e)
        }
        this.NpcEntities(p, list)
        return list
    }

    // Der Snapshot für p: sein Zustand, die letzte gerechnete Eingabe, die neuen und geänderten Entitäten (unverändert: nur alle 2 s), die
    // verschwundenen.
    Raser.Packet SnapshotFor(Player p, defined int time) {
        var s = new Raser.Packet(Raser.Protocol.Snapshot)
        s.time = time
        s.tick = this.tick
        s.region = this.region.id
        s.ack = p.pawn.seq
        s.cash = p.inv.cash
        var car = this.sim.Find(p.pawn.vehicle)
        Raser.Vehicle body = undefined
        if (car != undefined) { body = car.body }
        s.SetSelf(p.pawn, body)
        var all = this.EntitiesFor(p)
        // die Grundlage: der zuletzt bestätigte Snapshot (Delta dagegen); ohne: alles ganz
        Raser.SnapState grund = undefined
        if (p.snapAck > 0 && p.sent.ContainsKey(p.snapAck)) { grund = p.sent[p.snapAck] }
        var state = new Raser.SnapState(this.tick)
        foreach (e in all) {
            if (s.quant.Count >= Raser.Protocol.MaxEntities) { break }
            var q = Raser.EntityQ.Of(e)
            // weiter als FarLod m: nur jeden 2. Snapshot neu (dazwischen gilt für den Client der alte Stand - so steht es auch im Gedächtnis)
            float de = e.east - p.east
            float dn = e.north - p.north
            if (grund != undefined && grund.entities.ContainsKey(q.id) && (this.tick / Raser.Protocol.SnapshotEvery) % 2 == 1 && de * de + dn * dn > RegionServer.FarLod * RegionServer.FarLod) {
                var old = grund.entities[q.id]
                if (old.type == q.type) { q = old.Clone() }
            }
            state.entities[q.id] = q.Clone()
            s.quant.Add(take q)
        }
        state.self = Raser.SelfState.Of(s.self, s.selfVehicle)
        if (grund != undefined) {
            s.baseTick = grund.tick
            s.baseState = grund
        }
        p.sent[this.tick] = take state
        // nur, was der Client noch bestätigen kann (die letzten 2 s)
        var old2 = new List<int>()
        foreach (t in p.sent.Keys) { if (t < this.tick - 60 && t != p.snapAck) { old2.Add(t) } }
        foreach (t in old2) { p.sent.Remove(t) }
        return s
    }

    // Allen ihren Snapshot (15-mal je Sekunde).
    undefined SendSnapshots(defined int time) {
        foreach (p in this.players) {
            if (p.pawn == undefined) { continue }
            var s = this.SnapshotFor(p, time)
            int before = p.link.sentBytes
            p.link.Send(s)
            p.sentBytes = p.sentBytes + p.link.sentBytes - before
        }
    }

    // Eine Operation wartet, bis die Eingabe davor gerechnet ist (höchstens 16, höchstens 2 s - wer eine Nummer aus der Zukunft schickt, wartet
    // nur auf sich selbst).
    undefined QueueOp(Player p, Raser.Packet m) {
        if (p.waitingOps.Count >= 16) {
            this.SendInventory(p, m.seq, false)
            return
        }
        m.tick = this.tick
        p.waitingOps.Add(take m)
        this.Ops(p)
    }

    // Die wartenden Operationen, deren Eingabe gerechnet ist.
    undefined Ops(Player p) {
        while (p.waitingOps.Count > 0 && p.pawn != undefined) {
            var m = p.waitingOps[0]
            if (m.ack > p.pawn.seq && this.tick - m.tick < 60) { return }
            this.Operate(p, m)
            p.waitingOps.RemoveAt(0)
        }
    }

    // Eine Operation am Inventar: mit demselben Inventory.Apply geprüft (Lage und Reichweite aus dem Stand des Servers); Ablegen, Aufheben und
    // Öffnen nur zu Fuß. Die Antwort ist immer der echte Stand der Behälter (InvSet); wer denselben Rucksack offen hat, bekommt ihn auch.
    undefined Operate(Player p, Raser.Packet m) {
        if (p.inv == undefined) { return }
        if (p.pawn == undefined) {
            this.SendInventory(p, m.seq, false)
            return
        }
        var op = m.op
        this.Follow(p)
        bool ok = false
        bool onFoot = p.pawn.OnFoot && this.tick >= p.lyingUntil
        int touched = op.source
        if (op.kind == Raser.Protocol.OpOpen) {
            ok = onFoot && p.inv.Open(op.drop)
        } else if (op.kind == Raser.Protocol.OpClose) {
            p.inv.CloseOpened()
            ok = true
        } else if (op.kind == Raser.InvOp.Drop || op.kind == Raser.InvOp.PickUp) {
            if (op.kind == Raser.InvOp.PickUp) {
                var d = this.drops.Find(op.drop)
                if (d != undefined) { touched = d.data }
            }
            ok = onFoot && p.inv.Apply(op)
        } else if (op.kind == Raser.InvOp.Use) {
            // benutzen (essen, Lampe, tanken, reparieren): das Fahrzeug ist das nächste der Region
            p.inv.vehicle = this.NearestBody(p.east, p.north)
            ok = this.tick >= p.lyingUntil && p.inv.Apply(op)
            if (p.inv.message != "") { Gateway.Log(p.name + ": " + p.inv.message) }
        } else {
            ok = p.inv.Apply(op)
        }
        p.opSeq = m.seq
        this.SendInventory(p, m.seq, ok)
        // die anderen, die einen der Behälter offen haben
        foreach (q in this.players) {
            if (q == p || q.inv == undefined || q.inv.opened == 0) { continue }
            if (q.inv.opened == touched || q.inv.opened == op.target || q.inv.opened == op.source) {
                q.inv.Settle()
                if (q.inv.opened != 0 && this.drops.Find(q.inv.openedDrop) == undefined) { q.inv.CloseOpened() }
                this.SendInventory(q, q.opSeq, true)
            }
        }
    }

    // Das Fahrzeug, dessen Mitte (e, n) am nächsten ist (undefined: keins).
    Raser.Vehicle NearestBody(defined float e, defined float n) {
        Raser.Vehicle best = undefined
        float d2 = 1.0e30
        foreach (v in this.sim.vehicles) {
            float d = (v.body.east - e) * (v.body.east - e) + (v.body.north - n) * (v.body.north - n)
            if (d < d2) {
                d2 = d
                best = v.body
            }
        }
        return best
    }

    // Der echte Stand des Inventars an p: die IDs, alle Behälter, an die er kommt (die eigenen, der Rucksack auf dem Rücken, der geöffnete).
    undefined SendInventory(Player p, defined int seq, defined bool ok) {
        if (p.inv == undefined) { return }
        var inv = p.inv
        var s = new Raser.Packet(Raser.Protocol.InvSet)
        s.seq = seq
        s.ok = ok
        s.cash = inv.cash
        s.lamp = inv.lampOn
        int ids[] = [inv.pockets, inv.hands, inv.backpackSlot, inv.phoneSlot, inv.cursor, inv.opened, inv.openedDrop]
        for (int i = 0; i < 7; i++) { s.invIds[i] = ids[i] }
        var send = new List<int>()
        foreach (id in [inv.pockets, inv.hands, inv.backpackSlot, inv.phoneSlot, inv.cursor]) { send.Add(id) }
        var bp = inv.Backpack()
        if (bp != undefined) { send.Add(bp.id) }
        if (inv.opened != 0) { send.Add(inv.opened) }
        foreach (id in send) {
            var c = this.store.Find(id)
            if (c == undefined) { continue }
            var w = new Raser.ByteWriter(64)
            c.Write(w)
            s.containers.Add(Raser.Container.Read(new Raser.ByteReader(w.ToBytes())))
        }
        p.link.Send(s)
    }
}
