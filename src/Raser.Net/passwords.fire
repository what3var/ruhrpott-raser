// Raser.Net: Passwörter - PBKDF2 mit HMAC-SHA-256 (RFC 8018), Salz und Rundenzahl je Konto; Vergleich in fester Zeit.
#import "hash"

namespace Raser {
    class Passwords {
        static readonly defined int Rounds = 20000
        static readonly defined int MinLength = 6
        static readonly defined int MaxLength = 128

        // PBKDF2-HMAC-SHA-256: length Bytes aus Passwort (Text, UTF-8) und Salz.
        static byte[] Pbkdf2(string password, byte salt[], defined int rounds, defined int length) {
            var mac = new Hash.Hmac(Hash.Algorithm.Sha256, password)
            byte result[] = new byte[length]
            int done = 0
            int block = 1
            while (done < length) {
                // U1 = HMAC(P, S || INT(block)), Uj = HMAC(P, Uj-1), T = U1 xor ... xor Uc
                byte start[] = new byte[salt.length + 4]
                salt.CopyTo(start, 0)
                start[salt.length] = (block >> 24) & 255
                start[salt.length + 1] = (block >> 16) & 255
                start[salt.length + 2] = (block >> 8) & 255
                start[salt.length + 3] = block & 255
                byte u[] = mac.Update(start).Finish()
                byte t[] = copy u
                for (int i = 1; i < rounds; i++) {
                    byte next[] = mac.Update(u).Finish()
                    delete u
                    u = next
                    for (int k = 0; k < 32; k++) { t[k] = t[k] # u[k] }
                }
                int n = Math.Min(32, length - done)
                t.CopyTo(result, done, 0, n)
                done = done + n
                block = block + 1
            }
            return result
        }

        // Der Hash eines Passworts als Hex (32 Bytes).
        static string Derive(string password, string saltHex, defined int rounds) {
            return Hash.Hex.Encode(Raser.Passwords.Pbkdf2(password, Hash.Hex.Decode(saltHex), rounds, 32))
        }

        // Passt das Passwort zum gespeicherten Hash? (fester Zeitaufwand beim Vergleich)
        static bool Verify(string password, string saltHex, defined int rounds, string hashHex) {
            byte expected[] = Hash.Hex.Decode(hashHex)
            byte actual[] = Raser.Passwords.Pbkdf2(password, Hash.Hex.Decode(saltHex), rounds, expected.length)
            return Hash.Bytes.Equal(expected, actual)
        }

        static defined bool Valid(string password) {
            return password != undefined && password.Length >= Raser.Passwords.MinLength && password.Length <= Raser.Passwords.MaxLength
        }
    }
}
