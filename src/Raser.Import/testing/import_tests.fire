// Die Tests von Raser.Import (forge test src/Raser.Import/Raser.Import.fireproj).
// data/dgm_small.tif: 40 x 30 Float32 mit LZW, Höhe 100 + 0,25 x - 0,5 y (Pixel x, y), Pixel (3, 3) ohne Daten; links oben bei 376000 / 5705000.
// data/lod2_small.gml: zwei echte Gebäude aus LoD2_32_376_5704 (Geobasis NRW, dl-de/zero-2-0), eines mit drei Gebäudeteilen.
// data/osm_small.osm: von Hand geschrieben.
#import "testing"
#import "io"
#import "raser.core"
#import "raser.world"

class XmlTests {
    [Test "Elemente, Attribute, Text, Entitäten"]
    undefined Basics() {
        string text = "<?xml version=\"1.0\"?><!-- c --><a x=\"1\" y='z&amp;w'><b/>Hallo &lt;Welt&gt; &#228;<c:d>t</c:d><![CDATA[<roh>]]></a>"
        var r = new Raser.XmlReader(IO.Utf8.GetBytes(text))
        Testing.Assert.IsTrue(r.Next())
        Testing.Assert.AreEqual(Raser.XmlEvent.Start, r.kind)
        Testing.Assert.AreEqual("a", r.name)
        Testing.Assert.AreEqual("1", r.Attr("x"))
        Testing.Assert.AreEqual("z&w", r.Attr("y"))
        r.Next()
        Testing.Assert.AreEqual("b", r.name)
        Testing.Assert.IsTrue(r.selfClosing)
        r.Next()
        Testing.Assert.AreEqual(Raser.XmlEvent.End, r.kind)
        r.Next()
        Testing.Assert.AreEqual(Raser.XmlEvent.Text, r.kind)
        Testing.Assert.AreEqual("Hallo <Welt> ä", r.text)
        r.Next()
        Testing.Assert.AreEqual("c:d", r.name)
        Testing.Assert.AreEqual("d", r.localName)
        Testing.Assert.AreEqual("t", r.ReadText())
        r.Next()
        Testing.Assert.AreEqual("<roh>", r.text)
        r.Next()
        Testing.Assert.AreEqual(Raser.XmlEvent.End, r.kind)
        Testing.Assert.AreEqual("a", r.name)
        Testing.Assert.IsFalse(r.Next())
    }
}

class GeoTiffTests {
    [Test "Float32 aus Bits"]
    undefined Float32() {
        Testing.Assert.AreEqual(1.0, Raser.GeoTiff.Float32(0x3F800000))
        Testing.Assert.AreEqual(-2.5, Raser.GeoTiff.Float32(0xC0200000))
        Testing.Assert.AreEqual(0.0, Raser.GeoTiff.Float32(0))
        Testing.Assert.AreEqual(-9999.0, Raser.GeoTiff.Float32(0xC61C3C00))
    }

    [Test "DGM-Kachel mit LZW lesen"]
    undefined Read() {
        var raster = Raser.GeoTiff.Read(new Resource("data/dgm_small.tif").Bytes())
        Testing.Assert.AreEqual(40, raster.width)
        Testing.Assert.AreEqual(30, raster.height)
        Testing.Assert.AreEqual(376000.0, raster.east)
        Testing.Assert.AreEqual(5705000.0, raster.north)
        Testing.Assert.AreEqual(1.0, raster.pixel)
        Testing.Assert.AreEqual(-9999.0, raster.noData)
        Testing.Assert.AreEqual(100.0, raster.Pixel(0, 0))
        Testing.Assert.AreEqual(100.0 + 39 * 0.25 - 29 * 0.5, raster.Pixel(39, 29))
        Testing.Assert.AreEqual(-9999.0, raster.Pixel(3, 3))
        // Mitte des Pixels (10, 5): 376010,5 / 5704994,5.
        Testing.Assert.AreEqual(100.0, raster.At(376010.5, 5704994.5))
        // Zwischen zwei Pixelmitten in x: + 0,125.
        Testing.Assert.AreEqual(100.125, raster.At(376011.0, 5704994.5))
        Testing.Assert.IsTrue(raster.At(375999.0, 5704994.5) == undefined)
    }
}

class ProjectionTests {
    [Test "WGS84 nach UTM 32"]
    undefined Utm() {
        // Bochum, Rathaus (Vergleichswert aus einer unabhängigen Rechnung).
        var p = Raser.Utm.FromLatLon(51.4818, 7.2160)
        Testing.Assert.IsTrue(Math.Abs(p[0] - 376122.83) < 0.05)
        Testing.Assert.IsTrue(Math.Abs(p[1] - 5704914.23) < 0.05)
        // Auf dem Mittelmeridian: Ost = 500000.
        var q = Raser.Utm.FromLatLon(51.0, 9.0)
        Testing.Assert.IsTrue(Math.Abs(q[0] - 500000.0) < 0.001)
    }
}

class CityGmlTests {
    [Test "Gebäude und Gebäudeteile"]
    undefined Read() {
        var list = Raser.CityGml.Read(new Resource("data/lod2_small.gml").Bytes())
        Testing.Assert.AreEqual(4, list.Count)
        var a = list[0]
        Testing.Assert.AreEqual("DENW01AL1000Amp7", a.id)
        Testing.Assert.AreEqual("3100", a.roofCode)
        Testing.Assert.AreEqual(8, a.ground.length / 3)
        Testing.Assert.AreEqual(4, a.roofs.Count)
        Testing.Assert.IsTrue(Math.Abs(a.measuredHeight - 13.272) < 0.001)
        Testing.Assert.AreEqual(Raser.RoofType.Gable, Raser.CityGml.RoofOf(a.roofCode))
        // Die Teile des zweiten Gebäudes haben eigene IDs und erben die Funktion.
        Testing.Assert.IsTrue(list[1].id.StartsWith("UUID_"))
        Testing.Assert.IsTrue(list[1].function != undefined)
    }

    [Test "Gebäude in eine Kachel"]
    undefined Tile() {
        var region = new Raser.Region()
        region.AddBuildings(Raser.CityGml.Read(new Resource("data/lod2_small.gml").Bytes()), "lod2_small.gml")
        // Das erste Gebäude liegt bei rund 376570 / 5704530.
        var lb = region.buildings[0]
        var key = Raser.TileKey.Of(lb.box.minX, lb.box.minY)
        var tile = region.Build(key)
        Testing.Assert.IsTrue(tile.data.buildings.Count >= 1)
        var b = tile.data.buildings[0]
        Testing.Assert.AreEqual("lod2:DENW01AL1000Amp7", b.source)
        Testing.Assert.IsTrue(Math.Abs(b.ground - 105.734) < 0.001)
        Testing.Assert.IsTrue(Math.Abs(b.eaves - 115.416) < 0.001)
        Testing.Assert.IsTrue(Math.Abs(b.ridge - 119.006) < 0.001)
        Testing.Assert.IsTrue(b.footprint[0] >= -1.0 && b.footprint[0] <= 257.0)
        Testing.Assert.IsTrue(tile.heights == undefined)
        // Die Voxelisierung baut daraus ein Dach mit Schnitten.
        var v = new Raser.Voxelizer(tile, new Raser.OverrideSet(), 1)
        float cx = (b.footprint[0] + b.footprint[4]) / 2.0
        float cy = (b.footprint[1] + b.footprint[5]) / 2.0
        var model = v.models[0]
        float r = model.RoofAt(cx, cy)
        Testing.Assert.IsTrue(r >= b.eaves - 0.01 && r <= b.ridge + 0.01)
    }
}

class OsmTests {
    [Test "Straßen, Flächen, POIs"]
    undefined Read() {
        var osm = new Raser.OsmData()
        osm.Read(new Resource("data/osm_small.osm").Bytes())
        osm.Read(new Resource("data/osm_small.osm").Bytes())     // doppelt gelesen: zählt einmal
        Testing.Assert.AreEqual(7, osm.NodeCount)
        Testing.Assert.AreEqual(6, osm.ways.Count)
        Testing.Assert.AreEqual(1, osm.points.Count)
        Testing.Assert.AreEqual("Tanke & Trinkhalle", osm.points[0].tags["name"])
        var features = osm.Features()
        // Straße, Park, Fußweg, Tunnel; dazu ein Gebiet und ein Gebäude-Umriss (für das Aussehen der Häuser)
        Testing.Assert.AreEqual(6, features.Count)
        Testing.Assert.AreEqual("highway=primary", features[3].kind)
        Testing.Assert.AreEqual(-1, features[3].layer)
        features.RemoveAt(3)
        Testing.Assert.AreEqual("zone:landuse=residential", features[3].kind)
        Testing.Assert.AreEqual("Altstadt", features[3].name)
        Testing.Assert.AreEqual("osm:building", features[4].kind)
        Testing.Assert.AreEqual("building=retail;start_date=1910", features[4].tags)
        Testing.Assert.AreEqual("highway=residential", features[0].kind)
        Testing.Assert.AreEqual(5.5, features[0].width)
        Testing.Assert.AreEqual("osm:way/10", features[0].source)
        Testing.Assert.IsTrue(features[1].area)
        Testing.Assert.AreEqual("leisure=park", features[1].kind)
        Testing.Assert.AreEqual(8, features[1].points.length)
        Testing.Assert.AreEqual(3.5, features[2].width)
        Testing.Assert.AreEqual(Raser.Material.Paving, features[2].surface)
    }

    [Test "OSM in eine Kachel"]
    undefined Tile() {
        var osm = new Raser.OsmData()
        osm.Read(new Resource("data/osm_small.osm").Bytes())
        var region = new Raser.Region()
        region.AddOsm(osm, "osm_small.osm")
        var key = Raser.TileKey.Of(376122.8, 5704914.2)
        var tile = region.Build(key)
        Testing.Assert.AreEqual(3, tile.data.roads.Count)
        Testing.Assert.AreEqual(1, tile.data.areas.Count)
        Testing.Assert.AreEqual(1, tile.data.zones.Count)
        Testing.Assert.AreEqual("landuse=residential", tile.data.zones[0].kind)
        Testing.Assert.AreEqual(1, tile.data.pois.Count)
        Testing.Assert.AreEqual("amenity=fuel", tile.data.pois[0].kind)
        var p = tile.data.pois[0]
        Testing.Assert.IsTrue(p.x >= 0.0 && p.x < 256.0 && p.y >= 0.0 && p.y < 256.0)
    }
}

// Tunnel, Unterführungen und Tiefgaragen (Raser.TunnelSolver) auf einem künstlichen DGM.
class TunnelTests {
    // Ein DGM von 600 x 300 m (1 m) ab der Südwest-Ecke der Kachel (1500, 22280), überall h außer wo dam es anders sagt.
    static Raser.Region Region(defined float h, defined bool dam) {
        var region = new Raser.Region()
        var r = new Raser.GeoRaster()
        r.width = 600
        r.height = 300
        r.pixel = 1.0
        r.east = 1500 * 256.0 - 10.0
        r.north = 22280 * 256.0 + 290.0
        r.values = new float[600 * 300]
        for (int y = 0; y < 300; y++) {
            for (int x = 0; x < 600; x++) {
                float v = h
                // ein Bahndamm (6 m) quer über die Straße, 30 m breit; über der Straße (y 100 +- 6) fehlt er im DGM (die Brücke ist herausgerechnet)
                float e = x + 0.5 - 10.0
                float n = 290.0 - y - 0.5
                if (dam && e >= 100.0 && e <= 130.0 && Math.Abs(n - 100.0) > 6.0) { v = h + 6.0 }
                r.values[y * 600 + x] = v
            }
        }
        region.AddDgm(take r, "test")
        return region
    }

    static undefined Road(Raser.Region region, string source, string kind, defined int layer, defined float x0, defined float y0, defined float x1, defined float y1) {
        var f = new Raser.OsmFeature()
        f.source = source
        f.kind = kind
        f.layer = layer
        f.width = 7.0
        float e = 1500 * 256.0
        float n = 22280 * 256.0
        f.points = [e + x0, n + y0, e + x1, n + y1]
        var box = Raser.Box2.Of(f.points)
        box.Grow(4.0)
        region.featureBoxes.Add(take box)
        region.features.Add(take f)
    }

    static Raser.Road Find(Raser.Tile tile, string source) {
        foreach (r in tile.data.roads) { if (r.source == source) { return r } }
        return undefined
    }

    [Test "Tunnel unter dem Gelände: Fahrbahn tief, Rampen davor"]
    undefined UnderGround() {
        var region = TunnelTests.Region(100.0, false)
        TunnelTests.Road(region, "a", "highway=secondary", 0, 10.0, 100.0, 60.0, 100.0)
        TunnelTests.Road(region, "b", "highway=secondary", -1, 60.0, 100.0, 160.0, 100.0)
        TunnelTests.Road(region, "c", "highway=secondary", 0, 160.0, 100.0, 230.0, 100.0)
        var tile = region.Build(new Raser.TileKey(1500, 22280))
        var b = TunnelTests.Find(tile, "b")
        Testing.Assert.IsTrue(b.profile != undefined)
        Testing.Assert.AreEqual(101, b.profile.length)
        Testing.Assert.AreEqual(4.5, b.clearance)
        // in der Mitte: Gelände - lichte Höhe - Decke
        Testing.Assert.IsTrue(Math.Abs(b.profile[50] - 95.0) < 0.01)
        Testing.Assert.IsTrue(Math.Abs(b.top[50] - 100.0) < 0.01)
        // an den Enden (offen) höchstens 8 % steiler
        Testing.Assert.IsTrue(b.profile[0] < 95.2)
        // die Rampe davor: von 95,08 die Straße a hinauf (8 %), am anderen Ende noch 4 m tiefer
        var a = TunnelTests.Find(tile, "a")
        Testing.Assert.IsTrue(a.profile != undefined)
        Testing.Assert.IsTrue(Math.Abs(a.profile[a.profile.length - 1] - b.profile[0]) < 0.02)
        Testing.Assert.IsTrue(Math.Abs(a.profile[0] - (b.profile[0] + 0.08 * 50.0)) < 0.05)
        Testing.Assert.IsTrue(Math.Abs(a.top[0] - 100.0) < 0.01)
        // das Raster: über dem Tunnel unverändert, auf der Rampe abgesenkt (neben ihr nicht)
        Testing.Assert.IsTrue(Math.Abs(tile.heights.At(110.0, 100.0) - 100.0) < 0.01)
        Testing.Assert.IsTrue(tile.heights.At(55.0, 100.0) < 96.0)
        Testing.Assert.IsTrue(Math.Abs(tile.heights.At(55.0, 110.0) - 100.0) < 0.01)
        // zur Laufzeit ein Deck unter dem Gelände, mit Portalen an beiden Enden
        var decks = Raser.Bridges.Of(tile)
        Raser.BridgeDeck deck = undefined
        foreach (d in decks) { if (d.road == b.id) { deck = d } }
        Testing.Assert.IsTrue(deck != undefined)
        Testing.Assert.IsTrue(deck.tunnel)
        Testing.Assert.IsTrue(deck.startJoined && deck.endJoined)
        Testing.Assert.IsTrue(Math.Abs(deck.half - 4.5) < 0.01)
        Testing.Assert.IsTrue(Raser.Tunnels.Covered(deck.At(50.0), deck.TopAt(50.0)))
        // die Stützwände der Rampen (Fahrphysik)
        var walls = Raser.Tunnels.Walls(tile)
        Testing.Assert.IsTrue(walls.Count > 100)
    }

    [Test "Unterführung unter einem Damm: Fahrbahn auf dem DGM, der Damm läuft darüber"]
    undefined UnderDam() {
        var region = TunnelTests.Region(100.0, true)
        TunnelTests.Road(region, "a", "highway=secondary", 0, 10.0, 100.0, 95.0, 100.0)
        TunnelTests.Road(region, "b", "highway=secondary", -1, 95.0, 100.0, 135.0, 100.0)
        TunnelTests.Road(region, "c", "highway=secondary", 0, 135.0, 100.0, 230.0, 100.0)
        var tile = region.Build(new Raser.TileKey(1500, 22280))
        var b = TunnelTests.Find(tile, "b")
        Testing.Assert.IsTrue(Math.Abs(b.profile[20] - 100.0) < 0.01)
        Testing.Assert.IsTrue(Math.Abs(b.top[20] - 106.0) < 0.01)
        Testing.Assert.IsTrue(Math.Abs(tile.heights.At(115.0, 100.0) - 106.0) < 0.01)
        // keine Rampe
        var a = TunnelTests.Find(tile, "a")
        Testing.Assert.IsTrue(a.profile == undefined)
    }

    [Test "Tiefgarage: Fahrgasse auf ihrem Boden"]
    undefined Garage() {
        var region = TunnelTests.Region(100.0, false)
        TunnelTests.Road(region, "a", "highway=service", 0, 10.0, 100.0, 60.0, 100.0)
        TunnelTests.Road(region, "b", "highway=service", -1, 60.0, 100.0, 100.0, 100.0)
        TunnelTests.Road(region, "c", "highway=service", -1, 100.0, 100.0, 150.0, 100.0)
        var f = new Raser.OsmFeature()
        f.source = "g"
        f.kind = "parking=underground"
        f.area = true
        float e = 1500 * 256.0
        float n = 22280 * 256.0
        f.points = [e + 95.0, n + 80.0, e + 160.0, n + 80.0, e + 160.0, n + 120.0, e + 95.0, n + 120.0]
        region.featureBoxes.Add(Raser.Box2.Of(f.points))
        region.features.Add(take f)
        var tile = region.Build(new Raser.TileKey(1500, 22280))
        Testing.Assert.AreEqual(1, tile.data.garages.Count)
        Testing.Assert.IsTrue(Math.Abs(tile.data.garages[0].floor - 97.0) < 0.01)
        var c = TunnelTests.Find(tile, "c")
        Testing.Assert.IsTrue(Math.Abs(c.profile[25] - 97.0) < 0.01)
        Testing.Assert.AreEqual(2.5, c.clearance)
        // die Zufahrt b liegt so tief wie die Garage (dieselbe lichte Höhe), die Rampe davor steigt mit 15 %
        var b = TunnelTests.Find(tile, "b")
        Testing.Assert.IsTrue(Math.Abs(b.profile[0] - 97.15) < 0.01)
        var a = TunnelTests.Find(tile, "a")
        Testing.Assert.IsTrue(Math.Abs(a.profile[a.profile.length - 2] - 97.3) < 0.02)
        var decks = Raser.Bridges.Of(tile)
        int garages = 0
        foreach (d in decks) { if (d.ring != undefined) { garages++ } }
        Testing.Assert.AreEqual(1, garages)
        var pillars = new List<float>()
        var lines = new List<float>()
        foreach (d in decks) { if (d.ring != undefined) { Raser.Tunnels.Bays(d, decks, pillars, lines) } }
        Testing.Assert.IsTrue(lines.Count > 0)
        Testing.Assert.IsTrue(pillars.Count > 0)
    }
}
