// Raser.Client: der Himmel hinter der Welt (Farben und Bilder aus Raser.SkyLook).
//
// Eine eigene kleine Szene ohne Nebel, mit einer eigenen Kamera, die der Kamera der Welt folgt (in ihrer Mitte, nur die Drehung): die Kuppel
// (Verlauf, Dämmerung, Lichtglocke; 1000 m), die Sterne (950 m), Sonne und Mond als Billboards (900 m) und die Wolkenschicht (800 m), alle
// unbeleuchtet. Die Welt wird mit durchsichtigem Hintergrund gerendert (Alpha 0: der Nebel färbt nur Rot, Grün und Blau, deckende Dreiecke
// setzen Alpha 255); danach kommt der Himmel in zwei Blits hinter sie. Der Nebel der Welt nimmt die Farbe des Horizonts in Blickrichtung an,
// so verschwinden ferne Gebäude im Himmel. Die Texturen werden nur neu gemacht, wenn sich Wetter, Sonne oder Mond merklich ändern.
// Szene: x = Ost, y = oben, z = -Nord.
class Sky {
    static readonly defined int Segments = 48          // Teile rundherum
    static readonly defined int Rings = 20             // Ringe vom Horizont zum Zenit
    static readonly defined int Stars = 160

    Raser.Weather weather
    Camera world                    // die Kamera der Welt
    Scene worldScene
    Scene scene
    Camera eye
    Renderer back                   // zeichnet ins Bild des Himmels
    Renderer front                  // zeichnet ins Bild der Welt
    Model shell
    Model starModel
    Object dome
    Object clouds
    Object stars
    Object sun
    Object moon
    Raser.SkyLook look
    int horizon[]                   // die Farbe am Horizont je 5° Azimut
    defined float drift             // so weit sind die Wolken gezogen (Grad um den Zenit)
    string made                     // wofür die Texturen gemacht sind
    string madeClouds
    defined int fogColor

    construct(Raser.Weather weather, Scene worldScene, Camera world) {
        this.weather = weather
        this.world = world
        this.worldScene = worldScene
        this.scene = new Scene()
        this.scene.Shadows = false
        this.scene.Threads = worldScene.Threads
        this.eye = new Camera(new Framebuffer(world.Framebuffer.Width(), world.Framebuffer.Height()))
        this.eye.Near = 1m
        this.eye.Far = 2000m
        this.scene.Add(this.eye)
        this.back = new Renderer(this.eye.Framebuffer)
        this.front = new Renderer(world.Framebuffer)
        this.horizon = new int[72]
        this.made = ""
        this.madeClouds = ""
        this.shell = Sky.Shell()
        this.dome = Sky.Part(this.shell, 1000.0)
        this.scene.Add(this.dome)
        this.starModel = Sky.StarField()
        this.stars = Sky.Part(this.starModel, 950.0)
        this.scene.Add(this.stars)
        // Sonne und Mond: Billboards (zeigen zur Kamera, oben bleibt oben)
        this.sun = Sky.Disc(2.0 * 900.0 * Math.Tan(9.0 * Math.PI / 180.0))
        this.scene.Add(this.sun)
        this.moon = Sky.Disc(2.0 * 900.0 * Math.Tan(0.86 * Math.PI / 180.0))
        this.scene.Add(this.moon)
        this.clouds = Sky.Part(this.shell, 800.0)
        this.scene.Add(this.clouds)
    }

    // Ein Teil des Himmels: unbeleuchtet, ohne Schatten, von beiden Seiten sichtbar (die Kamera ist innen), um die Kamera herum.
    static Object Part(Model model, defined float radius) {
        var o = new Object(model)
        o.KeepMeshCoordinates = true
        o.SetPosition(0m, 0m, 0m)
        o.ScaleX = radius
        o.ScaleY = radius
        o.ScaleZ = radius
        Sky.Plain(o)
        return o
    }

    static Object Disc(defined float size) {
        var o = new Object(Template.Quad, 0m, 0m, -900m, size * 1m, size * 1m, 0m)
        o.Billboard = BillboardMode.Facing
        Sky.Plain(o)
        o.Visible = false
        return o
    }

    static undefined Plain(Object o) {
        o.Color = S3D.Rgb(255, 255, 255)        // (sonst dunkelt das Grau der Vorgabe die Texturen ab)
        o.Lit = false
        o.CastShadows = false
        o.ReceiveShadows = false
        o.Material = new Material(0.0, 32.0, true, true)
    }

    // Die Kugel der Kuppel und der Wolken (Radius 1): Ringe nach Raser.SkyLook.ElevationOf, unten zu einem Pol geschlossen; u ist der
    // Azimut (0 Nord, im Uhrzeigersinn), v die Texturzeile (Zeile 0 der Textur: v = 0, unten).
    static Model Shell() {
        int n = Sky.Segments
        var vs = new List<float>()
        vs.Add(0.0)                                         // der Pol unten (-90°)
        vs.Add(0.0)
        vs.Add(0.04)
        for (int k = 0; k <= Sky.Rings; k++) { vs.Add(Raser.SkyLook.Below + (1.0 - Raser.SkyLook.Below) * k / Sky.Rings) }
        int rings = vs.Count
        float pos[] = new float[rings * (n + 1) * 3]
        float uv[] = new float[rings * (n + 1) * 2]
        int idx[] = new int[(rings - 1) * n * 6]
        float rad = Math.PI / 180.0
        for (int k = 0; k < rings; k++) {
            float v = vs[k]
            float el = Raser.SkyLook.ElevationOf(v) * rad
            if (k == 0) { el = -Math.PI / 2.0 }
            // (der oberste Ring knapp unter dem Rand der Textur: sonst holt die Interpolation die unterste Zeile dazu)
            if (k == rings - 1) { v = 1.0 - 0.6 / 64.0 }
            for (int j = 0; j <= n; j++) {
                float az = j * 2.0 * Math.PI / n
                int at = k * (n + 1) + j
                pos[at * 3] = Math.Sin(az) * Math.Cos(el)
                pos[at * 3 + 1] = Math.Sin(el)
                pos[at * 3 + 2] = -Math.Cos(az) * Math.Cos(el)
                uv[at * 2] = j * 1.0 / n
                uv[at * 2 + 1] = v
            }
        }
        int t = 0
        for (int k = 0; k + 1 < rings; k++) {
            for (int j = 0; j < n; j++) {
                int a = k * (n + 1) + j
                int c = a + n + 1
                idx[t] = a
                idx[t + 1] = a + 1
                idx[t + 2] = c
                idx[t + 3] = a + 1
                idx[t + 4] = c + 1
                idx[t + 5] = c
                t = t + 6
            }
        }
        return Model.FromArrays(pos, uv, idx)
    }

    // Die Sterne als winzige Vierecke (0,3°) auf der Kugel (Radius 1), jeder mit seiner Helligkeit als Spalte einer 16 x 1-Textur.
    static Model StarField() {
        float list[] = Raser.SkyLook.Stars(Sky.Stars)
        int n = Sky.Stars
        float pos[] = new float[n * 12]
        float uv[] = new float[n * 8]
        int idx[] = new int[n * 6]
        float half = Math.Tan(0.15 * Math.PI / 180.0)
        for (int s = 0; s < n; s++) {
            // Szene: x Ost, y oben, z -Nord
            float dx = list[s * 4]
            float dy = list[s * 4 + 2]
            float dz = -list[s * 4 + 1]
            // zwei Richtungen quer dazu: waagrecht und darüber
            float hl = Math.Sqrt(dx * dx + dz * dz)
            float ax = -dz / hl
            float az = dx / hl
            float bx = dy * az
            float by = dz * ax - dx * az
            float bz = -dy * ax
            float level = (Math.Floor(list[s * 4 + 3] * 15.0) + 0.5) / 16.0
            for (int c = 0; c < 4; c++) {
                float sa = -1.0
                float sb = -1.0
                if (c == 1 || c == 2) { sa = 1.0 }
                if (c >= 2) { sb = 1.0 }
                int at = s * 4 + c
                pos[at * 3] = dx + (ax * sa + bx * sb) * half
                pos[at * 3 + 1] = dy + by * sb * half
                pos[at * 3 + 2] = dz + (az * sa + bz * sb) * half
                uv[at * 2] = level
                uv[at * 2 + 1] = 0.5
            }
            idx[s * 6] = s * 4
            idx[s * 6 + 1] = s * 4 + 1
            idx[s * 6 + 2] = s * 4 + 2
            idx[s * 6 + 3] = s * 4
            idx[s * 6 + 4] = s * 4 + 2
            idx[s * 6 + 5] = s * 4 + 3
        }
        return Model.FromArrays(pos, uv, idx)
    }

    // Das Wetter auf den Himmel legen (nach jeder Änderung): neue Farben; Texturen nur, wenn sich genug geändert hat.
    undefined Apply() {
        var w = this.weather
        if (this.look != undefined) { delete this.look }
        this.look = new Raser.SkyLook(w)
        for (int k = 0; k < 72; k++) { this.horizon[k] = this.look.Horizon(k * 5.0) }
        string key = Math.Round(w.elevation * 2.0) + "/" + Math.Round(w.azimuth / 3.0) + "/" + Math.Round(w.clouds * 40.0) + "/" + Math.Round(w.rain * 40.0) + "/" + Math.Round(w.fog * 40.0)
        string moonKey = key + "/" + Math.Round(w.moonElevation * 2.0) + "/" + Math.Round(w.moonAzimuth / 2.0) + "/" + Math.Round(w.moonLit * 50.0)
        if (moonKey == this.made) { return }
        this.made = moonKey
        float rad = Math.PI / 180.0
        // die Kuppel
        {
            byte data[] = this.look.DomeRgba(256, 64)
            var old = this.dome.Texture
            this.dome.Texture = new Texture(256, 64, data)
            if (old != undefined) { delete old }
        }
        // die Wolken (das teuerste Bild: nur, wenn sich Sonne oder Wetter geändert haben)
        if (key != this.madeClouds) {
            this.madeClouds = key
            byte data[] = this.look.CloudRgba(512, 128)
            var old = this.clouds.Texture
            this.clouds.Texture = new Texture(512, 128, data)
            if (old != undefined) { delete old }
        }
        float overcast = Raser.SkyLook.Smooth(0.75, 0.97, w.clouds)
        float fogged = Math.Clamp(w.fog * 1.6, 0.0, 1.0)
        // die Sonne: am Horizont rot und matt, hinter dichten Wolken und im Nebel weg
        float sunVis = Math.Clamp((w.elevation + 1.0) / 1.5, 0.0, 1.0) * (1.0 - overcast) * (1.0 - fogged * 0.85)
        this.sun.Visible = sunVis > 0.01
        if (this.sun.Visible) {
            byte data[] = this.look.SunRgba(128, 0.07, sunVis)
            var old = this.sun.Texture
            this.sun.Texture = new Texture(128, 128, data)
            if (old != undefined) { delete old }
            this.sun.SetPosition(w.sunX * 900m, w.sunZ * 900m, -w.sunY * 900m)
        }
        // der Mond: nachts hell, am Tag blass; seine Phase aus dem Licht der Sonne
        float moonVis = Math.Clamp((w.moonElevation + 1.0) / 2.0, 0.0, 1.0) * (1.0 - overcast) * (1.0 - fogged) * (0.55 + 0.45 * this.look.night + 0.3 * (1.0 - this.look.daylight))
        this.moon.Visible = moonVis > 0.01
        if (this.moon.Visible) {
            // das Bild des Betrachters am Mond: rechts (Blick x oben), oben (die Senkrechte, quer zum Blick), zum Betrachter hin
            float mx = w.moonX
            float my = w.moonY
            float mz = w.moonZ
            float ux = -mz * mx
            float uy = -mz * my
            float uz = 1.0 - mz * mz
            float ul = Math.Max(Math.Sqrt(ux * ux + uy * uy + uz * uz), 0.0001)
            ux = ux / ul
            uy = uy / ul
            uz = uz / ul
            float rx = my * uz - mz * uy
            float ry = mz * ux - mx * uz
            float rz = mx * uy - my * ux
            float sr = w.sunX * rx + w.sunY * ry + w.sunZ * rz
            float su = w.sunX * ux + w.sunY * uy + w.sunZ * uz
            float st = -(w.sunX * mx + w.sunY * my + w.sunZ * mz)
            byte data[] = this.look.MoonRgba(64, 0.7, sr, su, st, Math.Min(moonVis, 1.0))
            var old = this.moon.Texture
            this.moon.Texture = new Texture(64, 64, data)
            if (old != undefined) { delete old }
            this.moon.SetPosition(mx * 900m, mz * 900m, -my * 900m)
        }
        // die Sterne: nur in klaren Nächten, und auch dann wenige (die Stadt ist hell)
        float starVis = Math.Clamp((-w.elevation - 7.0) / 5.0, 0.0, 1.0) * Math.Clamp(1.0 - w.clouds * 1.1, 0.0, 1.0) * (1.0 - Math.Clamp(w.fog * 3.0, 0.0, 1.0))
        this.stars.Visible = starVis > 0.01
        if (this.stars.Visible) {
            byte data[] = new byte[16 * 4]
            for (int k = 0; k < 16; k++) {
                // die schwachen gehen in der Lichtglocke unter
                float a = Math.Clamp((k + 0.5) / 16.0 * 1.25 - 0.25, 0.0, 1.0) * starVis
                data[k * 4] = 255
                data[k * 4 + 1] = 248
                data[k * 4 + 2] = 236
                data[k * 4 + 3] = Raser.SkyLook.Byte(a * 255.0)
            }
            var old = this.stars.Texture
            this.stars.Texture = new Texture(16, 1, data)
            if (old != undefined) { delete old }
            this.stars.Texture.Filter = TextureFilter.Nearest
        }
    }

    // Die Farbe des Horizonts in Blickrichtung (0xRRGGBB), aus den Werten je 5°.
    defined int HorizonAt(defined float azimuth) {
        float a = ((azimuth % 360.0) + 360.0) % 360.0 / 5.0
        int i = Math.Floor(a)!int % 72
        return Raser.Weather.Mix(this.horizon[i], this.horizon[(i + 1) % 72], a - Math.Floor(a))
    }

    // Die Wolken ziehen weiter (gut 3 Stunden für eine Runde um den Zenit - nah am Horizont sieht es aus wie Wind).
    undefined Advance(defined float dt) {
        this.drift = (this.drift + dt * 0.03) % 360.0
        this.clouds.RotationY = this.drift * 1deg
    }

    // Vor dem Rendern der Welt: der Nebel nimmt die Farbe des Horizonts in Blickrichtung an (Azimut = -Drehung der Kamera um y).
    undefined Follow() {
        if (this.look == undefined) { return }
        float azimuth = -(this.world.RotationY / 1deg)
        int c = this.HorizonAt(azimuth)
        if (c != this.fogColor) {
            this.fogColor = c
            this.worldScene.FogColor = Atmosphere.Rgb(c)
        }
    }

    // Nach dem Rendern der Welt: der Himmel aus derselben Richtung, die Welt darüber (wo sie Alpha 0 hat, bleibt der Himmel), zurück ins Bild.
    undefined Draw() {
        if (this.look == undefined || this.world.LastRenderer != RenderMode.Software) { return }
        this.eye.RotationX = this.world.RotationX
        this.eye.RotationY = this.world.RotationY
        this.eye.RotationZ = this.world.RotationZ
        this.eye.FieldOfView = this.world.FieldOfView
        this.eye.Render()
        this.back.Blit(this.world.Framebuffer, 0, 0, BlitMode.Transparent!int)
        this.front.Blit(this.eye.Framebuffer, 0, 0, BlitMode.Copy!int)
    }
}
